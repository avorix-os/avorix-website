---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ConsentBanner from "../components/ConsentBanner.astro";
import { getLangFromUrl } from "../i18n/translations";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
  schemaOrg?: object | object[];
}

const {
  title,
  description = "Avorix \u2014 Qualit\u00e4t ohne Fachkr\u00e4fte-Abh\u00e4ngigkeit",
  ogImage = "/og-image.jpg",
  ogImageAlt,
  ogType = "website",
  schemaOrg,
} = Astro.props;
const lang = getLangFromUrl(Astro.url);
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://avorix.de";
const canonicalUrl = `${siteUrl}${Astro.url.pathname}`;
const ogImageUrl = `${siteUrl}${ogImage}`;
const fullTitle = `${title} | Avorix`;

// hreflang (Anweisung 20, Abschnitt 7): Fuer jedes Paar wechselseitig de und en,
// dazu x-default auf die deutsche Fassung. Seiten ohne Gegenstueck bekommen
// keine Angabe -- ein hreflang, das ins Leere zeigt, schadet mehr als keins.
const SPRACHPAARE: Record<string, string> = {
  "/": "/en",
  "/personal": "/en/staff",
  "/schulung": "/en/training",
  "/system": "/en/system",
  "/pilotprogramm": "/en/pilot-program",
  "/koch-app": "/en/cook-app",
  "/ueber-uns": "/en/about",
  "/kontakt": "/en/contact",
  "/impressum": "/en/legal-notice",
  "/datenschutz": "/en/privacy",
};
const pfad = Astro.url.pathname.replace(/\/+$/, "") || "/";
let paar: { de: string; en: string } | null = null;
if (SPRACHPAARE[pfad]) {
  paar = { de: pfad, en: SPRACHPAARE[pfad] };
} else {
  const de = Object.keys(SPRACHPAARE).find(k => SPRACHPAARE[k] === pfad);
  if (de) paar = { de, en: pfad };
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Anweisung 30, Schritt 7.9: faerbt die Browserleiste auf
         Mobilgeraeten in die Papier-Hintergrundfarbe. */}
    <meta name="theme-color" content="#F7F6F2" />
    <meta name="description" content={description} />
    <meta name="google-site-verification" content="WuMVUFKkYclVOtZyiyU_PZwYn-Zhk4kdLf3ws9I26eM" />
    {/* Google Consent Mode v2: Default-Deny vor allen anderen Skripten */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied'
      });
    </script>
    {/* Scroll-Reveal: js-Klasse setzt CSS-Hide, bevor Body gerendert wird (kein FOUC) */}
    <script is:inline>
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js');
      }
    </script>
    <link rel="canonical" href={canonicalUrl} />
    {paar && (
      <>
        <link rel="alternate" hreflang="de" href={`${siteUrl}${paar.de === "/" ? "/" : paar.de}`} />
        <link rel="alternate" hreflang="en" href={`${siteUrl}${paar.en}`} />
        <link rel="alternate" hreflang="x-default" href={`${siteUrl}${paar.de === "/" ? "/" : paar.de}`} />
      </>
    )}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />

    {/* Open Graph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta property="og:site_name" content="Avorix" />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "de_DE"} />

    {/* Twitter Card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <title>{fullTitle}</title>
    {schemaOrg && (
      <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">Zum Inhalt springen</a>
    <Header />
    <main id="main" class="inhalt">
      <slot />
    </main>
    <Footer />
    <ConsentBanner lang={lang} />
    {/* CTA-Klick-Tracking: delegierter Listener, idempotent */}
    <script is:inline>
      (function () {
        if (window.__ctaBound) return;
        window.__ctaBound = true;
        document.addEventListener('click', function (e) {
          var el = e.target.closest('[data-cta-location]');
          if (!el) return;
          window.dataLayer = window.dataLayer || [];
          // Ohne data-cta-event bleibt es beim bisherigen Demo-Ereignis —
          // die bestehenden Buttons feuern also unveraendert weiter.
          window.dataLayer.push({
            event: el.getAttribute('data-cta-event') || 'cta_demo_click',
            cta_location: el.getAttribute('data-cta-location')
          });
        });
      })();
    </script>
    {/* Scroll-Reveal Observer (W0-Fix): beobachtet .reveal-Elemente.
         threshold 0 + rootMargin -12% loesen auch bei langen Sektionen sicher aus. */}
    <script is:inline>
      (function () {
        if (!document.documentElement.classList.contains('js')) return;
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('reveal-visible');
            io.unobserve(entry.target);
          });
        }, { threshold: 0, rootMargin: '0px 0px -12% 0px' });
        document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
      })();
    </script>
    {/* Anker-Sprung beim Seitenaufruf (Anweisung 30, Schritt 1).
         Zwei Dinge gingen schief, wenn man von aussen auf /personal#anfrage kam:
         1. Der Sprung war durch scroll-behavior animiert und brach beim Laden ab.
            Das ist in der CSS geloest (html:focus-within), hier steht die Absicherung.
         2. Die Ziel-Sektion traegt .reveal und ist bis zum Beobachter-Treffer
            unsichtbar -- man stuende an der richtigen Stelle vor einem leeren Bild.
         Deshalb: Ziel einblenden, dann ohne Animation anspringen. Einmal sofort und
         einmal nach 'load', weil nachladende Bilder das Layout noch verschieben.
         Hat der Nutzer inzwischen selbst gescrollt, unterbleibt der zweite Sprung. */}
    <script is:inline>
      (function () {
        if (!window.location.hash) return;
        var id;
        try { id = decodeURIComponent(window.location.hash.slice(1)); }
        catch (e) { id = window.location.hash.slice(1); }
        if (!id) return;

        var selbstGescrollt = false;
        ['wheel', 'touchstart', 'keydown'].forEach(function (ev) {
          window.addEventListener(ev, function () { selbstGescrollt = true; },
            { passive: true, once: true });
        });

        function sprung() {
          var ziel = document.getElementById(id);
          if (!ziel) return;
          // Die Sektion sofort sichtbar machen -- scroll-margin-top sorgt
          // dafuer, dass die Ueberschrift unter dem Header frei steht.
          var sektion = ziel.closest ? ziel.closest('.reveal') : null;
          if (sektion) sektion.classList.add('reveal-visible');
          ziel.scrollIntoView({ behavior: 'auto', block: 'start' });
        }

        sprung();
        window.addEventListener('load', function () {
          if (selbstGescrollt) return;
          sprung();
        });
      })();
    </script>
</body>
</html>

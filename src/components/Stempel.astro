---
/* Rundes AÜ-Siegel (Anweisung 58). Ersetzt den rechteckigen Textstempel.
   groesse: 'klein' (88 px, Hero/Karten) oder 'gross' (200 px, Schlussblock).
   hell: helle Fassung für dunklen Grund (nur klein). */
interface Props {
  lang?: 'de' | 'en';
  groesse?: 'klein' | 'gross';
  hell?: boolean;
}
const { lang = 'de', groesse = 'klein', hell = false } = Astro.props;
const alt = lang === 'en'
  ? 'Certified: German staffing licence under § 1 AÜG, Avorix GmbH'
  : 'Geprüft: Erlaubnis zur Arbeitnehmerüberlassung nach § 1 AÜG, Avorix GmbH';
const datei = `/siegel/avorix-siegel-${lang}${groesse === 'klein' ? '-klein' : ''}${groesse === 'klein' && hell ? '-hell' : ''}.svg`;
const mass = groesse === 'gross' ? 200 : 88;
---
<img class={`siegel siegel--${groesse}`} src={datei} alt={alt} width={mass} height={mass}>

<style>
/* object-fit + feste Maße: die globale Regel img { object-fit: cover } würde
   das Siegel in Flex-Containern sonst strecken und abschneiden. */
.siegel {
  display: block;
  flex: none;
  object-fit: contain;
}
.siegel--klein {
  width: 88px;
  height: 88px;
}
.siegel--gross {
  width: 200px;
  height: 200px;
  margin-inline: auto;
}
</style>

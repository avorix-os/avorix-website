---
import { getLangFromUrl, useTranslations, getLocalizedPath } from "../i18n/translations";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Anweisung 13: Die Navigation folgt der Kaufabsicht, nicht dem Aufbau des
// Angebots. Personal steht deshalb als eigener Punkt und nicht mehr als
// vierter Eintrag unter "Unser System".
const angebotLinks = [
  { label: "Die App", href: "/koch-app" },
  { label: "Die Schulung", href: "/schulung" },
  { label: "Wie alles zusammenspielt", href: "/system" },
  { label: "Pilotprogramm 2026", href: "/pilotprogramm" },
];

const zielgruppenLinks = [
  { label: "Ferienhotels", href: "/fuer-hotels" },
  { label: "Restaurants & Gasthöfe", href: "/fuer-restaurants" },
  { label: "Sporthotels", href: "/fuer-sporthotels" },
];

// W5: aktive Seite markieren (aria-current)
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (href: string) => (href.replace(/\/+$/, "") || "/") === pathname;
---

<style>
  /* === SITE HEADER === */
  .site-header {
    background: var(--eisen);
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 50;
    transition: box-shadow 0.2s ease;
  }
  /* W5: Schatten ab ~8px Scroll */
  .site-header.is-scrolled {
    box-shadow: 0 2px 12px rgba(38,37,31,.25);
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header { transition: none; }
  }

  .nav-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 28px;
    height: 60px;
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .nav-logo img {
    height: 26px;
    width: auto;
    display: block;
    filter: brightness(0) invert(1);
  }

  /* Desktop nav. H1 (Anweisung 18): Grundfassung ist das Handy, also aus.
     Ab 900 tritt sie an die Stelle des Burgers. */
  .nav-desktop {
    display: none;
    align-items: center;
    gap: 20px;
    flex: 1;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 18px;
    flex: 1;
  }

  /* Nav links: paper-white, 82% opacity, hover underline */
  .nav-link {
    color: var(--papier);
    opacity: 0.82;
    font-size: 14.5px;
    text-decoration: none;
    position: relative;
    padding: 6px 2px;
    transition: opacity 0.18s ease;
    white-space: nowrap;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 2px;
    right: 2px;
    bottom: 2px;
    height: 2px;
    background: var(--papier);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }
  .nav-link:hover { opacity: 1; }
  .nav-link:hover::after { transform: scaleX(1); }
  /* W5: aktive Seite — dauerhafter Unterstrich */
  .nav-link[aria-current="page"] { opacity: 1; }
  .nav-link[aria-current="page"]::after { transform: scaleX(1); }

  /* Dropdown trigger */
  .nav-dropdown { position: relative; }
  .nav-dropdown-trigger {
    color: var(--papier);
    opacity: 0.82;
    font-size: 14.5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px 2px;
    display: flex;
    align-items: center;
    gap: 4px;
    position: relative;
    transition: opacity 0.18s ease;
    white-space: nowrap;
    font-family: inherit;
  }
  .nav-dropdown-trigger::after {
    content: '';
    position: absolute;
    left: 2px;
    right: 18px;
    bottom: 2px;
    height: 2px;
    background: var(--papier);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }
  .nav-dropdown-trigger:hover { opacity: 1; }
  .nav-dropdown-trigger:hover::after { transform: scaleX(1); }

  /* Dropdown panel */
  .nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 210px;
    background: var(--flaeche);
    border-radius: var(--radius);
    box-shadow: var(--schatten);
    padding: 6px 0;
    opacity: 0;
    transform: translateY(-4px);
    pointer-events: none;
    transition: opacity 0.16s ease, transform 0.16s ease;
    z-index: 10;
  }
  .nav-dropdown-menu.is-open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-dropdown-menu { transition: none; }
  }

  .nav-dropdown-item {
    display: block;
    padding: 10px 14px;
    font-size: 15px;
    color: var(--druck);
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .nav-dropdown-item:hover { background: var(--flaeche-hover); }

  /* Anweisung 13: zwei Spalten im Koch-App-Menue */
  .nav-dropdown-menu-zwei {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 24px;
    min-width: 420px;
    padding: 14px 6px;
  }
  .nav-dropdown-titel {
    font-family: var(--f-mono);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .18em;
    color: var(--akzent);
    line-height: 1;
    /* B2: 10 lag ausserhalb der Skala, Label zu seiner Gruppe sind 8. */
    margin: 0 0 8px 14px;
  }
  /* B2: 18 lag ausserhalb der Skala, zwischen zwei Gruppen stehen 24. */
  .nav-dropdown-titel-zweite { margin-top: 24px; }
  .nav-dropdown-item[aria-current="page"] { color: var(--akzent); }

  /* CTA button */
  .nav-cta {
    background: var(--papier);
    color: var(--eisen);
    padding: 9px 18px;
    border-radius: var(--radius);
    font-size: 14.5px;
    font-weight: 700;
    font-family: var(--f-head);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: filter 0.18s ease;
  }
  .nav-cta:hover { filter: brightness(1.06); }

  /* Zweiter Weg in der Leiste: heller Rahmen statt gefuellter Flaeche,
     damit die Rangfolge der beiden CTAs sichtbar bleibt. */
  .nav-cta-outline {
    background: transparent;
    color: var(--papier);
    border: 1.5px solid rgba(247, 246, 242, 0.45);
    padding: 7.5px 16.5px;
  }
  .nav-cta-outline:hover {
    border-color: var(--papier);
    filter: none;
  }

  /* Burger button */
  .nav-burger {
    display: flex;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: var(--papier);
    margin-left: auto;
    flex-shrink: 0;
    min-width: 48px;
    min-height: 48px;
    align-items: center;
    justify-content: center;
  }

  /* Ab 900 die Desktop-Navigation, darunter der Burger. */
  @media (min-width: 900px) {
    .nav-desktop { display: flex; }
    .nav-burger { display: none; }
  }

  /* === MOBILE OVERLAY === */
  .nav-mobile-overlay {
    position: fixed;
    inset: 0;
    background: var(--eisen);
    z-index: 49;
    overflow-y: auto;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .nav-mobile-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-mobile-overlay { transition: none; }
  }
  @media (min-width: 900px) {
    .nav-mobile-overlay { display: none !important; }
  }

  .nav-mobile-close {
    position: absolute;
    top: 14px;
    right: 16px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--papier);
    opacity: 0.7;
    min-width: 48px;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.15s ease;
  }
  .nav-mobile-close:hover { opacity: 1; }

  .nav-mobile-inner {
    padding: 80px 28px 48px;
    display: flex;
    flex-direction: column;
  }

  /* Mobile links */
  .nav-mobile-link {
    color: var(--papier);
    text-decoration: none;
    font-size: 18px;
    padding: 14px 0;
    min-height: 48px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(247,246,242,.1);
    transition: opacity 0.15s ease;
  }
  .nav-mobile-link:hover { opacity: 0.8; }
  .nav-mobile-link[aria-current="page"] { color: var(--akzent-hell); opacity: 1; }

  /* Mobile accordion sections */
  .mobile-section { border-bottom: 1px solid rgba(247,246,242,.1); }
  .mobile-section-trigger {
    color: var(--papier);
    background: none;
    border: none;
    cursor: pointer;
    font-size: 18px;
    font-family: inherit;
    padding: 14px 0;
    min-height: 48px;
    width: 100%;
    text-align: left;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: opacity 0.15s ease;
  }
  .mobile-section-trigger:hover { opacity: 0.8; }
  .mobile-section-trigger svg {
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-section-trigger svg { transition: none; }
  }

  .mobile-section-content {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows 0.25s ease;
  }
  .mobile-section-content.is-open { grid-template-rows: 1fr; }
  @media (prefers-reduced-motion: reduce) {
    .mobile-section-content { transition: none; }
  }
  .mobile-section-inner { min-height: 0; padding-bottom: 8px; }

  .mobile-section-link {
    color: var(--papier);
    opacity: 0.78;
    text-decoration: none;
    font-size: 16px;
    padding: 12px 16px;
    min-height: 48px;
    display: flex;
    align-items: center;
    transition: opacity 0.15s ease;
  }
  .mobile-section-link:hover { opacity: 1; }
  .mobile-section-link[aria-current="page"] { color: var(--akzent-hell); opacity: 1; }

  .nav-mobile-cta {
    margin-top: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--papier);
    color: var(--eisen);
    font-weight: 700;
    font-size: 16px;
    font-family: var(--f-head);
    border-radius: var(--radius);
    padding: 16px 24px;
    min-height: 56px;
    text-decoration: none;
    text-align: center;
    transition: filter 0.18s ease;
  }
  .nav-mobile-cta:hover { filter: brightness(0.95); }

  /* Die beiden CTAs stehen mobil oben: der erste ohne Abstand nach oben,
     der zweite als Rahmen-Variante direkt darunter. */
  .nav-mobile-cta-oben { margin-top: 0; }
  .nav-mobile-cta-outline {
    margin-top: 10px;
    background: transparent;
    color: var(--papier);
    border: 1.5px solid rgba(247, 246, 242, 0.45);
  }
  .nav-mobile-cta-outline:hover {
    border-color: var(--papier);
    filter: none;
  }

  .nav-mobile-lang {
    margin-top: 20px;
  }
  /* W6: "English" im Burger als volles Touch-Ziel (>=48px) */
  .nav-mobile-lang :global(.lang-switch) {
    display: flex;
    align-items: center;
    min-height: 48px;
    font-size: 18px;
    padding: 12px 0;
  }
</style>

<header class="site-header">
  <div class="nav-inner">
    <a href={getLocalizedPath("/", lang)} class="nav-logo" aria-label="Avorix – Startseite">
      <img src="/logo.png" alt="Avorix" />
    </a>

    {lang === "de" ? (
      <nav class="nav-desktop" aria-label="Hauptnavigation">
        <div class="nav-links">
          <a href="/personal" class="nav-link" aria-current={isCurrent("/personal") ? "page" : undefined}>Personal</a>

          <div class="nav-dropdown">
            <button
              type="button"
              class="nav-dropdown-trigger"
              aria-expanded="false"
              aria-haspopup="true"
            >
              Die Koch-App
              <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div class="nav-dropdown-menu nav-dropdown-menu-zwei" role="menu">
              <div class="nav-dropdown-spalte">
                <p class="nav-dropdown-titel">Das Angebot</p>
                {angebotLinks.map(link => (
                  <a href={link.href} class="nav-dropdown-item" role="menuitem" aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a>
                ))}
              </div>
              <div class="nav-dropdown-spalte">
                <p class="nav-dropdown-titel">Für wen</p>
                {zielgruppenLinks.map(link => (
                  <a href={link.href} class="nav-dropdown-item" role="menuitem" aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a>
                ))}
              </div>
            </div>
          </div>

          <a href="/ueber-uns" class="nav-link" aria-current={isCurrent("/ueber-uns") ? "page" : undefined}>Über uns</a>
        </div>

        <a
          href="/personal#anfrage"
          data-cta-location="header"
          data-cta-event="cta_personal_click"
          class="nav-cta"
        >
          Personal anfragen
        </a>
        <a href="/kontakt" data-cta-location="header" class="nav-cta nav-cta-outline">
          App-Demo
        </a>
        <LanguageSwitcher />
      </nav>
    ) : (
      <nav class="nav-desktop" aria-label="Main navigation">
        <div class="nav-links">
          <a href="/en" class="nav-link" aria-current={isCurrent("/en") ? "page" : undefined}>{t("nav.home")}</a>
          <a href="/en/about" class="nav-link" aria-current={isCurrent("/en/about") ? "page" : undefined}>{t("nav.about")}</a>
          <a href="/en/cook-app" class="nav-link" aria-current={isCurrent("/en/cook-app") ? "page" : undefined}>{t("nav.kochapp")}</a>
          <a href="/en/product" class="nav-link" aria-current={isCurrent("/en/product") ? "page" : undefined}>{t("nav.produkt")}</a>
        </div>
        <a href="/en/contact" data-cta-location="header" class="nav-cta">{t("nav.contact")}</a>
        <LanguageSwitcher />
      </nav>
    )}

    <button
      id="mobile-menu-btn"
      class="nav-burger"
      aria-label="Menü öffnen"
      aria-expanded="false"
      aria-controls="mobile-nav-overlay"
    >
      <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</header>

<div
  id="mobile-nav-overlay"
  class="nav-mobile-overlay"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation"
>
  <button id="mobile-close-btn" class="nav-mobile-close" aria-label="Menü schließen">
    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <div class="nav-mobile-inner">
    {lang === "de" ? (
      <>
        {/* Beide Wege stehen oben, "Personal anfragen" zuerst (Anweisung 12a). */}
        <a
          href="/personal#anfrage"
          data-cta-location="header"
          data-cta-event="cta_personal_click"
          class="nav-mobile-cta nav-mobile-cta-oben"
        >
          Personal anfragen
        </a>
        <a href="/kontakt" data-cta-location="header" class="nav-mobile-cta nav-mobile-cta-outline">
          App-Demo
        </a>

        <a href="/personal" class="nav-mobile-link" aria-current={isCurrent("/personal") ? "page" : undefined}>Personal</a>

        <div class="mobile-section">
          <button type="button" class="mobile-section-trigger" aria-expanded="false">
            Die Koch-App
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="mobile-section-content">
            <div class="mobile-section-inner">
              <p class="nav-dropdown-titel">Das Angebot</p>
              {angebotLinks.map(link => (
                <a href={link.href} class="mobile-section-link" aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a>
              ))}
              <p class="nav-dropdown-titel nav-dropdown-titel-zweite">Für wen</p>
              {zielgruppenLinks.map(link => (
                <a href={link.href} class="mobile-section-link" aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a>
              ))}
            </div>
          </div>
        </div>

        <a href="/ueber-uns" class="nav-mobile-link" aria-current={isCurrent("/ueber-uns") ? "page" : undefined}>Über uns</a>

        <div class="nav-mobile-lang">
          <LanguageSwitcher />
        </div>
      </>
    ) : (
      <>
        <a href="/en" class="nav-mobile-link" aria-current={isCurrent("/en") ? "page" : undefined}>{t("nav.home")}</a>
        <a href="/en/about" class="nav-mobile-link" aria-current={isCurrent("/en/about") ? "page" : undefined}>{t("nav.about")}</a>
        <a href="/en/cook-app" class="nav-mobile-link" aria-current={isCurrent("/en/cook-app") ? "page" : undefined}>{t("nav.kochapp")}</a>
        <a href="/en/product" class="nav-mobile-link" aria-current={isCurrent("/en/product") ? "page" : undefined}>{t("nav.produkt")}</a>
        <a href="/en/contact" data-cta-location="header" class="nav-mobile-cta">{t("nav.contact")}</a>
        <div class="nav-mobile-lang">
          <LanguageSwitcher />
        </div>
      </>
    )}
  </div>
</div>

<script is:inline>
(function () {
  if (document.querySelector('[data-nav-v51]')) return;
  var header = document.querySelector('.site-header');
  if (header) header.setAttribute('data-nav-v51', '1');

  // W5: Schatten ab ~8px Scroll
  if (header) {
    var onScroll = function () {
      if (window.scrollY > 8) header.classList.add('is-scrolled');
      else header.classList.remove('is-scrolled');
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  var btn = document.getElementById('mobile-menu-btn');
  var overlay = document.getElementById('mobile-nav-overlay');
  var closeBtn = document.getElementById('mobile-close-btn');
  var lastFocus = null;

  function openOverlay() {
    lastFocus = document.activeElement;
    overlay.classList.add('is-open');
    btn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    if (closeBtn) closeBtn.focus();
  }

  function closeOverlay() {
    overlay.classList.remove('is-open');
    btn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    if (lastFocus) lastFocus.focus();
  }

  if (btn) btn.addEventListener('click', openOverlay);
  if (closeBtn) closeBtn.addEventListener('click', closeOverlay);

  // Escape key
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') {
      if (overlay && overlay.classList.contains('is-open')) {
        closeOverlay();
        return;
      }
      document.querySelectorAll('.nav-dropdown-menu.is-open').forEach(function (m) {
        m.classList.remove('is-open');
        var t = m.closest('.nav-dropdown').querySelector('.nav-dropdown-trigger');
        if (t) { t.setAttribute('aria-expanded', 'false'); t.focus(); }
      });
    }
  });

  // Mobile accordion
  document.querySelectorAll('.mobile-section-trigger').forEach(function (trigger) {
    trigger.addEventListener('click', function () {
      var expanded = trigger.getAttribute('aria-expanded') === 'true';
      var content = trigger.nextElementSibling;
      trigger.setAttribute('aria-expanded', String(!expanded));
      if (!expanded) {
        content.classList.add('is-open');
      } else {
        content.classList.remove('is-open');
      }
      var svg = trigger.querySelector('svg');
      if (svg) svg.style.transform = expanded ? '' : 'rotate(180deg)';
    });
  });

  // Desktop dropdowns
  document.querySelectorAll('.nav-dropdown').forEach(function (dropdown) {
    var trigger = dropdown.querySelector('.nav-dropdown-trigger');
    var menuEl = dropdown.querySelector('.nav-dropdown-menu');
    if (!trigger || !menuEl) return;
    var closeTimer;

    function openMenu() {
      clearTimeout(closeTimer);
      document.querySelectorAll('.nav-dropdown-menu.is-open').forEach(function (m) {
        if (m !== menuEl) {
          m.classList.remove('is-open');
          var t = m.closest('.nav-dropdown').querySelector('.nav-dropdown-trigger');
          if (t) t.setAttribute('aria-expanded', 'false');
        }
      });
      menuEl.classList.add('is-open');
      trigger.setAttribute('aria-expanded', 'true');
    }

    function closeMenu() {
      menuEl.classList.remove('is-open');
      trigger.setAttribute('aria-expanded', 'false');
    }

    trigger.addEventListener('click', function (e) {
      e.stopPropagation();
      menuEl.classList.contains('is-open') ? closeMenu() : openMenu();
    });

    trigger.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); trigger.click(); }
      if (e.key === 'Escape') { closeMenu(); trigger.focus(); }
    });

    menuEl.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') { closeMenu(); trigger.focus(); }
    });

    dropdown.addEventListener('mouseenter', function () {
      clearTimeout(closeTimer); openMenu();
    });
    dropdown.addEventListener('mouseleave', function () {
      closeTimer = setTimeout(closeMenu, 150);
    });
  });

  // Click outside closes dropdowns
  document.addEventListener('click', function (e) {
    if (!e.target.closest('.nav-dropdown')) {
      document.querySelectorAll('.nav-dropdown-menu.is-open').forEach(function (m) {
        m.classList.remove('is-open');
        var t = m.closest('.nav-dropdown').querySelector('.nav-dropdown-trigger');
        if (t) t.setAttribute('aria-expanded', 'false');
      });
    }
  });
})();
</script>

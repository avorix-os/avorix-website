---
import { getLangFromUrl, useTranslations, getLocalizedPath } from "../i18n/translations";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Anweisung 13: Die Navigation folgt der Kaufabsicht, nicht dem Aufbau des
// Angebots. Personal steht deshalb als eigener Punkt und nicht mehr als
// vierter Eintrag unter "Unser System".
// Korrektur 14 (Anweisung 25): "Wie alles zusammenspielt" steht vorn -- es ist
// die Klammer ueber die drei Bausteine; wer das Menue oeffnet, soll zuerst das
// Ganze sehen. "Das Personal" kommt neu dazu, hinter der Schulung, damit die
// drei Bausteine dieselbe Reihenfolge haben wie auf /system.
// Personal steht damit an zwei Stellen: als Hauptpunkt oben und hier. Das ist
// Absicht und keine Dublette -- zwei Wege zu derselben Seite.
const angebotLinks = [
  { label: "Wie alles zusammenspielt", href: "/system" },
  { label: "Die App", href: "/koch-app" },
  { label: "Die Schulung", href: "/schulung" },
  { label: "Das Personal", href: "/personal" },
  { label: "Pilotprogramm 2026", href: "/pilotprogramm" },
];

// Englisch: dieselbe Struktur, aber ohne die Spalte WHO IT IS FOR -- die
// Segmentseiten gibt es auf Englisch nicht (Anweisung 20, Abschnitt 7).
const offerLinks = [
  { label: "How It All Works Together", href: "/en/system" },
  { label: "The Cook App", href: "/en/cook-app" },
  { label: "The Training", href: "/en/training" },
  { label: "The Staff", href: "/en/staff" },
  { label: "Pilot Program 2026", href: "/en/pilot-program" },
];

const zielgruppenLinks = [
  { label: "Ferienhotels", href: "/fuer-hotels" },
  { label: "Restaurants & Gasthöfe", href: "/fuer-restaurants" },
  { label: "Sporthotels", href: "/fuer-sporthotels" },
];

// W5: aktive Seite markieren (aria-current)
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (href: string) => (href.replace(/\/+$/, "") || "/") === pathname;

// D1, Abnahme 4 (Anweisung 23): Der aktive Punkt muss in der geschlossenen
// Leiste erkennbar sein. Auf den vier Seiten hinter dem Aufklapper trug nur
// der Untereintrag die Markierung -- die sieht niemand, solange das Menue zu
// ist. Traegt eine dieser Seiten die Marke, wird der Aufklapper selbst aktiv.
// Seiten mit eigenem Hauptpunkt: dort markiert der Hauptpunkt, nicht der
// Aufklapper. Seit Korrektur 14 steht Personal an beiden Stellen, und ohne
// diese Ausnahme waeren auf /personal zwei Punkte gleichzeitig markiert.
const eigenerHauptpunkt = lang === "de" ? ["/personal"] : ["/en/staff"];
const aufklapperAktiv = (lang === "de" ? angebotLinks.concat(zielgruppenLinks) : offerLinks)
  .filter((link) => !eigenerHauptpunkt.includes(link.href))
  .some((link) => isCurrent(link.href));
---

<style>
  /* === SITE HEADER === */
  /* D1: Der seitliche Innenabstand der Leistenelemente. Mit den vollen 16px
     passt die Leiste erst ab 1200px; darunter ragte der Sprachumschalter
     heraus. Beide Werte stehen auf der Skala, und 1200 ist eine der drei
     erlaubten Bildschirmgrenzen aus H1 -- eine neue Grenze entsteht nicht. */
  .site-header { --nav-pad-x: 8px; }
  @media (min-width: 1200px) {
    .site-header { --nav-pad-x: 16px; }
  }

  .site-header {
    background: var(--eisen);
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 50;
    transition: box-shadow 0.2s ease;
  }
  /* W5: Schatten ab ~8px Scroll */
  .site-header.is-scrolled {
    box-shadow: 0 2px 12px rgba(38,37,31,.25);
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header { transition: none; }
  }

  /* D1 (Anweisung 18): Die Leiste war 60px hoch und die Navigation darin zu
     leise -- die beiden Buttons gewannen gegen die Punkte, die die Seite
     erschliessen. Jetzt 72px, damit die groesseren Ziele hineinpassen. */
  .nav-inner {
    /* B2-Nachtrag: 28px stand nicht auf der Skala. Mit 24px und 1080 liegt
       die Leiste ausserdem genau ueber der Inhaltsspalte, das Logo steht
       buendig zum Text darunter. Der gewonnene Platz ist das, was die
       groesseren Nav-Ziele bei 900px brauchen. */
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 24px;
    height: var(--header-hoehe);
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
  .nav-logo img {
    height: 26px;
    width: auto;
    display: block;
    filter: brightness(0) invert(1);
  }

  /* Desktop nav. H1 (Anweisung 18): Grundfassung ist das Handy, also aus.
     Ab 900 tritt sie an die Stelle des Burgers. */
  .nav-desktop {
    display: none;
    align-items: center;
    gap: 16px;
    flex: 1;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
    flex: 1;
  }

  /* Nav links: paper-white, 82% opacity, hover underline */
  /* D1: 16px statt 14,5 und Gewicht 500 statt 400. Der Innenabstand steht
     auf der Skala (8/16) statt auf den vorgegebenen 10px 14px, die keine
     Skalenstufen sind; die 44px Zielhoehe traegt stattdessen min-height --
     eine Hoehe ist eine Groesse, kein Abstand. Damit bleiben Abnahme 3
     (Skala) und Abnahme 29 (Bedienziele mindestens 44px) beide erfuellt. */
  .nav-link {
    color: var(--papier);
    opacity: 0.82;
    font-size: 16px;
    font-weight: 500;
    text-decoration: none;
    position: relative;
    padding: 8px var(--nav-pad-x);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    transition: opacity 0.18s ease;
    white-space: nowrap;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: var(--nav-pad-x);
    right: var(--nav-pad-x);
    bottom: 6px;
    height: 2px;
    background: var(--papier);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }
  .nav-link:hover { opacity: 1; }
  .nav-link:hover::after { transform: scaleX(1); }
  /* W5: aktive Seite — dauerhafter Unterstrich */
  .nav-link[aria-current="page"] { opacity: 1; }
  .nav-link[aria-current="page"]::after { transform: scaleX(1); }
  /* D1, Abnahme 4: der Aufklapper zeigt, dass die laufende Seite hinter ihm
     liegt -- gleiche Auszeichnung wie ein direkter Punkt. */
  .nav-dropdown-trigger.ist-aktiv { opacity: 1; }
  .nav-dropdown-trigger.ist-aktiv::after { transform: scaleX(1); }

  /* Dropdown trigger */
  .nav-dropdown { position: relative; }
  .nav-dropdown-trigger {
    color: var(--papier);
    opacity: 0.82;
    font-size: 16px;
    font-weight: 500;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px var(--nav-pad-x);
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 8px;
    position: relative;
    transition: opacity 0.18s ease;
    white-space: nowrap;
    font-family: inherit;
  }
  .nav-dropdown-trigger::after {
    content: '';
    position: absolute;
    left: var(--nav-pad-x);
    right: calc(var(--nav-pad-x) + 19px);
    bottom: 6px;
    height: 2px;
    background: var(--papier);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }
  .nav-dropdown-trigger:hover { opacity: 1; }
  .nav-dropdown-trigger:hover::after { transform: scaleX(1); }

  /* Dropdown panel */
  .nav-dropdown-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 210px;
    background: var(--flaeche);
    border-radius: var(--radius);
    box-shadow: var(--schatten);
    padding: 6px 0;
    opacity: 0;
    /* Anweisung 30, Schritt 7.6: wie beim Mobil-Overlay -- das geschlossene
       Dropdown blieb fokussierbar. */
    visibility: hidden;
    transform: translateY(-4px);
    pointer-events: none;
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0s linear 0.16s;
    z-index: 10;
  }
  .nav-dropdown-menu.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0s linear 0s;
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-dropdown-menu { transition: none; }
  }

  .nav-dropdown-item {
    display: block;
    padding: 10px 14px;
    font-size: 15px;
    color: var(--druck);
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .nav-dropdown-item:hover { background: var(--flaeche-hover); }

  /* Anweisung 13: zwei Spalten im Koch-App-Menue */
  .nav-dropdown-menu-zwei {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 24px;
    min-width: 420px;
    padding: 14px 6px;
  }
  .nav-dropdown-titel {
    font-family: var(--f-mono);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .18em;
    color: var(--akzent);
    line-height: 1;
    /* B2: 10 lag ausserhalb der Skala, Label zu seiner Gruppe sind 8. */
    margin: 0 0 8px 14px;
  }
  /* B2: 18 lag ausserhalb der Skala, zwischen zwei Gruppen stehen 24. */
  .nav-dropdown-titel-zweite { margin-top: 24px; }
  .nav-dropdown-item[aria-current="page"] { color: var(--akzent); }

  /* CTA button */
  /* D1: Gewicht 500 statt 700 und dieselbe Zielhoehe wie die Nav-Zeile.
     Die Buttons bleiben, sie sind nur nicht mehr lauter als die Punkte. */
  .nav-cta {
    background: var(--papier);
    color: var(--eisen);
    padding: 8px 16px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius);
    /* Anweisung 30, Schritt 7.2: 14.5px war der einzige Wert ausserhalb
       der Typo-Skala. 15px wie die Nav-Punkte. */
    font-size: 15px;
    font-weight: 500;
    font-family: var(--f-head);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: filter 0.18s ease;
  }
  .nav-cta:hover { filter: brightness(1.06); }

  /* Zweiter Weg in der Leiste: heller Rahmen statt gefuellter Flaeche,
     damit die Rangfolge der beiden CTAs sichtbar bleibt. */
  .nav-cta-outline {
    background: transparent;
    color: var(--papier);
    border: 1.5px solid rgba(247, 246, 242, 0.45);
    padding: 8px 16px;
  }
  .nav-cta-outline:hover {
    border-color: var(--papier);
    filter: none;
  }

  /* Burger button */
  .nav-burger {
    display: flex;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: var(--papier);
    margin-left: auto;
    flex-shrink: 0;
    min-width: 48px;
    min-height: 48px;
    align-items: center;
    justify-content: center;
  }

  /* SEO-Paket Phase 1: Grenze von 900 auf 1040 angehoben. Mit dem vierten
     Nav-Punkt "Wissen" braucht die volle DE-Leiste (vier Punkte + zwei CTAs +
     Sprachumschalter) bei unveraendertem 32px-Abstand rund 1027px; erst ab 1040
     passt sie sicher. Darunter traegt der Burger, in dem "Wissen" gelistet ist. */
  @media (min-width: 1040px) {
    .nav-desktop { display: flex; }
    .nav-burger { display: none; }
  }

  /* === MOBILE OVERLAY === */
  .nav-mobile-overlay {
    position: fixed;
    inset: 0;
    background: var(--eisen);
    z-index: 49;
    overflow-y: auto;
    opacity: 0;
    /* Anweisung 30, Schritt 7.6: opacity + pointer-events nehmen dem
       geschlossenen Menue nur Sichtbarkeit und Maus, nicht den Fokus --
       mit der Tab-Taste lief man durch 12 unsichtbare Links. visibility
       nimmt es aus der Fokusfolge; die Verzoegerung laesst das Ausblenden
       zu Ende laufen, bevor es verschwindet. */
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, visibility 0s linear 0.2s;
  }
  .nav-mobile-overlay.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.2s ease, visibility 0s linear 0s;
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-mobile-overlay { transition: none; }
  }
  @media (min-width: 1040px) {
    .nav-mobile-overlay { display: none !important; }
  }

  .nav-mobile-close {
    position: absolute;
    top: 14px;
    right: 16px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--papier);
    opacity: 0.7;
    min-width: 48px;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.15s ease;
  }
  .nav-mobile-close:hover { opacity: 1; }

  .nav-mobile-inner {
    padding: 80px 28px 48px;
    display: flex;
    flex-direction: column;
  }

  /* Mobile links */
  .nav-mobile-link {
    color: var(--papier);
    text-decoration: none;
    font-size: 18px;
    padding: 14px 0;
    min-height: 48px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(247,246,242,.1);
    transition: opacity 0.15s ease;
  }
  .nav-mobile-link:hover { opacity: 0.8; }
  .nav-mobile-link[aria-current="page"] { color: var(--akzent-hell); opacity: 1; }

  /* Mobile accordion sections */
  .mobile-section { border-bottom: 1px solid rgba(247,246,242,.1); }
  .mobile-section-trigger {
    color: var(--papier);
    background: none;
    border: none;
    cursor: pointer;
    font-size: 18px;
    font-family: inherit;
    padding: 14px 0;
    min-height: 48px;
    width: 100%;
    text-align: left;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: opacity 0.15s ease;
  }
  .mobile-section-trigger:hover { opacity: 0.8; }
  .mobile-section-trigger svg {
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-section-trigger svg { transition: none; }
  }

  .mobile-section-content {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows 0.25s ease;
  }
  .mobile-section-content.is-open { grid-template-rows: 1fr; }
  @media (prefers-reduced-motion: reduce) {
    .mobile-section-content { transition: none; }
  }
  /* Korrektur 5 (Anweisung 25): Geschlossen war die Liste 8px hoch, und
     "DAS ANGEBOT" schimmerte darunter durch. Die Rasterzeile stand auf 0,
     der Innenabstand des Inhalts blieb aber stehen. Er gilt jetzt erst im
     geoeffneten Zustand. */
  .mobile-section-inner { min-height: 0; padding-bottom: 0; }
  .mobile-section-content.is-open .mobile-section-inner { padding-bottom: 8px; }

  .mobile-section-link {
    color: var(--papier);
    opacity: 0.78;
    text-decoration: none;
    font-size: 16px;
    padding: 12px 16px;
    min-height: 48px;
    display: flex;
    align-items: center;
    transition: opacity 0.15s ease;
  }
  .mobile-section-link:hover { opacity: 1; }
  .mobile-section-link[aria-current="page"] { color: var(--akzent-hell); opacity: 1; }

  .nav-mobile-cta {
    margin-top: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--papier);
    color: var(--eisen);
    font-weight: 700;
    font-size: 16px;
    font-family: var(--f-head);
    border-radius: var(--radius);
    padding: 16px 24px;
    min-height: 56px;
    text-decoration: none;
    text-align: center;
    transition: filter 0.18s ease;
  }
  .nav-mobile-cta:hover { filter: brightness(0.95); }

  /* Die beiden CTAs stehen mobil oben: der erste ohne Abstand nach oben,
     der zweite als Rahmen-Variante direkt darunter. */
  .nav-mobile-cta-oben { margin-top: 0; }
  .nav-mobile-cta-outline {
    margin-top: 10px;
    background: transparent;
    color: var(--papier);
    border: 1.5px solid rgba(247, 246, 242, 0.45);
  }
  .nav-mobile-cta-outline:hover {
    border-color: var(--papier);
    filter: none;
  }

  .nav-mobile-lang {
    /* B2-Nachtrag: 20px stand nicht auf der Skala. */
    margin-top: 24px;
  }
  /* W6: "English" im Burger als volles Touch-Ziel (>=48px).
     B2-Nachtrag: 12px stand nicht auf der Skala; die Zielhoehe traegt
     ohnehin die Mindesthoehe, nicht der Innenabstand. */
  .nav-mobile-lang :global(.lang-switch) {
    display: flex;
    align-items: center;
    min-height: 48px;
    font-size: 18px;
    padding: 8px 0;
  }
</style>

<header class="site-header">
  <div class="nav-inner">
    <a href={getLocalizedPath("/", lang)} class="nav-logo" aria-label="Avorix – Startseite">
      <img src="/logo.png" alt="Avorix" width="1743" height="445" />
    </a>

    {lang === "de" ? (
      <nav class="nav-desktop" aria-label="Hauptnavigation">
        <div class="nav-links">
          <a href="/personal" class="nav-link" aria-current={isCurrent("/personal") ? "page" : undefined}>Personal</a>

          <div class="nav-dropdown">
            <button
              type="button"
              class:list={["nav-dropdown-trigger", { "ist-aktiv": aufklapperAktiv }]}
              aria-expanded="false"
              aria-haspopup="true"
            >
              Die Koch-App
              <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div class="nav-dropdown-menu nav-dropdown-menu-zwei" role="menu">
              <div class="nav-dropdown-spalte">
                <p class="nav-dropdown-titel">Das Angebot</p>
                {angebotLinks.map(link => (
                  <a href={link.href} class="nav-dropdown-item" role="menuitem" aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a>
                ))}
              </div>
              <div class="nav-dropdown-spalte">
                <p class="nav-dropdown-titel">Für wen</p>
                {zielgruppenLinks.map(link => (
                  <a href={link.href} class="nav-dropdown-item" role="menuitem" aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a>
                ))}
              </div>
            </div>
          </div>

          <a href="/wissen/" class="nav-link" aria-current={isCurrent("/wissen") ? "page" : undefined}>Wissen</a>

          <a href="/ueber-uns" class="nav-link" aria-current={isCurrent("/ueber-uns") ? "page" : undefined}>Über uns</a>
        </div>

        <a
          href="/personal#anfrage"
          data-cta-location="header"
          data-cta-event="cta_personal_click"
          class="nav-cta"
        >
          Personal anfragen
        </a>
        <a href="/kontakt" data-cta-location="header" class="nav-cta nav-cta-outline">
          App-Demo
        </a>
        <LanguageSwitcher />
      </nav>
    ) : (
      <nav class="nav-desktop" aria-label="Main navigation">
        <div class="nav-links">
          <a href="/en/staff" class="nav-link" aria-current={isCurrent("/en/staff") ? "page" : undefined}>Staff</a>

          <div class="nav-dropdown">
            <button
              type="button"
              class:list={["nav-dropdown-trigger", { "ist-aktiv": aufklapperAktiv }]}
              aria-expanded="false"
              aria-haspopup="true"
            >
              The Cook App
              <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div class="nav-dropdown-menu" role="menu">
              <div class="nav-dropdown-spalte">
                <p class="nav-dropdown-titel">The offer</p>
                {offerLinks.map(link => (
                  <a href={link.href} class="nav-dropdown-item" role="menuitem" aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a>
                ))}
              </div>
            </div>
          </div>

          <a href="/en/about" class="nav-link" aria-current={isCurrent("/en/about") ? "page" : undefined}>About Us</a>
        </div>

        <a
          href="/en/staff#request"
          data-cta-location="header"
          data-cta-event="cta_personal_click"
          class="nav-cta"
        >
          Request Staff
        </a>
        <a href="/en/contact" data-cta-location="header" class="nav-cta nav-cta-outline">
          Book a Demo
        </a>
        <LanguageSwitcher />
      </nav>
    )}

    <button
      id="mobile-menu-btn"
      class="nav-burger"
      aria-label="Menü öffnen"
      aria-expanded="false"
      aria-controls="mobile-nav-overlay"
    >
      <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
</header>

<div
  id="mobile-nav-overlay"
  class="nav-mobile-overlay"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation"
>
  <button id="mobile-close-btn" class="nav-mobile-close" aria-label="Menü schließen">
    <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <div class="nav-mobile-inner">
    {lang === "de" ? (
      <>
        {/* Beide Wege stehen oben, "Personal anfragen" zuerst (Anweisung 12a). */}
        <a
          href="/personal#anfrage"
          data-cta-location="header"
          data-cta-event="cta_personal_click"
          class="nav-mobile-cta nav-mobile-cta-oben"
        >
          Personal anfragen
        </a>
        <a href="/kontakt" data-cta-location="header" class="nav-mobile-cta nav-mobile-cta-outline">
          App-Demo
        </a>

        <a href="/personal" class="nav-mobile-link" aria-current={isCurrent("/personal") ? "page" : undefined}>Personal</a>

        <div class="mobile-section">
          <button type="button" class="mobile-section-trigger" aria-expanded="false">
            Die Koch-App
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="mobile-section-content">
            <div class="mobile-section-inner">
              <p class="nav-dropdown-titel">Das Angebot</p>
              {angebotLinks.map(link => (
                <a href={link.href} class="mobile-section-link" aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a>
              ))}
              <p class="nav-dropdown-titel nav-dropdown-titel-zweite">Für wen</p>
              {zielgruppenLinks.map(link => (
                <a href={link.href} class="mobile-section-link" aria-current={isCurrent(link.href) ? "page" : undefined}>{link.label}</a>
              ))}
            </div>
          </div>
        </div>

        <a href="/wissen/" class="nav-mobile-link" aria-current={isCurrent("/wissen") ? "page" : undefined}>Wissen</a>

        <a href="/ueber-uns" class="nav-mobile-link" aria-current={isCurrent("/ueber-uns") ? "page" : undefined}>Über uns</a>

        <div class="nav-mobile-lang">
          <LanguageSwitcher />
        </div>
      </>
    ) : (
      <>
        {/* Beide Wege stehen oben, "Request Staff" zuerst -- wie auf Deutsch. */}
        <a
          href="/en/staff#request"
          data-cta-location="header"
          data-cta-event="cta_personal_click"
          class="nav-mobile-cta nav-mobile-cta-oben"
        >

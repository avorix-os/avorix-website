---
<div class="bw-wrap" data-bewerbung>
  <form class="card bw-form space-y-6" action="/api/formular" method="POST" data-bewerbung-form data-quelle={quelle} data-sprache={lang} data-whatsapp={WHATSAPP_LINK_BEWERBUNG} data-profil={istProfil ? "true" : "false"}>
    <input type="hidden" name="formular" value="bewerbung" />
    <input type="hidden" name="quelle" value={quelle} />
    <input type="text" name="website" class="bw-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <input type="hidden" name="form_ts" value="" data-bw-ts />
    {rolleFest && <input type="hidden" name="rolle" value="koch" />}
    {istBewerberseite && <input type="hidden" name="sprache" value={lang} />}

    {/* Anweisung 74: Hinweis ueber dem ersten Feld, wer sich bewerben kann. */}
    <p class="bw-hinweis">{T.arbeitHinweis}</p>

    <div>
      <label for={`${p}-name`} class="bw-label">{T.name} <span class="bw-pflicht">*</span></label>
      <input type="text" id={`${p}-name`} name="name" required autocomplete="name" class="bw-field" />
    </div>

    <div>
      <label for={`${p}-telefon`} class="bw-label">{T.telefon} <span class="bw-pflicht">*</span></label>
      <input type="tel" id={`${p}-telefon`} name="telefon" required autocomplete="tel" inputmode="tel" class="bw-field" />
    </div>

    <div>
      <label for={`${p}-email`} class="bw-label">{T.email} <span class="bw-opt">{T.emailOpt}</span></label>
      <input type="email" id={`${p}-email`} name="email" autocomplete="email" class="bw-field" />
    </div>

    {!rolleFest && (
      <fieldset class="bw-fieldset">
        <legend class="bw-label">{ROLLE_LABELS.legend} <span class="bw-pflicht">*</span></legend>
        {/* Anweisung 76: auf der Profil-Seite drei Knoepfe untereinander (die
            Leitungs-Beschriftung ist lang), sonst die zwei Knoepfe nebeneinander. */}
        <div class={istProfil ? "bw-arbeit" : "bw-rollen"}>
          <label class={istProfil ? "bw-rolle bw-rolle--block" : "bw-rolle"}>
            <input type="radio" name="rolle" value="koch" required />
            <span>{ROLLE_LABELS.koch}</span>
          </label>
          <label class={istProfil ? "bw-rolle bw-rolle--block" : "bw-rolle"}>
            <input type="radio" name="rolle" value="service" />
            <span>{ROLLE_LABELS.service}</span>
          </label>
          {istProfil && (
            <label class="bw-rolle bw-rolle--block">
              <input type="radio" name="rolle" value="leitung" />
              <span>{ROLLE_LABELS.leitung}</span>
            </label>
          )}
        </div>
      </fieldset>
    )}

    {lang === "en" && (
      <div>
        <label for={`${p}-land`} class="bw-label">{T.land} <span class="bw-pflicht">*</span></label>
        <select id={`${p}-land`} name="land" required class="bw-field">
          <option value="" selected disabled>{T.bitteWaehlen}</option>
          {LAND_VALUES.map((o) => <option value={o.v}>{o.l}</option>)}
        </select>
      </div>
    )}

    <div>
      <label for={`${p}-region`} class="bw-label">{T.region} <span class="bw-pflicht">*</span></label>
      <select id={`${p}-region`} name="region" required class="bw-field">
        <option value="" selected disabled>{T.bitteWaehlen}</option>
        {regionen.map((o) => <option value={o.v}>{o.l}</option>)}
      </select>
    </div>

    {/* Anweisung 66: Pflichtfeld Arbeitserlaubnis, drei Radios untereinander,
        keine Vorauswahl. Wert immer deutsch, Beschriftung in der Seitensprache. */}
    <fieldset class="bw-fieldset">
      <legend class="bw-label">{T.arbeitLegend} <span class="bw-pflicht">*</span></legend>
      <div class="bw-arbeit">
        {arbeitOptionen.map((o) => (
          <label class="bw-rolle bw-rolle--block">
            <input type="radio" name="arbeitserlaubnis" value={o.v} required />
            <span>{o.l}</span>
          </label>
        ))}
      </div>
    </fieldset>

    {/* Anweisung 74: bei „Nein oder unklar" erscheint diese Meldung, der
        Absende-Knopf wird gesperrt (Logik im Skript unten). */}
    <p class="bw-sperre" data-bw-sperre role="status" aria-live="polite" hidden>
      {T.arbeitSperrePre}<a href={WHATSAPP_LINK_BEWERBUNG} class="typo-link" target="_blank" rel="noopener">{T.arbeitSperreWa}</a>{T.arbeitSperrePost}
    </p>

    <div>
      <label for={`${p}-erfahrung`} class="bw-label">{T.erfahrung} <span class="bw-pflicht">*</span></label>
      <select id={`${p}-erfahrung`} name="erfahrung" required class="bw-field">
        <option value="" selected disabled>{T.bitteWaehlen}</option>
        {erfahrung.map((o) => <option value={o.v}>{o.l}</option>)}
      </select>
    </div>

    {istBewerberseite && (
      <div>
        <label for={`${p}-sprachen`} class="bw-label">{T.sprachen} <span class="bw-pflicht">*</span></label>
        <select id={`${p}-sprachen`} name="sprachen" required class="bw-field">
          <option value="" selected disabled>{T.bitteWaehlen}</option>
          {SPRACHEN_VALUES[lang].map((o) => <option value={o.v}>{o.l}</option>)}
        </select>
      </div>
    )}

    <div>
      <label for={`${p}-nachricht`} class="bw-label">{T.nachricht} <span class="bw-opt">{T.nachrichtOpt}</span></label>
      <textarea id={`${p}-nachricht`} name="nachricht" rows="3" class="bw-field bw-textarea"></textarea>
    </div>

    {/* Anweisung 76: Block „Deine Wünsche (freiwillig)". Eigene Gruppe, alle
        Felder freiwillig, keine Vorauswahl. Nur auf der Profil-Seite. */}
    {istProfil && (
      <fieldset class="bw-fieldset bw-wunsch-gruppe">
        <legend class="bw-wunsch-legend">{WUNSCHE.gruppe}</legend>
        <p class="bw-wunsch-unter">{WUNSCHE.unter}</p>

        <div class="bw-wunsch-feld">
          <span class="bw-label" id={`${p}-wege-label`}>{WUNSCHE.wegeLegend} <span class="bw-opt">{WUNSCHE.wegeHint}</span></span>
          <div class="bw-arbeit" role="group" aria-labelledby={`${p}-wege-label`}>
            {WUNSCHE.wege.map((o) => (
              <label class="bw-rolle bw-rolle--block bw-check">
                <input type="checkbox" name="wege" value={o.v} />
                <span>{o.l}</span>
              </label>
            ))}
          </div>
        </div>

        <div class="bw-wunsch-feld">
          <label for={`${p}-verfuegbar`} class="bw-label">{WUNSCHE.verfuegbar}</label>
          <input type="text" id={`${p}-verfuegbar`} name="verfuegbar_ab" class="bw-field" placeholder={WUNSCHE.verfuegbarPh} />
        </div>

        <fieldset class="bw-fieldset bw-wunsch-feld">
          <legend class="bw-label">{WUNSCHE.arbeitszeitLegend}</legend>
          <div class="bw-rollen bw-rollen--drei">
            {WUNSCHE.arbeitszeit.map((o) => (
              <label class="bw-rolle"><input type="radio" name="arbeitszeit" value={o.v} /><span>{o.l}</span></label>
            ))}
          </div>
        </fieldset>

        <fieldset class="bw-fieldset bw-wunsch-feld">
          <legend class="bw-label">{WUNSCHE.umzugLegend}</legend>
          <div class="bw-arbeit">
            {WUNSCHE.umzug.map((o) => (
              <label class="bw-rolle bw-rolle--block"><input type="radio" name="umzug" value={o.v} /><span>{o.l}</span></label>
            ))}
          </div>
        </fieldset>

        <fieldset class="bw-fieldset bw-wunsch-feld">
          <legend class="bw-label">{WUNSCHE.unterkunftLegend}</legend>
          <div class="bw-rollen">
            {WUNSCHE.unterkunft.map((o) => (
              <label class="bw-rolle"><input type="radio" name="unterkunft" value={o.v} /><span>{o.l}</span></label>
            ))}
          </div>
        </fieldset>

        <div class="bw-wunsch-feld">
          <label for={`${p}-gehalt`} class="bw-label">{WUNSCHE.gehalt}</label>
          <input type="text" id={`${p}-gehalt`} name="gehaltswunsch" class="bw-field" />
          <p class="bw-feld-hinweis">{WUNSCHE.gehaltHint}</p>
        </div>
      </fieldset>
    )}

    {/* Anweisung 76: Freigabe fuer Betriebe – freiwillig, nicht vorausgewaehlt,
        optisch abgesetzt. Ist das Haekchen gesetzt, geht profil_freigabe=ja mit. */}
    {istProfil && (
      <div class="bw-freigabe">
        <label class="bw-freigabe-label">
          <input type="checkbox" name="profil_freigabe" value="ja" />
          <span>{FREIGABE.pre}<a href={FREIGABE.href}>{FREIGABE.link}</a>{FREIGABE.post}</span>
        </label>
      </div>
    )}

    <Altcha sprache={lang} />

    <button type="submit" class="btn btn-primary bw-submit" data-bw-sending={T.sending}>{istProfil ? PROFIL.button : T.button}</button>
    {whatsappHinweis && (
      <p class="bw-whatsapp">
        {istProfil ? PROFIL.waPre : "Lieber per WhatsApp? "}
        <a href={WHATSAPP_LINK_BEWERBUNG} data-cta-location={`${quelle}-formular-whatsapp`} class="typo-link" target="_blank" rel="noopener">{istProfil ? PROFIL.waLink : "Schreib uns"}</a>
      </p>
    )}
    {istProfil ? (
      <p class="formular-hinweis">
        {PROFIL.hinweisPre}<a href={PROFIL.hinweisHref}>{PROFIL.hinweisLink}</a>{PROFIL.hinweisPost}
      </p>
    ) : (
      <p class="formular-hinweis">
        {T.hinweisPre}<a href={T.hinweisHref}>{T.hinweisLink}</a>{T.hinweisPost}
      </p>
    )}
  </form>

  {istProfil ? (
    /* Anweisung 76: zwei Fassungen (mit/ohne Freigabe); das Skript waehlt sie
       beim Absenden anhand des Freigabe-Haekchens aus. */
    <div
      class="card bw-danke hidden"
      data-bw-danke
      data-bw-danke-profil
      data-ja-titel={PROFIL.jaTitel}
      data-ja-text={PROFIL.jaText}
      data-nein-titel={PROFIL.neinTitel}
      data-nein-text={PROFIL.neinText}
      role="status"
      tabindex="-1"
    >
      <p class="bw-danke-titel" data-danke-titel>{PROFIL.jaTitel}</p>
      <p data-danke-text>{PROFIL.jaText}</p>
    </div>
  ) : (
    <div class="card bw-danke hidden" data-bw-danke role="status" tabindex="-1">
      <p class="bw-danke-titel">{T.dankeTitel}</p>
      <p>{T.dankeText}</p>
    </div>
  )}
</div>

<style>
.bw-hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; overflow: hidden; }
.bw-form, .bw-danke { padding: 2rem; }
@media (max-width: 480px) {
  .bw-form, .bw-danke { padding: 1.25rem; }
}
.bw-label {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: var(--druck);
  margin-bottom: 8px;
}
.bw-pflicht { color: var(--akzent); }
.bw-opt { font-weight: 400; color: var(--grau); }
.bw-field {
  width: 100%;
  min-height: 58px;
  line-height: 24px;
  background: var(--flaeche);
  border: 1px solid var(--linie);
  border-radius: var(--radius);
  padding: 16px;
  font-size: 16px;
  font-family: var(--f-body);
  color: var(--druck);
  transition: border-color .15s;
  appearance: auto;
  box-sizing: border-box;
}
.bw-field:focus { outline: none; border-color: var(--akzent); }
.bw-field:focus-visible { outline: 3px solid var(--akzent); outline-offset: 2px; }
.bw-textarea { resize: none; min-height: 0; }
.bw-fieldset { border: 0; padding: 0; margin-inline: 0; margin-top: 0; }
.bw-fieldset legend { padding: 0; }
.bw-rollen { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
/* Anweisung 66: Arbeitserlaubnis – drei Optionen untereinander. Die Kaestchen
   bekommen ihr Styling ueber .bw-rolle--block NACH der Basisregel .bw-rolle span. */
.bw-arbeit { display: grid; grid-template-columns: 1fr; gap: 12px; }
.bw-rolle { position: relative; display: block; cursor: pointer; }
.bw-rolle input { position: absolute; opacity: 0; width: 1px; height: 1px; }
.bw-rolle span {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 58px;
  padding: 0 16px;
  border: 1px solid var(--linie);
  border-radius: var(--radius);
  background: var(--flaeche);
  font-weight: 600;
  color: var(--druck);
  transition: border-color .15s, background-color .15s;
}
.bw-rolle input:checked + span {
  border-color: var(--akzent);
  background: #F3D9C8;
  color: var(--akzent);
}
.bw-rolle input:focus-visible + span { outline: 3px solid var(--akzent); outline-offset: 2px; }
/* Anweisung 68: Die Arbeitserlaubnis-Antworten sind ganze Saetze und brechen auf
   dem Handy um. Innenabstand oben/unten (sonst klebt der Text am Rahmen) und
   linksbuendig. Steht NACH .bw-rolle span, damit die Regel bei gleicher
   Spezifitaet gewinnt; min-height:0, damit auch eine einzeilige Antwort denselben
   12px-Abstand oben/unten hat. */
.bw-rolle--block > span {
  padding: 12px 16px;
  min-height: 0;
  justify-content: flex-start;
  text-align: left;
}
/* Anweisung 76: Wünsche-Block und Freigabe. */
.bw-rollen--drei { grid-template-columns: 1fr 1fr 1fr; }
@media (max-width: 400px) {
  .bw-rollen--drei { grid-template-columns: 1fr; }
}
/* Mehrfachauswahl „wege": wie die Rolle-Knoepfe (bw-rolle--block liefert das
   linksbuendige Block-Layout schon), nur die Checked-Farbe kommt hier dazu. */
.bw-check input:checked + span { border-color: var(--akzent); background: #F3D9C8; color: var(--akzent); }
.bw-wunsch-gruppe {
  border: 1px solid var(--linie);
  border-radius: var(--radius);
  padding: 20px;
  display: grid;
  gap: 20px;
}
.bw-wunsch-legend {
  font-family: var(--f-head);
  font-weight: 700;
  font-size: 18px;
  color: var(--druck);
  padding: 0;
  float: left; /* im Grid-Fieldset haelt das die Legende oben */
}
.bw-wunsch-unter { font-size: 15px; color: var(--grau); margin: 0; clear: both; }
.bw-wunsch-feld { display: block; }
.bw-feld-hinweis { font-size: 13px; line-height: 1.5; color: var(--grau); margin-top: 8px; }
.bw-freigabe {
  border-top: 1px solid var(--linie);
  padding-top: 20px;
}
.bw-freigabe-label {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  cursor: pointer;
  font-size: 15px;
  line-height: 1.5;
  color: var(--druck);
}
.bw-freigabe-label input {
  flex: none;
  width: 22px;
  height: 22px;
  margin-top: 1px;
  accent-color: var(--akzent);
}
.bw-submit { width: 100%; }
.bw-whatsapp { font-size: 15px; color: var(--grau); text-align: center; }
/* Anweisung 74: Hinweis ueber dem Formular + Sperr-Meldung unter dem Feld. */
.bw-hinweis { font-size: 15px; line-height: 1.5; color: var(--grau); }
.bw-sperre { font-size: 15px; line-height: 1.5; color: var(--akzent); font-weight: 600; }
.bw-fehler { font-size: 14px; color: var(--akzent); font-weight: 600; }
.bw-danke { background: #F3D9C8; }
.bw-danke p { color: var(--druck); }
.bw-danke-titel { font-family: var(--f-head); font-weight: 700; font-size: 20px; margin-bottom: 8px; }
@media (prefers-reduced-motion: reduce) {
  .bw-field, .bw-rolle span { transition: none; }
}
</style>

<script>
  import { absenden } from '../scripts/formular';
  document.querySelectorAll<HTMLElement>('[data-bewerbung]').forEach((wrap) => {
    const form = wrap.querySelector<HTMLFormElement>('[data-bewerbung-form]');
    const danke = wrap.querySelector<HTMLElement>('[data-bw-danke]');
    if (!form) return;
    const ts = form.querySelector<HTMLInputElement>('[data-bw-ts]');
    if (ts) ts.value = String(Date.now());
    let gesendet = false;

    // Anweisung 74: Bei „Nein oder unklar" Meldung zeigen und Absende-Knopf sperren;
    // bei einer Ja-Antwort Meldung weg und Knopf wieder frei.
    const sperre = wrap.querySelector<HTMLElement>('[data-bw-sperre]');
    const sperrKnopf = form.querySelector<HTMLButtonElement>('[type="submit"]');
    const pruefeArbeit = () => {
      const sel = form.querySelector<HTMLInputElement>('input[name="arbeitserlaubnis"]:checked');
      const gesperrt = !!(sel && sel.value === 'Nein oder unklar');
      if (sperre) sperre.hidden = !gesperrt;
      if (sperrKnopf) sperrKnopf.disabled = gesperrt;
    };
    form.querySelectorAll<HTMLInputElement>('input[name="arbeitserlaubnis"]').forEach((r) => r.addEventListener('change', pruefeArbeit));
    pruefeArbeit();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (gesendet) return;
      const knopf = form.querySelector<HTMLButtonElement>('[type="submit"]');
      const label = knopf ? knopf.textContent : '';
      const sending = knopf ? (knopf.getAttribute('data-bw-sending') || 'Wird gesendet…') : '';
      if (knopf) { knopf.disabled = true; knopf.textContent = sending; }

      const sprache = (form.getAttribute('data-sprache') || 'de') as 'de' | 'en' | 'hu';
      const whatsapp = form.getAttribute('data-whatsapp') || '';
      const r = await absenden(form, { sprache, variante: 'bewerber', whatsapp });

      if (r.ok) {
        gesendet = true;
        const istProfil = form.dataset.profil === 'true';
        const fd = new FormData(form);
        const freigabe = fd.get('profil_freigabe') === 'ja';
        // Anweisung 63: Ereignis nur ohne Verdacht (sonst zaehlt Google Ads Spam).
        if (!r.verdacht) {
          const w = window as any;
          w.dataLayer = w.dataLayer || [];
          const ereignis: Record<string, string> = {
            event: 'bewerbung',
            rolle: String(fd.get('rolle') || ''),
            quelle: form.dataset.quelle || '',
          };
          // Anweisung 76: Profil-Seite haengt freigabe und wege an (Kuerzel).
          if (istProfil) {
            const map: Record<string, string> = {
              'Bei Avorix angestellt': 'avorix',
              'Direkt im Betrieb, dauerhaft': 'fest',
              'Direkt im Betrieb, Saison': 'saison',
            };
            ereignis.freigabe = freigabe ? 'ja' : 'nein';
            ereignis.wege = fd.getAll('wege').map((w2) => map[String(w2)] || '').filter(Boolean).join(',');
          }
          w.dataLayer.push(ereignis);
        }
        // Anweisung 76: Danke-Fassung nach Freigabe (mit/ohne) auswaehlen.
        if (istProfil && danke && danke.hasAttribute('data-bw-danke-profil')) {
          const titel = danke.querySelector<HTMLElement>('[data-danke-titel]');
          const text = danke.querySelector<HTMLElement>('[data-danke-text]');
          if (titel) titel.textContent = freigabe ? (danke.dataset.jaTitel || '') : (danke.dataset.neinTitel || '');
          if (text) text.textContent = freigabe ? (danke.dataset.jaText || '') : (danke.dataset.neinText || '');
        }
        form.classList.add('hidden');
        danke?.classList.remove('hidden');
        danke?.focus();
      } else {
        // Fehlermeldung zeigt absenden() bereits; Knopf wieder freigeben.
        if (knopf) { knopf.disabled = false; knopf.textContent = label; }
      }
    });
  });
</script>

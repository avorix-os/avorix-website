---
// Anweisung 60: Bewerbungsformular fuer /jobs/ und /jobs/koch/.
// Anweisung 61: zusaetzlich ungarische und englische Fassung fuer die
// Bewerberseiten /hu/szakacs-allas/ und /en/jobs/cook/. Nur die Beschriftung
// ist uebersetzt, die GESENDETEN Werte sind immer deutsch (der Formular-Dienst
// wertet ueber alle Sprachen gleich aus). Zwei Zusatzfelder: `sprachen` (HU+EN)
// und `land` (nur EN), dazu ein verstecktes `sprache`.
// Kennung `bewerbung` im eigenen Formular-Dienst (form-service/forms.js).
// Kein Upload, kein Einwilligungs-Haekchen (Bewerberdaten nach § 26 BDSG).
// Messung: genau ein dataLayer-Ereignis `bewerbung`, nur bei { ok: true }.
import { WHATSAPP_LINK_BEWERBUNG } from "../data/whatsapp";

type Sprache = "de" | "hu" | "en";
interface Props {
  quelle: "jobs" | "lp-koch" | "lp-hu" | "lp-en";
  nurKoch?: boolean;
  whatsappHinweis?: boolean;
  lang?: Sprache;
}
const { quelle, nurKoch = false, whatsappHinweis = false, lang = "de" } = Astro.props as Props;
const p = `bw-${quelle}`;

// Auswahlwerte: gesendeter Wert (v) + angezeigte Beschriftung (l).
const REGION_VALUES = {
  de: [
    "Bodensee und Oberschwaben",
    "München und Oberbayern",
    "Stuttgart und Region",
    "Frankfurt und Rhein-Main",
    "Tirol",
    "Vorarlberg",
    "Egal, ich bin flexibel",
  ].map((r) => ({ v: r, l: r })),
  hu: [
    { v: "Österreich (Tirol, Vorarlberg)", l: "Ausztria (Tirol, Vorarlberg)" },
    { v: "Deutschland", l: "Németország" },
    { v: "Egal, ich bin flexibel", l: "Mindegy, rugalmas vagyok" },
  ],
  en: [
    { v: "Österreich (Tirol, Vorarlberg)", l: "Austria (Tyrol, Vorarlberg)" },
    { v: "Deutschland", l: "Germany" },
    { v: "Egal, ich bin flexibel", l: "Either, I am flexible" },
  ],
};
const ERFAHRUNG_VALUES = {
  de: ["1 bis 2 Jahre", "3 bis 5 Jahre", "mehr als 5 Jahre"].map((e) => ({ v: e, l: e })),
  hu: [
    { v: "1 bis 2 Jahre", l: "1 vagy 2 év" },
    { v: "3 bis 5 Jahre", l: "3 és 5 év között" },
    { v: "mehr als 5 Jahre", l: "Több mint 5 év" },
  ],
  en: [
    { v: "1 bis 2 Jahre", l: "1 or 2 years" },
    { v: "3 bis 5 Jahre", l: "3 to 5 years" },
    { v: "mehr als 5 Jahre", l: "More than 5 years" },
  ],
};
const SPRACHEN_VALUES = {
  hu: [
    { v: "Englisch", l: "Angol" },
    { v: "Deutsch", l: "Német" },
    { v: "Englisch und Deutsch", l: "Angol és német" },
    { v: "keine der beiden", l: "Egyiken sem" },
  ],
  en: [
    { v: "Englisch", l: "English" },
    { v: "Deutsch", l: "German" },
    { v: "Englisch und Deutsch", l: "English and German" },
    { v: "keine der beiden", l: "Neither" },
  ],
};
const LAND_VALUES = [
  { v: "Polen", l: "Poland" },
  { v: "Rumänien", l: "Romania" },
  { v: "Slowakei", l: "Slovakia" },
  { v: "Tschechien", l: "Czech Republic" },
  { v: "Kroatien", l: "Croatia" },
  { v: "Ungarn", l: "Hungary" },
  { v: "Slowenien", l: "Slovenia" },
  { v: "Bulgarien", l: "Bulgaria" },
  { v: "anderes EU-Land", l: "Other EU country" },
  { v: "anderes Land", l: "Other country" },
];

const T = {
  de: {
    name: "Dein Name", telefon: "Telefonnummer, wir rufen dich an",
    email: "E-Mail", emailOpt: "(wenn du eine Bestätigung willst)",
    rolleLegend: "Ich bewerbe mich als:", rolleKoch: "Koch", rolleService: "Servicekraft",
    land: "", region: "Wo willst du arbeiten?", erfahrung: "Wie lange arbeitest du schon in der Gastronomie?",
    sprachen: "", nachricht: "Was hast du zuletzt gemacht?", nachrichtOpt: "(freiwillig)",
    bitteWaehlen: "Bitte wählen", button: "Bewerbung abschicken", sending: "Wird gesendet…",
    fehler: "Das hat gerade nicht geklappt. Versuch es bitte noch einmal oder ruf uns an: 07541 3973915.",
    hinweisPre: "Wir verarbeiten deine Angaben, um deine Bewerbung zu bearbeiten. Mehr dazu steht in unserer ",
    hinweisLink: "Datenschutzerklärung", hinweisHref: "/datenschutz/", hinweisPost: " im Abschnitt „Bewerbungen“.",
    dankeTitel: "Danke, deine Bewerbung ist da.",
    dankeText: "Wir melden uns innerhalb von 24 Stunden, meistens per Telefon. Halte dein Handy in der Nähe.",
  },
  hu: {
    name: "A neved", telefon: "Telefonszám (WhatsAppos szám is jó)",
    email: "E-mail", emailOpt: "(ha visszaigazolást kérsz)",
    land: "", region: "Hol szeretnél dolgozni?", erfahrung: "Mennyi tapasztalatod van a vendéglátásban?",
    sprachen: "Milyen nyelven beszélsz?", nachricht: "Milyen pozícióban dolgoztál?", nachrichtOpt: "(nem kötelező)",
    bitteWaehlen: "Kérlek, válassz", button: "Jelentkezés elküldése", sending: "Küldés…",
    fehler: "Ez most nem sikerült. Kérlek, próbáld újra, vagy hívj minket: +49 7541 3973915.",
    hinweisPre: "Az adataidat a jelentkezésed feldolgozásához használjuk. Részletek az ",
    hinweisLink: "adatvédelmi tájékoztatóban", hinweisHref: "/en/privacy/", hinweisPost: " (angol nyelven), az „Applications” részben.",
    dankeTitel: "Köszönjük, megkaptuk a jelentkezésed.",
    dankeText: "24 órán belül jelentkezünk, telefonon vagy WhatsAppon. Tartsd kéznél a telefonodat.",
  },
  en: {
    name: "Your name", telefon: "Phone number (WhatsApp is fine)",
    email: "Email", emailOpt: "(if you want a confirmation)",
    land: "Where do you live?", region: "Where would you like to work?", erfahrung: "How long have you worked in hospitality?",
    sprachen: "Which languages can you work in?", nachricht: "What did you do most recently?", nachrichtOpt: "(optional)",
    bitteWaehlen: "Please choose", button: "Send application", sending: "Sending…",
    fehler: "That did not work just now. Please try again or call us: +49 7541 3973915.",
    hinweisPre: "We process your details to handle your application. More in our ",
    hinweisLink: "privacy policy", hinweisHref: "/en/privacy/", hinweisPost: ", section “Applications”.",
    dankeTitel: "Thank you, we have received your application.",
    dankeText: "We will get back to you within 24 hours, by phone or WhatsApp. Keep your phone close.",
  },
}[lang];

const istBewerberseite = lang !== "de";
// Auf HU/EN steht die Rolle fest auf Koch; Pflichtstern immer sichtbar.
const rolleFest = nurKoch || istBewerberseite;
const regionen = REGION_VALUES[lang];
const erfahrung = ERFAHRUNG_VALUES[lang];
---
<div class="bw-wrap" data-bewerbung>
  <form class="card bw-form space-y-6" action="/api/formular" method="POST" data-bewerbung-form data-quelle={quelle}>
    <input type="hidden" name="formular" value="bewerbung" />
    <input type="hidden" name="quelle" value={quelle} />
    <input type="text" name="website" class="bw-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <input type="hidden" name="form_ts" value="" data-bw-ts />
    {rolleFest && <input type="hidden" name="rolle" value="koch" />}
    {istBewerberseite && <input type="hidden" name="sprache" value={lang} />}

    <div>
      <label for={`${p}-name`} class="bw-label">{T.name} <span class="bw-pflicht">*</span></label>
      <input type="text" id={`${p}-name`} name="name" required autocomplete="name" class="bw-field" />
    </div>

    <div>
      <label for={`${p}-telefon`} class="bw-label">{T.telefon} <span class="bw-pflicht">*</span></label>
      <input type="tel" id={`${p}-telefon`} name="telefon" required autocomplete="tel" inputmode="tel" class="bw-field" />
    </div>

    <div>
      <label for={`${p}-email`} class="bw-label">{T.email} <span class="bw-opt">{T.emailOpt}</span></label>
      <input type="email" id={`${p}-email`} name="email" autocomplete="email" class="bw-field" />
    </div>

    {!rolleFest && (
      <fieldset class="bw-fieldset">
        <legend class="bw-label">{T.rolleLegend} <span class="bw-pflicht">*</span></legend>
        <div class="bw-rollen">
          <label class="bw-rolle">
            <input type="radio" name="rolle" value="koch" required />
            <span>{T.rolleKoch}</span>
          </label>
          <label class="bw-rolle">
            <input type="radio" name="rolle" value="service" />
            <span>{T.rolleService}</span>
          </label>
        </div>
      </fieldset>
    )}

    {lang === "en" && (
      <div>
        <label for={`${p}-land`} class="bw-label">{T.land} <span class="bw-pflicht">*</span></label>
        <select id={`${p}-land`} name="land" required class="bw-field">
          <option value="" selected disabled>{T.bitteWaehlen}</option>
          {LAND_VALUES.map((o) => <option value={o.v}>{o.l}</option>)}
        </select>
      </div>
    )}

    <div>
      <label for={`${p}-region`} class="bw-label">{T.region} <span class="bw-pflicht">*</span></label>
      <select id={`${p}-region`} name="region" required class="bw-field">
        <option value="" selected disabled>{T.bitteWaehlen}</option>
        {regionen.map((o) => <option value={o.v}>{o.l}</option>)}
      </select>
    </div>

    <div>
      <label for={`${p}-erfahrung`} class="bw-label">{T.erfahrung} <span class="bw-pflicht">*</span></label>
      <select id={`${p}-erfahrung`} name="erfahrung" required class="bw-field">
        <option value="" selected disabled>{T.bitteWaehlen}</option>
        {erfahrung.map((o) => <option value={o.v}>{o.l}</option>)}
      </select>
    </div>

    {istBewerberseite && (
      <div>
        <label for={`${p}-sprachen`} class="bw-label">{T.sprachen} <span class="bw-pflicht">*</span></label>
        <select id={`${p}-sprachen`} name="sprachen" required class="bw-field">
          <option value="" selected disabled>{T.bitteWaehlen}</option>
          {SPRACHEN_VALUES[lang].map((o) => <option value={o.v}>{o.l}</option>)}
        </select>
      </div>
    )}

    <div>
      <label for={`${p}-nachricht`} class="bw-label">{T.nachricht} <span class="bw-opt">{T.nachrichtOpt}</span></label>
      <textarea id={`${p}-nachricht`} name="nachricht" rows="3" class="bw-field bw-textarea"></textarea>
    </div>

    <p class="bw-fehler hidden" data-bw-fehler role="alert">{T.fehler}</p>

    <button type="submit" class="btn btn-primary bw-submit" data-bw-sending={T.sending}>{T.button}</button>
    {whatsappHinweis && (
      <p class="bw-whatsapp">
        Lieber per WhatsApp?
        <a href={WHATSAPP_LINK_BEWERBUNG} data-cta-location={`${quelle}-formular-whatsapp`} class="typo-link" target="_blank" rel="noopener">Schreib uns</a>
      </p>
    )}
    <p class="formular-hinweis">
      {T.hinweisPre}<a href={T.hinweisHref}>{T.hinweisLink}</a>{T.hinweisPost}
    </p>
  </form>

  <div class="card bw-danke hidden" data-bw-danke role="status" tabindex="-1">
    <p class="bw-danke-titel">{T.dankeTitel}</p>
    <p>{T.dankeText}</p>
  </div>
</div>

<style>
.bw-hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; overflow: hidden; }
.bw-form, .bw-danke { padding: 2rem; }
@media (max-width: 480px) {
  .bw-form, .bw-danke { padding: 1.25rem; }
}
.bw-label {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: var(--druck);
  margin-bottom: 8px;
}
.bw-pflicht { color: var(--akzent); }
.bw-opt { font-weight: 400; color: var(--grau); }
.bw-field {
  width: 100%;
  min-height: 58px;
  line-height: 24px;
  background: var(--flaeche);
  border: 1px solid var(--linie);
  border-radius: var(--radius);
  padding: 16px;
  font-size: 16px;
  font-family: var(--f-body);
  color: var(--druck);
  transition: border-color .15s;
  appearance: auto;
  box-sizing: border-box;
}
.bw-field:focus { outline: none; border-color: var(--akzent); }
.bw-field:focus-visible { outline: 3px solid var(--akzent); outline-offset: 2px; }
.bw-textarea { resize: none; min-height: 0; }
.bw-fieldset { border: 0; padding: 0; margin-inline: 0; margin-top: 0; }
.bw-fieldset legend { padding: 0; }
.bw-rollen { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.bw-rolle { position: relative; display: block; cursor: pointer; }
.bw-rolle input { position: absolute; opacity: 0; width: 1px; height: 1px; }
.bw-rolle span {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 58px;
  padding: 0 16px;
  border: 1px solid var(--linie);
  border-radius: var(--radius);
  background: var(--flaeche);
  font-weight: 600;
  color: var(--druck);
  transition: border-color .15s, background-color .15s;
}
.bw-rolle input:checked + span {
  border-color: var(--akzent);
  background: #F3D9C8;
  color: var(--akzent);
}
.bw-rolle input:focus-visible + span { outline: 3px solid var(--akzent); outline-offset: 2px; }
.bw-submit { width: 100%; }
.bw-whatsapp { font-size: 15px; color: var(--grau); text-align: center; }
.bw-fehler { font-size: 14px; color: var(--akzent); font-weight: 600; }
.bw-danke { background: #F3D9C8; }
.bw-danke p { color: var(--druck); }
.bw-danke-titel { font-family: var(--f-head); font-weight: 700; font-size: 20px; margin-bottom: 8px; }
@media (prefers-reduced-motion: reduce) {
  .bw-field, .bw-rolle span { transition: none; }
}
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-bewerbung]').forEach((wrap) => {
    const form = wrap.querySelector<HTMLFormElement>('[data-bewerbung-form]');
    const danke = wrap.querySelector<HTMLElement>('[data-bw-danke]');
    const fehler = wrap.querySelector<HTMLElement>('[data-bw-fehler]');
    if (!form) return;
    const ts = form.querySelector<HTMLInputElement>('[data-bw-ts]');
    if (ts) ts.value = String(Date.now());
    let gesendet = false;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (gesendet) return;
      const knopf = form.querySelector<HTMLButtonElement>('[type="submit"]');
      const label = knopf ? knopf.textContent : '';
      const sending = knopf ? (knopf.getAttribute('data-bw-sending') || 'Wird gesendet…') : '';
      if (knopf) { knopf.disabled = true; knopf.textContent = sending; }
      fehler?.classList.add('hidden');
      try {
        const fd = new FormData(form);
        const g = (window as any).avorixGclid ? (window as any).avorixGclid() : '';
        if (g) fd.append('gclid', g);
        const res = await fetch(form.action, { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
        const daten = await res.json().catch(() => null);
        if (res.ok && daten && daten.ok === true) {
          gesendet = true;
          const w = window as any;
          w.dataLayer = w.dataLayer || [];
          w.dataLayer.push({ event: 'bewerbung', rolle: String(fd.get('rolle') || ''), quelle: form.dataset.quelle || '' });
          form.classList.add('hidden');
          danke?.classList.remove('hidden');
          danke?.focus();
          return;
        }
        throw new Error('nicht ok');
      } catch {
        if (knopf) { knopf.disabled = false; knopf.textContent = label; }
        fehler?.classList.remove('hidden');
      }
    });
  });
</script>

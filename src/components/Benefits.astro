---
import { getLangFromUrl, useTranslations } from "../i18n/translations";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const benefits = [
  {
    title: t("benefits.1.title"),
    text: t("benefits.1.text"),
  },
  {
    title: t("benefits.2.title"),
    text: t("benefits.2.text"),
  },
  {
    title: t("benefits.3.title"),
    text: t("benefits.3.text"),
  },
];
---

<section id="benefits" class="reveal section-gap">
  <div class="content-width">
    <h2 class="mb-12" style="color:var(--druck)">
      {t("benefits.title")}
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {benefits.map((b) => (
        <div class="card">
          <h3 class="mb-3">{b.title}</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">{b.text}</p>
        </div>
      ))}
    </div>

    <!-- Visual photo strip -->
    <div class="mt-16 overflow-hidden" style="border-radius:var(--radius);box-shadow:var(--schatten)">
      <img
        src="/avorix_gastro-hotel-60.webp"
        alt="Mise en place in der Profik&uuml;che &mdash; Mengenkůche mit Avorix"
        width="1200"
        height="540"
        class="w-full object-cover"
        style="height:360px"
        loading="lazy"
      />
    </div>
  </div>
</section>

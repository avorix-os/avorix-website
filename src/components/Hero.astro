---
import { getLangFromUrl, useTranslations, getLocalizedPath } from "../i18n/translations";
import Stempel from "./Stempel.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hero-section px-6" style="background:var(--papier)">
  <div class="content-width hero-grid">
    <!-- Text: mobile below, desktop left -->
    <div class="hero-copy">
      <h1 class="mb-6" set:html={t("hero.tagline")}></h1>
      <p class="lead mb-8 max-w-[62ch]" style="color:var(--grau)">
        {t("hero.subtitle")}
      </p>
      <div class="flex flex-col sm:flex-row items-start gap-4 mb-4">
        <a
          href={getLocalizedPath(lang === "de" ? "/kontakt" : "/contact", lang)}
          data-cta-location="hero"
          class="btn btn-primary"
        >
          {t("hero.cta")}
        </a>
        <a
          href="#benefits"
          class="btn btn-secondary"
        >
          {t("hero.secondary_cta")} ↓
        </a>
      </div>
      <p class="text-sm mb-6" style="color:var(--grau)">{t("hero.cta_note")}</p>
      <div class="hero-badges">
        <Stempel>Certified &middot; German staffing licence</Stempel>
      </div>
    </div>
    <!-- Image: mobile above, desktop right -->
    <div class="hero-media">
      <img
        src="/avorix_kitchen_ai.webp"
        alt="Profiküche mit KI-gestütztem Rezeptmanagement"
        width="1920"
        height="1080"
        class="w-full h-full object-cover"
        loading="eager"
      />
    </div>
  </div>
</section>

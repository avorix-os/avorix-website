---
import { getLangFromUrl, useTranslations, getLocalizedPath } from "../i18n/translations";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="pt-32 pb-20 px-6 bg-gradient-to-br from-brand-50 via-white to-neutral-50">
  <div class="max-w-4xl mx-auto text-center">
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-avorix-dark leading-tight mb-6">
      {t("hero.tagline")}
    </h1>
    <p class="text-lg md:text-xl text-avorix-gray max-w-2xl mx-auto mb-10 leading-relaxed">
      {t("hero.subtitle")}
    </p>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={getLocalizedPath(lang === "de" ? "/kontakt" : "/contact", lang)}
        data-cta-location="hero"
        class="btn btn-primary"
      >
        {t("hero.cta")}
      </a>
      <a
        href="#benefits"
        class="btn btn-secondary"
      >
        {t("hero.secondary_cta")} ↓
      </a>
    </div>
    <p class="text-sm text-avorix-silver mt-4">{t("hero.cta_note")}</p>
  </div>

  <!-- Hero visual -->
  <div class="max-w-5xl mx-auto px-6 pb-12 -mt-4">
    <div class="relative rounded-2xl overflow-hidden shadow-2xl">
      <img
        src="/avorix_kitchen_ai.webp"
        alt="Profiküche mit KI-gestütztem Rezeptmanagement"
        width="1920"
        height="1080"
        class="w-full object-cover h-64 sm:h-80 md:h-96"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
    </div>
  </div>
</section>

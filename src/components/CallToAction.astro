---
import { getLangFromUrl, useTranslations, getLocalizedPath } from "../i18n/translations";
import Stempel from "./Stempel.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="py-[56px] md:py-[84px] px-6">
  <div class="max-w-3xl mx-auto text-center">
    <div class="mb-6">
      <Stempel>Certified &middot; German staffing licence</Stempel>
    </div>
    <p class="mb-6" style="font-family:Charter, Georgia, serif; font-style:italic; font-size:24px; color:var(--druck)">It&#8217;s sorted.</p>
    <a
      href={getLocalizedPath(lang === "de" ? "/kontakt" : "/contact", lang)}
      data-cta-location="cta"
      class="btn btn-primary"
    >
      {t("cta.button")}
    </a>
  </div>
</section>

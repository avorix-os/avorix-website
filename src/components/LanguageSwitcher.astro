---
import { getLangFromUrl, languages } from "../i18n/translations";

const lang = getLangFromUrl(Astro.url);
const otherLang = lang === "de" ? "en" : "de";

// Map current path to equivalent in other language
// Only pages that exist in BOTH languages are mapped.
// Die gebauten Seiten liegen als Verzeichnis mit index.html, Astro.url.pathname
// endet deshalb auf einen Schraegstrich ("/koch-app/"). Die Tabellen unten stehen
// ohne. Ohne diese Normalisierung greift keine einzige Zuordnung, und der
// Umschalter landet immer auf der Startseite der anderen Sprache.
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
let otherPath: string;

if (lang === "de") {
  // DE -> EN (only old pages that have EN equivalents)
  const deToEn: Record<string, string> = {
    "/": "/en",
    "/ueber-uns": "/en/about",
    "/kontakt": "/en/contact",
    "/impressum": "/en/legal-notice",
    "/datenschutz": "/en/privacy",
    "/koch-app": "/en/cook-app",
    "/personal": "/en/staff",
    "/schulung": "/en/training",
    "/system": "/en/system",
    "/pilotprogramm": "/en/pilot-program",
  };
  otherPath = deToEn[pathname] || `/en`;
} else {
  // EN -> DE
  const enToDe: Record<string, string> = {
    "/en": "/",
    "/en/about": "/ueber-uns",
    "/en/contact": "/kontakt",
    "/en/legal-notice": "/impressum",
    "/en/privacy": "/datenschutz",
    "/en/cook-app": "/koch-app",
    "/en/staff": "/personal",
    "/en/training": "/schulung",
    "/en/system": "/system",
    "/en/pilot-program": "/pilotprogramm",
    // /en/product bleibt bewusst ohne Zuordnung: Die deutsche /produkt gibt es
    // nicht mehr, sie leitet auf /system um -- eine inhaltlich andere Seite.
    // Bis ueber die Seite entschieden ist, fuehrt der Umschalter auf die
    // Startseite statt auf eine unpassende Seite.
  };
  otherPath = enToDe[pathname] || "/";
}
---

<style>
  .lang-switch {
    color: rgba(247, 246, 242, 0.82);
    font-size: 14.5px;
    text-decoration: none;
    padding: 6px 2px;
    position: relative;
    transition: color 0.18s ease;
    white-space: nowrap;
  }
  .lang-switch::after {
    content: '';
    position: absolute;
    left: 2px;
    right: 2px;
    bottom: 2px;
    height: 2px;
    background: var(--papier);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }
  .lang-switch:hover {
    color: var(--papier);
  }
  .lang-switch:hover::after {
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .lang-switch::after { transition: none; }
  }
</style>

<a href={otherPath} class="lang-switch">
  {languages[otherLang]}
</a>

---
import { getLangFromUrl, useTranslations } from "../i18n/translations";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<style>
  /* H1 (Anweisung 18): Grundfassung ist das Handy. Ab 640 wird daraus die Zeile. */
  .site-footer {
    background: var(--eisen);
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .footer-logo {
    display: block;
    flex-shrink: 0;
  }
  .footer-logo img {
    height: 22px;
    width: auto;
    display: block;
    filter: brightness(0) invert(1);
  }

  .footer-right {
    display: flex;
    align-items: center;
    /* C6 (Anweisung 23): 12px lag neben der Skala. */
    gap: 16px;
    flex-wrap: wrap;
    font-family: var(--f-mono);
    font-size: 13px;
  }

  /* Paper-white at 55% opacity via rgba – allows children to override on hover */
  .footer-text,
  .footer-sep {
    color: rgba(247, 246, 242, 0.55);
  }

  /* C7 (Anweisung 23): Impressum, Datenschutz und Cookie-Einstellungen sind
     eigenstaendige Ziele und waren 21px hoch. Die Zielhoehe kommt aus der
     Mindesthoehe, nicht aus einer groesseren Schrift -- die bleibt bei 13px.
     Links im Fliesstext sind ausdruecklich nicht betroffen. */
  .footer-link,
  .footer-cookie-btn {
    color: rgba(247, 246, 242, 0.55);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .footer-link:hover,
  .footer-cookie-btn:hover {
    color: var(--papier);
  }

  .footer-cookie-btn {
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
    font-family: inherit;
    cursor: pointer;
  }

  @media (min-width: 640px) {
    .site-footer {
      flex-direction: row;
      align-items: center;
      gap: 20px;
      padding: 28px 34px;
    }
  }
</style>

<footer class="site-footer">
  <a href={lang === "de" ? "/" : "/en"} class="footer-logo" aria-label="Avorix – Startseite">
    <img src="/logo.png" alt="Avorix" width="1743" height="445" />
  </a>

  {lang === "de" ? (
    <div class="footer-right">
      <span class="footer-text">Avorix GmbH, Friedrichshafen</span>
      <span class="footer-sep">·</span>
      <a href="/impressum" class="footer-link">Impressum</a>
      <span class="footer-sep">·</span>
      <a href="/datenschutz" class="footer-link">Datenschutz</a>
      <span class="footer-sep">·</span>
      <a href="/wissen/" class="footer-link">Wissen</a>
      <span class="footer-sep">·</span>
      <a href="/jobs/" class="footer-link">Jobs bei Avorix</a>
      <span class="footer-sep">·</span>
      <button type="button" id="footer-cookie-settings" class="footer-cookie-btn">Cookie-Einstellungen</button>
    </div>
  ) : (
    <div class="footer-right">
      <span class="footer-text">Avorix GmbH, Friedrichshafen</span>
      <span class="footer-sep">·</span>
      <a href="/en/legal-notice" class="footer-link">{t("footer.imprint")}</a>
      <span class="footer-sep">·</span>
      <a href="/en/privacy" class="footer-link">{t("footer.privacy")}</a>
      <span class="footer-sep">·</span>
      <button type="button" id="footer-cookie-settings" class="footer-cookie-btn">Cookie settings</button>
    </div>
  )}
</footer>

<script is:inline>
  (function () {
    var el = document.getElementById('footer-cookie-settings');
    if (el && !el.dataset.bound) {
      el.dataset.bound = '1';
      el.addEventListener('click', function () {
        if (window.avorixConsent) window.avorixConsent.openPanel(el);
      });
    }
  })();
</script>

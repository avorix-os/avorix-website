---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getImage } from "astro:assets";
import kochVonHintenPass from "../assets/bilder/koch-von-hinten-pass.jpg";

const ogImg = await getImage({ src: kochVonHintenPass, width: 1200, format: "jpeg" });

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Startseite",
      "item": "https://avorix.de/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Pilotprogramm",
      "item": "https://avorix.de/pilotprogramm"
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Was kostet mich das Pilotprogramm?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Deutlich weniger als der reguläre Preis. Die genaue Zahl hängt von Ihrer Karte ab und steht nach der Küchen-Analyse fest, schriftlich und ohne versteckte Posten."
      }
    },
    {
      "@type": "Question",
      "name": "Wie lange bin ich gebunden?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Die App-Nutzung läuft über 12 Monate. Kürzer ist nicht seriös: Ein System, das Ihre Küche verändert, beweist sich nicht in vier Wochen."
      }
    },
    {
      "@type": "Question",
      "name": "Muss ich als Referenz auftreten?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nein. Anonyme Auswertung ja, öffentliche Referenz nur, wenn Sie das ausdrücklich wollen. Dann mit eigenem Deal."
      }
    },
    {
      "@type": "Question",
      "name": "Was ist, wenn es bei uns nicht funktioniert?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Dann sagen wir uns das offen, im Zweifel auch: Abbruch. Genau dafür sind Pilotprojekte da. Ihre Rezeptdokumentation behalten Sie in jedem Fall, die Arbeit war dann nicht umsonst."
      }
    },
    {
      "@type": "Question",
      "name": "Wir haben gar keinen Küchenchef mehr. Geht es trotzdem?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Gerade dann. Für die Übergangszeit können wir zusätzlich einen unserer festangestellten Köche rechtssicher ausleihen. Sprechen Sie es im Kennenlern-Gespräch an."
      }
    }
  ]
};
---

<BaseLayout
  title="Pilotprogramm 2026 für Hotel- und Restaurantküchen"
  description="Werden Sie Pilotbetrieb: das komplette Avorix-System zu Pilotkonditionen, gegen ehrliches Feedback und anonyme Auswertung."
  ogImage={ogImg.src}
  ogImageAlt="Küchenchef von hinten am Pass einer Hotelküche während des Betriebs"
  schemaOrg={[breadcrumbSchema, faqSchema]}
>
  {/* Hero (W2: Text-Hero, linksbündig) */}
 <section class="hero-section px-6">
    <div class="content-width">
      <p class="eyebrow mb-6">Pilotprogramm 2026</p>
      <h1 class="mb-6">
        Wir suchen 3 Hotelk&uuml;chen, die 2026 mit uns <mark>den Beweis antreten.</mark>
      </h1>
      <p class="lead mb-10 max-w-[var(--spalte-text)]" style="color:var(--grau)">
        Die Avorix Koch-App ist neu. Was nicht neu ist: unsere K&ouml;che und unsere Abl&auml;ufe, die seit Jahren in Profik&uuml;chen stehen. Was uns noch fehlt, sind Betriebe, deren Ergebnisse wir zeigen d&uuml;rfen. Deshalb machen wir Ihnen <strong>ein Angebot, das wir so nur den ersten H&auml;usern machen</strong>.
      </p>
      <a
        href="#anfrage"
        data-cta-location="hero"
        class="btn btn-primary"
      >Pilotplatz anfragen</a>
    </div>
  </section>

  {/* Das Angebot */}
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-10 md:mb-16" style="color:var(--druck)">Das Angebot. Ohne Kleingedrucktes.</h2>
      <div class="grid sm:grid-cols-2 gap-8">
        {/* Sie bekommen */}
        <div class="card">
          <h3 class="mb-4">Sie bekommen:</h3>
          <ul class="space-y-4" style="color:var(--grau)">
            <li class="flex items-start gap-4">
              <svg class="w-5 h-5 shrink-0 mt-0.5" style="color:var(--akzent)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Das komplette Avorix-System: Rezeptaufnahme durch einen erfahrenen Koch, Schulung Ihres Teams direkt am Herd, die Koch-App f&uuml;r Ihren ganzen Betrieb.</span>
            </li>
            <li class="flex items-start gap-4">
              <svg class="w-5 h-5 shrink-0 mt-0.5" style="color:var(--akzent)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span><strong>Pilotkonditionen: rund die H&auml;lfte des regul&auml;ren Preises.</strong></span>
            </li>
            <li class="flex items-start gap-4">
              <svg class="w-5 h-5 shrink-0 mt-0.5" style="color:var(--akzent)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Den direkten Draht zum Gr&uuml;nder: B&ouml;rge Penk betreut die Pilotbetriebe pers&ouml;nlich.</span>
            </li>
            <li class="flex items-start gap-4">
              <svg class="w-5 h-5 shrink-0 mt-0.5" style="color:var(--akzent)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Priorit&auml;t bei allem: Ihre W&uuml;nsche flie&szlig;en zuerst in die App ein.</span>
            </li>
          </ul>
        </div>
        {/* Wir bekommen */}
        <div class="card">
          <h3 class="mb-4">Wir bekommen:</h3>
          <ul class="space-y-4" style="color:var(--grau)">
            <li class="flex items-start gap-4">
              <svg class="w-5 h-5 shrink-0 mt-0.5" style="color:var(--akzent)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Ihr ehrliches Feedback. Auch das unbequeme.</span>
            </li>
            <li class="flex items-start gap-4">
              <svg class="w-5 h-5 shrink-0 mt-0.5" style="color:var(--akzent)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Die Erlaubnis, Ihre Ergebnisse anonym auszuwerten (zum Beispiel: &bdquo;Ein Ferienhotel am Bodensee senkte den Wareneinsatz um X Prozent&ldquo;). Ihr Name taucht dabei nirgends auf, das sichern wir vertraglich zu.</span>
            </li>
          </ul>
        </div>
      </div>
      <p class="mt-8 max-w-[var(--spalte-text)]" style="color:var(--grau)">
        Wenn Sie dar&uuml;ber hinaus bereit sind, &ouml;ffentlich als Referenz aufzutreten, sprechen wir &uuml;ber einen eigenen Deal mit noch besseren Konditionen. Das ist aber freiwillig und keine Bedingung.
      </p>
    </div>
  </section>

  {/* Passt das */}
 <section class="reveal section-gap section-band">
    <div class="content-width">
      <h2 class="mb-10 md:mb-16" style="color:var(--druck)">Passt das zu Ihrem Haus?</h2>
      <div class="grid sm:grid-cols-2 gap-8">
        {/* Passt */}
        <div class="card">
          <h3 class="mb-4" style="color:var(--akzent)">Das Pilotprogramm passt, wenn:</h3>
          <ul class="space-y-4" style="color:var(--grau)">
            <li class="flex items-start gap-4">
              <svg class="w-5 h-5 shrink-0 mt-0.5" style="color:var(--akzent)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Sie ein Hotel oder Restaurant in Deutschland oder &Ouml;sterreich f&uuml;hren, idealerweise mit Halbpension oder fester Karte.</span>
            </li>
            <li class="flex items-start gap-4">
              <svg class="w-5 h-5 shrink-0 mt-0.5" style="color:var(--akzent)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Der Fachkr&auml;ftemangel bei Ihnen real ist: offene Stellen, Abh&auml;ngigkeit von einzelnen K&ouml;pfen, schwankende Qualit&auml;t.</span>
            </li>
            <li class="flex items-start gap-4">
              <svg class="w-5 h-5 shrink-0 mt-0.5" style="color:var(--akzent)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Sie bereit sind, Abl&auml;ufe zu ver&auml;ndern. Nicht alles auf einmal, aber ernsthaft.</span>
            </li>
          </ul>
        </div>
        {/* Passt nicht */}
        <div class="card">
          <h3 class="mb-4">Es passt nicht, wenn:</h3>
          <ul class="space-y-4" style="color:var(--grau)">
            <li class="flex items-start gap-4">
              <svg class="w-5 h-5 shrink-0 mt-0.5" style="color:var(--grau)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
              <span>Sie eine t&auml;glich wechselnde Spitzengastronomie mit eigenem Patron am Herd f&uuml;hren. Daf&uuml;r ist Avorix nicht gebaut.</span>
            </li>
            <li class="flex items-start gap-4">
              <svg class="w-5 h-5 shrink-0 mt-0.5" style="color:var(--grau)" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
              <span>Sie nur die App wollen, aber nichts am Ablauf &auml;ndern m&ouml;chten. Dann verbrennen wir beide Zeit und Geld.</span>
            </li>
          </ul>
        </div>
      </div>
      <p class="mt-8 max-w-[var(--spalte-text)]" style="color:var(--grau)">
        Diese Ehrlichkeit sparen wir uns nicht. <strong>Ein Pilotprojekt, das nicht passt, schadet Ihnen und uns.</strong>
      </p>
    </div>
  </section>

  {/* Vier Schritte */}
 <section class="reveal section-gap section-band">
    <div class="content-width text-spalte">
      <h2 class="mb-10 md:mb-16" style="color:var(--druck)">Vier Schritte bis zur K&uuml;che, die immer funktioniert.</h2>
      <div class="space-y-8">
        {/* Schritt 1 */}
        <div class="flex gap-4 items-start">
          <span class="schritt-chip">1</span>
          <div>
            <h3 class="mb-4">Kennenlern-Gespr&auml;ch (30 Minuten, kostenlos).</h3>
            <p class="max-w-[var(--spalte-text)]" style="color:var(--grau)">Per Video oder Telefon. Sie schildern Ihre Situation, wir pr&uuml;fen gemeinsam, ob das Pilotprogramm passt. Danach entscheiden beide Seiten in Ruhe.</p>
          </div>
        </div>
        {/* Schritt 2 */}
        <div class="flex gap-4 items-start">
          <span class="schritt-chip">2</span>
          <div>
            <h3 class="mb-4">K&uuml;chen-Analyse vor Ort.</h3>
            <p class="max-w-[var(--spalte-text)]" style="color:var(--grau)">Ein Avorix-Koch schaut sich Ihre K&uuml;che, Ihre Karte und Ihr Team an. Sie bekommen <strong>einen konkreten Fahrplan mit Aufwand und Kosten</strong>, auf den Euro genau.</p>
          </div>
        </div>
        {/* Schritt 3 */}
        <div class="flex gap-4 items-start">
          <span class="schritt-chip">3</span>
          <div>
            <h3 class="mb-4">Aufnahme und Schulung.</h3>
            <p class="max-w-[var(--spalte-text)]" style="color:var(--grau)">Wir dokumentieren Ihre Karte, richten die App ein und schulen Ihr Team am Herd, <strong>w&auml;hrend der Betrieb normal weiterl&auml;uft</strong>.</p>
          </div>
        </div>
        {/* Schritt 4 */}
        <div class="flex gap-4 items-start">
          <span class="schritt-chip">4</span>
          <div>
            <h3 class="mb-4">Laufender Betrieb mit Begleitung.</h3>
            <p class="max-w-[var(--spalte-text)]" style="color:var(--grau)">Ihr Team arbeitet mit dem System. Wir bleiben dran, sammeln Ihr Feedback und justieren nach. Alle paar Wochen ein kurzes Gespr&auml;ch mit B&ouml;rge.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Gründer (W4: 7/12 Absatz + 5/12 Pull-Quote, kein Platzhalterbild) */}
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-10 md:mb-16" style="color:var(--druck)">Wer hinter dem Angebot steht</h2>
      <div class="gruender-grid">
        <div>
          <p class="leading-relaxed max-w-[var(--spalte-text)]" style="color:var(--grau)">
            B&ouml;rge Penk, K&uuml;chenchef mit 20 Jahren Praxis, hat Avorix aus dem eigenen K&uuml;chenalltag heraus entwickelt. F&uuml;r die Pilotbetriebe ist er pers&ouml;nlich verantwortlich:
          </p>
        </div>
        <blockquote class="gruender-quote">
          &bdquo;Bei den ersten H&auml;usern stehe ich selbst gerade. Wenn es dort nicht funktioniert, funktioniert unser Gesch&auml;ftsmodell nicht. Einfacher kann ich Ihr Risiko nicht machen.&ldquo;
        </blockquote>
      </div>
    </div>
  </section>

  {/* Warum 3 */}
 <section class="reveal section-gap section-dunkel">
    <div class="content-width text-spalte">
      <h2 class="mb-6">Warum nur 3 Pl&auml;tze?</h2>
      <p class="leading-relaxed max-w-[var(--spalte-text)]">
        Weil jede Einf&uuml;hrung echte Menschen braucht: Ein Avorix-Koch steht bei Ihnen in der K&uuml;che, nicht in einem Callcenter. Mehr als einen neuen Betrieb pro Monat k&ouml;nnen wir sauber betreuen, und <strong>Qualit&auml;t geht vor Wachstum.</strong> Deshalb ist bei 3 Pilotbetrieben Schluss. Danach gelten regul&auml;re Konditionen.
      </p>
    </div>
  </section>

  {/* FAQ */}
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-10" style="color:var(--druck)">H&auml;ufige Fragen</h2>
      <div class="faq-list">
        <details class="faq-item" open>
          <summary class="faq-q">Was kostet mich das Pilotprogramm?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Deutlich weniger als der regul&auml;re Preis. Die genaue Zahl h&auml;ngt von Ihrer Karte ab und steht nach der K&uuml;chen-Analyse fest, <strong>schriftlich und ohne versteckte Posten</strong>.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Wie lange bin ich gebunden?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Die App-Nutzung l&auml;uft &uuml;ber 12 Monate. K&uuml;rzer ist nicht seri&ouml;s: Ein System, das Ihre K&uuml;che ver&auml;ndert, beweist sich nicht in vier Wochen.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Muss ich als Referenz auftreten?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Nein. Anonyme Auswertung ja, &ouml;ffentliche Referenz nur, wenn Sie das ausdr&uuml;cklich wollen. Dann mit eigenem Deal.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Was ist, wenn es bei uns nicht funktioniert?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Dann sagen wir uns das offen, im Zweifel auch: Abbruch. Genau daf&uuml;r sind Pilotprojekte da. Ihre Rezeptdokumentation behalten Sie in jedem Fall, die Arbeit war dann nicht umsonst.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Wir haben gar keinen K&uuml;chenchef mehr. Geht es trotzdem?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Gerade dann. F&uuml;r die &Uuml;bergangszeit k&ouml;nnen wir zus&auml;tzlich einen unserer festangestellten K&ouml;che rechtssicher ausleihen. Sprechen Sie es im Kennenlern-Gespr&auml;ch an.</p></div></div>
        </details>
      </div>
      {/* Kernsatz (Anweisung 30, Schritt 4) */}
      <p class="mt-8 max-w-[var(--spalte-text)]" style="color:var(--druck);font-weight:700">Ihre K&uuml;che h&auml;lt Ihr Niveau. Auch wenn der Spitzenkoch fehlt.</p>
    </div>
  </section>

  {/* Pilotplatz anfragen */}
 <section id="anfrage" class="reveal section-gap">
    <div class="content-width">
      <div style="max-width:640px">
        <h2 class="mb-6" style="color:var(--druck)">Pilotplatz anfragen. Unverbindlich.</h2>
        <p class="text-lg mb-10" style="color:var(--grau)">Drei Minuten. Danach melden wir uns innerhalb von zwei Werktagen.</p>

        <p class="formular-pflicht">Felder mit * brauchen wir, alles andere ist freiwillig.</p>
        <form id="pilot-form" class="card pilot-form-wrap space-y-6" action="https://formspree.io/f/xqegwngo" method="POST">
          <input type="hidden" name="_subject" value="Pilot-Anfrage über avorix.de" />

          <div>
            <label for="pilot-name" class="pilot-label">
              Name <span style="color:var(--akzent)">*</span>
            </label>
            <input
              type="text"
              id="pilot-name"
              name="name"
              autocomplete="name"
              required
              class="pilot-field"
            />
          </div>

          <div>
            <label for="pilot-betrieb" class="pilot-label">
              Betrieb (Hotel/Restaurant) + Ort <span style="color:var(--akzent)">*</span>
            </label>
            <input
              type="text"
              id="pilot-betrieb"
              name="betrieb"
              autocomplete="organization"
              required
              class="pilot-field"
            />
          </div>

          <div>
            <label for="pilot-email" class="pilot-label">
              E-Mail <span style="color:var(--akzent)">*</span>
            </label>
            <input
              type="email"
              id="pilot-email"
              name="email"
              autocomplete="email"
              required
              class="pilot-field"
            />
          </div>

          <div>
            <label for="pilot-telefon" class="pilot-label">
              Telefon <span class="pilot-label-opt">(optional, f&uuml;r schnellere R&uuml;ckmeldung)</span>
            </label>
            <input
              type="tel"
              id="pilot-telefon"
              name="telefon"
              autocomplete="tel"
              class="pilot-field"
            />
          </div>

          <div>
            <label for="pilot-teamgroesse" class="pilot-label">
              Wie gro&szlig; ist Ihr K&uuml;chenteam?
            </label>
            <select
              id="pilot-teamgroesse"
              name="kuechenteam"
              class="pilot-field"
            >
              <option value="">Bitte w&auml;hlen</option>
              <option value="1 bis 3">1 bis 3</option>
              <option value="4 bis 8">4 bis 8</option>
              <option value="mehr als 8">mehr als 8</option>
            </select>
          </div>

          <div>
            <label for="pilot-problem" class="pilot-label">
              Was ist gerade Ihr gr&ouml;&szlig;tes K&uuml;chenproblem? <span class="pilot-label-opt">(optional)</span>
            </label>
            <textarea
              id="pilot-problem"
              name="kuechenproblem"
              rows="4"
              class="pilot-field pilot-textarea"
            ></textarea>
          </div>

          <div id="pilot-success" class="hidden pilot-success-msg">
            Danke. Wir melden uns innerhalb von zwei Werktagen.
          </div>

          <button
            type="submit"
            class="btn btn-primary pilot-submit"
          >
            Pilotplatz anfragen
          </button>
          <p class="formular-hinweis">
            Mit dem Absenden stimmen Sie der Verarbeitung Ihrer Angaben zur Bearbeitung Ihrer Anfrage zu.
            Mehr dazu in der <a href="/datenschutz" class="typo-link">Datenschutzerkl&auml;rung</a>.
          </p>
        </form>
        <div class="pilot-zweitwege">
          <a href="/kontakt" data-cta-location="pilot-zweitweg" class="btn btn-secondary">Erst einmal die App ansehen</a>
          <a href="/personal#anfrage" data-cta-location="pilot-zweitweg" data-cta-event="cta_personal_click" class="btn btn-secondary">Sie brauchen jetzt jemanden?</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>


/* Formular (3.14) */
.pilot-form-wrap {
  padding: 2rem;
}
.pilot-label {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: var(--druck);
  margin-bottom: 8px;
}
.pilot-label-opt {
  font-weight: 400;
  color: var(--grau);
}
.pilot-field {
  width: 100%;
  background: var(--flaeche);
  border: 1px solid var(--linie);
  border-radius: var(--radius);
  padding: 16px;
  font-size: 16px;
  font-family: var(--f-body);
  color: var(--druck);
  transition: border-color .15s;
  appearance: auto;
  box-sizing: border-box;
}
.pilot-field:focus {
  outline: none;
  border-color: var(--akzent);
}
.pilot-field:focus-visible {
  outline: 3px solid var(--akzent);
  outline-offset: 2px;
}
.pilot-textarea {
  resize: none;
}
.pilot-field:invalid:not(:placeholder-shown) {
  border-color: var(--fehler);
}

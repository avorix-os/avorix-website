---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image, getImage } from "astro:assets";
import Stempel from "../components/Stempel.astro";
import sporthotelSpeisesaal from "../assets/bilder/sporthotel-speisesaal.jpg";

const ogImg = await getImage({ src: sporthotelSpeisesaal, width: 1200, format: "jpeg" });
const ogImageAlt = "Moderner Speisesaal eines Sporthotels mit Bergpanorama";
---

<BaseLayout
  title="K&uuml;chensystem f&uuml;r Sporthotels"
  description="Halbpension, Gruppen und Trainingslager mit halber Mannschaft stemmen: Avorix macht Ihre Sporthotel-K&uuml;che verl&auml;sslich."
  ogImage={ogImg.src}
  ogImageAlt={ogImageAlt}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "url": "https://avorix.cloud/fuer-sporthotels",
    "primaryImageOfPage": {
      "@type": "ImageObject",
      "url": `https://avorix.cloud${ogImg.src}`,
      "description": ogImageAlt
    }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://avorix.cloud/" },
          { "@type": "ListItem", "position": 2, "name": "Für Sporthotels", "item": "https://avorix.cloud/fuer-sporthotels" }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          { "@type": "Question", "name": "Wir fahren Buffet und Menü gemischt. Geht das?", "acceptedAnswer": { "@type": "Answer", "text": "Ja. Jede Komponente wird als eigenes Rezept mit Stückzahlen geführt, egal ob sie auf dem Teller oder im Chafing-Dish landet." } },
          { "@type": "Question", "name": "Wie kurz vor Saisonstart können wir noch anfangen?", "acceptedAnswer": { "@type": "Answer", "text": "Je nach Karte typischerweise wenige Wochen für Aufnahme und Schulung. Je früher vor der Saison, desto entspannter." } },
          { "@type": "Question", "name": "Können Sonderwünsche von Sportlergruppen abgebildet werden?", "acceptedAnswer": { "@type": "Answer", "text": "Varianten (vegetarisch, kalorienbewusst) werden wie eigene Gerichte dokumentiert und sind damit genauso reproduzierbar." } },
          { "@type": "Question", "name": "Bekommen wir für die Saison auch Personal?", "acceptedAnswer": { "@type": "Answer", "text": "Ja, das ist Teil des Systems: festangestellte Köche, rechtssicher verliehen, für Wochen oder die ganze Saison." } }
        ]
      }
    ]
  })} />

  <!-- Hero (W2: Split 55/45, Bild rechts) -->
 <section class="hero-section px-6" style="background:var(--papier)">
    <div class="content-width hero-grid">
      <div class="hero-copy">
        <p class="eyebrow mb-4">F&uuml;r Sporthotels</p>
        <h1 class="mb-6">
          Ihre G&auml;ste bringen Leistung. <mark>Ihre K&uuml;che auch.</mark> Egal wer gerade kocht.
        </h1>
        <p class="lead mb-6" style="color:var(--grau)">
          Halbpension auf Niveau, Gruppen-Men&uuml;s in St&uuml;ckzahl, Saisonkr&auml;fte ab Tag eins produktiv: Avorix macht Ihre Sporthotel-K&uuml;che unabh&auml;ngig davon, wen Sie diese Saison gefunden haben.
        </p>
        <div class="flex flex-wrap gap-4 mb-6">
          <a href="/kontakt" data-cta-location="sporthotels-hero" class="btn btn-primary">Demo vereinbaren</a>
          <a href="/personal#anfrage" data-cta-location="sporthotels-hero" data-cta-event="cta_personal_click" class="btn btn-secondary">Personal anfragen</a>
        </div>
        <div class="hero-badges">
          <Stempel>Gepr&uuml;ft &middot; A&Uuml;-Erlaubnis</Stempel>
        </div>
      </div>
      <div class="hero-media">
        <Image
          src={sporthotelSpeisesaal}
          alt="Moderner Speisesaal eines Sporthotels mit Bergpanorama"
          widths={[480, 800, 1200, 1600]}
          sizes="(max-width: 900px) 100vw, 528px"
          loading="eager"
          fetchpriority="high"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Problem -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Halbpension auf Niveau. Mit halber Mannschaft.</h2>
      <!-- Korrektur 9 (Anweisung 25): Der Satz stand unter der Gruppe. Er ist zu
           verstehen, bevor man sie gesehen hat, also gehoert er nach oben. -->
      <p class="mb-10 max-w-[62ch]" style="color:var(--grau)">Wenn die K&uuml;che wackelt, wackelt der Ruf des Hauses. <strong>Und der entscheidet, ob die Gruppe n&auml;chstes Jahr wiederkommt.</strong></p>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">
        <div class="card">
          <h3 class="mb-4">Aktive G&auml;ste verzeihen wenig.</h3>
          <p class="text-sm" style="color:var(--grau)">Wer tags&uuml;ber Leistung bringt, erwartet abends verl&auml;sslich gutes Essen. <strong>Jeden Abend, die ganze Saison.</strong></p>
        </div>
        <div class="card">
          <h3 class="mb-4">Gruppen sprengen jede Routine.</h3>
          <p class="text-sm" style="color:var(--grau)">Trainingslager, Vereine, Camps: 60 Essen auf einmal, zus&auml;tzlich zum Haus. <strong>Ihr Stammteam federt das nicht ab.</strong></p>
        </div>
        <div class="card">
          <h3 class="mb-4">Saisonkr&auml;fte kommen ohne Einarbeitung.</h3>
          <p class="text-sm" style="color:var(--grau)">Und gehen nach einer Saison wieder. Jedes Jahr f&auml;ngt Ihre K&uuml;che von vorn an.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- System (W4: Modul-Karten) -->
 <section class="reveal section-gap" style="background:var(--papier)">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Das Avorix-System: drei Bausteine f&uuml;r eine K&uuml;che, die durchh&auml;lt.</h2>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">
        <div class="card-modul">
          <div class="card-modul-header">
            <span class="card-modul-label">Modul 1</span>
            <span class="card-modul-leader"></span>
          </div>
          <h3 class="mb-4">Unser System</h3>
          <p class="text-sm" style="color:var(--grau)">Ihre Halbpensions-Zyklen und Men&uuml;folgen als Schritt-f&uuml;r-Schritt-Anleitungen in der Koch-App, mit Fotos, Mengen und Zeiten. Der Portionsrechner skaliert jedes Gericht automatisch von 40 auf 100 Essen.</p>
        </div>
        <div class="card-modul">
          <div class="card-modul-header">
            <span class="card-modul-label">Modul 2</span>
            <span class="card-modul-leader"></span>
          </div>
          <h3 class="mb-4">Die Schulung</h3>
          <p class="text-sm" style="color:var(--grau)">Ein Avorix-Koch (mindestens Sous-Chef-Erfahrung) nimmt Ihre Karte auf und lernt Ihr Team an.</p>
        </div>
        <div class="card-modul">
          <div class="card-modul-header">
            <span class="card-modul-label">Modul 3</span>
            <span class="card-modul-leader"></span>
          </div>
          <h3 class="mb-4">Die Verst&auml;rkung</h3>
          <p class="text-sm mb-4" style="color:var(--grau)">F&uuml;r die Saison leihen wir Ihnen festangestellte K&ouml;che aus. Rechtssicher, mit Arbeitnehmer&uuml;berlassungserlaubnis.</p>
          <Stempel>Gepr&uuml;ft &middot; A&Uuml;-Erlaubnis</Stempel>
        </div>
      </div>
      <div class="mt-8">
        <a href="/system" data-cta-location="sporthotels-system" class="btn btn-secondary">So funktioniert das System</a>
      </div>
    </div>
  </section>

  <!-- Gruppen-Menüs -->
 <section class="reveal section-gap">
    <div class="content-width text-spalte">
      <h2 class="mb-6" style="color:var(--druck)">Gruppen-Men&uuml;s in St&uuml;ckzahl sind der Idealfall f&uuml;r das System.</h2>
      <p class="max-w-[62ch]" style="color:var(--grau)">
        Trainingslager-Men&uuml;folgen und Halbpensions-Zyklen sind planbar: gleiche Gerichte, klare Mengen, feste Termine. Genau das kann das System am besten. <strong>Einmal sauber dokumentiert, wird jede Men&uuml;folge reproduzierbar</strong>, jeden Abend, von jeder Kraft, in jeder St&uuml;ckzahl. Ihre K&uuml;che wei&szlig; am Morgen, was am Abend auf 80 Tellern liegt.
      </p>
    </div>
  </section>

  <!-- Köche für die Saison -->
 <section class="reveal section-gap section-dunkel">
    <div class="content-width text-spalte">
      <h2 class="mb-6">K&ouml;che f&uuml;r die Saison. Rechtssicher. Ab Tag eins produktiv.</h2>
      <p class="mb-4 max-w-[62ch]">
        Wir arbeiten in Deutschland und &Ouml;sterreich, auch in Tirol. Unsere K&ouml;che sind bei uns fest angestellt und werden mit beh&ouml;rdlicher Arbeitnehmer&uuml;berlassungserlaubnis verliehen. <strong>Das sch&uuml;tzt Sie vor dem Scheinselbst&auml;ndigkeits-Risiko</strong>, das bei &bdquo;selbstst&auml;ndigen&ldquo; Saisonk&ouml;chen schnell 50.000 Euro und mehr kosten kann.
      </p>
      <p class="max-w-[62ch]">
        Und weil jeder Avorix-Koch mit der App arbeitet, gilt: Der Saisonkoch geht im Fr&uuml;hjahr. <strong>Sein Wissen bleibt bei Ihnen.</strong>
      </p>
    </div>
  </section>

  <!-- Vor der Saison -->
 <section class="reveal section-gap">
    <div class="content-width text-spalte">
      <h2 class="mb-6" style="color:var(--druck)">Vor der Saison ist der beste Zeitpunkt.</h2>
      <p class="mb-6 max-w-[62ch]" style="color:var(--grau)">
        Die ruhigen Wochen vor Saisonstart sind ideal f&uuml;r Aufnahme und Schulung: <strong>Wenn die ersten Gruppen anreisen, l&auml;uft Ihr System schon.</strong> Als einer unserer Pilotbetriebe 2026 starten Sie zu Konditionen von rund der H&auml;lfte des regul&auml;ren Preises.
      </p>
      <a href="/pilotprogramm" data-cta-location="sporthotels-pilot" class="btn btn-primary">Zum Pilotprogramm</a>
    </div>
  </section>

  <!-- FAQ -->
 <section class="reveal section-gap" style="background:var(--papier)">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">H&auml;ufige Fragen</h2>
      <div class="faq-list">
        <details class="faq-item" open>
          <summary class="faq-q">Wir fahren Buffet und Men&uuml; gemischt. Geht das?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Ja. Jede Komponente wird als eigenes Rezept mit St&uuml;ckzahlen gef&uuml;hrt, egal ob sie auf dem Teller oder im Chafing-Dish landet.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Wie kurz vor Saisonstart k&ouml;nnen wir noch anfangen?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Je nach Karte typischerweise wenige Wochen f&uuml;r Aufnahme und Schulung. Je fr&uuml;her vor der Saison, desto entspannter.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">K&ouml;nnen Sonderw&uuml;nsche von Sportlergruppen abgebildet werden?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Varianten (vegetarisch, kalorienbewusst) werden wie eigene Gerichte dokumentiert und sind damit genauso reproduzierbar.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Bekommen wir f&uuml;r die Saison auch Personal?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Ja, das ist Teil des Systems: festangestellte K&ouml;che, rechtssicher verliehen, f&uuml;r Wochen oder die ganze Saison.</p></div></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Final CTA → Peak-End (3.18) -->
 <section class="reveal section-gap" style="background:var(--papier)">
    <div class="content-width text-center">
      <div class="mb-6">
        <Stempel>Gepr&uuml;ft &middot; A&Uuml;-Erlaubnis</Stempel>
      </div>
      <p class="mb-6" style="font-family:Charter, Georgia, serif; font-style:italic; font-size:24px; color:var(--druck)">Es ist geregelt.</p>
      <a href="/kontakt" data-cta-location="sporthotels-final" class="btn btn-primary">Demo vereinbaren</a>
    </div>
  </section>
</BaseLayout>

<script>
/* FAQ-Schlie&szlig;-Animation — progressive enhancement */
document.querySelectorAll('.faq-item').forEach(function(item) {
  var summary = item.querySelector('summary');
  if (!summary) return;
  summary.addEventListener('click', function(e) {
    if (!item.open) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    e.preventDefault();
    item.classList.add('faq-closing');
    var body = item.querySelector('.faq-body');
    if (!body) { item.classList.remove('faq-closing'); item.removeAttribute('open'); return; }
    body.addEventListener('transitionend', function handler() {
      body.removeEventListener('transitionend', handler);
      item.classList.remove('faq-closing');
      item.removeAttribute('open');
    });
  });
});
</script>

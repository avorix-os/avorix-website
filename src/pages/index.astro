---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image, getImage } from "astro:assets";
import Lightbox from "../components/Lightbox.astro";
import Stempel from "../components/Stempel.astro";
import kochAppTabletPass from "../assets/bilder/koeche-am-pass-mit-tablet.jpg";
import leerenPassMorgens from "../assets/bilder/leerer-pass-morgens.jpg";
import waageZutaten from "../assets/bilder/waage-zutaten.jpg";
import appKochmodus1 from "../assets/bilder/app-kochmodus-schritt1.png";
import appPortionsrechner from "../assets/bilder/app-rezept-detail-portionsrechner.png";
import appRezepteListe from "../assets/bilder/app-rezepte-liste.png";

const ogImg = await getImage({ src: kochAppTabletPass, width: 1200, format: "jpeg" });
const ogImageAlt = "Zwei Köche am Pass einer Profiküche, davor ein Tablet mit der Avorix Koch-App";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "AVORIX GmbH",
    "url": "https://avorix.cloud",
    "logo": "https://avorix.cloud/avorix-logo.svg",
    "description": "Avorix führt Ihr Küchenteam Schritt für Schritt durch jedes Gericht. Mit Koch-App, Schulung durch echte Köche und rechtssicherem Personal. Auch ohne ausgebildete Köche.",
    "founder": {
      "@type": "Person",
      "name": "Börge Penk"
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Friedrichshafen",
      "addressCountry": "DE"
    },
    "areaServed": ["DE", "AT"],
    "url": "https://avorix.cloud"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": []
  },
  {
    "@context": "https://schema.org",
    "@type": "SpeakableSpecification",
    "cssSelector": "#direktantwort"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Wer tippt unsere Rezepte ein?",
        "acceptedAnswer": { "@type": "Answer", "text": "Wir. Ein Avorix-Koch kommt zu Ihnen, kocht mit Ihrem Team und legt jedes Gericht in der App an. Sie müssen nichts selbst einpflegen." }
      },
      {
        "@type": "Question",
        "name": "Merken unsere Gäste etwas davon?",
        "acceptedAnswer": { "@type": "Answer", "text": "Nein. Ihre Gäste erleben Ihre Küche und Ihre Rezepte, nur eben verlässlich in gleicher Qualität. Auf Wunsch sichern wir Ihnen vertraglich zu, dass wir Ihren Betrieb nirgends als Referenz nennen." }
      },
      {
        "@type": "Question",
        "name": "Unser Team ist nicht besonders technikaffin. Klappt das trotzdem?",
        "acceptedAnswer": { "@type": "Answer", "text": "Ja, dafür ist die App gebaut. Wer ein Foto ansehen und einen Haken setzen kann, kann mit ihr arbeiten. Geschult wird direkt am Herd, nicht im Seminarraum." }
      },
      {
        "@type": "Question",
        "name": "Was passiert mit unseren Rezepten? Wem gehören die?",
        "acceptedAnswer": { "@type": "Answer", "text": "Ihnen. Ihre Rezepte bleiben Ihr Eigentum und werden nicht an andere Betriebe weitergegeben." }
      },
      {
        "@type": "Question",
        "name": "Wie schnell sind wir startklar?",
        "acceptedAnswer": { "@type": "Answer", "text": "Vom Erstgespräch bis zum eigenständigen Arbeiten vergehen je nach Karte typischerweise wenige Wochen. Den genauen Fahrplan bekommen Sie nach dem Erstgespräch." }
      },
      {
        "@type": "Question",
        "name": "Welche Technik brauchen wir in der Küche?",
        "acceptedAnswer": { "@type": "Answer", "text": "Ein Tablet oder Smartphone und eine Internetverbindung. Mehr nicht. Die App läuft im Browser, es muss nichts installiert werden." }
      },
      {
        "@type": "Question",
        "name": "Ersetzt das unseren Küchenchef?",
        "acceptedAnswer": { "@type": "Answer", "text": "Nein. Ein guter Küchenchef wird mit Avorix besser, weil sein Wissen endlich festgehalten ist und sein Team selbstständiger arbeitet. Avorix hilft vor allem dann, wenn der Küchenchef fehlt, ausfällt oder wechselt." }
      },
      {
        "@type": "Question",
        "name": "Wir sind in Österreich. Geht das?",
        "acceptedAnswer": { "@type": "Answer", "text": "Ja, wir arbeiten in Deutschland und Österreich." }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "url": "https://avorix.cloud/",
    "primaryImageOfPage": {
      "@type": "ImageObject",
      "url": `https://avorix.cloud${ogImg.src}`,
      "description": ogImageAlt
    }
  }
];
---

<BaseLayout
  title="Koch-App, Schulung & Küchenpersonal für Hotels und Gastronomie | Avorix"
  description="Avorix führt Ihr Küchenteam Schritt für Schritt durch jedes Gericht. Mit Koch-App, Schulung durch echte Köche und rechtssicherem Personal. Auch ohne ausgebildete Köche."
  ogImage={ogImg.src}
  ogImageAlt={ogImageAlt}
  schemaOrg={schema}
>
  <!-- Hero (W2: Split 55/45, Bild spannt, Stempel zuerst) -->
 <section class="hero-section px-6" style="background:var(--papier)">
    <div class="content-width hero-grid">
      <!-- Text: mobil unten, Desktop links -->
      <div class="hero-copy">
        <p class="eyebrow mb-4">Koch-App + Schulung + Personal</p>
        <h1 class="mb-6">
          Ihre K&uuml;che <mark style="white-space:nowrap">h&auml;lt Ihr Niveau.</mark><br />Auch wenn der Spitzenkoch fehlt.
        </h1>
        <p class="lead mb-6" style="color:var(--grau)">
          Avorix hilft doppelt: sofort ein Koch, wenn Ihrer fehlt. Und ein System, damit es nie wieder so weit kommt. <strong style="color:var(--druck)">Auch ohne ausgebildete K&ouml;che.</strong>
        </p>
        <div class="flex flex-wrap gap-4 mb-6">
          <a href="/personal#anfrage" data-cta-location="hero" data-cta-event="cta_personal_click" class="btn btn-primary">Personal anfragen</a>
          <a href="/kontakt" data-cta-location="hero" class="btn btn-secondary">App-Demo vereinbaren</a>
        </div>
        <div class="hero-badges">
          <Stempel>Gepr&uuml;ft &middot; A&Uuml;-Erlaubnis</Stempel>
          <span class="check-badge"><span class="check-badge-mark">&#10003;</span> Von K&ouml;chen entwickelt, nicht von Software-Leuten</span>
          <span class="check-badge"><span class="check-badge-mark">&#10003;</span> Friedrichshafen am Bodensee &middot; DE + AT</span>
        </div>
      </div>
      <!-- Bild: mobil oben, Desktop rechts -->
      <div class="hero-media">
        <Image
          src={kochAppTabletPass}
          alt="Zwei K&ouml;che von hinten am Pass einer Profik&uuml;che, dazwischen ein Tablet mit der laufenden Avorix Koch-App"
          widths={[480, 800, 1200, 1600, 2000]}
          sizes="(max-width: 900px) 100vw, 528px"
          loading="eager"
          fetchpriority="high"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Direkt-Antwort (GEO) -->
 <section class="reveal">
    <div class="content-width">
      <p id="direktantwort" class="text-base leading-relaxed py-4 max-w-[62ch]" style="color:var(--grau)">Avorix ist ein K&uuml;chensystem f&uuml;r Hotels und Gastronomie aus Friedrichshafen am Bodensee. Es verbindet eine Koch-App, die K&uuml;chenteams Schritt f&uuml;r Schritt durch jedes Gericht f&uuml;hrt, mit Schulung durch erfahrene K&ouml;che und rechtssicherem K&uuml;chenpersonal-Verleih mit beh&ouml;rdlicher Arbeitnehmer&uuml;berlassungserlaubnis. Avorix arbeitet in Deutschland und &Ouml;sterreich.</p>
    </div>
  </section>

  <!-- Problem (W3: Split H2+Absatz links, Foto rechts) -->
 <section class="reveal section-gap">
    <div class="content-width split-row">
      <div class="split-copy">
        <h2 class="mb-6" style="color:var(--druck)">Kommt Ihnen das bekannt vor?</h2>
        <p class="lead max-w-[62ch]" style="color:var(--druck)">Ihre K&uuml;che steht und f&auml;llt mit einer einzigen Person.</p>
        <p class="max-w-[62ch]" style="color:var(--grau)">Wenn die K&uuml;che wackelt, wackelt alles: <strong style="color:var(--druck)">erst die Qualit&auml;t, dann die Bewertungen, dann der Ruf.</strong> Und irgendwann steht die Frage im Raum, wie lange es so noch weitergeht. Damit sind Sie nicht allein: Fachkr&auml;ftemangel in der K&uuml;che ist in fast jedem Betrieb ein Thema.</p>
      </div>
      <div class="split-media">
        <Image
          src={leerenPassMorgens}
          alt="Leere Hotelküche am Morgen vor dem Service"
          widths={[480, 800, 1200, 1600]}
          sizes="(max-width: 900px) 100vw, 420px"
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
    <div class="content-width" style="margin-top:32px">
      <div class="grid md:grid-cols-3 gap-6">
        <div class="card">
          <h3 class="mb-3">Der K&uuml;chenchef k&uuml;ndigt. Oder der Souschef. Mitten in der Saison.</h3>
          <p class="text-sm" style="color:var(--grau)">Mit jeder Schl&uuml;sselkraft geht Wissen: die Rezepte, die Mengen, die Abl&auml;ufe. <strong style="color:var(--druck)">Der Rest des Teams steht da und improvisiert.</strong></p>
        </div>
        <div class="card">
          <h3 class="mb-3">Jeder kocht anders.</h3>
          <p class="text-sm" style="color:var(--grau)">Montag schmeckt das Schnitzel anders als Freitag. Die Portionen schwanken. <strong style="color:var(--druck)">Stammg&auml;ste merken das zuerst.</strong></p>
        </div>
        <div class="card">
          <h3 class="mb-3">Sie finden schlicht niemanden.</h3>
          <p class="text-sm" style="color:var(--grau)">Auf Ihre Stellenanzeige meldet sich niemand, der kochen kann. <strong style="color:var(--druck)">Und wenn doch, ist er nach einer Saison wieder weg.</strong></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Wo stehen Sie -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-8" style="color:var(--druck)">Wo stehen Sie gerade?</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="card flex flex-col">
          <h3 class="mb-3">&bdquo;Der Notfall ist da.&ldquo;</h3>
          <p class="text-sm mb-4" style="color:var(--grau)">Der Koch ist weg, die Saison l&auml;uft. Wir schicken Ihnen einen Koch. <strong style="color:var(--druck)">Und sorgen daf&uuml;r, dass Sie nie wieder einen suchen m&uuml;ssen.</strong></p>
          <a href="/personal#anfrage" data-cta-location="tuer-notfall" data-cta-event="cta_personal_click" class="btn btn-primary" style="margin-top:auto">Jetzt Hilfe holen</a>
        </div>
        <div class="card flex flex-col">
          <h3 class="mb-3">&bdquo;Noch l&auml;uft es. Aber ich mache mir Sorgen.&ldquo;</h3>
          <p class="text-sm mb-4" style="color:var(--grau)">Ihre K&uuml;che steht und f&auml;llt mit einer einzigen Person. Sichern Sie ihr Wissen, <strong style="color:var(--druck)">solange es noch im Haus ist.</strong></p>
          <a href="/system" data-cta-location="tuer-sorge" class="btn btn-secondary" style="margin-top:auto">Wissen sichern</a>
        </div>
        <div class="card flex flex-col">
          <h3 class="mb-3">&bdquo;Die Saison kommt.&ldquo;</h3>
          <p class="text-sm mb-4" style="color:var(--grau)">Zu wenig Leute f&uuml;r die Spitze. <strong style="color:var(--druck)">Saisonkr&auml;fte, die ab dem ersten Tag kochen wie Ihr Stammteam.</strong></p>
          <a href="/personal#anfrage" data-cta-location="tuer-saison" class="btn btn-secondary" style="margin-top:auto">Saison planen</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Warum Avorix (W4: H2 linksb&uuml;ndig) -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-8" style="color:var(--druck)">Warum Avorix</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="card">
          <h3 class="mb-3">Konsistente Qualit&auml;t</h3>
          <p class="text-sm" style="color:var(--grau)">Standardisierte Prozesse und die Avorix Koch-App sichern <strong style="color:var(--druck)">gleichbleibende Speisenqualit&auml;t, unabh&auml;ngig vom Erfahrungslevel</strong> Ihres K&uuml;chenteams.</p>
        </div>
        <div class="card">
          <h3 class="mb-3">Weniger Personalabh&auml;ngigkeit</h3>
          <p class="text-sm" style="color:var(--grau)"><strong style="color:var(--druck)">Das Wissen steckt im System, nicht mehr nur in einzelnen K&ouml;pfen.</strong> Avorix macht Ihren Betrieb unabh&auml;ngiger von einzelnen Schl&uuml;sselkr&auml;ften. Und neue Kr&auml;fte kochen vom ersten Tag an mit.</p>
        </div>
        <div class="card">
          <h3 class="mb-3">Volle Kostenkontrolle</h3>
          <p class="text-sm" style="color:var(--grau)">Rezeptbasierte Kalkulation, Wareneinsatz-Tracking und standardisierte Portionierung bringen <strong style="color:var(--druck)">Transparenz in Ihre K&uuml;chenkosten.</strong></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Erkl&auml;rung (W3: Split H2+Absatz links, Foto rechts) -->
 <section id="so-funktioniert-es" class="reveal section-gap">
    <div class="content-width split-row">
      <div class="split-copy">
        <h2 class="mb-4" style="color:var(--druck)">Was ist Avorix? In einer Minute erkl&auml;rt.</h2>
        <p class="max-w-[62ch]" style="color:var(--grau)">Stellen Sie sich ein Navi vor. Ein Navi bringt jeden Fahrer ans Ziel, auch wenn er die Strecke nicht kennt. Avorix macht dasselbe in Ihrer K&uuml;che: Es f&uuml;hrt Ihr Team Schritt f&uuml;r Schritt durch jedes Gericht Ihrer Karte, mit klaren Anleitungen, erprobten Abl&auml;ufen und echten K&ouml;chen, die Ihr Team anlernen. Damit jeder Teller so rausgeht, wie Sie es wollen. Jeden Tag.</p>
      </div>
      <div class="split-media">
        <Image
          src={waageZutaten}
          alt="Digitale Küchenwaage mit einer Schüssel geschnittenem Gemüse in einer Profiküche"
          widths={[480, 800, 1200, 1600]}
          sizes="(max-width: 900px) 100vw, 420px"
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
    <div class="content-width" style="margin-top:32px">
      <div class="grid md:grid-cols-3 gap-6">
        <div class="card">
          <div class="schritt-chip mb-3" aria-hidden="true">1</div>
          <h3 class="mb-3">Ihre Gerichte, glasklar aufgeschrieben.</h3>
          <p class="text-sm" style="color:var(--grau)">Ein erfahrener Avorix-Koch kommt in Ihren Betrieb und schreibt Ihre Karte auf. Jedes Gericht wird in einfache Schritte zerlegt, mit Fotos, genauen Mengen und Zeiten. Und ehrlich: Viele K&uuml;chen haben Rezepte, gekocht wird trotzdem nach Gef&uuml;hl. Mit der App h&auml;ngt das Rezept direkt am Posten, und der einfachste Weg ist der richtige.</p>
        </div>
        <div class="card">
          <div class="schritt-chip mb-3" aria-hidden="true">2</div>
          <h3 class="mb-3">Abl&auml;ufe, die auch ein kleines Team schafft.</h3>
          <p class="text-sm" style="color:var(--grau)">Vieles wird ruhig vorbereitet, wenn Zeit ist. Vakuumiert und gek&uuml;hlt. Im Service wird nur noch fertiggestellt. <strong style="color:var(--druck)">So stemmt eine kleine Mannschaft eine anspruchsvolle Karte</strong>, ohne dass die Qualit&auml;t leidet. Profik&uuml;chen arbeiten seit Jahren so.</p>
        </div>
        <div class="card">
          <div class="schritt-chip mb-3" aria-hidden="true">3</div>
          <h3 class="mb-3">Die Koch-App am Herd.</h3>
          <p class="text-sm" style="color:var(--grau)">Am Posten h&auml;ngt ein Tablet. Die App zeigt der K&uuml;chenkraft Schritt f&uuml;r Schritt, was zu tun ist: <strong style="color:var(--druck)">Foto, Menge, Zeit, fertig.</strong> Die App rechnet Portionen automatisch um und beh&auml;lt den Wareneinsatz im Blick.</p>
        </div>
      </div>
      <div class="mt-8 space-y-3" style="color:var(--grau)">
        <p class="max-w-[62ch]"><strong style="color:var(--druck)">Und Ihre Kosten?</strong> Ausgebildete K&ouml;che sind teuer, wenn Sie &uuml;berhaupt welche finden. Mit Avorix kochen angelernte Kr&auml;fte auf Ihrem Niveau, und Ihre Fachkr&auml;fte machen nur noch das, was wirklich ihr K&ouml;nnen braucht.</p>
        <p class="max-w-[62ch]"><strong style="color:var(--druck)">Software, Abl&auml;ufe und Personal aus einer Hand.</strong> Das gibt es so nur bei Avorix.</p>
      </div>
    </div>
  </section>

  <!-- AÜe-Block: Personal-Beweis (dunkle Sektion 3.10) -->
 <section class="reveal section-gap section-dunkel" style="background:var(--eisen)">
    <div class="content-width">
      <div class="mb-6">
        <Stempel class="stempel--hell">Gepr&uuml;ft &middot; A&Uuml;-Erlaubnis</Stempel>
      </div>
      <h2 class="mb-4" style="color:var(--papier)">
        Und wenn <span style="color:var(--akzent-hell)">Personal fehlt</span>?
      </h2>
      <p class="max-w-[62ch]" style="color:rgba(247,246,242,0.8)">
        Avorix hilft doppelt: sofort ein Koch, wenn Ihrer fehlt. Und ein System, damit es nie wieder so weit kommt. Unsere K&ouml;che sind bei uns <span style="color:var(--akzent-hell)">fest angestellt</span> und <span style="color:var(--akzent-hell)">rechtssicher</span> verliehen. F&uuml;r die Anlernphase, f&uuml;r die Saison oder f&uuml;r den Notfall.
      </p>
      <div class="mt-6">
        <a href="/personal#anfrage" data-cta-location="personal-dunkel" data-cta-event="cta_personal_click" class="btn btn-primary">Personal anfragen</a>
      </div>
    </div>
  </section>

  <!-- Ablauf -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-8" style="color:var(--druck)">So kommt Avorix in Ihren Betrieb. In vier Schritten.</h2>
      <div class="space-y-6">
        <div class="flex gap-4">
          <div class="schritt-chip shrink-0">1</div>
          <div>
            <h3>Wir schauen uns Ihre K&uuml;che an. (Kostenlos)</h3>
            <p class="text-sm mt-1 max-w-[62ch]" style="color:var(--grau)">Ein Gespr&auml;ch, 30 Minuten, per Video oder vor Ort. Sie erz&auml;hlen, wo es klemmt. Wir sagen ehrlich, ob Avorix zu Ihnen passt. Wenn nicht, sagen wir das auch.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="schritt-chip shrink-0">2</div>
          <div>
            <h3>Ein Avorix-Koch nimmt Ihre Karte auf.</h3>
            <p class="text-sm mt-1 max-w-[62ch]" style="color:var(--grau)">Er kocht mit Ihrem Team, dokumentiert jedes Gericht, fotografiert jeden Schritt und legt alles in der App an. Typischerweise dauert das eine Woche.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="schritt-chip shrink-0">3</div>
          <div>
            <h3>Ihr Team lernt das System.</h3>
            <p class="text-sm mt-1 max-w-[62ch]" style="color:var(--grau)">Daf&uuml;r gibt es zwei Wege, je nachdem was zu Ihrem Betrieb passt: kompakte Schulungstage mit einem Avorix-Koch, der sich ganz auf das Anlernen konzentriert. Oder ein Avorix-Koch arbeitet ganz normal in Ihrer K&uuml;che mit und bringt Ihrem Team das System nebenbei bei, w&auml;hrend er produktiv kocht. In beiden F&auml;llen mit mindestens Sous-Chef-Erfahrung.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="schritt-chip shrink-0">4</div>
          <div>
            <h3>Sie arbeiten selbstst&auml;ndig. Wir bleiben erreichbar.</h3>
            <p class="text-sm mt-1 max-w-[62ch]" style="color:var(--grau)">Ab jetzt f&uuml;hrt die App Ihr Team durch jeden Tag. Neue Gerichte pflegen Sie selbst ein oder wir &uuml;bernehmen das. Und wenn Ihnen ein Koch ausf&auml;llt, rufen Sie uns an.</p>
          </div>
        </div>
      </div>
      <p class="mt-8 font-bold" style="color:var(--druck)">Sie f&uuml;hren Ihre K&uuml;che. Nicht Ihre K&uuml;che Sie.</p>
      <div class="mt-6">
        <a href="/kontakt" data-cta-location="ablauf" class="btn btn-primary">Demo vereinbaren</a>
      </div>
    </div>
  </section>

  <!-- So sieht das am Herd aus -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-8" style="color:var(--druck)">So sieht das am Herd aus.</h2>
      <div class="grid md:grid-cols-3 gap-4">
        <Lightbox label="REZEPTSCHRITT" caption={`„Jeder Schritt mit Menge, Temperatur und Zeit. Zum Abhaken.“`} flach>
          <Image
            src={appKochmodus1}
            alt="Screenshot der Avorix Koch-App: Rezeptschritt im Koch-Modus mit Temperatur und Timer"
            widths={[480, 800]}
            sizes="(max-width: 768px) 90vw, (max-width: 1280px) 30vw, 360px"
            loading="lazy"
            decoding="async"
            class="w-full h-auto"
          />
        </Lightbox>
        <Lightbox label="PORTIONSRECHNER" caption={`„Heute 80 Gäste statt 60? Die App rechnet alle Mengen um.“`} flach>
          <Image
            src={appPortionsrechner}
            alt="Screenshot der Avorix Koch-App: Portionsrechner skaliert ein Rezept auf 80 Portionen"
            widths={[480, 800]}
            sizes="(max-width: 768px) 90vw, (max-width: 1280px) 30vw, 360px"
            loading="lazy"
            decoding="async"
            class="w-full h-auto"
          />
        </Lightbox>
        <Lightbox label="REZEPTBIBLIOTHEK" caption={`„Ihre ganze Karte an einem Ort. Für das ganze Team.“`}>
          <Image
            src={appRezepteListe}
            alt="Screenshot der Avorix Koch-App: Rezeptbibliothek mit Kategorien, Zeiten und Kosten pro Portion"
            widths={[480, 800]}

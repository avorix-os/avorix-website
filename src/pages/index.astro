---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image, getImage } from "astro:assets";
import Lightbox from "../components/Lightbox.astro";
import Stempel from "../components/Stempel.astro";
import kochAppTabletPass from "../assets/bilder/koeche-am-pass-mit-tablet.jpg";
import leerenPassMorgens from "../assets/bilder/leerer-pass-morgens.jpg";
import waageZutaten from "../assets/bilder/waage-zutaten.jpg";
import appKochmodus1 from "../assets/bilder/app-kochmodus-schritt1.png";
import appPortionsrechner from "../assets/bilder/app-rezept-detail-portionsrechner.png";
import appRezepteListe from "../assets/bilder/app-rezepte-liste.png";

const ogImg = await getImage({ src: kochAppTabletPass, width: 1200, format: "jpeg" });
const ogImageAlt = "Zwei Köche am Pass einer Profiküche, davor ein Tablet mit der Avorix Koch-App";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": ["Organization", "EmploymentAgency"],
    "@id": "https://avorix.de/#organization",
    "name": "AVORIX GmbH",
    "legalName": "AVORIX GmbH",
    "alternateName": "Avorix",
    "url": "https://avorix.de/",
    "logo": {
      "@type": "ImageObject",
      "url": "https://avorix.de/avorix-logo-quadrat-dunkel.png",
      "width": 1024,
      "height": 1024
    },
    "image": "https://avorix.de/avorix-logo-quadrat-dunkel.png",
    "description": "Festangestellte Köche, wenn Ihrer fehlt, in der Regel innerhalb von 24 bis 72 Stunden. Dazu Koch-App und Schulung, damit Ihre Küche Ihr Niveau hält.",
    "telephone": "+49 7541 3973915",
    "email": "info@avorix.de",
    "founder": {
      "@type": "Person",
      "@id": "https://avorix.de/ueber-uns/#boerge-penk",
      "name": "Börge Penk"
    },
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Fallenbrunnen 14",
      "postalCode": "88045",
      "addressLocality": "Friedrichshafen",
      "addressCountry": "DE"
    },
    "areaServed": ["DE", "AT"],
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "08:00",
      "closes": "17:00"
    },
    "hasMap": "https://maps.google.com/?cid=3756241428225524465",
    "vatID": "DE368762673",
    "identifier": {
      "@type": "PropertyValue",
      "propertyID": "Handelsregister",
      "value": "HRB 751118, Amtsgericht Ulm"
    },
    "sameAs": [
      "https://maps.google.com/?cid=3756241428225524465",
      "https://www.linkedin.com/company/avorix-gmbh/",
      "https://www.provenexpert.com/de-de/avorix-personalloesungen/"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "SpeakableSpecification",
    "cssSelector": "#direktantwort"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Wer tippt unsere Rezepte ein?",
        "acceptedAnswer": { "@type": "Answer", "text": "Wir. Ein Avorix-Koch kommt zu Ihnen, kocht mit Ihrem Team und legt jedes Gericht in der App an. Sie müssen nichts selbst einpflegen." }
      },
      {
        "@type": "Question",
        "name": "Merken unsere Gäste etwas davon?",
        "acceptedAnswer": { "@type": "Answer", "text": "Nein. Ihre Gäste erleben Ihre Küche und Ihre Rezepte, nur eben verlässlich in gleicher Qualität. Auf Wunsch sichern wir Ihnen vertraglich zu, dass wir Ihren Betrieb nirgends als Referenz nennen." }
      },
      {
        "@type": "Question",
        "name": "Unser Team ist nicht besonders technikaffin. Klappt das trotzdem?",
        "acceptedAnswer": { "@type": "Answer", "text": "Ja, dafür ist die App gebaut. Wer ein Foto ansehen und einen Haken setzen kann, kann mit ihr arbeiten. Geschult wird direkt am Herd, nicht im Seminarraum." }
      },
      {
        "@type": "Question",
        "name": "Was passiert mit unseren Rezepten? Wem gehören die?",
        "acceptedAnswer": { "@type": "Answer", "text": "Ihnen. Ihre Rezepte bleiben Ihr Eigentum und werden nicht an andere Betriebe weitergegeben." }
      },
      {
        "@type": "Question",
        "name": "Wie schnell sind wir startklar?",
        "acceptedAnswer": { "@type": "Answer", "text": "Vom Erstgespräch bis zum eigenständigen Arbeiten vergehen je nach Karte typischerweise wenige Wochen. Den genauen Fahrplan bekommen Sie nach dem Erstgespräch." }
      },
      {
        "@type": "Question",
        "name": "Welche Technik brauchen wir in der Küche?",
        "acceptedAnswer": { "@type": "Answer", "text": "Ein Tablet oder Smartphone und eine Internetverbindung. Mehr nicht. Die App läuft im Browser, es muss nichts installiert werden." }
      },
      {
        "@type": "Question",
        "name": "Ersetzt das unseren Küchenchef?",
        "acceptedAnswer": { "@type": "Answer", "text": "Nein. Ein guter Küchenchef wird mit Avorix besser, weil sein Wissen endlich festgehalten ist und sein Team selbstständiger arbeitet. Avorix hilft vor allem dann, wenn der Küchenchef fehlt, ausfällt oder wechselt." }
      },
      {
        "@type": "Question",
        "name": "Wir sind in Österreich. Geht das?",
        "acceptedAnswer": { "@type": "Answer", "text": "Ja, wir arbeiten in Deutschland und Österreich." }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "url": "https://avorix.de/",
    "primaryImageOfPage": {
      "@type": "ImageObject",
      "url": `https://avorix.de${ogImg.src}`,
      "description": ogImageAlt
    }
  }
];
---

<BaseLayout
  title="Küchenpersonal, Koch-App und Schulung für Hotels"
  description="Festangestellte Köche, wenn Ihrer fehlt, in der Regel innerhalb von 24 bis 72 Stunden. Dazu Koch-App und Schulung, damit Ihre Küche Ihr Niveau hält."
  ogImage={ogImg.src}
  ogImageAlt={ogImageAlt}
  schemaOrg={schema}
>
  {/* D0 Hero: Foto randabfallend rechts, Text links an der Inhaltskante */}
  <section class="home-hero">
    <div class="home-hero-grid">
      <div class="home-hero-copy">
        <p class="eyebrow mb-4">K&uuml;chenpersonal &amp; Koch-App</p>
        <h1>
          Ihre K&uuml;che <mark>h&auml;lt Ihr Niveau.</mark><br />Auch wenn der Spitzenkoch fehlt.
        </h1>
        <p class="lead">
          Avorix hilft doppelt: sofort ein Koch, wenn Ihrer fehlt. Und ein System, damit es nie wieder so weit kommt.
        </p>
        <div class="hero-buttons">
          <a href="/personal#anfrage" data-cta-location="hero" data-cta-event="cta_personal_click" class="btn btn-primary">Personal anfragen</a>
          <a href="/kontakt" data-cta-location="hero" class="btn btn-secondary">App-Demo vereinbaren</a>
        </div>
        <div class="hero-beleg">
          <Stempel />
          <div class="hero-beleg-text">
            <span>Von K&ouml;chen entwickelt, nicht von Software-Leuten</span>
            <span>Friedrichshafen am Bodensee &middot; DE + AT</span>
          </div>
        </div>
      </div>
      <div class="home-hero-media">
        <Image
          src={kochAppTabletPass}
          alt="Zwei K&ouml;che von hinten am Pass einer Profik&uuml;che, dazwischen ein Tablet mit der laufenden Avorix Koch-App"
          widths={[480, 800, 1200, 1600, 2000]}
          sizes="(max-width: 900px) 100vw, 50vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  {/* D1 Einordnung (GEO) */}
  <section class="reveal section-gap">
    <div class="content-width linie-oben">
      <p id="direktantwort" class="einordnung-text">Avorix ist ein K&uuml;chensystem f&uuml;r Hotels und Gastronomie aus Friedrichshafen am Bodensee. Es verleiht festangestellte K&ouml;che mit beh&ouml;rdlicher Arbeitnehmer&uuml;berlassungserlaubnis und verbindet das mit einer Koch-App f&uuml;r gef&uuml;hrtes Arbeiten, die K&uuml;chenteams Schritt f&uuml;r Schritt durch jedes Gericht f&uuml;hrt, und mit Schulung durch erfahrene K&ouml;che. Avorix arbeitet in Deutschland und &Ouml;sterreich.</p>
    </div>
  </section>

  {/* D2 Problem: Text + Bild, darunter Liste mit Linien */}
  <section class="reveal section-gap">
    <div class="content-width">
      <div class="schmerz-top">
        <div>
          <h2>Kommt Ihnen das bekannt vor?</h2>
          <p class="lead">Ihre K&uuml;che steht und f&auml;llt mit einer einzigen Person.</p>
          <p class="schmerz-absatz">Wenn die K&uuml;che wackelt, wackelt alles: <strong>erst die Qualit&auml;t, dann die Bewertungen, dann der Ruf.</strong> Und irgendwann steht die Frage im Raum, wie lange es so noch weitergeht. Damit sind Sie nicht allein: Fachkr&auml;ftemangel in der K&uuml;che ist in fast jedem Betrieb ein Thema.</p>
        </div>
        <div class="schmerz-bild">
          <Image
            src={leerenPassMorgens}
            alt="Leere Hotelküche am Morgen vor dem Service"
            widths={[480, 800, 1200, 1600]}
            sizes="(max-width: 900px) 100vw, 520px"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
      <ul class="schmerz-liste">
        <li>
          <h3>Der K&uuml;chenchef k&uuml;ndigt. Oder der Souschef. Mitten in der Saison.</h3>
          <p>Mit jeder Schl&uuml;sselkraft geht Wissen: die Rezepte, die Mengen, die Abl&auml;ufe. Der Rest des Teams steht da und improvisiert.</p>
        </li>
        <li>
          <h3>Jeder kocht anders.</h3>
          <p>Montag schmeckt das Schnitzel anders als Freitag. Die Portionen schwanken. Stammg&auml;ste merken das zuerst.</p>
        </li>
        <li>
          <h3>Sie finden schlicht niemanden.</h3>
          <p>Auf Ihre Stellenanzeige meldet sich niemand, der kochen kann. Und wenn doch, ist er nach einer Saison wieder weg.</p>
        </li>
      </ul>
    </div>
  </section>

  {/* D3 Wo stehen Sie: die einzigen Karten der Seite (section-band) */}
  <section class="reveal section-gap section-band">
    <div class="content-width">
      <h2>Wo stehen Sie gerade?</h2>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">
        <div class="card tuer-card">
          <h3>&bdquo;Der Notfall ist da.&ldquo;</h3>
          <p>Der Koch ist weg, die Saison l&auml;uft. Wir schicken Ihnen einen Koch. Und sorgen daf&uuml;r, dass Sie nie wieder einen suchen m&uuml;ssen.</p>
          <a href="/personal#anfrage" data-cta-location="tuer-notfall" data-cta-event="cta_personal_click" class="btn btn-primary tuer-btn">Jetzt Hilfe holen</a>
        </div>
        <div class="card tuer-card">
          <h3>&bdquo;Noch l&auml;uft es. Aber ich mache mir Sorgen.&ldquo;</h3>
          <p>Ihre K&uuml;che steht und f&auml;llt mit einer einzigen Person. Sichern Sie ihr Wissen, solange es noch im Haus ist.</p>
          <a href="/system" data-cta-location="tuer-sorge" class="btn btn-secondary tuer-btn">Wissen sichern</a>
        </div>
        <div class="card tuer-card">
          <h3>&bdquo;Die Saison kommt.&ldquo;</h3>
          <p>Zu wenig Leute f&uuml;r die Spitze. Saisonkr&auml;fte, die ab dem ersten Tag kochen wie Ihr Stammteam.</p>
          <a href="/personal#anfrage" data-cta-location="tuer-saison" class="btn btn-secondary tuer-btn">Saison planen</a>
        </div>
      </div>
    </div>
  </section>

  {/* D4 Warum Avorix: drei Spalten mit Linie oben */}
  <section class="reveal section-gap">
    <div class="content-width">
      <h2>Warum Avorix</h2>
      <div class="warum-spalten">
        <div class="spalte-linie">
          <h3>Konsistente Qualit&auml;t</h3>
          <p>Standardisierte Prozesse und die Avorix Koch-App sichern gleichbleibende Speisenqualit&auml;t, unabh&auml;ngig vom Erfahrungslevel Ihres K&uuml;chenteams.</p>
        </div>
        <div class="spalte-linie">
          <h3>Weniger Personalabh&auml;ngigkeit</h3>
          <p>Das Wissen steckt im System, nicht mehr nur in einzelnen K&ouml;pfen. Avorix macht Ihren Betrieb unabh&auml;ngiger von einzelnen Schl&uuml;sselkr&auml;ften. Und neue Kr&auml;fte kochen vom ersten Tag an mit.</p>
        </div>
        <div class="spalte-linie">
          <h3>Volle Kostenkontrolle</h3>
          <p>Rezeptbasierte Kalkulation, Wareneinsatz-Tracking und standardisierte Portionierung bringen Transparenz in Ihre K&uuml;chenkosten.</p>
        </div>
      </div>
    </div>
  </section>

  {/* D5 Was ist Avorix: Linie oben, Text + Foto, darunter drei Schritte */}
  <section id="so-funktioniert-es" class="reveal section-gap">
    <div class="content-width linie-oben">
      <div class="was-top">
        <div>
          <h2>Was ist Avorix? In einer Minute erkl&auml;rt.</h2>
          <p class="lead">Software, Abl&auml;ufe und Personal aus einer Hand. Das gibt es so nur bei Avorix.</p>
          <p class="was-absatz">Stellen Sie sich ein Navi vor. Ein Navi bringt jeden Fahrer ans Ziel, auch wenn er die Strecke nicht kennt. Avorix macht dasselbe in Ihrer K&uuml;che: Es f&uuml;hrt Ihr Team Schritt f&uuml;r Schritt durch jedes Gericht Ihrer Karte, mit klaren Anleitungen, erprobten Abl&auml;ufen und echten K&ouml;chen, die Ihr Team anlernen. Damit jeder Teller so rausgeht, wie Sie es wollen. Jeden Tag. Wir nennen das gef&uuml;hrtes Arbeiten.</p>
        </div>
        <div class="was-bild">
          <Image
            src={waageZutaten}
            alt="Digitale Küchenwaage mit einer Schüssel geschnittenem Gemüse in einer Profiküche"
            widths={[480, 800, 1200, 1600]}
            sizes="(max-width: 900px) 100vw, 420px"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
      <div class="was-schritte">
        <div class="spalte-linie">
          <p class="schritt-label">Schritt 1</p>
          <h3>Ihre Gerichte, glasklar aufgeschrieben.</h3>
          <p>Ein erfahrener Avorix-Koch kommt in Ihren Betrieb und schreibt Ihre Karte auf. Jedes Gericht wird in einfache Schritte zerlegt, mit Fotos, genauen Mengen und Zeiten. Und ehrlich: Viele K&uuml;chen haben Rezepte, gekocht wird trotzdem nach Gef&uuml;hl. Mit der App h&auml;ngt das Rezept direkt am Posten, und der einfachste Weg ist der richtige.</p>
        </div>
        <div class="spalte-linie">
          <p class="schritt-label">Schritt 2</p>
          <h3>Abl&auml;ufe, die auch ein kleines Team schafft.</h3>
          <p>Vieles wird ruhig vorbereitet, wenn Zeit ist. Vakuumiert und gek&uuml;hlt. Im Service wird nur noch fertiggestellt. So stemmt eine kleine Mannschaft eine anspruchsvolle Karte, ohne dass die Qualit&auml;t leidet. Profik&uuml;chen arbeiten seit Jahren so.</p>
        </div>
        <div class="spalte-linie">
          <p class="schritt-label">Schritt 3</p>
          <h3>Die Koch-App am Herd.</h3>
          <p>Am Posten h&auml;ngt ein Tablet. Die App zeigt der K&uuml;chenkraft Schritt f&uuml;r Schritt, was zu tun ist: Foto, Menge, Zeit, fertig. Die App rechnet Portionen automatisch um und beh&auml;lt den Wareneinsatz im Blick.</p>
        </div>
      </div>
      <p class="was-kosten"><strong>Und Ihre Kosten?</strong> Ausgebildete K&ouml;che sind teuer, wenn Sie &uuml;berhaupt welche finden. Mit Avorix kochen angelernte Kr&auml;fte auf Ihrem Niveau, und Ihre Fachkr&auml;fte machen nur noch das, was wirklich ihr K&ouml;nnen braucht.</p>
    </div>
  </section>

  {/* D6 Und wenn Personal fehlt? (dunkler Block, zwei Spalten, ohne Siegel) */}
  <section class="reveal section-gap section-dunkel">
    <div class="content-width">
      <div class="dunkel-grid">
        <h2>Und wenn <span>Personal fehlt</span>?</h2>
        <div>
          <p class="dunkel-absatz">Avorix hilft doppelt: sofort ein Koch, wenn Ihrer fehlt. Und ein System, damit es nie wieder so weit kommt. Unsere K&ouml;che sind bei uns <span class="dunkel-hell">fest angestellt</span> und <span class="dunkel-hell">rechtssicher</span> verliehen. F&uuml;r die Anlernphase, f&uuml;r die Saison oder f&uuml;r den Notfall.</p>
          <a href="/personal#anfrage" data-cta-location="personal-dunkel" data-cta-event="cta_personal_click" class="btn btn-primary">Personal anfragen</a>
        </div>
      </div>
    </div>
  </section>

  {/* D7 So kommt Avorix in Ihren Betrieb: Bon (section-band) */}
  <section class="reveal section-gap section-band">
    <div class="content-width">
      <div class="bon-layout">
        <div class="bon-copy">
          <h2>So kommt Avorix in Ihren Betrieb. In vier Schritten.</h2>
          <a href="/kontakt" data-cta-location="ablauf" class="btn btn-primary bon-cta">App-Demo vereinbaren</a>
        </div>
        <div class="bon-wrap">
          <div class="bon">
            <div aria-hidden="true">
              <p class="bon-kopf"><span>AVORIX</span><span>IHR START</span></p>
              <p class="bon-unterkopf"><span>Friedrichshafen</span><span>4 Schritte</span></p>
              <hr />
            </div>
            <ol>
              <li><div><b>Wir schauen uns Ihre K&uuml;che an. (Kostenlos)</b><span>Ein Gespr&auml;ch, 30 Minuten, per Video oder vor Ort. Sie erz&auml;hlen, wo es klemmt. Wir sagen ehrlich, ob Avorix zu Ihnen passt. Wenn nicht, sagen wir das auch.</span></div></li>
              <li><div><b>Ein Avorix-Koch nimmt Ihre Karte auf.</b><span>Er kocht mit Ihrem Team, dokumentiert jedes Gericht, fotografiert jeden Schritt und legt alles in der App an. Typischerweise dauert das eine Woche.</span></div></li>
              <li><div><b>Ihr Team lernt das System.</b><span>Daf&uuml;r gibt es zwei Wege, je nachdem was zu Ihrem Betrieb passt: kompakte Schulungstage mit einem Avorix-Koch, der sich ganz auf das Anlernen konzentriert. Oder ein Avorix-Koch arbeitet ganz normal in Ihrer K&uuml;che mit und bringt Ihrem Team das System nebenbei bei, w&auml;hrend er produktiv kocht. In beiden F&auml;llen mit mindestens Sous-Chef-Erfahrung.</span></div></li>
              <li><div><b>Sie arbeiten selbstst&auml;ndig. Wir bleiben erreichbar.</b><span>Ab jetzt f&uuml;hrt die App Ihr Team durch jeden Tag. Neue Gerichte pflegen Sie selbst ein oder wir &uuml;bernehmen das. Und wenn Ihnen ein Koch ausf&auml;llt, rufen Sie uns an.</span></div></li>
            </ol>
            <hr />
            <p class="bon-fuss">Sie f&uuml;hren Ihre K&uuml;che.<br />Nicht Ihre K&uuml;che Sie.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* D8 So sieht das am Herd aus: drei Screenshots ohne Karte, dunkler Grund */}
  <section class="reveal section-gap">
    <div class="content-width">
      <h2>So sieht das am Herd aus.</h2>
      <div class="herd-grid grid sm:grid-cols-2 md:grid-cols-3 gap-4">
        <Lightbox label="REZEPTSCHRITT" caption={`„Jeder Schritt mit Menge, Temperatur und Zeit. Zum Abhaken.“`} flach>
          <Image
            src={appKochmodus1}
            alt="Screenshot der Avorix Koch-App: Rezeptschritt im Koch-Modus mit Temperatur und Timer"
            widths={[480, 800]}
            sizes="(max-width: 768px) 90vw, (max-width: 1280px) 30vw, 360px"
            loading="lazy"
            decoding="async"
            class="w-full h-auto"
          />
        </Lightbox>
        <Lightbox label="PORTIONSRECHNER" caption={`„Heute 80 Gäste statt 60? Die App rechnet alle Mengen um.“`} flach>
          <Image
            src={appPortionsrechner}
            alt="Screenshot der Avorix Koch-App: Portionsrechner skaliert ein Rezept auf 80 Portionen"
            widths={[480, 800]}
            sizes="(max-width: 768px) 90vw, (max-width: 1280px) 30vw, 360px"
            loading="lazy"
            decoding="async"
            class="w-full h-auto"
          />
        </Lightbox>
        <Lightbox label="REZEPTBIBLIOTHEK" caption={`„Ihre ganze Karte an einem Ort. Für das ganze Team.“`} flach>
          <Image
            src={appRezepteListe}
            alt="Screenshot der Avorix Koch-App: Rezeptbibliothek mit Kategorien, Zeiten und Kosten pro Portion"
            widths={[480, 800]}
            sizes="(max-width: 768px) 90vw, (max-width: 1280px) 30vw, 360px"
            loading="lazy"
            decoding="async"
            class="w-full h-auto"
          />
        </Lightbox>
      </div>
      <p class="herd-hinweis">Die App l&auml;uft auf Tablet und Smartphone, direkt im Browser. Es muss nichts installiert werden.</p>
    </div>
  </section>

  {/* D9 Wir leihen Ihnen unsere Köche: Linie oben, zwei Spalten, ohne Kasten */}
  <section class="reveal section-gap">
    <div class="content-width linie-oben">
      <div class="leihen-grid">
        <h2>Und wenn Personal fehlt: Wir leihen Ihnen unsere K&ouml;che. Rechtssicher.</h2>
        <div>
          <p class="leihen-p">Viele Anbieter schicken Ihnen &bdquo;selbstst&auml;ndige&ldquo; K&ouml;che mit Rechnung. Das Problem: Bei einer Pr&uuml;fung stuft die Rentenversicherung diese K&ouml;che oft als scheinselbstst&auml;ndig ein. Dann zahlt nicht der Koch, sondern Ihr Haus. Nachforderungen &uuml;ber mehrere Jahre, schnell im hohen f&uuml;nfstelligen Bereich.</p>
          <p class="leihen-p">Unsere K&ouml;che sind bei uns fest angestellt und sozialversichert. Wir haben die beh&ouml;rdliche Arbeitnehmer&uuml;berlassungserlaubnis. Sie bekommen K&ouml;nnen in die K&uuml;che und bleiben auf der sicheren Seite.</p>
          <p class="leihen-p leihen-fett">Im Gastgewerbe haben nur wenige Anbieter diese Erlaubnis. Fragen Sie danach, bevor Sie irgendwo buchen. Auch wenn es nicht bei uns ist.</p>
          <a href="/personal" data-cta-location="rechtssicherheit" class="btn btn-secondary">Mehr zu Schulung und Personal</a>
        </div>
      </div>
    </div>

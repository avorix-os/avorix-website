---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image, getImage } from "astro:assets";
import Stempel from "../components/Stempel.astro";
import schulungVonHinten from "../assets/bilder/schulung-von-hinten.jpg";
import anrichtenHaende from "../assets/bilder/anrichten-haende.jpg";

const ogImg = await getImage({ src: schulungVonHinten, width: 1200, format: "jpeg" });
const ogImageAlt = "Zwei Köche von hinten am Herd, einer erklärt einen Arbeitsschritt";

const schemaOrg = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Avorix",
        "item": "https://avorix.cloud/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Die Schulung",
        "item": "https://avorix.cloud/schulung"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Küchen-Schulung durch Avorix-Köche",
    "description": "Ein Avorix-Koch mit Sous-Chef-Erfahrung nimmt Ihre Karte auf und lernt Ihr Team an, direkt am Herd. Als Schulungsblock oder live im Betrieb.",
    "provider": {
      "@type": "Organization",
      "name": "Avorix GmbH",
      "url": "https://avorix.cloud",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Friedrichshafen",
        "addressCountry": "DE"
      },
      "founder": {
        "@type": "Person",
        "name": "Avorix"
      },
      "areaServed": {
        "@type": "Country",
        "name": "DE"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Wer sind die Avorix-Köche?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Fest angestellte Profis mit Berufserfahrung in Hotel- und Restaurantküchen. Wer bei uns schult, hat mindestens Sous-Chef-Erfahrung."
        }
      },
      {
        "@type": "Question",
        "name": "Was ist, wenn der Koch nicht zu unserem Team passt?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Dann sprechen Sie mit uns, und wir finden eine Lösung. Es bringt niemandem etwas, wenn die Chemie nicht stimmt."
        }
      },
      {
        "@type": "Question",
        "name": "Wie schnell ist mein Team fit?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Wer eine Woche mit der App gekocht hat, braucht sie nicht mehr erklärt zu bekommen. Für eine typische Karte rechnen Sie mit zwei Blöcken."
        }
      },
      {
        "@type": "Question",
        "name": "Arbeiten die Köche mit der Koch-App?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja. Dadurch hinterlässt jeder Einsatz dokumentiertes Wissen in Ihrer Küche."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "url": "https://avorix.cloud/schulung",
    "primaryImageOfPage": {
      "@type": "ImageObject",
      "url": `https://avorix.cloud${ogImg.src}`,
      "description": ogImageAlt
    }
  }
];
---

<BaseLayout
  title="K&uuml;chen-Schulung durch erfahrene K&ouml;che"
  description="Ein Avorix-Koch mit Sous-Chef-Erfahrung nimmt Ihre Karte auf und lernt Ihr Team an, direkt am Herd. Als Schulungsblock oder live im Betrieb."
  ogImage={ogImg.src}
  ogImageAlt={ogImageAlt}
  schemaOrg={schemaOrg}
>

  <!-- Hero (W2: Split 55/45, Bild rechts) -->
 <section class="hero-section px-6" style="background:var(--papier)">
    <div class="content-width hero-grid">
      <div class="hero-copy">
        <p class="eyebrow mb-4">Modul: Die Schulung</p>
        <h1 class="mb-6">
          Ihr Team lernt <mark style="white-space:nowrap">unser System</mark>. Von K&ouml;chen, die es selbst k&ouml;nnen.
        </h1>
        <p class="lead mb-6 max-w-[62ch]" style="color:var(--grau)">
          Ein Avorix-Koch mit mindestens Sous-Chef-Erfahrung nimmt Ihre Karte auf, legt sie in der Koch-App an und lernt Ihr Team an, direkt am Herd, nicht im Seminarraum.
        </p>
        <div class="flex flex-wrap gap-4 mb-6">
          <a href="/kontakt" data-cta-location="schulung-hero" class="btn btn-primary">Demo vereinbaren</a>
          <a href="/personal#anfrage" data-cta-location="schulung-hero" data-cta-event="cta_personal_click" class="btn btn-secondary">Personal anfragen</a>
        </div>
        <div class="hero-badges">
          <Stempel>Gepr&uuml;ft &middot; A&Uuml;-Erlaubnis</Stempel>
        </div>
      </div>
      <div class="hero-media">
        <Image
          src={schulungVonHinten}
          alt="Zwei K&ouml;che von hinten am Herd, einer erkl&auml;rt einen Arbeitsschritt"
          widths={[480, 800, 1200]}
          sizes="(max-width: 900px) 100vw, 528px"
          loading="eager"
          fetchpriority="high"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Zwei Wege -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-10 md:mb-16" style="color:var(--druck)">
        Anlernen, wie es zu Ihrem Betrieb passt.
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
        <!-- Weg 1 -->
        <div class="card">
          <div class="mb-4">
            <span class="schritt-chip">1</span>
          </div>
          <h3 class="mb-4">Weg 1: Die Block-Schulung</h3>
          <p class="leading-relaxed" style="color:var(--grau)">
            Ein Avorix-Koch kommt f&uuml;r einen Block zu Ihnen: f&uuml;nf Tage mit je sechs Stunden. Er konzentriert sich ganz auf Ihre K&uuml;che, nimmt die Karte auf, dokumentiert, fotografiert und lernt Ihr Team an. Er kocht in dieser Zeit nicht im Service mit, seine ganze Aufmerksamkeit geh&ouml;rt dem Anlernen. F&uuml;r eine typische Karte rechnen Sie mit zwei Bl&ouml;cken: erst Aufnahme und Dokumentation, dann die reine Schulung mit dem fertigen Material.
          </p>
        </div>
        <!-- Weg 2 -->
        <div class="card">
          <div class="mb-4">
            <span class="schritt-chip">2</span>
          </div>
          <h3 class="mb-4">Weg 2: Die Live-Schulung</h3>
          <p class="leading-relaxed" style="color:var(--grau)">
            Ein Avorix-Koch arbeitet ganz normal in Ihrer K&uuml;che mit, macht Bons fertig und produziert, und lernt Ihr Team nebenbei an, mitten im echten Betrieb. Sie bezahlen einen produktiven Koch und bekommen die Schulung dazu.
          </p>
        </div>
      </div>
      <p class="text-sm mt-8 max-w-[62ch]" style="color:var(--grau)">
        <strong>F&uuml;r beide Wege gilt:</strong> Der Avorix-Koch hat mindestens Sous-Chef-Erfahrung. Es schult niemand, der es nicht selbst jeden Tag kann.
      </p>
    </div>
  </section>

  <!-- Am Herd -->
 <section class="reveal section-gap" style="background:var(--papier)">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">
        Am Herd. Im echten Betrieb. Mit Ihrem eigenen Essen.
      </h2>
      <p class="lead mb-6 max-w-[62ch]" style="color:var(--grau)">
        Geschult wird nicht mit Beispielrezepten, sondern mit Ihrer Karte. Ihr Team lernt genau die Gerichte, die es ab morgen kocht, mit der App, die ab morgen am Posten h&auml;ngt. Wer eine Woche so gearbeitet hat, braucht keine Erkl&auml;rung mehr.
      </p>
      <Image
        src={anrichtenHaende}
        alt="Koch richtet ein Gericht mit einer Anrichtepinzette an, Blick &uuml;ber die Schulter"
        widths={[480, 800, 1200, 1600]}
        sizes="(max-width: 1024px) 100vw, 1080px"
        loading="lazy"
        decoding="async"
        class="w-full object-cover mb-8"
        style="height:360px;border-radius:var(--radius);box-shadow:var(--schatten)"
      />
      <p class="leading-relaxed mb-8 max-w-[62ch]" style="color:var(--grau)">
        <strong>Und wenn w&auml;hrend der Schulung Personal fehlt:</strong> Daf&uuml;r gibt es unser Personal-Modul, festangestellte K&ouml;che, rechtssicher verliehen.
      </p>
      <a
        href="/personal"
        data-cta-location="schulung-personal-link"
        class="inline-flex items-center gap-2 font-semibold"
        style="color:var(--akzent);min-height:44px;padding-block:10px"
      >
        Zum Personal-Modul
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </section>

  <!-- Was kostet das -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Was kostet das?</h2>
      <div class="card card-text">
        <p class="leading-relaxed mb-6" style="color:var(--grau)">
          Klare Stundens&auml;tze und Blockpreise, ohne versteckte Posten. Die Zahlen bekommen Sie im Erstgespr&auml;ch schwarz auf wei&szlig;. F&uuml;r die ersten Betriebe gelten 2026 Pilotkonditionen deutlich unter dem regul&auml;ren Preis.
        </p>
        <a
          href="/kontakt"
          data-cta-location="schulung-kosten"
          class="btn btn-primary"
        >Demo vereinbaren</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
 <section class="reveal section-gap" style="background:var(--papier)">
    <div class="content-width">
      <h2 class="mb-10" style="color:var(--druck)">H&auml;ufige Fragen</h2>
      <div class="faq-list">
        <details class="faq-item" open>
          <summary class="faq-q">Wer sind die Avorix-K&ouml;che?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Fest angestellte Profis mit Berufserfahrung in Hotel- und Restaurantk&uuml;chen. Wer bei uns schult, hat mindestens Sous-Chef-Erfahrung.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Was ist, wenn der Koch nicht zu unserem Team passt?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Dann sprechen Sie mit uns, und wir finden eine L&ouml;sung. Es bringt niemandem etwas, wenn die Chemie nicht stimmt.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Wie schnell ist mein Team fit?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Wer eine Woche mit der App gekocht hat, braucht sie nicht mehr erkl&auml;rt zu bekommen. F&uuml;r eine typische Karte rechnen Sie mit zwei Bl&ouml;cken.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Arbeiten die K&ouml;che mit der Koch-App?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Ja. Dadurch hinterl&auml;sst jeder Einsatz dokumentiertes Wissen in Ihrer K&uuml;che.</p></div></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Final CTA → Peak-End (3.18) -->
 <section class="reveal section-gap">
    <div class="content-width text-center">
      <div class="mb-6">
        <Stempel>Gepr&uuml;ft &middot; A&Uuml;-Erlaubnis</Stempel>
      </div>
      <p class="mb-6" style="font-family:Charter, Georgia, serif; font-style:italic; font-size:24px; color:var(--druck)">Es ist geregelt.</p>
      <a
        href="/kontakt"
        data-cta-location="schulung-final"
        class="btn btn-primary"
      >Demo vereinbaren</a>
    </div>
  </section>
</BaseLayout>

<script>
/* FAQ-Schlie&szlig;-Animation &mdash; progressive enhancement */
document.querySelectorAll('.faq-item').forEach(function(item) {
  var summary = item.querySelector('summary');
  if (!summary) return;
  summary.addEventListener('click', function(e) {
    if (!item.open) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    e.preventDefault();
    item.classList.add('faq-closing');
    var body = item.querySelector('.faq-body');
    if (!body) { item.classList.remove('faq-closing'); item.removeAttribute('open'); return; }
    body.addEventListener('transitionend', function handler() {
      body.removeEventListener('transitionend', handler);
      item.classList.remove('faq-closing');
      item.removeAttribute('open');
    });
  });
});
</script>

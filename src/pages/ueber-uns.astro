---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image, getImage } from "astro:assets";
import Stempel from "../components/Stempel.astro";
import vakuumbeutelKuehlhaus from "../assets/bilder/vakuumbeutel-kuehlhaus.jpg";
import boergeKueche from "../assets/bilder/boerge-kueche.jpg";

const ogImg = await getImage({ src: vakuumbeutelKuehlhaus, width: 1200, format: "jpeg" });
const ogImageAlt = "Beschriftete Vakuumbeutel mit vorbereiteten Zutaten im Kühlraum einer Profiküche";

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Startseite",
      "item": "https://avorix.de/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Über uns",
      "item": "https://avorix.de/ueber-uns"
    }
  ]
};
---

<BaseLayout
  title="Über Avorix: von einem Küchenchef gebaut"
  description="Avorix ist aus der Praxis entstanden: erst Köche, dann Abläufe, dann die App. Das Team und die Geschichte hinter dem System."
  ogImage={ogImg.src}
  ogImageAlt={ogImageAlt}
  schemaOrg={[
    breadcrumb,
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "url": "https://avorix.de/ueber-uns",
      "primaryImageOfPage": {
        "@type": "ImageObject",
        "url": `https://avorix.de${ogImg.src}`,
        "description": ogImageAlt
      }
    }
  ]}
>

  <!-- Hero (W2: Text-Hero, linksbündig) -->
 <section class="hero-section px-6" style="background:var(--papier)">
    <div class="content-width">
      <p class="eyebrow mb-4">&Uuml;ber uns</p>
      <h1 class="mb-6">Von einem <mark>K&uuml;chenchef</mark> gebaut. Nicht von Software-Leuten.</h1>
      <p class="lead max-w-[62ch]" style="color:var(--grau)">Avorix ist aus der Praxis entstanden: aus echten K&uuml;chen, echten Dienstpl&auml;nen und dem t&auml;glichen Kampf um gutes Personal.</p>
      <p class="mt-6 max-w-[62ch]" style="color:var(--grau)">Wir kennen das. Wir haben selbst in solchen K&uuml;chen gestanden.</p>
    </div>
  </section>

  <!-- Gründer (W4: 7/12 Absatz + 5/12 Pull-Quote) -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Der Mann hinter dem System.</h2>
      <div class="gruender-grid">
        <div>
          <p class="max-w-[62ch]" style="color:var(--grau)">B&ouml;rge Penk hat 20 Jahre in Profik&uuml;chen gearbeitet, vom Auszubildenden bis zum K&uuml;chenchef mit gro&szlig;en Teams. Er hat Karten entwickelt, Mannschaften gef&uuml;hrt und den Fachkr&auml;ftemangel <strong>nicht aus Statistiken kennengelernt, sondern aus jedem einzelnen Dienstplan</strong>.</p>
        </div>
        <blockquote class="gruender-quote">&bdquo;Ich habe zu oft erlebt, dass eine K&uuml;che steht und f&auml;llt mit einer einzigen Person. Das muss nicht sein. Gutes Kochen kann man aufschreiben, zeigen und beibringen.&ldquo;</blockquote>
      </div>
      <!-- Position 3 (Anweisung 37): Börge-Geschichte nach dem Zitat, mit echtem Foto (Betriebskueche). -->
      <div class="split-row mt-12">
        <div class="split-copy">
          <p style="color:var(--grau)">Angefangen hat er ganz unten: als Jugendlicher Gem&uuml;se geschnitten, Geschirr gesp&uuml;lt, dann hochgearbeitet bis zum K&uuml;chenleiter. &Uuml;ber all die Jahre fiel ihm immer dasselbe auf: Es fehlte an qualifizierten Leuten, und die guten brannten aus. Statt zu resignieren, begann er, Menschen ohne klassische Kochausbildung f&uuml;r die K&uuml;che zu begeistern, und entdeckte, wie viel Talent in ihnen steckt. 2023 gr&uuml;ndete er daf&uuml;r sein erstes Unternehmen, die BP Gastroberatung in Berlin. Innerhalb kurzer Zeit waren 15 festangestellte K&ouml;che im Einsatz. Daraus ist die AVORIX GmbH geworden.</p>
        </div>
        <div class="split-media">
          <Image
            src={boergeKueche}
            alt="Börge Penk in Kochjacke in einer Betriebsküche"
            widths={[480, 800, 1200]}
            sizes="(max-width: 900px) 100vw, 420px"
            loading="lazy"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Geschichte -->
 <section class="reveal section-gap" style="background:var(--papier)">
    <div class="content-width">
      <h2 style="color:var(--druck)">Erst K&ouml;che. Dann Abl&auml;ufe. Dann die App.</h2>
      <!-- Echter Split: Text links, Bild rechts — keine halbe Spalte mit Leere (Folgerunde 1 / 3a) -->
      <div class="split-row">
        <div class="split-copy">
          <p class="mb-4" style="color:var(--grau)">Avorix begann als Personaldienstleister f&uuml;r das Gastgewerbe: festangestellte K&ouml;che, verliehen an H&auml;user, denen Personal fehlte. Dabei zeigte sich immer dasselbe Muster: Der Einsatz half, aber <strong>sobald der Koch ging, war der Betrieb so verwundbar wie vorher</strong>.</p>
          <p style="color:var(--grau)">Also haben wir angefangen, das Wissen dazulassen: erst mit standardisierten Abl&auml;ufen (vorbereiten, vakuumieren, regenerieren), dann mit dokumentierten Rezepten, schlie&szlig;lich mit der Avorix Koch-App, die beides f&uuml;r jedes K&uuml;chenteam nutzbar macht. Heute ist daraus ein komplettes System geworden: <strong>Software, Schulung und Personal aus einer Hand.</strong></p>
        </div>
        <div class="split-media">
          <Image
            src={vakuumbeutelKuehlhaus}
            alt="Beschriftete Vakuumbeutel mit vorbereiteten Zutaten im Kühlraum einer Profiküche"
            widths={[480, 800, 1200, 1600]}
            sizes="(max-width: 900px) 100vw, 420px"
            loading="eager"
            fetchpriority="high"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Technologie -->
 <section class="reveal section-gap">
    <div class="content-width text-spalte">
      <h2 style="color:var(--druck)">Technologie als Unterst&uuml;tzung. Nicht als Ersatz.</h2>
      <div>
        <div>
          <p style="color:var(--grau)">Wir wollen keine K&uuml;chen ohne Menschen. Wir wollen K&uuml;chen, in denen Menschen ohne jahrelange Ausbildung gute Arbeit leisten k&ouml;nnen, und <strong>in denen das Wissen des Hauses nicht mit der n&auml;chsten K&uuml;ndigung verschwindet</strong>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Fakten -->
 <section class="reveal section-gap" style="background:var(--papier)">
    <div class="content-width text-spalte">
      <h2 class="mb-6" style="color:var(--druck)">Was Sie schwarz auf wei&szlig; haben.</h2>
      <ul class="space-y-4">
        <li class="py-4" style="border-bottom:1px solid var(--linie);color:var(--druck)">Sitz in Friedrichshafen am Bodensee (AVORIX GmbH)</li>
        <li class="py-4" style="border-bottom:1px solid var(--linie);color:var(--druck)">T&auml;tig in Deutschland und &Ouml;sterreich</li>
        <li class="py-4" style="border-bottom:1px solid var(--linie);color:var(--druck)">Beh&ouml;rdliche Arbeitnehmer&uuml;berlassungserlaubnis der Bundesagentur f&uuml;r Arbeit</li>
      </ul>
    </div>
  </section>

  <!-- Diskretion -->
 <section class="reveal section-gap section-dunkel">
    <div class="content-width text-spalte">
      <h2 class="mb-6">Unsere Kunden schm&uuml;cken sich nicht mit uns. Das ist Absicht.</h2>
      <p class="max-w-[62ch]">Unsere Kunden f&uuml;hren ihre K&uuml;che mit unserem System, und was in ihrer K&uuml;che passiert, geht niemanden etwas an. <strong>Diese Diskretion ist Teil unseres Angebots.</strong></p>
    </div>
  </section>

  <!-- Final CTA → Peak-End (3.18) -->
 <section class="reveal section-gap" style="background:var(--papier)">
    <div class="content-width text-center">
      <div class="mb-6">
        <Stempel>Gepr&uuml;ft &middot; A&Uuml;-Erlaubnis</Stempel>
      </div>
      <p class="mb-6" style="font-family:Charter, Georgia, serif; font-style:italic; font-size:24px; color:var(--druck)">Es ist geregelt.</p>
      <a href="/kontakt" data-cta-location="ueberuns-final" class="btn btn-primary">App-Demo vereinbaren</a>
      <a href="/personal#anfrage" data-cta-location="ueberuns-final" data-cta-event="cta_personal_click" class="btn btn-secondary">Personal anfragen</a>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image, getImage } from "astro:assets";
import Stempel from "../components/Stempel.astro";
import speiselokalGastraum from "../assets/bilder/gasthof-stube.jpg";

const ogImg = await getImage({ src: speiselokalGastraum, width: 1200, format: "jpeg" });
const ogImageAlt = "Heller, modern eingedeckter Gastraum eines Restaurants mit Holztischen, Weingläsern und Kachelofen";

const schemaOrg = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Startseite",
        "item": "https://avorix.de/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Für Restaurants & Gasthöfe",
        "item": "https://avorix.de/fuer-restaurants"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Unsere Karte wechselt saisonal. Passt das trotzdem?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja. Die Stammkarte wird einmal sauber aufgenommen, Saisongerichte pflegen Sie danach selbst ein oder wir übernehmen das."
        }
      },
      {
        "@type": "Question",
        "name": "Wir sind ein Familienbetrieb, keiner von uns ist ein Technik-Mensch.",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Dafür ist die App gebaut: Foto ansehen, Haken setzen. Geschult wird am Herd, nicht im Seminarraum."
        }
      },
      {
        "@type": "Question",
        "name": "Was sagt unser Koch dazu, wenn wir sein Wissen dokumentieren?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Die Erfahrung zeigt: Gute Köche gewinnen dadurch. Ihr Wissen bekommt endlich den Stellenwert, den es verdient, und sie müssen nicht mehr jeden Handgriff selbst machen."
        }
      },
      {
        "@type": "Question",
        "name": "Können wir uns das als kleiner Betrieb leisten?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Deshalb gibt es das Pilotprogramm. Im Erstgespräch rechnen wir Ihnen die Zahlen transparent vor, und Sie entscheiden danach in Ruhe."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "url": "https://avorix.de/fuer-restaurants",
    "primaryImageOfPage": {
      "@type": "ImageObject",
      "url": `https://avorix.de${ogImg.src}`,
      "description": ogImageAlt
    }
  }
];
---

<BaseLayout
  title="Küchensystem für Restaurants und Gasthöfe"
  description="Ihr Gasthof steht und fällt mit einem Kopf? Avorix sichert Ihre Rezepte, lernt Ihr Team an und überbrückt Ausfälle rechtssicher."
  ogImage={ogImg.src}
  ogImageAlt={ogImageAlt}
  schemaOrg={schemaOrg}
>
  {/* Hero (W2: Split 55/45, Bild rechts) */}
 <section class="hero-section px-6">
    <div class="content-width hero-grid">
      <div class="hero-copy">
        <p class="eyebrow mb-4">F&uuml;r Restaurants &amp; Gasth&ouml;fe</p>
        <h1 class="mb-6">
          Ihr Gasthof steht und f&auml;llt mit einem Kopf. <mark>Muss er nicht.</mark>
        </h1>
        <p class="lead mb-6" style="color:var(--grau)">
          Avorix sichert die Rezepte Ihres Hauses, lernt Ihr Team an und &uuml;berbr&uuml;ckt Ausf&auml;lle mit echten K&ouml;chen. Damit Ihre K&uuml;che Ihr Niveau h&auml;lt. Jeden Tag. <strong>Auch ohne ausgebildete K&ouml;che.</strong>
        </p>
        <div class="flex flex-wrap gap-4 mb-6">
          <a href="/kontakt" data-cta-location="restaurants-hero" class="btn btn-primary">App-Demo vereinbaren</a>
          <a href="/personal#anfrage" data-cta-location="restaurants-hero" data-cta-event="cta_personal_click" class="btn btn-secondary">Personal anfragen</a>
        </div>
        <div class="hero-badges">
          <Stempel>Gepr&uuml;ft &middot; A&Uuml;-Erlaubnis</Stempel>
        </div>
      </div>
      <div class="hero-media">
        <Image
          src={speiselokalGastraum}
          alt="Heller, modern eingedeckter Gastraum eines Restaurants mit Holztischen, Weingläsern und Kachelofen"
          widths={[480, 800, 1200, 1600]}
          sizes="(max-width: 900px) 100vw, 528px"
          loading="eager"
          fetchpriority="high"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </section>

  {/* Problem */}
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Wenn der Koch geht, geht es um alles.</h2>
      {/* Korrektur 9 (Anweisung 25): Der Satz stand unter der Gruppe. Er ist zu
           verstehen, bevor man sie gesehen hat, also gehoert er nach oben. */}
      <p class="mb-10 max-w-[var(--spalte-text)]" style="color:var(--grau)">Irgendwann steht die Frage im Raum, wie lange es so noch weitergeht. <strong>Genau f&uuml;r diesen Punkt gibt es Avorix.</strong></p>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">
        <div class="card">
          <h3 class="mb-4">Die K&uuml;ndigung ist keine Personalie. Sie ist eine Existenzfrage.</h3>
          <p class="text-sm" style="color:var(--grau)">Im Gasthof h&auml;ngt die ganze K&uuml;che an einem oder zwei K&ouml;pfen. Geht einer, <strong>stehen Sie &uuml;ber Nacht ohne das Wissen da, das Ihr Haus ausmacht</strong>.</p>
        </div>
        <div class="card">
          <h3 class="mb-4">Ihre Stammg&auml;ste merken es zuerst.</h3>
          <p class="text-sm" style="color:var(--grau)">Der Braten schmeckt anders, die Portionen schwanken, die erste schlechte Bewertung steht online. <strong>Der Ruf, den Sie &uuml;ber Jahre aufgebaut haben, wackelt in Wochen.</strong></p>
        </div>
        <div class="card">
          <h3 class="mb-4">Auf Ihre Anzeige meldet sich niemand.</h3>
          <p class="text-sm" style="color:var(--grau)">Und wenn doch, k&ouml;nnen Sie nicht zahlen, was Kettenhotels zahlen. <strong>Also improvisieren Sie weiter und hoffen, dass nichts passiert.</strong></p>
        </div>
      </div>
    </div>
  </section>

  {/* System (W4: Modul-Karten) */}
 <section class="reveal section-gap section-band">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Das Avorix-System: Rezepte sichern, Team anlernen, Ausf&auml;lle &uuml;berbr&uuml;cken.</h2>
      <p class="max-w-[var(--spalte-text)] mb-8" style="color:var(--grau)">Stellen Sie sich ein Navi f&uuml;r Ihre K&uuml;che vor: Es bringt jede Kraft zum fertigen Gericht, auch wenn sie es noch nie gekocht hat. Daf&uuml;r kommen drei Bausteine zusammen:</p>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">
        <div class="card-modul">
          <div class="card-modul-header">
            <span class="card-modul-label">Modul 1</span>
            <span class="card-modul-leader"></span>
          </div>
          <h3 class="mb-4">Unser System</h3>
          <p class="text-sm" style="color:var(--grau)">Ihre Karte als Schritt-f&uuml;r-Schritt-Anleitung in der Koch-App, mit Fotos, Mengen und Zeiten.</p>
        </div>
        <div class="card-modul">
          <div class="card-modul-header">
            <span class="card-modul-label">Modul 2</span>
            <span class="card-modul-leader"></span>
          </div>
          <h3 class="mb-4">Die Schulung</h3>
          <p class="text-sm" style="color:var(--grau)">Ein Avorix-Koch (mindestens Sous-Chef-Erfahrung) nimmt Ihre Karte auf und lernt Ihr Team an, direkt am Herd.</p>
        </div>
        <div class="card-modul">
          <div class="card-modul-header">
            <span class="card-modul-label">Modul 3</span>
            <span class="card-modul-leader"></span>
          </div>
          <h3 class="mb-4">Die Verst&auml;rkung</h3>
          <p class="text-sm mb-4" style="color:var(--grau)">F&auml;llt jemand aus, leihen wir Ihnen einen festangestellten Koch. Rechtssicher, mit Arbeitnehmer&uuml;berlassungserlaubnis.</p>
          <Stempel>Gepr&uuml;ft &middot; A&Uuml;-Erlaubnis</Stempel>
        </div>
      </div>
      <p class="mt-6 max-w-[var(--spalte-text)]" style="color:var(--grau)">Und Ihre G&auml;ste? Merken nichts. <strong>Sie erleben Ihre K&uuml;che und Ihre Rezepte, nur eben verl&auml;sslich.</strong> Wir nennen keinen Kunden ohne sein ausdr&uuml;ckliches Einverst&auml;ndnis.</p>
      <div class="mt-6">
        <a href="/system" data-cta-location="restaurants-system" class="btn btn-secondary">So funktioniert das System</a>
      </div>
    </div>
  </section>

  {/* Feste Karte (W3: Split) */}
 <section class="reveal section-gap section-band">
    <div class="content-width text-spalte">
      <div>
        <h2 class="mb-6" style="color:var(--druck)">Eine feste Karte ist schneller gesichert, als Sie denken.</h2>
        <p class="max-w-[var(--spalte-text)]" style="color:var(--grau)">Ein Beispiel: eine Karte mit rund 12 Gerichten, drei Vorspeisen, drei Hauptgerichte, drei Desserts, ein vegetarisches Gericht, etwas f&uuml;r Kinder. So eine Karte nimmt ein Avorix-Koch in einem Block auf (f&uuml;nf Tage mit je sechs Stunden), dazu kommt ein zweiter Block f&uuml;r die Schulung Ihres Teams. <strong>Danach steckt das Wissen Ihres Hauses im System und nicht mehr nur in einer einzigen Person.</strong></p>
      </div>
    </div>
  </section>

  {/* Vier Schritte */}
 <section class="reveal section-gap">
    <div class="content-width text-spalte">
      <h2 class="mb-6" style="color:var(--druck)">Vier Schritte, wenige Wochen.</h2>
      <div class="space-y-6">
        <div class="flex gap-4">
          <div class="schritt-chip shrink-0">1</div>
          <div>
            <h3 class="mb-4">Gespr&auml;ch (30 Minuten, kostenlos)</h3>
            <p class="text-sm mt-6 max-w-[var(--spalte-text)]" style="color:var(--grau)">Sie erz&auml;hlen, wo es klemmt. Wir sagen ehrlich, ob Avorix passt.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="schritt-chip shrink-0">2</div>
          <div>
            <h3 class="mb-4">Aufnahme</h3>
            <p class="text-sm mt-6 max-w-[var(--spalte-text)]" style="color:var(--grau)">Ein Avorix-Koch kocht mit, dokumentiert und legt Ihre Karte in der App an.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="schritt-chip shrink-0">3</div>
          <div>
            <h3 class="mb-4">Schulung</h3>
            <p class="text-sm mt-6 max-w-[var(--spalte-text)]" style="color:var(--grau)">Ihr Team lernt das System, am Herd, im laufenden Betrieb.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="schritt-chip shrink-0">4</div>
          <div>
            <h3 class="mb-4">Selbstst&auml;ndig arbeiten</h3>
            <p class="text-sm mt-6 max-w-[var(--spalte-text)]" style="color:var(--grau)">Die App f&uuml;hrt Ihr Team durch jeden Tag. Wir bleiben erreichbar.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Pilotbetrieb */}
 <section class="reveal section-gap section-dunkel">
    <div class="content-width text-spalte">
      <h2 class="mb-6">Als Pilotbetrieb zur halben Rechnung.</h2>
      <p class="mb-6 max-w-[var(--spalte-text)]">Wir nehmen 2026 eine kleine Zahl von Pilotbetrieben auf: rund die H&auml;lfte des regul&auml;ren Preises, im Gegenzug ehrliches Feedback und die anonyme Auswertung Ihrer Ergebnisse. <strong>Ihr Name taucht nirgends auf.</strong></p>
      <a href="/pilotprogramm" data-cta-location="restaurants-pilot" class="btn btn-primary">Zum Pilotprogramm</a>
    </div>
  </section>

  {/* FAQ */}
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">H&auml;ufige Fragen</h2>
      <div class="faq-list">
        <details class="faq-item" open>
          <summary class="faq-q">Unsere Karte wechselt saisonal. Passt das trotzdem?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Ja. Die Stammkarte wird einmal sauber aufgenommen, Saisongerichte pflegen Sie danach selbst ein oder wir &uuml;bernehmen das.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Wir sind ein Familienbetrieb, keiner von uns ist ein Technik-Mensch.<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Daf&uuml;r ist die App gebaut: Foto ansehen, Haken setzen. Geschult wird am Herd, nicht im Seminarraum.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Was sagt unser Koch dazu, wenn wir sein Wissen dokumentieren?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Die Erfahrung zeigt: Gute K&ouml;che gewinnen dadurch. Ihr Wissen bekommt endlich den Stellenwert, den es verdient, und sie m&uuml;ssen nicht mehr jeden Handgriff selbst machen.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">K&ouml;nnen wir uns das als kleiner Betrieb leisten?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Deshalb gibt es das Pilotprogramm. Im Erstgespr&auml;ch rechnen wir Ihnen die Zahlen transparent vor, und Sie entscheiden danach in Ruhe.</p></div></div>
        </details>
      </div>
    </div>
  </section>

  {/* Final CTA → Peak-End (3.18) */}
 <section class="reveal section-gap">
    <div class="content-width text-center">
      <div class="mb-6">
        <Stempel>Gepr&uuml;ft &middot; A&Uuml;-Erlaubnis</Stempel>
      </div>
      <p class="mb-6" style="font-family:Charter, Georgia, serif; font-style:italic; font-size:24px; color:var(--druck)">Es ist geregelt.</p>
      <a href="/kontakt" data-cta-location="restaurants-final" class="btn btn-primary">App-Demo vereinbaren</a>
    </div>
  </section>
</BaseLayout>

<script>
/* FAQ-Schliess-Animation — progressive enhancement */
document.querySelectorAll('.faq-item').forEach(function(item) {
  var summary = item.querySelector('summary');
  if (!summary) return;
  summary.addEventListener('click', function(e) {
    if (!item.open) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    e.preventDefault();
    item.classList.add('faq-closing');
    var body = item.querySelector('.faq-body');
    if (!body) { item.classList.remove('faq-closing'); item.removeAttribute('open'); return; }
    body.addEventListener('transitionend', function handler() {
      body.removeEventListener('transitionend', handler);
      item.classList.remove('faq-closing');
      item.removeAttribute('open');
    });
  });
});
</script>

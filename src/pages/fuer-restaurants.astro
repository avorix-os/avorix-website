---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image, getImage } from "astro:assets";
import Stempel from "../components/Stempel.astro";
import speiselokalGastraum from "../assets/bilder/speiselokal-gastraum.jpg";
import steakNahaufnahme from "../assets/bilder/steak-nahaufnahme.jpg";

const ogImg = await getImage({ src: speiselokalGastraum, width: 1200, format: "jpeg" });
const ogImageAlt = "Heller, modern eingedeckter Gastraum eines Restaurants mit Holztischen, Weingläsern und Kachelofen";

const schemaOrg = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Startseite",
        "item": "https://avorix.cloud/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Für Restaurants & Gasthöfe",
        "item": "https://avorix.cloud/fuer-restaurants"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Unsere Karte wechselt saisonal. Passt das trotzdem?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja. Die Stammkarte wird einmal sauber aufgenommen, Saisongerichte pflegen Sie danach selbst ein oder wir übernehmen das."
        }
      },
      {
        "@type": "Question",
        "name": "Wir sind ein Familienbetrieb, keiner von uns ist ein Technik-Mensch.",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Dafür ist die App gebaut: Foto ansehen, Haken setzen. Geschult wird am Herd, nicht im Seminarraum."
        }
      },
      {
        "@type": "Question",
        "name": "Was sagt unser Koch dazu, wenn wir sein Wissen dokumentieren?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Die Erfahrung zeigt: Gute Köche gewinnen dadurch. Ihr Wissen bekommt endlich den Stellenwert, den es verdient, und sie müssen nicht mehr jeden Handgriff selbst machen."
        }
      },
      {
        "@type": "Question",
        "name": "Können wir uns das als kleiner Betrieb leisten?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Deshalb gibt es das Pilotprogramm. Im Erstgespräch rechnen wir Ihnen die Zahlen transparent vor, und Sie entscheiden danach in Ruhe."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "url": "https://avorix.cloud/fuer-restaurants",
    "primaryImageOfPage": {
      "@type": "ImageObject",
      "url": `https://avorix.cloud${ogImg.src}`,
      "description": ogImageAlt
    }
  }
];
---

<BaseLayout
  title="Küchensystem für Restaurants und Gasthöfe"
  description="Ihr Gasthof steht und fällt mit einem Kopf? Avorix sichert Ihre Rezepte, lernt Ihr Team an und überbrückt Ausfälle rechtssicher."
  ogImage={ogImg.src}
  ogImageAlt={ogImageAlt}
  schemaOrg={schemaOrg}
>
  <!-- Hero -->
  <section class="pt-28 pb-16 px-6" style="background:var(--papier)">
    <div class="max-w-4xl mx-auto">
      <p class="eyebrow mb-4">F&uuml;r Restaurants &amp; Gasth&ouml;fe</p>
      <h1 class="mb-6">
        Ihr Gasthof steht und f&auml;llt mit einem Kopf. Muss er nicht.
      </h1>
      <p class="lead mb-6" style="color:var(--grau)">
        Avorix sichert die Rezepte Ihres Hauses, lernt Ihr Team an und &uuml;berbr&uuml;ckt Ausf&auml;lle mit echten K&ouml;chen. Damit Ihre K&uuml;che Ihr Niveau h&auml;lt. Jeden Tag. <strong style="color:var(--druck)">Auch ohne ausgebildete K&ouml;che.</strong>
      </p>
      <div class="flex flex-wrap gap-4 mb-6">
        <a href="/kontakt" data-cta-location="restaurants-hero" class="btn btn-primary">Demo vereinbaren</a>
      </div>
      <div class="flex flex-wrap gap-3">
        <span class="check-badge"><span class="check-badge-mark">&#10003;</span> Beh&ouml;rdliche Arbeitnehmer&uuml;berlassungserlaubnis (Agentur f&uuml;r Arbeit)</span>
      </div>
      <div class="mt-8">
        <Image
          src={speiselokalGastraum}
          alt="Heller, modern eingedeckter Gastraum eines Restaurants mit Holztischen, Weingläsern und Kachelofen"
          widths={[480, 800, 1200, 1600]}
          sizes="(max-width: 896px) 100vw, 896px"
          loading="eager"
          fetchpriority="high"
          class="w-full h-64 md:h-80 object-cover"
          style="border-radius:var(--radius);box-shadow:var(--schatten)"
        />
      </div>
    </div>
  </section>

  <!-- Problem -->
  <section class="py-16 px-6" style="border-top:1px solid var(--linie)">
    <div class="max-w-5xl mx-auto">
      <h2 class="mb-8">Wenn der Koch geht, geht es um alles.</h2>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="card">
          <h3 class="mb-3">Die K&uuml;ndigung ist keine Personalie. Sie ist eine Existenzfrage.</h3>
          <p class="text-sm" style="color:var(--grau)">Im Gasthof h&auml;ngt die ganze K&uuml;che an einem oder zwei K&ouml;pfen. Geht einer, stehen Sie &uuml;ber Nacht ohne das Wissen da, das Ihr Haus ausmacht.</p>
        </div>
        <div class="card">
          <h3 class="mb-3">Ihre Stammg&auml;ste merken es zuerst.</h3>
          <p class="text-sm" style="color:var(--grau)">Der Braten schmeckt anders, die Portionen schwanken, die erste schlechte Bewertung steht online. Der Ruf, den Sie &uuml;ber Jahre aufgebaut haben, wackelt in Wochen.</p>
        </div>
        <div class="card">
          <h3 class="mb-3">Auf Ihre Anzeige meldet sich niemand.</h3>
          <p class="text-sm" style="color:var(--grau)">Und wenn doch, k&ouml;nnen Sie nicht zahlen, was Kettenhotels zahlen. Also improvisieren Sie weiter und hoffen, dass nichts passiert.</p>
        </div>
      </div>
      <p class="mt-6" style="color:var(--grau)">Irgendwann steht die Frage im Raum, wie lange es so noch weitergeht. Genau f&uuml;r diesen Punkt gibt es Avorix.</p>
    </div>
  </section>

  <!-- System -->
  <section class="py-16 px-6" style="background:var(--papier);border-top:1px solid var(--linie)">
    <div class="max-w-5xl mx-auto">
      <h2 class="mb-4">Das Avorix-System: Rezepte sichern, Team anlernen, Ausf&auml;lle &uuml;berbr&uuml;cken.</h2>
      <p class="max-w-3xl mb-8" style="color:var(--grau)">Stellen Sie sich ein Navi f&uuml;r Ihre K&uuml;che vor: Es bringt jede Kraft zum fertigen Gericht, auch wenn sie es noch nie gekocht hat. Daf&uuml;r kommen drei Bausteine zusammen:</p>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="card">
          <h3 class="mb-3">Unser System</h3>
          <p class="text-sm" style="color:var(--grau)">Ihre Karte als Schritt-f&uuml;r-Schritt-Anleitung in der Koch-App, mit Fotos, Mengen und Zeiten.</p>
        </div>
        <div class="card">
          <h3 class="mb-3">Die Schulung</h3>
          <p class="text-sm" style="color:var(--grau)">Ein Avorix-Koch (mindestens Sous-Chef-Erfahrung) nimmt Ihre Karte auf und lernt Ihr Team an, direkt am Herd.</p>
        </div>
        <div class="card">
          <h3 class="mb-3">Die Verst&auml;rkung</h3>
          <p class="text-sm" style="color:var(--grau)">F&auml;llt jemand aus, leihen wir Ihnen einen festangestellten Koch. Rechtssicher, mit Arbeitnehmer&uuml;berlassungserlaubnis.</p>
        </div>
      </div>
      <p class="mt-6" style="color:var(--grau)">Und Ihre G&auml;ste? Merken nichts. Sie erleben Ihre K&uuml;che und Ihre Rezepte, nur eben verl&auml;sslich. Wir nennen keinen Kunden &ouml;ffentlich.</p>
      <div class="mt-6">
        <a href="/system" data-cta-location="restaurants-system" class="btn btn-secondary">So funktioniert das System</a>
      </div>
    </div>
  </section>

  <!-- Feste Karte -->
  <section class="py-16 px-6" style="border-top:1px solid var(--linie)">
    <div class="max-w-4xl mx-auto">
      <h2 class="mb-4">Eine feste Karte ist schneller gesichert, als Sie denken.</h2>
      <Image
        src={steakNahaufnahme}
        alt="Perfekt gebratenes Steak in Nahaufnahme auf dunklem Teller"
        widths={[480, 800, 1200]}
        sizes="(max-width: 896px) 100vw, 896px"
        loading="lazy"
        decoding="async"
        class="w-full h-64 md:h-72 object-cover mb-6"
        style="border-radius:var(--radius);box-shadow:var(--schatten)"
      />
      <p class="mb-6" style="color:var(--grau)">Ein Beispiel: eine Karte mit rund 12 Gerichten, drei Vorspeisen, drei Hauptgerichte, drei Desserts, ein vegetarisches Gericht, etwas f&uuml;r Kinder. So eine Karte nimmt ein Avorix-Koch in einem Block auf (f&uuml;nf Tage mit je sechs Stunden), dazu kommt ein zweiter Block f&uuml;r die Schulung Ihres Teams. Danach steckt das Wissen Ihres Hauses im System und nicht mehr nur in einem Kopf.</p>
    </div>
  </section>

  <!-- Vier Schritte -->
  <section class="py-16 px-6" style="background:var(--papier);border-top:1px solid var(--linie)">
    <div class="max-w-4xl mx-auto">
      <h2 class="mb-8">Vier Schritte, wenige Wochen.</h2>
      <div class="space-y-6">
        <div class="flex gap-4">
          <div class="schritt-chip shrink-0">1</div>
          <div>
            <h3 class="mb-1">Gespr&auml;ch (30 Minuten, kostenlos)</h3>
            <p class="text-sm mt-1" style="color:var(--grau)">Sie erz&auml;hlen, wo es klemmt. Wir sagen ehrlich, ob Avorix passt.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="schritt-chip shrink-0">2</div>
          <div>
            <h3 class="mb-1">Aufnahme</h3>
            <p class="text-sm mt-1" style="color:var(--grau)">Ein Avorix-Koch kocht mit, dokumentiert und legt Ihre Karte in der App an.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="schritt-chip shrink-0">3</div>
          <div>
            <h3 class="mb-1">Schulung</h3>
            <p class="text-sm mt-1" style="color:var(--grau)">Ihr Team lernt das System, am Herd, im laufenden Betrieb.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="schritt-chip shrink-0">4</div>
          <div>
            <h3 class="mb-1">Selbstst&auml;ndig arbeiten</h3>
            <p class="text-sm mt-1" style="color:var(--grau)">Die App f&uuml;hrt Ihr Team durch jeden Tag. Wir bleiben erreichbar.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pilotbetrieb -->
  <section class="py-16 px-6" style="border-top:1px solid var(--linie)">
    <div class="max-w-4xl mx-auto">
      <h2 class="mb-4">Als Pilotbetrieb zur halben Rechnung.</h2>
      <p class="mb-6" style="color:var(--grau)">Wir nehmen 2026 eine kleine Zahl von Pilotbetrieben auf: rund die H&auml;lfte des regul&auml;ren Preises, im Gegenzug ehrliches Feedback und die anonyme Auswertung Ihrer Ergebnisse. Ihr Name taucht nirgends auf.</p>
      <a href="/pilotprogramm" data-cta-location="restaurants-pilot" class="btn btn-primary">Zum Pilotprogramm</a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-16 px-6" style="background:var(--papier);border-top:1px solid var(--linie)">
    <div class="max-w-3xl mx-auto">
      <h2 class="mb-8">H&auml;ufige Fragen</h2>
      <div class="faq-list">
        <details class="faq-item" open>
          <summary class="faq-q">Unsere Karte wechselt saisonal. Passt das trotzdem?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Ja. Die Stammkarte wird einmal sauber aufgenommen, Saisongerichte pflegen Sie danach selbst ein oder wir &uuml;bernehmen das.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Wir sind ein Familienbetrieb, keiner von uns ist ein Technik-Mensch.<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Daf&uuml;r ist die App gebaut: Foto ansehen, Haken setzen. Geschult wird am Herd, nicht im Seminarraum.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Was sagt unser Koch dazu, wenn wir sein Wissen dokumentieren?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Die Erfahrung zeigt: Gute K&ouml;che gewinnen dadurch. Ihr Wissen bekommt endlich den Stellenwert, den es verdient, und sie m&uuml;ssen nicht mehr jeden Handgriff selbst machen.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">K&ouml;nnen wir uns das als kleiner Betrieb leisten?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Deshalb gibt es das Pilotprogramm. Im Erstgespr&auml;ch rechnen wir Ihnen die Zahlen transparent vor, und Sie entscheiden danach in Ruhe.</p></div></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Final CTA → Peak-End (3.18) -->
  <section class="py-20 px-6" style="background:var(--papier);border-top:1px solid var(--linie)">
    <div class="max-w-3xl mx-auto text-center">
      <div class="mb-6">
        <Stempel>Gepr&uuml;ft &middot; A&Uuml;-Erlaubnis</Stempel>
      </div>
      <p class="mb-6" style="font-family:Charter, Georgia, serif; font-style:italic; font-size:24px; color:var(--druck)">Es ist geregelt.</p>
      <a href="/kontakt" data-cta-location="restaurants-final" class="btn btn-primary">Demo vereinbaren</a>
    </div>
  </section>
</BaseLayout>

<style>
/* FAQ-Accordion (3.13) */
.faq-list {
  border-top: 1px solid var(--linie);
}
.faq-item {
  border-bottom: 1px solid var(--linie);
}
.faq-item summary {
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  cursor: pointer;
  font-family: var(--f-head);
  font-weight: 700;
  font-size: 17px;
  line-height: 1.35;
  color: var(--text-primary, #1C1B16);
  padding: 18px 0;
}
.faq-item summary::-webkit-details-marker { display: none; }
.faq-chevron {
  color: var(--akzent);
  flex-shrink: 0;
  transition: transform 0.2s ease;
}
.faq-item[open] > summary .faq-chevron {
  transform: rotate(180deg);
}
.faq-item.faq-closing > summary .faq-chevron {
  transform: rotate(0deg);
}
.faq-body {
  display: grid;
  grid-template-rows: 0fr;
  overflow: hidden;
  transition: grid-template-rows 0.25s ease;
}
.faq-item[open] > .faq-body {
  grid-template-rows: 1fr;
}
.faq-item.faq-closing > .faq-body {
  grid-template-rows: 0fr;
}
.faq-inner {
  min-height: 0;
}
.faq-inner p {
  font-size: 16px;
  color: var(--grau);
  padding-bottom: 18px;
  margin: 0;
}
@media (prefers-reduced-motion: reduce) {
  .faq-body,
  .faq-chevron {
    transition: none;
  }
}
</style>

<script>
/* FAQ-Schliess-Animation — progressive enhancement */
document.querySelectorAll('.faq-item').forEach(function(item) {
  var summary = item.querySelector('summary');
  if (!summary) return;
  summary.addEventListener('click', function(e) {
    if (!item.open) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    e.preventDefault();
    item.classList.add('faq-closing');
    var body = item.querySelector('.faq-body');
    if (!body) { item.classList.remove('faq-closing'); item.removeAttribute('open'); return; }
    body.addEventListener('transitionend', function handler() {
      body.removeEventListener('transitionend', handler);
      item.classList.remove('faq-closing');
      item.removeAttribute('open');
    });
  });
});
</script>

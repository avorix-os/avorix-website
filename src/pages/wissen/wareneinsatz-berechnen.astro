</BaseLayout>

<style>
  .eyebrow-link { color: inherit; text-decoration: none; }
  .eyebrow-link:hover { text-decoration: underline; }

  .rechner {
    max-width: 640px;
    background: var(--flaeche);
    border: 1px solid var(--linie);
    border-radius: var(--radius);
    padding: 24px;
  }
  .rechner-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 600px) {
    .rechner-grid { grid-template-columns: 1fr 1fr; }
  }
  .rechner-feld label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    color: var(--druck);
    margin-bottom: 8px;
  }
  .rechner-input-wrap { position: relative; }
  .rechner-input-wrap input {
    width: 100%;
    min-height: 60px;
    background: var(--papier);
    border: 1px solid var(--linie);
    border-radius: var(--radius);
    padding: 0 40px 0 16px;
    font-size: 16px;
    font-family: var(--f-body);
    color: var(--druck);
    box-sizing: border-box;
    transition: border-color .15s;
    appearance: textfield;
    -moz-appearance: textfield;
  }
  .rechner-input-wrap input:focus { outline: none; border-color: var(--akzent); }
  .rechner-input-wrap input:focus-visible { outline: 3px solid var(--akzent); outline-offset: 2px; }
  .rechner-einheit {
    position: absolute;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--grau);
    font-size: 16px;
    pointer-events: none;
  }
  .rechner-ausgabe {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--linie);
  }
  .rechner-zeile {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    font-size: 16px;
    color: var(--grau);
    padding: 6px 0;
  }
  .rechner-zeile strong {
    font-family: var(--f-head);
    font-size: 20px;
    color: var(--druck);
    white-space: nowrap;
  }
  .rechner-hinweis-fehler {
    color: var(--akzent);
    font-size: 14px;
    line-height: 1.5;
    padding: 8px 0 0;
  }
  .rechner-datenschutz {
    margin-top: 16px;
    font-size: 13px;
    color: var(--grau);
  }
</style>

<script>
/* FAQ-Schließ-Animation — progressive enhancement */
document.querySelectorAll('.faq-item').forEach(function(item) {
  var summary = item.querySelector('summary');
  if (!summary) return;
  summary.addEventListener('click', function(e) {
    if (!item.open) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    e.preventDefault();
    item.classList.add('faq-closing');
    var body = item.querySelector('.faq-body');
    if (!body) { item.classList.remove('faq-closing'); item.removeAttribute('open'); return; }
    body.addEventListener('transitionend', function handler() {
      body.removeEventListener('transitionend', handler);
      item.classList.remove('faq-closing');
      item.removeAttribute('open');
    });
  });
});
</script>

<script>
/* Wareneinsatz-Rechner — rein clientseitig, keine Datenübertragung */
(function () {
  var elAnfang = document.getElementById('we-anfang');
  var elEinkauf = document.getElementById('we-einkauf');
  var elEnde = document.getElementById('we-ende');
  var elUmsatz = document.getElementById('we-umsatz');
  if (!elAnfang || !elEinkauf || !elEnde || !elUmsatz) return;

  var outEinsatz = document.getElementById('we-out-einsatz');
  var zeileQuote = document.getElementById('we-zeile-quote');
  var outQuote = document.getElementById('we-out-quote');
  var zeileRohertrag = document.getElementById('we-zeile-rohertrag');
  var outRohertrag = document.getElementById('we-out-rohertrag');
  var fehler = document.getElementById('we-fehler');

  var eur = new Intl.NumberFormat('de-DE', { maximumFractionDigits: 0 });
  var proz = new Intl.NumberFormat('de-DE', { minimumFractionDigits: 1, maximumFractionDigits: 1 });

  function wert(el) {
    var n = parseFloat(el.value);
    if (isNaN(n)) return 0;
    if (n < 0) { el.value = '0'; return 0; }
    return n;
  }

  function rechne() {
    var ab = wert(elAnfang);
    var ek = wert(elEinkauf);
    var eb = wert(elEnde);
    var umsatz = wert(elUmsatz);
    var einsatz = ab + ek - eb;

    if (einsatz < 0) {
      fehler.hidden = false;
      outEinsatz.parentElement.hidden = true;
      zeileQuote.hidden = true;
      zeileRohertrag.hidden = true;
      return;
    }
    fehler.hidden = true;
    outEinsatz.parentElement.hidden = false;
    outEinsatz.textContent = eur.format(Math.round(einsatz)) + ' €';

    if (umsatz > 0) {
      outQuote.textContent = proz.format(einsatz / umsatz * 100) + ' %';
      zeileQuote.hidden = false;
      outRohertrag.textContent = eur.format(Math.round(umsatz - einsatz)) + ' €';
      zeileRohertrag.hidden = false;
    } else {
      zeileQuote.hidden = true;
      zeileRohertrag.hidden = true;
    }
  }

  [elAnfang, elEinkauf, elEnde, elUmsatz].forEach(function (el) {
    el.addEventListener('input', rechne);
  });
  rechne();
})();
</script>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image, getImage } from "astro:assets";
import Stempel from "../../components/Stempel.astro";
import dampfTopf from "../../assets/bilder/dampf-topf.jpg";

const ogImg = await getImage({ src: dampfTopf, width: 1200, format: "jpeg" });
const ogImageAlt = "Steam rising from a stainless steel pot on the gas range of a professional kitchen";

const schemaOrg = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Avorix",
        "item": "https://avorix.de/en"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Staff",
        "item": "https://avorix.de/en/staff"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Hiring out permanently employed chefs",
    "description": "Avorix hires out permanently employed, fully insured chefs to hotels and restaurants in Germany and Austria, on the basis of the official German staffing licence.",
    "provider": {
      "@type": "Organization",
      "name": "Avorix GmbH",
      "url": "https://avorix.de",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Friedrichshafen",
        "addressCountry": "DE"
      },
      "areaServed": {
        "@type": "Country",
        "name": "DE"
      }
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Who are the Avorix chefs?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Permanently employed professionals with working experience in hotel and restaurant kitchens."
        }
      },
      {
        "@type": "Question",
        "name": "What if the chef does not fit our team?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Then talk to us and we will find a solution. It does nobody any good if the chemistry is wrong."
        }
      },
      {
        "@type": "Question",
        "name": "How does this work contractually?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Through a staffing contract (Arbeitnehmerüberlassungsvertrag) of the kind the Federal Employment Agency provides for. You sign a few more pages than you would for an agency invoice, and that is precisely what protects you."
        }
      },
      {
        "@type": "Question",
        "name": "Can a placement grow into more (training, your system)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes, at any time. Many businesses start with a staff placement and build our system afterwards, so that the next absence is no longer an emergency."
        }
      },
      {
        "@type": "Question",
        "name": "How quickly can someone be with us?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Usually within 24 to 72 hours, depending on location and requirements."
        }
      },
      {
        "@type": "Question",
        "name": "Is there a minimum placement period?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. A single day is just as possible as a whole season."
        }
      },
      {
        "@type": "Question",
        "name": "Can we book a chef only, without the app and the system?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Many properties start exactly that way: someone is missing, we send a chef. You do not have to book anything else."
        }
      },
      {
        "@type": "Question",
        "name": "I do not need a full-time chef. Is there a smaller option?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Several houses can share the expertise of one Avorix head chef: he develops your menu, visits your business regularly and coaches your team, at a fixed monthly price. Mention it in the first call."
        }
      },
      {
        "@type": "Question",
        "name": "Who is the employer of the chef we hire?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Avorix remains the employer. We take care of the employment contract, wages, social security and the employer's obligations. In your kitchen, the chef is integrated into your routines and you direct his day-to-day work. This clear division of roles is the principle behind Arbeitnehmerüberlassung."
        }
      },
      {
        "@type": "Question",
        "name": "What is Arbeitnehmerüberlassung, and how does it protect you?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Arbeitnehmerüberlassung, the German framework for hiring out employees, means this: the chef remains an employee of Avorix. We hold the employment contract, pay the wages and remit social security contributions and non-wage labour costs. You deploy the chef temporarily in your business, integrate him into your working routines and give him work-related instructions. For this you pay us the agreed hourly rate. For this form of staffing, the provider generally requires a licence from the Federal Employment Agency, and Avorix holds one. The decisive advantage for you: the placement takes place openly and deliberately within the statutory framework for hiring out employees, and not through a legally questionable arrangement. You get qualified kitchen staff flexibly, and at the same time you reduce the legal risks of using external personnel."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Hire chefs with the official German staffing licence",
    "url": "https://avorix.de/en/staff",
    "inLanguage": "en",
    "primaryImageOfPage": {
      "@type": "ImageObject",
      "url": `https://avorix.de${ogImg.src}`,
      "description": ogImageAlt
    }
  }
];
---

<BaseLayout
  title="Hire Professional Chefs in Germany &amp; Austria"
  description="Permanently employed chefs, hired out under the official German staffing licence. Usually available within 24 to 72 hours, no minimum placement period."
  ogImage={ogImg.src}
  ogImageAlt={ogImageAlt}
  schemaOrg={schemaOrg}
>

  {/* Hero (W2: Split 55/45, Bild rechts) */}
 <section class="hero-section px-6" style="background:var(--papier)">
    <div class="content-width hero-grid">
      <div class="hero-copy">
        <p class="eyebrow mb-4">Module: The Reinforcement</p>
        <h1 class="mb-6">
          Real chefs. Permanently employed. <mark>Legally hired out.</mark>
        </h1>
        <p class="lead mb-6 max-w-[62ch]" style="color:var(--grau)">
          Your kitchen stands or falls with a single person. When you are short of staff, we lend you our permanently employed chefs: for emergencies, for the season, for the gap. Few companies in hospitality hold this licence. It puts you on solid legal ground.
        </p>
        <div class="flex flex-wrap gap-4 mb-6">
          <a href="#request" data-cta-location="staff-hero" data-cta-event="cta_personal_click" class="btn btn-primary">Request Staff</a>
        </div>
        <div class="hero-badges">
          <Stempel>Certified &middot; German staffing licence</Stempel>
        </div>
        <p class="hero-telefon mt-6">
          In an emergency, call us directly:
          <a
            href="tel:+4975413973915"
            data-cta-location="hero"
            data-cta-event="personal_anruf_click"
            class="hero-telefon-link"
          >07541 3973915</a>
          <span class="hero-telefon-zeit">(Mon to Fri, 8 am to 5 pm, answerphone outside these hours)</span>
        </p>
      </div>
      <div class="hero-media">
        <Image
          src={dampfTopf}
          alt="Steam rising from a stainless steel pot on the gas range of a professional kitchen"
          widths={[480, 800, 1200]}
          sizes="(max-width: 900px) 100vw, 528px"
          loading="eager"
          fetchpriority="high"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </section>

  {/* Einleitungsabsatz */}
 <section class="reveal section-gap">
    <div class="content-width">
      <p class="leading-relaxed max-w-[62ch]" style="color:var(--grau)">
        Avorix hires out permanently employed, fully insured chefs to hotels and restaurants in Germany and Austria. The basis is the official staffing licence (Arbeitnehmer&uuml;berlassungserlaubnis) issued by the Federal Employment Agency. It protects businesses from the bogus self-employment risk that can arise with brokered &bdquo;self-employed&ldquo; chefs. You can request staff by phone or through the enquiry form on this page.
      </p>
    </div>
  </section>

  {/* Wann Sie uns rufen */}
 <section class="reveal section-gap" style="background:var(--papier)">
    <div class="content-width">
      <h2 class="mb-10 md:mb-16" style="color:var(--druck)">When to call us.</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
        <div class="card">
          <h3 class="mb-4">The emergency.</h3>
          <p class="leading-relaxed" style="color:var(--grau)">
            Your head chef is out and the season is running. An Avorix chef steps in, by the day or by the week.
          </p>
        </div>
        <div class="card">
          <h3 class="mb-4">The season.</h3>
          <p class="leading-relaxed" style="color:var(--grau)">
            You know you need two extra pairs of hands. Our chefs reinforce your team for weeks or for the whole season.
          </p>
        </div>
        <div class="card">
          <h3 class="mb-4">The gap.</h3>
          <p class="leading-relaxed" style="color:var(--grau)">
            The new hire is taking longer than planned. We bridge the gap until your own solution is in place.
          </p>
        </div>
      </div>
      <p class="text-sm mt-8 max-w-[62ch]" style="color:var(--grau)">
        <strong>Short-notice placements are usually possible within 24 to 72 hours.</strong>
      </p>
    </div>
  </section>

  {/* So läuft ein Einsatz */}
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-10 md:mb-16" style="color:var(--druck)">How a placement works. In four steps.</h2>
      <div class="space-y-6">
        <div class="schritt">
          <span class="schritt-chip shrink-0">1</span>
          <div>
            <h3 class="mb-4">You send an enquiry or call us.</h3>
            <p class="max-w-[62ch]" style="color:var(--grau)">We get back to you within 24 hours.</p>
          </div>
        </div>
        <div class="schritt">
          <span class="schritt-chip shrink-0">2</span>
          <div>
            <h3 class="mb-4">We clarify what you need, when and for how long.</h3>
            <p class="max-w-[62ch]" style="color:var(--grau)">Short and specific: what kind of business, what kind of menu, starting when.</p>
          </div>
        </div>
        <div class="schritt">
          <span class="schritt-chip shrink-0">3</span>
          <div>
            <h3 class="mb-4">B&ouml;rge Penk selects the right chef.</h3>
            <p class="max-w-[62ch]" style="color:var(--grau)">Our head chef handles every enquiry personally. <strong>He knows what a kitchen demands, and he knows his people.</strong></p>
          </div>
        </div>
        <div class="schritt">
          <span class="schritt-chip shrink-0">4</span>
          <div>
            <h3 class="mb-4">The placement starts.</h3>
            <p class="max-w-[62ch]" style="color:var(--grau)">The hours worked are documented.</p>
          </div>
        </div>
      </div>
      <p class="mt-8 max-w-[62ch]" style="color:var(--grau)">
        <strong>You run your kitchen. Not the other way round.</strong>
      </p>
    </div>
  </section>

  {/* Wer bei Ihnen am Herd steht */}
 <section class="reveal section-gap" style="background:var(--papier)">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Who stands at your stove.</h2>
      <p class="leading-relaxed max-w-[62ch] mb-8" style="color:var(--grau)">
        Our chefs are permanently employed by Avorix and fully insured. Everyone we send is a trained chef with years of kitchen experience. <strong>We do not send kitchen assistants.</strong> We work in Germany and Austria.
      </p>
      <h3 class="mb-4">The hired chef leaves eventually. What he knows stays.</h3>
      <p class="leading-relaxed max-w-[62ch] mb-8" style="color:var(--grau)">
        Our chefs work with the Avorix Cook App and keep documenting as they go. You pay for staff and build our system into your kitchen along the way. With a conventional staffing agency, nothing remains once the placement ends. <strong>With us, the knowledge remains.</strong>
      </p>
      <a
        href="/en/contact"
        data-cta-location="staff-demo"
        class="btn btn-primary"
      >Book a Demo</a>
    </div>
  </section>

  {/* Rechtsteil, dunkler Block (G4: die Aussage, die von dieser Seite haengen bleibt).
       ACHTUNG: Diese Sektion geht zur anwaltlichen Gegenlese, Wortlaut nicht aendern. */}
 <section class="reveal section-gap section-dunkel" style="background:var(--eisen)">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--papier)">
        Why &bdquo;cheap self-employed&ldquo; chefs can cost you 50,000 euros.
      </h2>
      <p class="leading-relaxed mb-6 max-w-[62ch]" style="color:var(--papier);opacity:0.85">
        Many agencies send you &bdquo;self-employed&ldquo; chefs who invoice you with VAT. It sounds straightforward, but in most cases it is bogus self-employment: the chefs work to instructions, inside your operational routine, exactly like employees.
      </p>
      <p class="leading-relaxed mb-6 max-w-[62ch]" style="color:var(--papier);opacity:0.85">
        Here is what happens at the next social security audit. The auditors classify these chefs as bogus self-employed, and they do so in the vast majority of cases. The bill then goes not to the chef but to your business: all social security contributions, backdated three to four years. Depending on the scale, that quickly reaches 50,000 to 100,000 euros. The chef himself is usually nowhere to be found by then.
      </p>
      <p class="leading-relaxed mb-6 max-w-[62ch]" style="color:var(--papier);opacity:0.85">
        That is why we do it differently. Our chefs are permanently employed by Avorix and fully insured. We hold the official staffing licence issued by the Federal Employment Agency.
      </p>
      <p class="leading-relaxed max-w-[62ch]" style="color:var(--papier);opacity:0.85">
        Larger properties and hotel groups now book only companies that hold this licence, for exactly this reason. In hospitality, few providers do. Ask about it before you book anywhere. Even if it is not with us.
      </p>
    </div>
  </section>

  {/* Was ist Arbeitnehmerueberlassung.
       ACHTUNG: Diese Sektion geht zur anwaltlichen Gegenlese, Wortlaut nicht aendern.
       Der zweite Absatz traegt GENAU EINE Hervorhebung (Anweisung 20). */}
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">
        What is Arbeitnehmer&uuml;berlassung, and how does it protect you?
      </h2>
      <p class="leading-relaxed max-w-[62ch] mb-6" style="color:var(--grau)">
        Arbeitnehmer&uuml;berlassung, the German framework for hiring out employees, means this: the chef remains an employee of Avorix. We hold the employment contract, pay the wages and remit social security contributions and non-wage labour costs. You deploy the chef temporarily in your business, integrate him into your working routines and give him work-related instructions. For this you pay us the agreed hourly rate.
      </p>
      <p class="leading-relaxed max-w-[62ch]" style="color:var(--grau)">
        For this form of staffing, the provider generally requires a licence from the Federal Employment Agency, and Avorix holds one. <strong>The decisive advantage for you: the placement takes place openly and deliberately within the statutory framework for hiring out employees, and not through a legally questionable arrangement.</strong> You get qualified kitchen staff flexibly, and at the same time you reduce the legal risks of using external personnel.
      </p>
    </div>
  </section>

  {/* Ihre Gaeste */}
 <section class="reveal section-gap" style="background:var(--papier)">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Your guests experience your kitchen. Not ours.</h2>
      <p class="leading-relaxed max-w-[62ch]" style="color:var(--grau)">
        <strong>No guest notices that an Avorix chef is cooking alongside your team.</strong> We never name a client without their explicit consent, and on request we guarantee that in writing.
      </p>
    </div>
  </section>

  {/* Beweis-Block (Anweisung 30, Schritt 3): englische Fassung der deutschen
       Sektion "Aus dem laufenden Betrieb." auf /personal. Stelle wie dort --
       nach "Your guests experience your kitchen. Not ours.". Der Hinweis auf die
       Uebersetzung ist Pflicht, es ist eine echte Bewertung. */}
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">From day-to-day operations.</h2>
      <ul class="beweis-liste mb-8">
        <li>Over 1,000 placement days in our clients&rsquo; kitchens.</li>
        <li>One catering company sources around 15,000 hours a year through us.</li>
      </ul>
      <figure class="card card-text beweis-zitat mb-6">
        <p class="mb-3" style="color:var(--druck);font-weight:700">Proven in practice: the Seehotel Friedrichshafen.</p>
        <blockquote>
          <p class="leading-relaxed" style="color:var(--grau)">
            &ldquo;The Avorix system has stabilised our daily kitchen routine. We have raised the quality and at the same time massively reduced our dependence on the labour market.&rdquo;
          </p>
        </blockquote>
        <figcaption class="text-sm mt-4" style="color:var(--grau)">
          Translated from the German original.
        </figcaption>
      </figure>
      <figure class="card card-text beweis-zitat">
        <blockquote>
          <p class="leading-relaxed" style="color:var(--grau)">
            &ldquo;[&hellip;] I can highly recommend working with the Avorix team. Under the direction of head chef B&ouml;rge Penk, Avorix has supported us reliably and very professionally during peak loads, especially at busy trade fairs and larger congresses. The team fits into our routines very quickly, even with up to 20 cooks at once: well organised, calm under pressure, quality-conscious, with good timing and hygiene. [&hellip;]&rdquo;
          </p>
        </blockquote>
        <figcaption class="text-sm mt-4" style="color:var(--grau)">
          Kitchen director of a catering company, review from 25 February 2026. Translated from the German original.
        </figcaption>
      </figure>
    </div>
  </section>

  {/* Position 1 (Anweisung 37): A permanent head chef is a fixed cost */}
 <section class="reveal section-gap" style="background:var(--papier)">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">A permanent head chef is a fixed cost. Our chef is not.</h2>
      <p class="lead max-w-[62ch]" style="color:var(--grau)">
        A permanent head chef costs you the full salary every month, no matter how busy your house is. Add employer contributions, holiday entitlement and sick days. With an Avorix chef, you turn that fixed cost into a cost you control: you book what you need and end the assignment when things calm down.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 mt-10">
        <div class="card">
          <h3 class="mb-4">Predictable.</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">
            The hourly rate is fixed before the assignment starts. No hidden charges.
          </p>
        </div>
        <div class="card">
          <h3 class="mb-4">No surprises.</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">
            You pay for the assignment, not for the absences: sick days, holiday entitlements and employer contributions of a permanent hire do not apply.
          </p>
        </div>
        <div class="card">
          <h3 class="mb-4">No long-term commitment.</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">
            We convince through performance, not through contracts that lock you in.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Position 2 (Anweisung 37): One head chef for several houses */}
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">One head chef for several houses.</h2>
      <p class="lead max-w-[62ch]" style="color:var(--grau)">
        Not every house needs a top head chef full time. That is why several houses in a region share the expertise of one Avorix professional: he develops your menu, keeps the quality up and coaches your team. You get the kitchen of a big house without the payroll of a big house.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 mt-10">
        <div class="card">
          <h3 class="mb-4">Fixed monthly price.</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">
            Full planning certainty for your calculation.
          </p>
        </div>
        <div class="card">
          <h3 class="mb-4">Seasonal menus.</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">
            Four times a year, the head chef develops new, regional menus for your house.
          </p>
        </div>
        <div class="card">
          <h3 class="mb-4">Quality checks on site.</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">
            The head chef visits your business regularly, reviews your processes and coaches your team.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* FAQ */}
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-10" style="color:var(--druck)">Frequently asked questions</h2>
      <div class="faq-list">
        <details class="faq-item" open>
          <summary class="faq-q">Who are the Avorix chefs?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Permanently employed professionals with working experience in hotel and restaurant kitchens.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">What if the chef does not fit our team?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Then talk to us and we will find a solution. It does nobody any good if the chemistry is wrong.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">How does this work contractually?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Through a staffing contract (Arbeitnehmer&uuml;berlassungsvertrag) of the kind the Federal Employment Agency provides for. You sign a few more pages than you would for an agency invoice, and that is precisely what protects you.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Can a placement grow into more (training, your system)?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Yes, at any time. Many businesses start with a staff placement and build our system afterwards, so that the next absence is no longer an emergency.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">How quickly can someone be with us?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Usually within 24 to 72 hours, depending on location and requirements.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Is there a minimum placement period?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>No. A single day is just as possible as a whole season.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Can we book a chef only, without the app and the system?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>

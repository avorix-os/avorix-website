---
import BaseLayout from "../../layouts/BaseLayout.astro";


const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Book a Demo — Avorix",
  "description": "Contact Avorix for a demo or more information about the Avorix Cook App and our kitchen management software for hotels and restaurants.",
  "url": "https://avorix.de/en/contact",
  "inLanguage": "en",
  "mainEntity": {
    "@type": "Organization",
    "name": "Avorix",
    "url": "https://avorix.de",
    "email": "info@avorix.de",
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "info@avorix.de",
      "contactType": "sales",
      "availableLanguage": ["German", "English"]
    }
  }
};
---
<BaseLayout title="Book a Demo" description="Contact Avorix for a demo or more information about the Avorix Cook App and our kitchen management software for hotels and restaurants." schemaOrg={schema}>
 <section class="hero-section px-6">
    <div class="content-width">
      <p class="eyebrow mb-4">Free Initial Consultation</p>
      <h1 class="mb-4">Book a Demo</h1>
      <p class="lead mb-10 max-w-[62ch]" style="color:var(--grau)">Get to know Avorix in a personal demo call. We'll show you exactly how our solution supports your kitchen operations.</p>

      {/* Calendly Booking Widget */}
      <div class="card card-text mb-16">
        <h2 class="mb-6" style="color:var(--druck)">Book Your Demo Directly</h2>
        <p class="mb-6 max-w-[62ch]" style="color:var(--grau)">Pick a free slot in our calendar — <strong>no phone calls, no waiting</strong>.</p>
        <a
          href="https://calendly.com/avorix/kostenfreies-erstgesprach"
          target="_blank"
          rel="noopener"
          class="btn btn-primary"
        >
          Select a Time
        </a>
        <p class="text-sm mt-6" style="color:var(--grau)">Free &amp; no obligation · 30 minutes</p>
      </div>

      <p class="eyebrow mb-8">Or send us a message</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-16">
        {/* Contact details (compact card, §3.15) */}
        <div class="card" style="align-self:start">
          <h3 class="mb-4" style="font-size:14px;font-weight:600;color:var(--druck)">Email</h3>
          <a href="mailto:info@avorix.de" class="kontakt-mailto">
            info@avorix.de
          </a>
        </div>

        <p class="formular-pflicht">Fields marked * are the ones we need, everything else is optional.</p>
        <form id="contact-form" class="space-y-4" action="https://formspree.io/f/xqegwngo" method="POST">
          <input type="hidden" name="_subject" value="Demo request via avorix.de" />
          <div>
            <label for="name" class="block text-sm font-medium mb-2" style="color:var(--druck)">
              Name *
            </label>
            <input
              type="text"
              id="name"
              name="name"
              autocomplete="name"
              required
              class="kontakt-field w-full"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium mb-2" style="color:var(--druck)">
              Email *
            </label>
            <input
              type="email"
              id="email"
              name="email"
              autocomplete="email"
              required
              class="kontakt-field w-full"
            />
          </div>
          <div>
            <label for="message" class="block text-sm font-medium mb-2" style="color:var(--druck)">
              Message *
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="kontakt-field w-full"
            ></textarea>
          </div>
          <button
            type="submit"
            class="btn btn-primary w-full"
          >
            Send
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
/* E-Mail-Link: Kupfer-Farbe, Unterstrich bei Hover (§3.14) */
.kontakt-mailto {
  color: var(--akzent);
  text-decoration: underline;
}
.kontakt-mailto:hover {
  text-decoration: underline;
}

/* Formularfelder: Token-basiert nach §3.14 */
.kontakt-field {
  display: block;
  background: var(--flaeche);
  border: 1px solid var(--linie);
  border-radius: var(--radius);
  padding: 16px;
  font-size: 16px;
  font-family: var(--f-body);
  color: var(--druck);
  outline: none;
  box-sizing: border-box;
}
.kontakt-field:focus {
  border-color: var(--akzent);
  box-shadow: 0 0 0 3px rgba(168, 83, 43, 0.15);
}
.kontakt-field.error {
  border-color: var(--fehler);
}
textarea.kontakt-field {
  resize: none;
}
@media (prefers-reduced-motion: reduce) {
  .kontakt-field {
    transition: none;
  }
}
</style>

<script>
  const contactForm = document.getElementById('contact-form') as HTMLFormElement;
  if (contactForm) {
    let leadSent = false;
    contactForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = contactForm.querySelector('[type="submit"]') as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending…';
      }
      try {
        const response = await fetch(contactForm.action, {
          method: 'POST',
          body: new FormData(contactForm),
          headers: { 'Accept': 'application/json' },
        });
        if (response.ok && !leadSent) {
          leadSent = true;
          (window as any).dataLayer = (window as any).dataLayer || [];
          (window as any).dataLayer.push({ event: 'generate_lead', form_name: 'demo_kontakt' });
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = response.ok ? 'Sent ✔' : 'Send';
        }
        if (response.ok) {
          contactForm.reset();
        }
      } catch {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send';
        }
      }
    });
  }
</script>

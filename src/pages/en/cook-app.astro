---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { useTranslations } from "../../i18n/translations";
import Stempel from "../../components/Stempel.astro";

const t = useTranslations("en");

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Avorix Cook App",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web, iOS, Android",
  "description": "The Avorix Cook App guides your kitchen team step-by-step through every recipe — for consistent food quality, regardless of experience level.",
  "url": "https://avorix.cloud/en/cook-app",
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "EUR",
    "description": "Pilot program — free trial phase"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Avorix",
    "url": "https://avorix.cloud"
  }
};
---

<BaseLayout title="Cook App" description="The Avorix Cook App guides your kitchen team step-by-step through every recipe — for consistent food quality, regardless of experience level." schemaOrg={schema}>
  <!-- Hero -->
 <section class="pt-32 pb-16 px-6" style="background:var(--papier)">
    <div class="max-w-4xl mx-auto text-center">
      <p class="eyebrow mb-4">Avorix Cook App</p>
      <h1 class="mb-6" set:html={t("kochapp.tagline")}></h1>
      <p class="lead max-w-2xl mx-auto mb-10" style="color:var(--grau)">
        {t("kochapp.intro")}
      </p>
      <a href="/en/contact" class="btn btn-primary">
        {t("kochapp.cta.button")}
      </a>
    </div>
  </section>

  <!-- How it works -->
 <section class="py-[56px] md:py-[84px] px-6">
    <div class="max-w-5xl mx-auto">
 <h2 class="text-3xl font-bold text-neutral-900 mb-14">{t("kochapp.how.title")}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        <div class="text-center">
          <div class="schritt-chip inline-block mb-5">1</div>
          <h3 class="text-lg font-semibold text-neutral-900 mb-3">{t("kochapp.how.step1.title")}</h3>
          <p class="text-neutral-600 leading-relaxed">{t("kochapp.how.step1.text")}</p>
        </div>
        <div class="text-center">
          <div class="schritt-chip inline-block mb-5">2</div>
          <h3 class="text-lg font-semibold text-neutral-900 mb-3">{t("kochapp.how.step2.title")}</h3>
          <p class="text-neutral-600 leading-relaxed">{t("kochapp.how.step2.text")}</p>
        </div>
        <div class="text-center">
          <div class="schritt-chip inline-block mb-5">3</div>
          <h3 class="text-lg font-semibold text-neutral-900 mb-3">{t("kochapp.how.step3.title")}</h3>
          <p class="text-neutral-600 leading-relaxed">{t("kochapp.how.step3.text")}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
 <section class="py-[56px] md:py-[84px] px-6">
    <div class="max-w-5xl mx-auto">
 <h2 class="text-3xl font-bold text-neutral-900 mb-14">{t("kochapp.features.title")}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
        <div class="card">
          <h3 class="font-bold text-neutral-900 mb-3">{t("kochapp.features.1.title")}</h3>
          <p class="text-neutral-600 leading-relaxed">{t("kochapp.features.1.text")}</p>
        </div>
        <div class="card">
          <h3 class="font-bold text-neutral-900 mb-3">{t("kochapp.features.2.title")}</h3>
          <p class="text-neutral-600 leading-relaxed">{t("kochapp.features.2.text")}</p>
        </div>
        <div class="card">
          <h3 class="font-bold text-neutral-900 mb-3">{t("kochapp.features.3.title")}</h3>
          <p class="text-neutral-600 leading-relaxed">{t("kochapp.features.3.text")}</p>
        </div>
        <div class="card">
          <h3 class="font-bold text-neutral-900 mb-3">{t("kochapp.features.4.title")}</h3>
          <p class="text-neutral-600 leading-relaxed">{t("kochapp.features.4.text")}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
 <section class="py-[56px] md:py-[84px] px-6">
    <div class="max-w-2xl mx-auto text-center">
      <div class="mb-6">
        <Stempel>Certified &middot; German staffing licence</Stempel>
      </div>
      <p class="mb-8" style="font-family:Charter, Georgia, serif; font-style:italic; font-size:24px; color:var(--druck)">It&rsquo;s sorted.</p>
      <a href="/en/contact" class="btn btn-primary">
        {t("kochapp.cta.button")}
      </a>
    </div>
  </section>
</BaseLayout>

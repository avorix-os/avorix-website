---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { useTranslations } from "../../i18n/translations";
import Stempel from "../../components/Stempel.astro";
import { Image } from "astro:assets";
import Lightbox from "../../components/Lightbox.astro";
import appPreisvergleich from "../../assets/bilder/app-preisvergleich.png";
import appWirtschaftlichkeit from "../../assets/bilder/app-wirtschaftlichkeit.png";

const t = useTranslations("en");

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Avorix Cook App",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web, iOS, Android",
  "description": "The Avorix Cook App guides your kitchen team step-by-step through every recipe — for consistent food quality, regardless of experience level.",
  "url": "https://avorix.cloud/en/cook-app",
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "EUR",
    "description": "Pilot program — free trial phase"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Avorix",
    "url": "https://avorix.cloud"
  }
};
---

<BaseLayout title="Cook App" description="The Avorix Cook App guides your kitchen team step-by-step through every recipe — for consistent food quality, regardless of experience level." schemaOrg={schema}>
  <!-- Hero (W2: Text-Hero, left-aligned) -->
 <section class="hero-section px-6" style="background:var(--papier)">
    <div class="content-width">
      <p class="eyebrow mb-4">Avorix Cook App</p>
      <h1 class="mb-6" set:html={t("kochapp.tagline")}></h1>
      <p class="lead max-w-[62ch] mb-10" style="color:var(--grau)">
        {t("kochapp.intro")}
      </p>
      <a href="/en/contact" class="btn btn-primary">
        {t("kochapp.cta.button")}
      </a>
    </div>
  </section>

  <!-- How it works -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-14" style="color:var(--druck)">{t("kochapp.how.title")}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        <div>
          <div class="schritt-chip inline-flex mb-5">1</div>
          <h3 class="mb-3">{t("kochapp.how.step1.title")}</h3>
          <p class="leading-relaxed" style="color:var(--grau)">{t("kochapp.how.step1.text")}</p>
        </div>
        <div>
          <div class="schritt-chip inline-flex mb-5">2</div>
          <h3 class="mb-3">{t("kochapp.how.step2.title")}</h3>
          <p class="leading-relaxed" style="color:var(--grau)">{t("kochapp.how.step2.text")}</p>
        </div>
        <div>
          <div class="schritt-chip inline-flex mb-5">3</div>
          <h3 class="mb-3">{t("kochapp.how.step3.title")}</h3>
          <p class="leading-relaxed" style="color:var(--grau)">{t("kochapp.how.step3.text")}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
 <section class="reveal section-gap" style="background:var(--papier)">
    <div class="content-width">
      <h2 class="mb-14" style="color:var(--druck)">{t("kochapp.features.title")}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
        <div class="card">
          <h3 class="mb-3">{t("kochapp.features.1.title")}</h3>
          <p class="leading-relaxed" style="color:var(--grau)">{t("kochapp.features.1.text")}</p>
        </div>
        <div class="card">
          <h3 class="mb-3">{t("kochapp.features.2.title")}</h3>
          <p class="leading-relaxed" style="color:var(--grau)">{t("kochapp.features.2.text")}</p>
        </div>
        <div class="card">
          <h3 class="mb-3">{t("kochapp.features.3.title")}</h3>
          <p class="leading-relaxed" style="color:var(--grau)">{t("kochapp.features.3.text")}</p>
        </div>
        <div class="card">
          <h3 class="mb-3">{t("kochapp.features.4.title")}</h3>
          <p class="leading-relaxed" style="color:var(--grau)">{t("kochapp.features.4.text")}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Add-on modules (12c) -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">If you want more: two add-on modules.</h2>
      <p class="max-w-[62ch] mb-8" style="color:var(--grau)">
        Both build on what your kitchen already uses. Avorix Preisvergleich requires the Warenwirtschaft package, Avorix Manager additionally the Organisation package.
      </p>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="card-modul">
          <div class="card-modul-header">
            <span class="card-modul-label">Add-on module</span>
            <span class="card-modul-leader"></span>
          </div>
          <h3 class="mb-3">Avorix Preisvergleich</h3>
          <p class="text-sm mb-3" style="color:var(--grau)">
            Suppliers and offers in one place. You upload your suppliers&rsquo; price lists, the app merges identical products and shows you the best price per item. Buying on gut feeling ends here.
          </p>
          <p class="text-sm" style="color:var(--grau)">
            One business already compares 802 items from five suppliers.
          </p>
          <div class="mt-6">
            <Lightbox label="PRICE COMPARISON" caption="Screenshot of the Avorix Cook App: price comparison showing the best price per item across several suppliers" zoomText="enlarge">
              <Image
                src={appPreisvergleich}
                alt="Screenshot of the Avorix Cook App: price comparison showing the best price per item across several suppliers"
                widths={[480, 800]}
                sizes="(max-width: 768px) 90vw, (max-width: 1280px) 45vw, 520px"
                loading="lazy"
                decoding="async"
                class="w-full h-auto"
              />
            </Lightbox>
          </div>
        </div>
        <div class="card-modul">
          <div class="card-modul-header">
            <span class="card-modul-label">Add-on module</span>
            <span class="card-modul-leader"></span>
          </div>
          <h3 class="mb-3">Avorix Manager</h3>
          <p class="text-sm" style="color:var(--grau)">
            Food cost, labour cost and gross profit, every month at a glance, with target values and a traffic light. Management sees everything, the head chef sees their share of the costs. Monthly closing and export are included.
          </p>
          <div class="mt-6">
            <Lightbox label="MANAGER" caption="Screenshot of the Avorix Cook App: monthly analysis of food cost, labour cost and gross profit" zoomText="enlarge">
              <Image
                src={appWirtschaftlichkeit}
                alt="Screenshot of the Avorix Cook App: monthly analysis of food cost, labour cost and gross profit"
                widths={[480, 800]}
                sizes="(max-width: 768px) 90vw, (max-width: 1280px) 45vw, 520px"
                loading="lazy"
                decoding="async"
                class="w-full h-auto"
              />
            </Lightbox>
          </div>
        </div>
      </div>
      <p class="text-sm mt-8 max-w-[62ch]" style="color:var(--grau)">
        What the modules cost, we will work out with you in the first call, to the euro. Early adopters also get the 2026 pilot conditions.
      </p>
    </div>
  </section>

  <!-- CTA → Peak-End (3.18) -->
 <section class="reveal section-gap" style="background:var(--papier)">
    <div class="content-width text-center">
      <div class="mb-6">
        <Stempel>Certified &middot; German staffing licence</Stempel>
      </div>
      <p class="mb-8" style="font-family:Charter, Georgia, serif; font-style:italic; font-size:24px; color:var(--druck)">It&rsquo;s sorted.</p>
      <a href="/en/contact" class="btn btn-primary">
        {t("kochapp.cta.button")}
      </a>
    </div>
  </section>
</BaseLayout>

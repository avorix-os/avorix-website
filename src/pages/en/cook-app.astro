---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Stempel from "../../components/Stempel.astro";
import { Image } from "astro:assets";
import Lightbox from "../../components/Lightbox.astro";
import appPreisvergleich from "../../assets/bilder/app-preisvergleich.png";


const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Avorix Cook App",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web, iOS, Android",
  "description": "The Avorix Cook App guides your kitchen team step-by-step through every recipe — for consistent food quality, regardless of experience level.",
  "url": "https://avorix.cloud/en/cook-app",
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "EUR",
    "description": "Pilot program — free trial phase"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Avorix",
    "url": "https://avorix.cloud"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Will my team actually go along with this?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "This objection comes up almost every time, and it almost always disappears within the first week. For two reasons: training happens at the stove, led by a chef with sous-chef experience or above who knows your team’s daily reality. And the app takes work off the team instead of monitoring them: no hunting for notes, no asking around, no debates about quantities. Anyone who has cooked with it for a week does not want to give it back."
      }
    }
  ]
};
---
<BaseLayout title="Cook App" description="The Avorix Cook App guides your kitchen team step-by-step through every recipe — for consistent food quality, regardless of experience level." schemaOrg={[schema, faqSchema]}>
  <!-- Hero (W2: Text-Hero, left-aligned) -->
 <section class="hero-section px-6" style="background:var(--papier)">
    <div class="content-width">
      <p class="eyebrow mb-4">Avorix Cook App</p>
      <h1 class="mb-6">Step by Step to a <mark>Perfect Kitchen</mark></h1>
      <p class="lead max-w-[62ch] mb-10" style="color:var(--grau)">
        The Avorix Cook App guides your kitchen team through every recipe — precisely, visually, and in real time. Consistent quality, <strong>no matter who's at the stove</strong>.
      </p>
      <a href="/en/contact" class="btn btn-primary">
        Request a Demo
      </a>
    </div>
  </section>

  <!-- How it works -->
  <!-- Korrektur 6.4 (Anweisung 29): Das Zahlen-Banner stand nur auf der
       deutschen Seite. Dieselbe Stelle, dieselbe Komponente, Subline oben
       wie in Korrektur 9. -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Measured in one customer&rsquo;s business.</h2>
      <p class="mb-10 max-w-[62ch]" style="color:var(--grau)">The app already pays for itself there.</p>
      <div class="grid sm:grid-cols-2 gap-6">
        <div class="card">
          <p class="mb-6" style="font-family:var(--f-head);font-weight:700;font-size:clamp(36px,5vw,48px);line-height:1.05;letter-spacing:-0.008em;color:var(--druck)">around 15&nbsp;%</p>
          <p style="color:var(--grau)">less labour input, with no compromise on standards</p>
        </div>
        <div class="card">
          <p class="mb-6" style="font-family:var(--f-head);font-weight:700;font-size:clamp(36px,5vw,48px);line-height:1.05;letter-spacing:-0.008em;color:var(--druck)">around 20&nbsp;%</p>
          <p style="color:var(--grau)">lower purchasing costs, from process, app and price comparison combined</p>
        </div>
      </div>
    </div>
  </section>

 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-10 md:mb-16" style="color:var(--druck)">How the Cook App Works</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-10">
        <div>
          <div class="schritt-chip inline-flex mb-6">1</div>
          <h3 class="mb-4">Choose a Recipe</h3>
          <p class="leading-relaxed" style="color:var(--grau)">The kitchen team selects the desired dish from the digital recipe library — on a tablet or smartphone, directly in the kitchen.</p>
        </div>
        <div>
          <div class="schritt-chip inline-flex mb-6">2</div>
          <h3 class="mb-4">Step-by-Step Guidance</h3>
          <p class="leading-relaxed" style="color:var(--grau)">Each step is displayed clearly and intuitively — with quantities, timings, and photos. <strong>No room for interpretation</strong>, no mistakes.</p>
        </div>
        <div>
          <div class="schritt-chip inline-flex mb-6">3</div>
          <h3 class="mb-4">Consistent Results</h3>
          <p class="leading-relaxed" style="color:var(--grau)">The dish turns out to standard — regardless of the cook's experience level. <strong>Quality becomes reproducible.</strong></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Add-on modules (12c) -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">If you want more: two add-on modules.</h2>
      <p class="max-w-[62ch] mb-8" style="color:var(--grau)">
        Both build on what your kitchen already uses. Avorix Preisvergleich requires the Warenwirtschaft package, Avorix Manager additionally the Organisation package.
      </p>
      <div class="grid sm:grid-cols-2 gap-6">
        <div class="card-modul">
          <div class="card-modul-header">
            <span class="card-modul-label">Add-on module</span>
            <span class="card-modul-leader"></span>
          </div>
          <h3 class="mb-4">Avorix Preisvergleich</h3>
          <p class="text-sm mb-6" style="color:var(--grau)">
            Suppliers and offers in one place. You upload your suppliers&rsquo; price lists, the app merges identical products and shows you the best price per item. <strong>Buying on gut feeling ends here.</strong>
          </p>
          <p class="text-sm" style="color:var(--grau)">
            One customer&rsquo;s kitchen now runs 802 items from five suppliers through it.
          </p>
          <div class="mt-6">
            <Lightbox label="PRICE COMPARISON" caption="Screenshot of the Avorix cook app: price comparison showing the best price per item across several suppliers" zoomText="enlarge" flach>
              <Image
                src={appPreisvergleich}
                alt="Screenshot of the Avorix cook app: price comparison showing the best price per item across several suppliers"
                widths={[480, 800]}
                sizes="(max-width: 768px) 90vw, (max-width: 1280px) 45vw, 520px"
                loading="lazy"
                decoding="async"
                class="w-full h-auto"
              />
            </Lightbox>
          </div>
        </div>
        <div class="card-modul">
          <div class="card-modul-header">
            <span class="card-modul-label">Add-on module</span>
            <span class="card-modul-leader"></span>
          </div>
          <h3 class="mb-4">Avorix Manager</h3>
          <p class="text-sm" style="color:var(--grau)">
            Food cost, labour cost and gross profit, every month at a glance, with target values and a traffic light. Management sees everything, the head chef sees their share of the costs. Monthly closing and export are included. <strong>You see it during the month, not in the annual accounts.</strong>
          </p>
        </div>
      </div>
      <p class="text-sm mt-8 max-w-[62ch]" style="color:var(--grau)">
        What the modules cost, we will work out with you in the first call, to the euro. Early adopters also get the 2026 pilot conditions.
      </p>
    </div>
  </section>

  <!-- FAQ (Anweisung 30, Schritt 5): Die Seite hatte noch keine FAQ-Liste und
       keine FAQ-Auszeichnung. Stelle wie auf der deutschen /koch-app: letzte
       Inhaltssektion vor dem Schlussbaustein. -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Frequently asked questions</h2>
      <div class="faq-list">
        <!-- Team-Einwand (Anweisung 30, Schritt 5) -->
        <details class="faq-item open">
          <summary class="faq-q">Will my team actually go along with this?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>This objection comes up almost every time, and it almost always disappears within the first week. For two reasons: training happens at the stove, led by a chef with sous-chef experience or above who knows your team&rsquo;s daily reality. And the app takes work off the team instead of monitoring them: no hunting for notes, no asking around, no debates about quantities. Anyone who has cooked with it for a week does not want to give it back.</p></div></div>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA → Peak-End (3.18) -->
 <section class="reveal section-gap" style="background:var(--papier)">
    <div class="content-width text-center">
      <div class="mb-6">
        <Stempel>Certified &middot; German staffing licence</Stempel>
      </div>
      <p class="mb-8" style="font-family:Charter, Georgia, serif; font-style:italic; font-size:24px; color:var(--druck)">It&rsquo;s sorted.</p>
      <a href="/en/contact" class="btn btn-primary">
        Request a Demo
      </a>
    </div>
  </section>
</BaseLayout>

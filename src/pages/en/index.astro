---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image, getImage } from "astro:assets";
import Lightbox from "../../components/Lightbox.astro";
import Stempel from "../../components/Stempel.astro";
import kochAppTabletPass from "../../assets/bilder/koeche-am-pass-mit-tablet.jpg";
import leerenPassMorgens from "../../assets/bilder/leerer-pass-morgens.jpg";
import waageZutaten from "../../assets/bilder/waage-zutaten.jpg";
import appKochmodus1 from "../../assets/bilder/app-kochmodus-schritt1.png";
import appPortionsrechner from "../../assets/bilder/app-rezept-detail-portionsrechner.png";
import appRezepteListe from "../../assets/bilder/app-rezepte-liste.png";

const ogImg = await getImage({ src: kochAppTabletPass, width: 1200, format: "jpeg" });
const ogImageAlt = "Two chefs at the pass of a professional kitchen with a tablet showing the Avorix Cook App";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": ["Organization", "EmploymentAgency"],
    "@id": "https://avorix.de/#organization",
    "name": "AVORIX GmbH",
    "legalName": "AVORIX GmbH",
    "alternateName": "Avorix",
    "url": "https://avorix.de/",
    "logo": {
      "@type": "ImageObject",
      "url": "https://avorix.de/avorix-logo-quadrat-dunkel.png",
      "width": 1024,
      "height": 1024
    },
    "image": "https://avorix.de/avorix-logo-quadrat-dunkel.png",
    "description": "Permanently employed chefs when yours is missing, usually within 24 to 72 hours. Plus the Cook App and training, so your kitchen holds your standard.",
    "telephone": "+49 7541 3973915",
    "email": "info@avorix.de",
    "founder": {
      "@type": "Person",
      "@id": "https://avorix.de/ueber-uns/#boerge-penk",
      "name": "Börge Penk"
    },
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Fallenbrunnen 14",
      "postalCode": "88045",
      "addressLocality": "Friedrichshafen",
      "addressCountry": "DE"
    },
    "areaServed": ["DE", "AT"],
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "08:00",
      "closes": "17:00"
    },
    "hasMap": "https://maps.google.com/?cid=3756241428225524465",
    "vatID": "DE368762673",
    "identifier": {
      "@type": "PropertyValue",
      "propertyID": "Handelsregister",
      "value": "HRB 751118, Amtsgericht Ulm"
    },
    "sameAs": [
      "https://maps.google.com/?cid=3756241428225524465",
      "https://www.linkedin.com/company/avorix-gmbh/",
      "https://www.provenexpert.com/de-de/avorix-personalloesungen/"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "SpeakableSpecification",
    "cssSelector": "#direktantwort"
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Who types in our recipes?",
        "acceptedAnswer": { "@type": "Answer", "text": "We do. An Avorix chef comes to you, cooks with your team and sets up every dish in the app. You do not have to enter anything yourselves." }
      },
      {
        "@type": "Question",
        "name": "Will our guests notice anything?",
        "acceptedAnswer": { "@type": "Answer", "text": "No. Your guests experience your kitchen and your recipes, just reliably at the same quality. On request we guarantee in writing that we never name your business as a reference." }
      },
      {
        "@type": "Question",
        "name": "Our team is not very tech-minded. Will this still work?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes, that is what the app is built for. Anyone who can look at a photo and tick a box can work with it. Training happens right at the stove, not in a seminar room." }
      },
      {
        "@type": "Question",
        "name": "What happens to our recipes? Who owns them?",
        "acceptedAnswer": { "@type": "Answer", "text": "You do. Your recipes remain your property and are never passed on to other businesses." }
      },
      {
        "@type": "Question",
        "name": "How quickly are we up and running?",
        "acceptedAnswer": { "@type": "Answer", "text": "From the first call to working independently typically takes a few weeks, depending on the menu. You get the exact plan after the first call." }
      },
      {
        "@type": "Question",
        "name": "What technology do we need in the kitchen?",
        "acceptedAnswer": { "@type": "Answer", "text": "A tablet or smartphone and an internet connection. Nothing more. The app runs in the browser." }
      },
      {
        "@type": "Question",
        "name": "Does it replace our head chef?",
        "acceptedAnswer": { "@type": "Answer", "text": "No. A good head chef gets better with Avorix, because his knowledge is finally captured and his team works more independently. Avorix helps most when the head chef is missing, off sick or moving on." }
      },
      {
        "@type": "Question",
        "name": "We are in Austria. Does that work?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes, we work in Germany and Austria." }
      },
      {
        "@type": "Question",
        "name": "Does it taste freshly cooked?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Vacuum sealing preserves flavour, texture and nutrients. Dishes are regenerated only when the guest orders, precisely and within minutes." }
      },
      {
        "@type": "Question",
        "name": "Do we need new equipment?",
        "acceptedAnswer": { "@type": "Answer", "text": "Usually not. In most kitchens the existing equipment is enough. What you genuinely lack we clarify in the free first call." }
      },
      {
        "@type": "Question",
        "name": "Do you also offer standalone F&B consulting?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. If for now you only want an outside look at your menu, processes and costing, we do that too. Just raise it in the first call." }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "url": "https://avorix.de/en",
    "primaryImageOfPage": {
      "@type": "ImageObject",
      "url": `https://avorix.de${ogImg.src}`,
      "description": ogImageAlt
    }
  }
];
---

<BaseLayout
  title="Cook App, Training & Kitchen Staff for Hotels"
  description="Permanently employed chefs when yours is missing, usually within 24 to 72 hours. Plus the Cook App and training, so your kitchen holds your standard."
  ogImage={ogImg.src}
  ogImageAlt={ogImageAlt}
  schemaOrg={schema}
>
  {/* D0 Hero: photo bleeding to the right edge, text at the content edge */}
  <section class="home-hero">
    <div class="home-hero-grid">
      <div class="home-hero-copy">
        <p class="eyebrow mb-4">Kitchen Staff &amp; Cook App</p>
        <h1>
          Your kitchen <mark>holds your standard.</mark><br />Even when your best chef is missing.
        </h1>
        <p class="lead">
          Avorix helps twice: a chef straight away when yours is missing. And a system so it never comes to that again.
        </p>
        <div class="hero-buttons">
          <a href="/en/staff#request" data-cta-location="hero" data-cta-event="cta_personal_click" class="btn btn-primary">Request Staff</a>
          <a href="/en/contact" data-cta-location="hero" class="btn btn-secondary">Book a Demo</a>
        </div>
        <div class="hero-beleg">
          <Stempel lang="en" />
          <div class="hero-beleg-text">
            <span>Built by chefs, not by software people</span>
            <span>Friedrichshafen on Lake Constance &middot; DE + AT</span>
          </div>
        </div>
      </div>
      <div class="home-hero-media">
        <Image
          src={kochAppTabletPass}
          alt="Two chefs at the pass of a professional kitchen with a tablet showing the Avorix Cook App"
          widths={[480, 800, 1200, 1600, 2000]}
          sizes="(max-width: 900px) 100vw, 50vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  {/* D1 Direct answer (GEO) */}
  <section class="reveal section-gap">
    <div class="content-width">
      <p id="direktantwort" class="einordnung-text">Avorix is a kitchen system for hotels and hospitality from Friedrichshafen on Lake Constance. It combines legally compliant kitchen staffing under the official German staffing licence, the Avorix Cook App for guided work, which takes kitchen teams step by step through every dish, and training by experienced chefs. Avorix works in Germany and Austria.</p>
    </div>
  </section>

  {/* D2 Problem: text + photo, then list with lines */}
  <section class="reveal section-gap">
    <div class="content-width">
      <div class="schmerz-top">
        <div>
          <h2>Does this sound familiar?</h2>
          <p class="lead">Your kitchen stands or falls with a single person.</p>
          <p class="schmerz-absatz">When the kitchen wobbles, everything wobbles: <strong>first the quality, then the reviews, then the reputation.</strong> And at some point the question is in the room how much longer this can go on. You are not alone in this: a shortage of skilled kitchen staff is an issue in almost every kitchen.</p>
        </div>
        <div class="schmerz-bild">
          <Image
            src={leerenPassMorgens}
            alt="The empty pass of a professional kitchen in the morning light"
            widths={[480, 800, 1200, 1600]}
            sizes="(max-width: 900px) 100vw, 520px"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
      <ul class="schmerz-liste">
        <li>
          <h3>The head chef resigns. Or the sous chef. Mid-season.</h3>
          <p>With every key person, knowledge walks out: the recipes, the quantities, the routines. The rest of the team stands there and improvises.</p>
        </li>
        <li>
          <h3>Everyone cooks differently.</h3>
          <p>On Monday the schnitzel tastes different than on Friday. Portions fluctuate. Regulars notice first.</p>
        </li>
        <li>
          <h3>You simply cannot find anyone.</h3>
          <p>Nobody who can cook replies to your job ad. And if someone does, they are gone again after one season.</p>
        </li>
      </ul>
    </div>
  </section>

  {/* D3 Where do you stand: the only cards of the page (section-band) */}
  <section class="reveal section-gap section-band">
    <div class="content-width">
      <h2>Where do you stand right now?</h2>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">
        <div class="card tuer-card">
          <h3>&bdquo;The emergency is here.&ldquo;</h3>
          <p>The chef is gone, the season is running. We send you a chef. And make sure you never have to search again.</p>
          <a href="/en/staff#request" data-cta-location="tuer-notfall" data-cta-event="cta_personal_click" class="btn btn-primary tuer-btn">Get help now</a>
        </div>
        <div class="card tuer-card">
          <h3>&bdquo;It still works. But I am getting worried.&ldquo;</h3>
          <p>Your kitchen stands or falls with a single person. Secure their knowledge while it is still in the house.</p>
          <a href="/en/system" data-cta-location="tuer-sorge" class="btn btn-secondary tuer-btn">Secure the knowledge</a>
        </div>
        <div class="card tuer-card">
          <h3>&bdquo;The season is coming.&ldquo;</h3>
          <p>Not enough people for the peak. Seasonal staff who cook like your core team from day one.</p>
          <a href="/en/staff#request" data-cta-location="tuer-saison" data-cta-event="cta_personal_click" class="btn btn-secondary tuer-btn">Plan the season</a>
        </div>
      </div>
    </div>
  </section>

  {/* D4 Why Avorix: three columns with line on top */}
  <section class="reveal section-gap">
    <div class="content-width">
      <h2>Why Avorix</h2>
      <div class="warum-spalten">
        <div class="spalte-linie">
          <h3>Consistent quality</h3>
          <p>Standardised processes and the Avorix Cook App keep the quality of your food consistent, whatever the experience level of your kitchen team.</p>
        </div>
        <div class="spalte-linie">
          <h3>Less dependence on individuals</h3>
          <p>The knowledge lives in the system, not only in a few heads. Avorix makes your business less dependent on single key people. And new staff cook along from day one.</p>
        </div>
        <div class="spalte-linie">
          <h3>Full cost control</h3>
          <p>Recipe-based costing, food cost tracking and standardised portioning bring transparency into your kitchen costs.</p>
        </div>
      </div>
    </div>
  </section>

  {/* D5 What is Avorix: line on top, text + photo, then three steps */}
  <section id="how-it-works" class="reveal section-gap">
    <div class="content-width linie-oben">
      <div class="was-top">
        <div>
          <h2>What is Avorix? Explained in one minute.</h2>
          <p class="lead">Software, routines and staff from one provider. Nowhere else in this combination.</p>
          <p class="was-absatz">Think of a sat nav. A sat nav gets every driver to the destination, even if they do not know the route. Avorix does the same in your kitchen: it guides your team step by step through every dish on your menu, with clear instructions, proven routines and real chefs who train your team. So that every plate goes out the way you want it. Every day. We call it guided work.</p>
        </div>
        <div class="was-bild">
          <Image
            src={waageZutaten}
            alt="Ingredients being weighed on a digital scale in a professional kitchen"
            widths={[480, 800, 1200, 1600]}
            sizes="(max-width: 900px) 100vw, 420px"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
      <div class="was-schritte">
        <div class="spalte-linie">
          <p class="schritt-label">Step 1</p>
          <h3>Your dishes, written down crystal clear.</h3>
          <p>An experienced Avorix chef comes to your business and writes down your menu. Every dish is broken into simple steps, with photos, exact quantities and timings. And honestly: many kitchens have recipes, yet everyone cooks by feel. With the app, the recipe hangs right at the station, and the easiest way is the right one.</p>
        </div>
        <div class="spalte-linie">
          <p class="schritt-label">Step 2</p>
          <h3>Routines that even a small team can manage.</h3>
          <p>A lot is prepared calmly when there is time. Vacuum-sealed and chilled. During service you only finish. That is how a small crew handles an ambitious menu without the quality suffering. Professional kitchens have worked this way for years.</p>
        </div>
        <div class="spalte-linie">
          <p class="schritt-label">Step 3</p>
          <h3>The Cook App at the stove.</h3>
          <p>A tablet hangs at the station. The app shows the cook step by step what to do: photo, quantity, time, done. The app scales portions automatically and keeps an eye on food cost.</p>
        </div>
      </div>
      <p class="was-kosten"><strong>And your costs?</strong> Trained chefs are expensive, if you can find any at all. With Avorix, semi-skilled staff cook to your standard, and your skilled people only do what genuinely needs their skill.</p>
    </div>
  </section>

  {/* D6 And when you are short of staff (dark block, two columns, no seal) */}
  <section class="reveal section-gap section-dunkel">
    <div class="content-width">
      <div class="dunkel-grid">
        <h2>And when you are <span>short of staff</span>?</h2>
        <div>
          <p class="dunkel-absatz">Avorix helps twice: a chef straight away when yours is missing. And a system so it never comes to that again. Our chefs are <span class="dunkel-hell">permanently employed</span> with us and hired out on <span class="dunkel-hell">solid legal ground</span>. For the training phase, for the season or for the emergency.</p>
          <a href="/en/staff#request" data-cta-location="personal-dunkel" data-cta-event="cta_personal_click" class="btn btn-primary">Request Staff</a>
        </div>
      </div>
    </div>
  </section>

  {/* D7 How Avorix comes into your business: the Bon (section-band) */}
  <section class="reveal section-gap section-band">
    <div class="content-width">
      <div class="bon-layout">
        <div class="bon-copy">
          <h2>How Avorix comes into your business. In four steps.</h2>
          <a href="/en/contact" data-cta-location="ablauf" class="btn btn-primary bon-cta">Book a Demo</a>
        </div>
        <div class="bon-wrap">
          <div class="bon">
            <div aria-hidden="true">
              <p class="bon-kopf"><span>AVORIX</span><span>YOUR START</span></p>
              <p class="bon-unterkopf"><span>Friedrichshafen</span><span>4 steps</span></p>
              <hr />
            </div>
            <ol>
              <li><div><b>We take a look at your kitchen. (Free of charge)</b><span>One conversation, 30 minutes, by video or on site. You tell us where it hurts. We tell you honestly whether Avorix suits you. If not, we say that too.</span></div></li>
              <li><div><b>An Avorix chef records your menu.</b><span>He cooks with your team, documents every dish, photographs every step and sets it all up in the app. Typically that takes a week.</span></div></li>
              <li><div><b>Your team learns the system.</b><span>There are two ways, depending on what suits your business: compact training days with an Avorix chef who concentrates fully on the training. Or an Avorix chef works in your kitchen as normal and teaches your team the system alongside, while cooking productively. In both cases with sous-chef experience or above.</span></div></li>
              <li><div><b>You work independently. We stay reachable.</b><span>From now on the app guides your team through every day. You add new dishes yourselves, or we do it for you. And if a chef drops out, you call us.</span></div></li>
            </ol>
            <hr />
            <p class="bon-fuss">You run your kitchen.<br />Not the other way round.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* D8 This is what it looks like at the stove: screenshots without cards, dark ground */}
  <section class="reveal section-gap">
    <div class="content-width">
      <h2>This is what it looks like at the stove.</h2>
      <div class="herd-grid grid sm:grid-cols-2 md:grid-cols-3 gap-4">
        <Lightbox label="RECIPE STEP" caption={`„Every step with quantity, temperature and time. Tick it off.“`} flach zoomText="enlarge">
          <Image
            src={appKochmodus1}
            alt="Screenshot of the Avorix Cook App: recipe step in cooking mode with temperature and timer"
            widths={[480, 800]}
            sizes="(max-width: 768px) 90vw, (max-width: 1280px) 30vw, 360px"
            loading="lazy"
            decoding="async"
            class="w-full h-auto"
          />
        </Lightbox>
        <Lightbox label="PORTION CALCULATOR" caption={`„80 guests today instead of 60? The app rescales every quantity.“`} flach zoomText="enlarge">
          <Image
            src={appPortionsrechner}
            alt="Screenshot of the Avorix Cook App: portion calculator scaling a recipe to 80 portions"
            widths={[480, 800]}
            sizes="(max-width: 768px) 90vw, (max-width: 1280px) 30vw, 360px"
            loading="lazy"
            decoding="async"
            class="w-full h-auto"
          />
        </Lightbox>
        <Lightbox label="RECIPE LIBRARY" caption={`„Your whole menu in one place. For the whole team.“`} flach zoomText="enlarge">
          <Image
            src={appRezepteListe}
            alt="Screenshot of the Avorix Cook App: recipe library with categories, times and cost per portion"
            widths={[480, 800]}
            sizes="(max-width: 768px) 90vw, (max-width: 1280px) 30vw, 360px"
            loading="lazy"
            decoding="async"
            class="w-full h-auto"
          />
        </Lightbox>
      </div>
      <p class="herd-hinweis">The app runs on tablet and smartphone, straight in the browser. Nothing needs installing.</p>
    </div>
  </section>

  {/* D9 Legal certainty: line on top, two columns, no box */}
  <section class="reveal section-gap">
    <div class="content-width linie-oben">
      <div class="leihen-grid">
        <h2>And when you are short of staff: we hire out our chefs to you. On solid legal ground.</h2>
        <div>
          <p class="leihen-p">Many agencies send you &bdquo;self-employed&ldquo; chefs with an invoice. The problem: in an audit, the pension insurance often classifies these chefs as bogus self-employed. Then it is not the chef who pays, but your business. Back payments over several years, quickly well into five figures.</p>
          <p class="leihen-p">That does not happen to you with Avorix. Our chefs are permanently employed and fully insured with us. We hold the official German staffing licence. You get skill into your kitchen and stay on the safe side.</p>
          <p class="leihen-p leihen-fett">In hospitality, few providers hold this licence. Ask for it before you book anywhere. Even if it is not with us.</p>
          <a href="/en/staff" data-cta-location="rechtssicherheit" class="btn btn-secondary">More on training and staff</a>
        </div>
      </div>
    </div>
  </section>

  {/* D10 Built by a head chef: text + quote (section-band) */}
  <section class="reveal section-gap section-band">
    <div class="content-width">
      <h2>Built by a head chef. Not by software people.</h2>
      <p class="gruender-p">Börge Penk worked in professional kitchens for 20 years, as head chef also with large teams. He knows the staff shortage not from statistics but from every single duty rota. Avorix is the system he wishes he had had as a head chef.</p>
      <p class="gruender-p">We know the feeling. We have stood in kitchens like that ourselves.</p>
      <blockquote class="gruender-quote">&bdquo;I have seen too often that a kitchen stands or falls with a single person. It does not have to be that way. Good cooking can be written down, shown and taught.&ldquo;</blockquote>
      <p class="gruender-diskret">You will not find client logos on this page. That is deliberate. Our clients run their kitchens with our system, and what happens in their kitchens is nobody&#8217;s business. On request we guarantee this discretion in writing.</p>
    </div>
  </section>

  {/* D11 Costs: two columns, no box */}
  <section class="reveal section-gap">
    <div class="content-width">
      <div class="kosten-grid">
        <h2>What does it cost?</h2>
        <div>
          <p class="lead kosten-lead">That depends on your menu and your team. In the first call we work it out for you transparently, to the euro and with no small print. For the first businesses, 2026 pilot conditions apply, well below the regular price.</p>
          <div class="kosten-btns">
            <a href="/en/contact" data-cta-location="kosten" class="btn btn-primary">Book a Demo</a>
            <a href="/en/pilot-program" data-cta-location="kosten-pilot" class="btn btn-secondary">To the Pilot Program</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* D12 FAQ: list with lines, plus/minus */}
  <section class="reveal section-gap">
    <div class="content-width">
      <h2>Frequently asked questions</h2>
      <div class="faq-list">
        <details class="faq-item" open>
          <summary class="faq-q">Who types in our recipes?<span class="faq-zeichen" aria-hidden="true"></span></summary>
          <div class="faq-body"><div class="faq-inner"><p>We do. An Avorix chef comes to you, cooks with your team and sets up every dish in the app. You do not have to enter anything yourselves.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Will our guests notice anything?<span class="faq-zeichen" aria-hidden="true"></span></summary>
          <div class="faq-body"><div class="faq-inner"><p>No. Your guests experience your kitchen and your recipes, just reliably at the same quality. On request we guarantee in writing that we never name your business as a reference.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Our team is not very tech-minded. Will this still work?<span class="faq-zeichen" aria-hidden="true"></span></summary>
          <div class="faq-body"><div class="faq-inner"><p>Yes, that is what the app is built for. Anyone who can look at a photo and tick a box can work with it. Training happens right at the stove, not in a seminar room.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">What happens to our recipes? Who owns them?<span class="faq-zeichen" aria-hidden="true"></span></summary>
          <div class="faq-body"><div class="faq-inner"><p>You do. Your recipes remain your property and are never passed on to other businesses.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">How quickly are we up and running?<span class="faq-zeichen" aria-hidden="true"></span></summary>
          <div class="faq-body"><div class="faq-inner"><p>From the first call to working independently typically takes a few weeks, depending on the menu. You get the exact plan after the first call.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">What technology do we need in the kitchen?<span class="faq-zeichen" aria-hidden="true"></span></summary>
          <div class="faq-body"><div class="faq-inner"><p>A tablet or smartphone and an internet connection. Nothing more. The app runs in the browser.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Does it replace our head chef?<span class="faq-zeichen" aria-hidden="true"></span></summary>

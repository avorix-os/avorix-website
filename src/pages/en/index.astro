---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Stempel from "../../components/Stempel.astro";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Avorix",
    "url": "https://avorix.cloud",
    "logo": "https://avorix.cloud/avorix-logo.svg",
    "description": "Avorix enables hotels and food service businesses to offer high-quality dishes consistently — even without trained chefs.",
    "email": "info@avorix.de",
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "info@avorix.de",
      "contactType": "sales",
      "availableLanguage": ["German", "English"]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Avorix",
    "url": "https://avorix.cloud"
  }
];
---

<BaseLayout
  title="Home"
  description="Avorix Cook App for hotels — consistent food quality despite skilled chef shortages. Recipe management and standardized processes for your kitchen team."
  schemaOrg={schema}
>
  <!-- Hero -->
  <section class="hero-section px-6" style="background:var(--papier)">
    <div class="content-width hero-grid">
      <!-- Text: mobile below, desktop left -->
      <div class="hero-copy">
        <h1 class="mb-6"><mark>Quality</mark> Without Staff Dependency</h1>
        <p class="lead mb-8 max-w-[62ch]" style="color:var(--grau)">
          The Avorix Cook App guides your kitchen team step-by-step through every recipe — delivering consistent food quality, <strong>regardless of experience level</strong>.
        </p>
        <div class="flex flex-col sm:flex-row items-start gap-4 mb-4">
          <a
            href="/en/contact"
            data-cta-location="hero"
            class="btn btn-primary"
          >
            Book a Demo
          </a>
          <a
            href="#benefits"
            class="btn btn-secondary"
          >
            Learn more &darr;
          </a>
        </div>
        <p class="text-sm mb-6" style="color:var(--grau)">Free &amp; no obligation</p>
        <div class="hero-badges">
          <Stempel>Certified &middot; German staffing licence</Stempel>
        </div>
      </div>
      <!-- Image: mobile above, desktop right -->
      <div class="hero-media">
        <img
          src="/avorix_kitchen_ai.webp"
          alt="Professional kitchen with AI-assisted recipe management"
          width="1920"
          height="1080"
          class="w-full h-full object-cover"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section id="benefits" class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-12" style="color:var(--druck)">
        Why Avorix
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="card">
          <h3 class="mb-3">Consistent Quality</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">Standardized processes and the Avorix Cook App ensure <strong>consistent food quality — regardless of your kitchen team's experience level</strong>.</p>
        </div>
        <div class="card">
          <h3 class="mb-3">Less Staff Dependency</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">A shortage of skilled kitchen staff is an issue in almost every kitchen. Avorix makes your operation <strong>less dependent on individual key personnel</strong>.</p>
        </div>
        <div class="card">
          <h3 class="mb-3">Full Cost Control</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">Recipe-based costing, food cost tracking, and standardized portioning bring <strong>transparency to your kitchen expenses</strong>.</p>
        </div>
      </div>

      <!-- Visual photo strip -->
      <div class="mt-16 overflow-hidden" style="border-radius:var(--radius);box-shadow:var(--schatten)">
        <img
          src="/avorix_gastro-hotel-60.webp"
          alt="Mise en place in a professional kitchen — volume cooking with Avorix"
          width="1200"
          height="540"
          class="w-full object-cover"
          style="height:360px"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Peak-End (3.18): eigene Sektion, zentriert auf die volle Container-Breite
       (Folgerunde 1 / 3b) — nie Teil einer anderen Sektion oder Spalte. -->
  <section class="section-gap px-6">
    <div class="content-width text-center">
      <div class="mb-6">
        <Stempel>Certified &middot; German staffing licence</Stempel>
      </div>
      <p class="mb-6" style="font-family:Charter, Georgia, serif; font-style:italic; font-size:24px; color:var(--druck)">It&#8217;s sorted.</p>
      <a
        href="/en/contact"
        data-cta-location="cta"
        class="btn btn-primary"
      >
        Get in touch
      </a>
    </div>
  </section>
</BaseLayout>

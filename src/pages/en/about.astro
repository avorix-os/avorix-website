---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { useTranslations } from "../../i18n/translations";

const t = useTranslations("en");
---

<BaseLayout title="About" description="Meet Avorix — kitchen management for 4-star resort hotels across the DACH region. We help properties maintain consistent food quality despite staff shortages.">
  <section class="pt-32 pb-20 px-6">
    <div class="max-w-3xl mx-auto">
      <h1 class="mb-6" style="color:var(--druck)">{t("about.title")}</h1>
      <p class="mb-8" style="color:var(--grau)">
        {t("about.intro")}
      </p>

      <!-- Team photo -->
      <div class="overflow-hidden mb-12" style="border-radius:var(--radius);box-shadow:var(--schatten)">
        <img
          src="/avorix_kitchen_branded.webp"
          alt="Avorix Koch App in action — chef in Avorix branded jacket"
          width="1920"
          height="1080"
          class="w-full object-cover h-56 sm:h-72"
          loading="lazy"
        />
      </div>

      <div class="space-y-12">
        <div>
          <h2 class="mb-4" style="color:var(--druck)">{t("about.mission.title")}</h2>
          <p style="color:var(--grau)">
            {t("about.mission.text")}
          </p>
        </div>

        <div>
          <h2 class="mb-4" style="color:var(--druck)">{t("about.focus.title")}</h2>
          <p style="color:var(--grau)">
            {t("about.focus.text")}
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Stempel from "../../components/Stempel.astro";

const schemaOrg = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Avorix",
        "item": "https://avorix.de/en"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Pilot Program",
        "item": "https://avorix.de/en/pilot-program"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What does the Pilot Program cost me?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Considerably less than the regular price. The exact figure depends on your menu and is fixed after the kitchen analysis, in writing and with nothing hidden."
        }
      },
      {
        "@type": "Question",
        "name": "How long am I committed for?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "App usage runs for 12 months. Anything shorter would not be serious: a system that changes your kitchen does not prove itself in four weeks."
        }
      },
      {
        "@type": "Question",
        "name": "Do I have to appear as a reference?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No. Anonymous evaluation yes, public reference only if you expressly want it. And then with a separate deal."
        }
      },
      {
        "@type": "Question",
        "name": "What if it does not work for us?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Then we say so openly, and if need be we stop. That is exactly what pilot projects are for. You keep your recipe documentation either way, so the work was not wasted."
        }
      },
      {
        "@type": "Question",
        "name": "We no longer have a head chef at all. Is it still possible?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Especially then. For the transition we can additionally hire out one of our permanently employed chefs to you, on solid legal ground. Raise it in the introductory call."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Pilot Program 2026",
    "url": "https://avorix.de/en/pilot-program",
    "inLanguage": "en"
  }
];
---

<BaseLayout
  title="Avorix Pilot Program 2026: 3 Places"
  description="Three hotel kitchens, around half the regular price, a direct line to the founder. Your name stays confidential, guaranteed in writing."
  schemaOrg={schemaOrg}
>

  {/* Hero (W2: Text-Hero, linksbündig) */}
 <section class="hero-section px-6">
    <div class="content-width">
      <p class="eyebrow mb-6">Pilot Program 2026</p>
      <h1 class="mb-6">
        We are looking for 3 hotel kitchens to <mark>prove it with us in 2026.</mark>
      </h1>
      <p class="lead mb-10 max-w-[var(--spalte-text)]" style="color:var(--grau)">
        The Avorix Cook App is new. What is not new: our chefs and our routines, which have stood in professional kitchens for years. What we still lack are businesses whose results we are allowed to show. So we are making you an offer we will only make to the first properties.
      </p>
      <a
        href="#apply"
        data-cta-location="hero"
        class="btn btn-primary"
      >Apply for a pilot place</a>
    </div>
  </section>

  {/* Das Angebot */}
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-10 md:mb-16" style="color:var(--druck)">The offer. No small print.</h2>
      <div class="grid sm:grid-cols-2 gap-8">
        <div class="card">
          <h3 class="mb-4">You get:</h3>
          <ul class="space-y-4" style="color:var(--grau)">
            <li class="flex items-start gap-4">
              <svg class="w-5 h-5 shrink-0 mt-0.5" style="color:var(--akzent)" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>The complete Avorix system: recipe recording by an experienced chef, training for your team at the stove, the Avorix Cook App for your whole business.</span>
            </li>
            <li class="flex items-start gap-4">
              <svg class="w-5 h-5 shrink-0 mt-0.5" style="color:var(--akzent)" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Pilot conditions: around half the regular price.</span>
            </li>
            <li class="flex items-start gap-4">
              <svg class="w-5 h-5 shrink-0 mt-0.5" style="color:var(--akzent)" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>A direct line to the founder: B&ouml;rge Penk looks after the pilot businesses personally.</span>
            </li>
            <li class="flex items-start gap-4">
              <svg class="w-5 h-5 shrink-0 mt-0.5" style="color:var(--akzent)" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Priority on everything: your requests go into the app first.</span>
            </li>
          </ul>
        </div>
        <div class="card">
          <h3 class="mb-4">We get:</h3>
          <ul class="space-y-4" style="color:var(--grau)">
            <li class="flex items-start gap-4">
              <svg class="w-5 h-5 shrink-0 mt-0.5" style="color:var(--akzent)" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Your honest feedback. Including the uncomfortable kind.</span>
            </li>
            <li class="flex items-start gap-4">
              <svg class="w-5 h-5 shrink-0 mt-0.5" style="color:var(--akzent)" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Permission to evaluate your results anonymously (for example: &bdquo;A resort hotel on Lake Constance reduced its food cost by X per cent&ldquo;). Your name appears nowhere, and we guarantee that in writing.</span>
            </li>
            <li class="flex items-start gap-4">
              <svg class="w-5 h-5 shrink-0 mt-0.5" style="color:var(--akzent)" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>If you are willing to go further and appear publicly as a reference, we will talk about a separate deal on even better terms. That is voluntary and not a condition.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* Passt das */}
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-10 md:mb-16" style="color:var(--druck)">Does this fit your property?</h2>
      <div class="grid sm:grid-cols-2 gap-8">
        <div class="card">
          <h3 class="mb-4">The Pilot Program fits if:</h3>
          <ul class="space-y-4" style="color:var(--grau)">
            <li class="flex items-start gap-4">
              <svg class="w-5 h-5 shrink-0 mt-0.5" style="color:var(--akzent)" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>You run a hotel or restaurant in Germany or Austria, ideally with half-board or a fixed menu.</span>
            </li>
            <li class="flex items-start gap-4">
              <svg class="w-5 h-5 shrink-0 mt-0.5" style="color:var(--akzent)" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>The skills shortage is real for you: vacancies, dependence on individual people, quality that fluctuates.</span>
            </li>
            <li class="flex items-start gap-4">
              <svg class="w-5 h-5 shrink-0 mt-0.5" style="color:var(--akzent)" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>You are ready to change routines. Not everything at once, but seriously.</span>
            </li>
          </ul>
        </div>
        <div class="card">
          <h3 class="mb-4">It does not fit if:</h3>
          <ul class="space-y-4" style="color:var(--grau)">
            <li class="flex items-start gap-4">
              <svg class="w-5 h-5 shrink-0 mt-0.5" style="color:var(--fehler)" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
              <span>You run daily-changing fine dining with your own patron at the stove. Avorix is not built for that.</span>
            </li>
            <li class="flex items-start gap-4">
              <svg class="w-5 h-5 shrink-0 mt-0.5" style="color:var(--fehler)" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
              <span>You only want the app but do not want to change anything about how you work. Then we would both be burning time and money.</span>
            </li>
          </ul>
        </div>
      </div>
      <p class="mt-8 max-w-[var(--spalte-text)]" style="color:var(--grau)">
        We do not spare you this honesty. <strong>A pilot project that does not fit harms you and us.</strong>
      </p>
    </div>
  </section>

  {/* Vier Schritte */}
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-10 md:mb-16" style="color:var(--druck)">Four steps to a kitchen that always works.</h2>
      <div class="space-y-6">
        <div class="schritt">
          <span class="schritt-chip shrink-0">1</span>
          <div>
            <h3 class="mb-4">Introductory call (30 minutes, free of charge).</h3>
            <p class="max-w-[var(--spalte-text)]" style="color:var(--grau)">By video or phone. You describe your situation, and together we check whether the Pilot Program fits. Afterwards both sides decide in their own time.</p>
          </div>
        </div>
        <div class="schritt">
          <span class="schritt-chip shrink-0">2</span>
          <div>
            <h3 class="mb-4">Kitchen analysis on site.</h3>
            <p class="max-w-[var(--spalte-text)]" style="color:var(--grau)">An Avorix chef looks at your kitchen, your menu and your team. You get <strong>a concrete plan with effort and costs</strong>, to the euro.</p>
          </div>
        </div>
        <div class="schritt">
          <span class="schritt-chip shrink-0">3</span>
          <div>
            <h3 class="mb-4">Recording and training.</h3>
            <p class="max-w-[var(--spalte-text)]" style="color:var(--grau)">We document your menu, set up the app and train your team at the stove, while service carries on as normal.</p>
          </div>
        </div>
        <div class="schritt">
          <span class="schritt-chip shrink-0">4</span>
          <div>
            <h3 class="mb-4">Running operation with support.</h3>
            <p class="max-w-[var(--spalte-text)]" style="color:var(--grau)">Your team works with the system. We stay on it, collect your feedback and adjust. Every few weeks, a short call with B&ouml;rge.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* Wer hinter dem Angebot steht */}
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-10 md:mb-16" style="color:var(--druck)">Who stands behind the offer</h2>
      <div class="gruender-grid">
        <div>
          <p class="leading-relaxed max-w-[var(--spalte-text)]" style="color:var(--grau)">
            B&ouml;rge Penk, head chef with 20 years of practice, developed Avorix out of his own working day in the kitchen. He is personally responsible for the pilot businesses:
          </p>
        </div>
        <blockquote class="gruender-quote">
          &bdquo;With the first properties, I am personally on the line. If it does not work there, our business model does not work. I cannot make your risk any smaller than that.&ldquo;
        </blockquote>
      </div>
    </div>
  </section>

  {/* Warum nur 3 */}
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Why only 3 places?</h2>
      <p class="leading-relaxed max-w-[var(--spalte-text)]" style="color:var(--grau)">
        Because every introduction takes real people: an Avorix chef stands in your kitchen, not in a call centre. We cannot look after more than one new business a month properly, and <strong>quality comes before growth</strong>. So it stops at 3 pilot businesses. After that, regular conditions apply.
      </p>
    </div>
  </section>

  {/* FAQ */}
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-10" style="color:var(--druck)">Frequently asked questions</h2>
      <div class="faq-list">
        <details class="faq-item" open>
          <summary class="faq-q">What does the Pilot Program cost me?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Considerably less than the regular price. The exact figure depends on your menu and is fixed after the kitchen analysis, in writing and with nothing hidden.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">How long am I committed for?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>App usage runs for 12 months. Anything shorter would not be serious: a system that changes your kitchen does not prove itself in four weeks.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Do I have to appear as a reference?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>No. Anonymous evaluation yes, public reference only if you expressly want it. And then with a separate deal.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">What if it does not work for us?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Then we say so openly, and if need be we stop. That is exactly what pilot projects are for. You keep your recipe documentation either way, so the work was not wasted.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">We no longer have a head chef at all. Is it still possible?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Especially then. For the transition we can additionally hire out one of our permanently employed chefs to you, on solid legal ground. Raise it in the introductory call.</p></div></div>
        </details>
      </div>
    </div>
  </section>

  {/* Formular */}
 <section id="apply" class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Apply for a pilot place. No obligation.</h2>
      <p class="text-lg mb-10" style="color:var(--grau)">Three minutes. We will get back to you within two working days.</p>

      <p class="formular-pflicht">Fields marked * are the ones we need, everything else is optional.</p>
      <form id="pilot-form" class="card pilot-form-wrap space-y-6" action="https://formspree.io/f/xqegwngo" method="POST">
        <input type="hidden" name="_subject" value="Pilot enquiry via avorix.de" />

        <div>
          <label for="pilot-name" class="pilot-label">
            Name <span style="color:var(--akzent)">*</span>
          </label>
          <input type="text" id="pilot-name" name="name" autocomplete="name" required class="pilot-field" />
        </div>

        <div>
          <label for="pilot-business" class="pilot-label">
            Business (hotel/restaurant) + town <span style="color:var(--akzent)">*</span>
          </label>
          <input type="text" id="pilot-business" name="betrieb" autocomplete="organization" required class="pilot-field" />
        </div>

        <div>
          <label for="pilot-email" class="pilot-label">
            Email <span style="color:var(--akzent)">*</span>
          </label>
          <input type="email" id="pilot-email" name="email" autocomplete="email" required class="pilot-field" />
        </div>

        <div>
          <label for="pilot-phone" class="pilot-label">
            Phone <span class="pilot-label-opt">(optional, for a faster reply)</span>
          </label>
          <input type="tel" id="pilot-phone" name="telefon" autocomplete="tel" class="pilot-field" />
        </div>

        <div>
          <label for="pilot-teamsize" class="pilot-label">
            How big is your kitchen team?
          </label>
          <select id="pilot-teamsize" name="kuechenteam" class="pilot-field">
            <option value="">Please choose</option>
            <option value="1 to 3">1 to 3</option>
            <option value="4 to 8">4 to 8</option>
            <option value="more than 8">more than 8</option>
          </select>
        </div>

        <div>
          <label for="pilot-problem" class="pilot-label">
            What is your biggest kitchen problem right now? <span class="pilot-label-opt">(optional)</span>
          </label>
          <textarea id="pilot-problem" name="kuechenproblem" rows="4" class="pilot-field pilot-textarea"></textarea>
        </div>

        <div id="pilot-success" class="hidden pilot-success-msg">
          Thank you. We will get back to you within two working days.
        </div>

        <button type="submit" class="btn btn-primary pilot-submit">
          Apply for a pilot place
        </button>
        <p class="formular-hinweis">
          By submitting, you consent to your details being processed in order to handle your enquiry.
          More on this in the <a href="/en/privacy" class="typo-link">privacy policy</a>.
        </p>
      </form>
      <div class="pilot-zweitwege">
        <a href="/en/cook-app" data-cta-location="pilot-secondary" class="btn btn-secondary">Take a look at the app first</a>
        <a href="/en/staff#request" data-cta-location="pilot-secondary" data-cta-event="cta_personal_click" class="btn btn-secondary">Need someone right now?</a>
      </div>
    </div>
  </section>

  {/* Final CTA → Peak-End (3.18) */}
 <section class="reveal section-gap">
    <div class="content-width text-center">
      <div class="mb-6">
        <Stempel>Certified &middot; German staffing licence</Stempel>
      </div>
      <p class="mb-6" style="font-family:Charter, Georgia, serif; font-style:italic; font-size:24px; color:var(--druck)">It&rsquo;s sorted.</p>
      <a
        href="#apply"
        data-cta-location="pilot-final"
        class="btn btn-primary"
      >Apply for a pilot place</a>
    </div>
  </section>
</BaseLayout>

<style>
/* Formular (3.14) */
.pilot-form-wrap {
  padding: 2rem;
}
.pilot-label {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: var(--druck);
  margin-bottom: 8px;
}
.pilot-label-opt {
  font-weight: 400;
  color: var(--grau);
}
.pilot-field {
  width: 100%;
  background: var(--flaeche);
  border: 1px solid var(--linie);
  border-radius: var(--radius);
  padding: 16px;
  font-size: 16px;
  font-family: var(--f-body);
  color: var(--druck);
  transition: border-color .15s;
  appearance: auto;
  box-sizing: border-box;
}
.pilot-field:focus {
  outline: none;
  border-color: var(--akzent);
}
.pilot-field:focus-visible {
  outline: 3px solid var(--akzent);
  outline-offset: 2px;
}
.pilot-textarea {
  resize: none;
}
.pilot-success-msg {
  color: var(--akzent);
  font-weight: 600;
  padding: 16px;
}
.pilot-zweitwege {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 24px;
}
@media (prefers-reduced-motion: reduce) {
  .pilot-field { transition: none; }
}
</style>

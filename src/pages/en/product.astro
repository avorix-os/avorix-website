---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { useTranslations } from "../../i18n/translations";
import Stempel from "../../components/Stempel.astro";

const t = useTranslations("en");

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Avorix Cook App",
  "alternateName": "Avorix Kitchen Management",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web, iOS, Android",
  "description": "The Avorix Cook App guides your kitchen team step-by-step through every recipe — with photos, quantities, and timings. For 4-star resort hotels with half-board.",
  "url": "https://avorix.cloud/en/product",
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "EUR",
    "description": "Pilot program for hotels — free trial phase"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Avorix",
    "url": "https://avorix.cloud"
  },
  "featureList": [
    "Step-by-step recipe guidance with photos",
    "Automatic quantity scaling",
    "Offline use in the kitchen",
    "Real-time quality control"
  ]
};
---

<BaseLayout
  title="Product — Avorix Cook App"
  description="The Avorix Cook App guides your kitchen team step-by-step through every recipe — with photos, quantities, and timings. For 4-star resort hotels with half-board."
  schemaOrg={schema}
>
  <!-- Hero (W2: Text-Hero, left-aligned) -->
 <section class="hero-section px-6" style="background:var(--papier)">
    <div class="content-width">
      <p class="eyebrow mb-4">{t("produkt.badge")}</p>
      <h1 class="mb-6" set:html={t("produkt.tagline")}></h1>
      <p class="lead max-w-[62ch] mb-10" style="color:var(--grau)">
        {t("produkt.subtitle")}
      </p>
      <a href="/en/contact" class="btn btn-primary">
        {t("produkt.cta.primary")}
      </a>
      <p class="text-sm mt-4" style="color:var(--grau)">{t("produkt.cta.note")}</p>
    </div>
  </section>

  <!-- Target Audience (dark proof section 3.10) -->
 <section class="reveal section-gap section-dunkel" style="background:var(--eisen)">
    <div class="content-width">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="mb-6" style="color:var(--papier)">{t("produkt.target.title")}</h2>
          <p class="leading-relaxed text-lg max-w-[62ch]" style="color:rgba(247,246,242,0.75)">{t("produkt.target.text")}</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-6">
          <div class="rounded-[6px] p-6" style="background:rgba(247,246,242,0.06);border:1px solid rgba(247,246,242,0.12)">
            <div class="text-4xl font-bold mb-2" style="color:var(--akzent-hell)">{t("produkt.target.stat2.number")}</div>
            <div class="text-sm leading-relaxed" style="color:rgba(247,246,242,0.65)">{t("produkt.target.stat2.label")}</div>
          </div>
          <div class="rounded-[6px] p-6" style="background:rgba(247,246,242,0.06);border:1px solid rgba(247,246,242,0.12)">
            <div class="text-4xl font-bold mb-2" style="color:var(--akzent-hell)">{t("produkt.target.stat3.number")}</div>
            <div class="text-sm leading-relaxed" style="color:rgba(247,246,242,0.65)">{t("produkt.target.stat3.label")}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Photo break -->
 <section class="reveal section-streifen">
    <div class="content-width">
      <div style="border-radius:var(--radius);box-shadow:var(--schatten);overflow:hidden">
        <img
          src="/avorix_gastro-hotel-62.webp"
          alt="Professional plating in a hotel kitchen — Avorix standard"
          width="1200"
          height="540"
          class="w-full object-cover"
          style="height:360px"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- How it works (visual workflow) -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-16" style="color:var(--druck)">{t("produkt.workflow.title")}</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        <div>
          <div class="schritt-chip inline-flex mb-6">1</div>
          <h3 class="mb-3">{t("produkt.workflow.step1.title")}</h3>
          <p class="leading-relaxed" style="color:var(--grau)">{t("produkt.workflow.step1.text")}</p>
        </div>
        <div>
          <div class="schritt-chip inline-flex mb-6">2</div>
          <h3 class="mb-3">{t("produkt.workflow.step2.title")}</h3>
          <p class="leading-relaxed" style="color:var(--grau)">{t("produkt.workflow.step2.text")}</p>
        </div>
        <div>
          <div class="schritt-chip inline-flex mb-6">3</div>
          <h3 class="mb-3">{t("produkt.workflow.step3.title")}</h3>
          <p class="leading-relaxed" style="color:var(--grau)">{t("produkt.workflow.step3.text")}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Grid -->
 <section class="reveal section-gap" style="background:var(--papier)">
    <div class="content-width">
      <h2 class="mb-14" style="color:var(--druck)">{t("produkt.features.title")}</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="card">
          <h3 class="mb-2">{t("produkt.features.1.title")}</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">{t("produkt.features.1.text")}</p>
        </div>
        <div class="card">
          <h3 class="mb-2">{t("produkt.features.2.title")}</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">{t("produkt.features.2.text")}</p>
        </div>
        <div class="card">
          <h3 class="mb-2">{t("produkt.features.3.title")}</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">{t("produkt.features.3.text")}</p>
        </div>
        <div class="card">
          <h3 class="mb-2">{t("produkt.features.4.title")}</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">{t("produkt.features.4.text")}</p>
        </div>
        <div class="card">
          <h3 class="mb-2">{t("produkt.features.5.title")}</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">{t("produkt.features.5.text")}</p>
        </div>
        <div class="card">
          <h3 class="mb-2">{t("produkt.features.6.title")}</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">{t("produkt.features.6.text")}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Development status / Pilot CTA → Peak-End (3.18) -->
 <section class="reveal section-gap">
    <div class="content-width text-center">
      <div class="mb-6">
        <Stempel>Certified &middot; German staffing licence</Stempel>
      </div>
      <p class="mb-8" style="font-family:Charter,Georgia,serif;font-style:italic;font-size:24px;color:var(--druck)">It&rsquo;s sorted.</p>
      <a
        href="/en/contact"
        class="btn btn-primary"
      >
        {t("produkt.cta.primary")}
      </a>
    </div>
  </section>
</BaseLayout>

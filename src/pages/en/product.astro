---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Stempel from "../../components/Stempel.astro";


const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Avorix Cook App",
  "alternateName": "Avorix Kitchen Management",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web, iOS, Android",
  "description": "The Avorix Cook App guides your kitchen team step-by-step through every recipe — with photos, quantities, and timings. For resort hotels with half-board.",
  "url": "https://avorix.cloud/en/product",
  "inLanguage": "en",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "EUR",
    "description": "Pilot program for hotels — free trial phase"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Avorix",
    "url": "https://avorix.cloud"
  },
  "featureList": [
    "Step-by-step recipe guidance with photos",
    "Automatic quantity scaling",
    "Offline use in the kitchen",
    "Real-time quality control"
  ]
};
---
<BaseLayout
  title="Product — Avorix Cook App"
  description="The Avorix Cook App guides your kitchen team step-by-step through every recipe — with photos, quantities, and timings. For resort hotels with half-board."
  schemaOrg={schema}
>
  <!-- Hero (W2: Text-Hero, left-aligned) -->
 <section class="hero-section px-6" style="background:var(--papier)">
    <div class="content-width">
      <p class="eyebrow mb-4">Avorix Cook App</p>
      <h1 class="mb-6">The Kitchen That <mark>Always Delivers</mark></h1>
      <p class="lead max-w-[62ch] mb-10" style="color:var(--grau)">
        The Avorix Cook App guides your kitchen team step-by-step through every recipe — with photos, quantities, and timings. Consistent quality for half-board operations, regardless of experience level.
      </p>
      <a href="/en/contact" class="btn btn-primary">
        Request a Demo
      </a>
      <p class="text-sm mt-4" style="color:var(--grau)">Free &amp; no obligation</p>
    </div>
  </section>

  <!-- Target Audience (dark proof section 3.10) -->
 <section class="reveal section-gap section-dunkel" style="background:var(--eisen)">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--papier)">Built for Resort Hotels with Half-Board</h2>
      <p class="leading-relaxed text-lg max-w-[62ch]" style="color:rgba(247,246,242,0.75)">Avorix is specifically designed for hotels with half-board offerings in Germany and Austria — properties where the kitchen faces daily pressure to deliver consistent quality for discerning guests.</p>
    </div>
  </section>

  <!-- Photo break -->
 <section class="reveal section-streifen">
    <div class="content-width">
      <div style="border-radius:var(--radius);box-shadow:var(--schatten);overflow:hidden">
        <img
          src="/avorix_gastro-hotel-62.webp"
          alt="Professional plating in a hotel kitchen — Avorix standard"
          width="1200"
          height="540"
          class="w-full object-cover"
          style="height:360px"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- How it works (visual workflow) -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-16" style="color:var(--druck)">What a Typical Day Looks Like</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        <div>
          <div class="schritt-chip inline-flex mb-6">1</div>
          <h3 class="mb-3">Morning Prep</h3>
          <p class="leading-relaxed" style="color:var(--grau)">The team opens the app, selects today's menu — and immediately knows what needs to be done.</p>
        </div>
        <div>
          <div class="schritt-chip inline-flex mb-6">2</div>
          <h3 class="mb-3">Preparation</h3>
          <p class="leading-relaxed" style="color:var(--grau)">Each cook sees their step, exact quantities, and the reference photo. No asking around, no guessing.</p>
        </div>
        <div>
          <div class="schritt-chip inline-flex mb-6">3</div>
          <h3 class="mb-3">Service-Ready</h3>
          <p class="leading-relaxed" style="color:var(--grau)">Every dish to standard — regardless of who's in the kitchen today. The result is reproducible.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Grid -->
 <section class="reveal section-gap" style="background:var(--papier)">
    <div class="content-width">
      <h2 class="mb-14" style="color:var(--druck)">What the Cook App Does</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="card">
          <h3 class="mb-2">Step-by-Step Recipe Guidance</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">Every dish is broken into clear steps — with photos, quantities, and timings. No room for interpretation, no prior experience required.</p>
        </div>
        <div class="card">
          <h3 class="mb-2">Automatic Portion Calculator</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">Quantities are automatically scaled to the required number of portions. No manual calculations, no waste, no errors.</p>
        </div>
        <div class="card">
          <h3 class="mb-2">Central Recipe Library</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">All recipes managed centrally for your hotel — always current, accessible by the entire team on any tablet or smartphone.</p>
        </div>
        <div class="card">
          <h3 class="mb-2">Food Cost Control</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">Recipe-based costing and food cost analysis bring transparency to your kitchen expenses — with no extra effort.</p>
        </div>
        <div class="card">
          <h3 class="mb-2">Offline-Capable</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">The app works without a stable internet connection — reliable in every kitchen situation, including basements and service areas.</p>
        </div>
        <div class="card">
          <h3 class="mb-2">Easy to Use</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">Designed for real kitchen life: large buttons, plain language, minimal onboarding. New staff can get started immediately.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Development status / Pilot CTA → Peak-End (3.18) -->
 <section class="reveal section-gap">
    <div class="content-width text-center">
      <div class="mb-6">
        <Stempel>Certified &middot; German staffing licence</Stempel>
      </div>
      <p class="mb-8" style="font-family:Charter,Georgia,serif;font-style:italic;font-size:24px;color:var(--druck)">It&rsquo;s sorted.</p>
      <a
        href="/en/contact"
        class="btn btn-primary"
      >
        Request a Demo
      </a>
    </div>
  </section>
</BaseLayout>

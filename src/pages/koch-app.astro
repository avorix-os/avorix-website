---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image, getImage } from "astro:assets";
import Lightbox from "../components/Lightbox.astro";
import Stempel from "../components/Stempel.astro";
import appKochmodus1 from "../assets/bilder/app-kochmodus-schritt1.png";
import appKochmodus2Haccp from "../assets/bilder/app-kochmodus-schritt2-haccp.png";
import appPortionsrechner from "../assets/bilder/app-rezept-detail-portionsrechner.png";
import appRezepteListe from "../assets/bilder/app-rezepte-liste.png";
import appDashboard from "../assets/bilder/app-dashboard.png";
import appMenuplaner from "../assets/bilder/app-menuplaner-woche.png";
import appEinkaufsliste from "../assets/bilder/app-einkaufsliste.png";
import appPreisvergleich from "../assets/bilder/app-preisvergleich.png";

const ogImg = await getImage({ src: appKochmodus1, width: 1200, format: "png" });
const ogImageAlt = "Screenshot der Avorix Koch-App: Rezeptschritt im Koch-Modus mit Temperatur und Timer";
---

<BaseLayout
  title="Die Avorix Koch-App: Schritt f&uuml;r Schritt kochen"
  description="Rezepte mit Fotos, Mengen und Zeiten, Portionsrechner, Men&uuml;planer, Einkaufslisten und Kalkulation. Die Koch-App f&uuml;r Hotel- und Restaurantk&uuml;chen."
  ogImage={ogImg.src}
  ogImageAlt={ogImageAlt}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://avorix.de/" },
          { "@type": "ListItem", "position": 2, "name": "Die Koch-App", "item": "https://avorix.de/koch-app" }
        ]
      },
      {
        "@type": "SoftwareApplication",
        "name": "Avorix Koch-App",
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "Web (Tablet und Smartphone)",
        "description": "Rezepte mit Fotos, Mengen und Zeiten, Portionsrechner, Menüplaner, Einkaufslisten und Kalkulation. Die Koch-App für Hotel- und Restaurantküchen.",
        "publisher": { "@type": "Organization", "name": "Avorix", "url": "https://avorix.de" },
        "screenshot": { "@type": "ImageObject", "url": `https://avorix.de${ogImg.src}` }
      },
      {
        "@type": "WebPage",
        "url": "https://avorix.de/koch-app",
        "primaryImageOfPage": {
          "@type": "ImageObject",
          "url": `https://avorix.de${ogImg.src}`,
          "description": ogImageAlt
        }
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          { "@type": "Question", "name": "Auf welchen Geräten läuft die App?", "acceptedAnswer": { "@type": "Answer", "text": "Auf Tablet und Smartphone, direkt in der Küche." } },
          { "@type": "Question", "name": "Brauchen wir Internet in der Küche?", "acceptedAnswer": { "@type": "Answer", "text": "Ja. Die App läuft im Browser und braucht eine Internetverbindung in der Küche, WLAN oder Mobilfunk." } },
          { "@type": "Question", "name": "Kann unser Team neue Gerichte selbst anlegen?", "acceptedAnswer": { "@type": "Answer", "text": "Ja. Nach der Schulung pflegen Sie neue Gerichte selbst ein, oder wir übernehmen das für Sie." } },
          { "@type": "Question", "name": "Was kosten die Zusatzmodule?", "acceptedAnswer": { "@type": "Answer", "text": "Das rechnen wir Ihnen im Erstgespräch vor, abhängig davon, welche Pakete Ihr Betrieb nutzt. Für die ersten Betriebe gelten auch hier die Pilotkonditionen 2026." } },
          { "@type": "Question", "name": "Macht mein Team da überhaupt mit?", "acceptedAnswer": { "@type": "Answer", "text": "Der Einwand kommt fast immer, und er verschwindet fast immer in der ersten Woche. Aus zwei Gründen: Angelernt wird nicht per Handbuch, sondern am Herd, von einem Koch mit mindestens Sous-Chef-Erfahrung, der den Alltag Ihres Teams kennt. Und die App nimmt dem Team Arbeit ab, statt es zu kontrollieren: kein Zettelsuchen, kein Nachfragen, keine Diskussion über Mengen. Wer eine Woche damit gekocht hat, gibt sie nicht mehr her." } },
          { "@type": "Question", "name": "Schmeckt das wie frisch gekocht?", "acceptedAnswer": { "@type": "Answer", "text": "Ja. Durch das Vakuumieren bleiben Aromen, Textur und Nährstoffe unter Luftabschluss erhalten. Regeneriert wird erst, wenn der Gast bestellt, punktgenau und in wenigen Minuten." } }
        ]
      }
    ]
  })} />

  <!-- Hero (W2: Split 55/45) -->
 <section class="hero-section px-6" style="background:var(--papier)">
    <div class="content-width hero-grid" style="align-items:center">
      <!-- Text: mobil unten, Desktop links -->
      <div class="hero-copy">
        <p class="eyebrow mb-4">Die Koch-App</p>
        <h1 class="mb-6">Ihr K&uuml;chenwissen. <mark>Zum Abhaken.</mark></h1>
        <p class="lead mb-6" style="color:var(--grau)">
          Die Avorix Koch-App f&uuml;hrt jede Kraft Schritt f&uuml;r Schritt durch Ihre Karte. Foto ansehen, Menge abwiegen, Haken setzen, fertig. So kocht Ihr Team jeden Tag auf Ihrem Niveau. <strong>Auch ohne ausgebildete K&ouml;che.</strong>
        </p>
        <a href="/kontakt" data-cta-location="kochapp-hero" class="btn btn-primary">App-Demo vereinbaren</a>
      </div>
      <!-- Screenshot: mobil oben, Desktop rechts -->
      <div class="hero-media">
        <Lightbox label="KOCHMODUS" caption="Screenshot der Avorix Koch-App: Rezeptschritt im Koch-Modus mit Temperatur und Timer" flach>
          <Image
            src={appKochmodus1}
            alt="Screenshot der Avorix Koch-App: Rezeptschritt im Koch-Modus mit Temperatur und Timer"
            widths={[480, 800, 1200]}
            sizes="(max-width: 896px) 100vw, 528px"
            loading="eager"
            fetchpriority="high"
            class="w-full h-auto"
          />
        </Lightbox>
      </div>
    </div>
  </section>

  <!-- Zahlen-Banner (12i, Fassung aus 12j/11) -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Gemessen in einem Kundenbetrieb.</h2>
      <!-- Korrektur 9 (Anweisung 25): Der Satz stand unter der Gruppe. Er ist zu
           verstehen, bevor man sie gesehen hat, also gehoert er nach oben. -->
      <p class="mb-10 max-w-[62ch]" style="color:var(--grau)">Die App tr&auml;gt sich dort schon selbst.</p>
      <div class="grid sm:grid-cols-2 gap-6">
        <div class="card">
          <p class="mb-6" style="font-family:var(--f-head);font-weight:700;font-size:clamp(36px,5vw,48px);line-height:1.05;letter-spacing:-0.008em;color:var(--druck)">rund 15&nbsp;%</p>
          <p style="color:var(--grau)">weniger Personaleinsatz, ohne Abstriche beim Niveau</p>
        </div>
        <div class="card">
          <p class="mb-6" style="font-family:var(--f-head);font-weight:700;font-size:clamp(36px,5vw,48px);line-height:1.05;letter-spacing:-0.008em;color:var(--druck)">rund 20&nbsp;%</p>
          <p style="color:var(--grau)">weniger Einkaufskosten, mit Abl&auml;ufen, App und Preisvergleich zusammen</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Was die App kann. Gezeigt, nicht behauptet.</h2>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">
        <div class="card">
          <h3 class="mb-4">1 &middot; Schritt-f&uuml;r-Schritt-F&uuml;hrung</h3>
          <p class="text-sm" style="color:var(--grau)">Jedes Gericht als klare Abfolge: Foto, Mengenangabe, Zeit. <strong>Kein Interpretationsspielraum</strong>, keine Fehler.</p>
        </div>
        <div class="card" style="padding:0;overflow:hidden">
          <Lightbox label="PORTIONSRECHNER" caption="Screenshot der Avorix Koch-App: Portionsrechner skaliert ein Rezept auf 80 Portionen" flach>
            <Image
              src={appPortionsrechner}
              alt="Screenshot der Avorix Koch-App: Portionsrechner skaliert ein Rezept auf 80 Portionen"
              widths={[480, 800]}
              sizes="(max-width: 768px) 90vw, (max-width: 1280px) 30vw, 360px"
              loading="lazy"
              decoding="async"
              class="w-full h-auto"
            />
          </Lightbox>
          <div class="p-8">
            <h3 class="mb-4">2 &middot; Automatischer Portionsrechner</h3>
            <p class="text-sm" style="color:var(--grau)">Heute 80 G&auml;ste statt 60? Die App skaliert alle Mengen automatisch auf die ben&ouml;tigte Portionszahl. <strong>Kein Nachrechnen, kein Zettel.</strong></p>
          </div>
        </div>
        <div class="card" style="padding:0;overflow:hidden">
          <Lightbox label="REZEPTBIBLIOTHEK" caption="Screenshot der Avorix Koch-App: Rezeptbibliothek mit Kategorien, Zeiten und Kosten pro Portion" flach>
            <Image
              src={appRezepteListe}
              alt="Screenshot der Avorix Koch-App: Rezeptbibliothek mit Kategorien, Zeiten und Kosten pro Portion"
              widths={[480, 800]}
              sizes="(max-width: 768px) 90vw, (max-width: 1280px) 30vw, 360px"
              loading="lazy"
              decoding="async"
              class="w-full h-auto"
            />
          </Lightbox>
          <div class="p-8">
            <h3 class="mb-4">3 &middot; Die Rezeptbibliothek</h3>
            <p class="text-sm" style="color:var(--grau)">Ihre ganze Karte an einem Ort, f&uuml;r das ganze Team. Saisonkarte, Standards, Beilagen, alles auffindbar in Sekunden.</p>
          </div>
        </div>
        <div class="card">
          <h3 class="mb-4">4 &middot; Wareneinsatz im Blick</h3>
          <p class="text-sm" style="color:var(--grau)">Rezeptbasierte Kalkulation und Wareneinsatz-Auswertung. <strong>Sie sehen, was jeder Teller wirklich kostet.</strong></p>
        </div>
        <div class="card">
          <h3 class="mb-4">5 &middot; L&auml;uft &uuml;berall in der K&uuml;che</h3>
          <p class="text-sm" style="color:var(--grau)">Auf Tablet und Smartphone, direkt am Posten. Die App l&auml;uft im Browser, <strong>es muss nichts installiert werden</strong>. Sie brauchen nur eine Internetverbindung in der K&uuml;che.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- HACCP-Dokumentations-Beweis (dunkle Sektion 3.10) -->
 <section class="reveal section-gap section-dunkel" style="background:var(--eisen)">
    <div class="content-width">
      <div class="split-row" style="align-items:center">
        <div class="split-copy">
          <p class="eyebrow mb-4" style="color:var(--akzent-hell)">HACCP &middot; Dokumentation</p>
          <h2 class="mb-6" style="color:var(--papier)">
            <span style="color:var(--akzent-hell)">Wareneinsatz</span> im Blick.
          </h2>
          <p class="mb-4 max-w-[62ch]" style="color:rgba(247,246,242,0.8)">Rezeptbasierte Kalkulation und <span style="color:var(--akzent-hell)">Wareneinsatz</span>-Auswertung. <strong>Sie sehen, was jeder Teller wirklich kostet.</strong></p>
          <p class="max-w-[62ch]" style="color:rgba(247,246,242,0.8)">Der Wareneinsatz des Tages ist <span style="color:var(--akzent-hell)">dokumentiert</span>, ohne dass jemand etwas aufschreiben musste.</p>
        </div>
        <div class="split-media" style="box-shadow:none">
          <Lightbox label="HACCP-KONTROLLE" caption="Screenshot der Avorix Koch-App: Arbeitsschritt mit rotem HACCP-Kontrollpunkt und 75 Grad Kerntemperatur" flach>
            <Image
              src={appKochmodus2Haccp}
              alt="Screenshot der Avorix Koch-App: Arbeitsschritt mit rotem HACCP-Kontrollpunkt und 75 Grad Kerntemperatur"
              widths={[480, 800]}
              sizes="(max-width: 768px) 100vw, (max-width: 1280px) 48vw, 560px"
              loading="lazy"
              decoding="async"
              class="w-full h-auto"
            />
          </Lightbox>
        </div>
      </div>
    </div>
  </section>

  <!-- Küchenorganisation -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Und die App organisiert gleich die ganze K&uuml;che mit.</h2>
      <div class="mb-8">
        <Lightbox label="DASHBOARD" caption="Screenshot der Avorix Koch-App: Dashboard mit den Modulen der K&uuml;chenverwaltung" flach>
          <Image
            src={appDashboard}
            alt="Screenshot der Avorix Koch-App: Dashboard mit den Modulen der K&uuml;chenverwaltung"
            widths={[480, 800, 1200]}
            sizes="(max-width: 1024px) 100vw, 1024px"
            loading="lazy"
            decoding="async"
            class="w-full h-auto"
          />
        </Lightbox>
      </div>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">
        <div class="card" style="padding:0;overflow:hidden">
          <Lightbox label="MENUPLANER" caption="Screenshot der Avorix Koch-App: Wochenplan mit Mittagessen und Abendessen inklusive Portionszahlen" flach>
            <Image
              src={appMenuplaner}
              alt="Screenshot der Avorix Koch-App: Wochenplan mit Mittagessen und Abendessen inklusive Portionszahlen"
              widths={[480, 800]}
              sizes="(max-width: 768px) 90vw, (max-width: 1280px) 30vw, 360px"
              loading="lazy"
              decoding="async"
              class="w-full h-auto"
            />
          </Lightbox>
          <div class="p-8">
            <h3 class="mb-4">Men&uuml;planer</h3>
            <p class="text-sm" style="color:var(--grau)">Speisen jeder Kalenderwoche planen, mit Mahlzeiten, Portionen und Notizen. <strong>Bew&auml;hrte Wochen kopieren Sie einfach in die n&auml;chste.</strong></p>
          </div>
        </div>
        <div class="card" style="padding:0;overflow:hidden">
          <Lightbox label="EINKAUFSLISTE" caption="Screenshot der Avorix Koch-App: Einkaufsliste mit Mengen, Einheiten und Gesamtkosten" flach>
            <Image
              src={appEinkaufsliste}
              alt="Screenshot der Avorix Koch-App: Einkaufsliste mit Mengen, Einheiten und Gesamtkosten"
              widths={[480, 800]}
              sizes="(max-width: 768px) 90vw, (max-width: 1280px) 30vw, 360px"
              loading="lazy"
              decoding="async"
              class="w-full h-auto"
            />
          </Lightbox>
          <div class="p-8">
            <h3 class="mb-4">Einkaufslisten auf Knopfdruck</h3>
            <p class="text-sm" style="color:var(--grau)">Aus dem fertigen Men&uuml;plan erzeugt die App die Einkaufsliste: Positionen, Mengen, Einheiten, gesch&auml;tzte Preise. <strong>Beim Einkaufen haken Sie ab.</strong></p>
          </div>
        </div>
        <div class="card">
          <h3 class="mb-4">Kalkulation bis zum Verkaufspreis</h3>
          <p class="text-sm" style="color:var(--grau)">Rohstoffkosten, Gemeinkosten und Gewinnaufschlag eintragen, und die App rechnet den Preis pro Portion.</p>
        </div>
        <div class="card">
          <h3 class="mb-4">Dienstplan</h3>
          <p class="text-sm" style="color:var(--grau)">Schichten pro Mitarbeiter und Tag, mit eigenen Schichttypen und Wochenansicht.</p>
        </div>
        <div class="card">
          <h3 class="mb-4">Zeiterfassung</h3>
          <p class="text-sm" style="color:var(--grau)">Ein- und ausstempeln direkt in der App, mit Monatsauswertung der Stunden.</p>
        </div>
        <div class="card">
          <h3 class="mb-4">Klare Rollen</h3>
          <p class="text-sm" style="color:var(--grau)">Ihr Souschef sieht den Plan, &auml;ndern kann ihn nur der K&uuml;chenchef. <strong>Jeder sieht genau das, was er braucht.</strong></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Zusatzmodule (12c) -->
 <section class="reveal section-gap" style="background:var(--papier)">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Wenn Sie mehr wollen: zwei Zusatzmodule.</h2>
      <!-- Korrektur 9 (Anweisung 25): Der Satz stand unter der Gruppe. Er ist zu
           verstehen, bevor man sie gesehen hat, also gehoert er nach oben. -->
      <p class="text-sm mb-10 max-w-[62ch]" style="color:var(--grau)">
        Was die Module kosten, rechnen wir Ihnen im Erstgespr&auml;ch vor, auf den Euro genau. F&uuml;r die ersten Betriebe gelten auch hier die Pilotkonditionen 2026.
      </p>
      <p class="max-w-[62ch] mb-8" style="color:var(--grau)">
        Beide bauen auf dem auf, was Ihre K&uuml;che schon nutzt. Avorix Preisvergleich setzt das Paket Warenwirtschaft voraus, Avorix Manager zus&auml;tzlich das Paket Organisation.
      </p>
      <div class="grid sm:grid-cols-2 gap-6">
        <div class="card-modul">
          <div class="card-modul-header">
            <span class="card-modul-label">Zusatzmodul</span>
            <span class="card-modul-leader"></span>
          </div>
          <h3 class="mb-4">Avorix Preisvergleich</h3>
          <p class="text-sm mb-6" style="color:var(--grau)">
            Lieferanten und Angebote an einem Ort. Sie laden die Preislisten Ihrer Lieferanten hoch, die App f&uuml;hrt gleiche Produkte zusammen und zeigt Ihnen den besten Preis je Artikel. <strong>Einkaufen nach Bauchgef&uuml;hl h&ouml;rt hier auf.</strong>
          </p>
          <p class="text-sm" style="color:var(--grau)">
            In einem Kundenbetrieb laufen dar&uuml;ber inzwischen 802 Artikel von f&uuml;nf Lieferanten.
          </p>
          <div class="mt-6">
            <Lightbox label="PREISVERGLEICH" caption="Screenshot der Avorix Koch-App: Preisvergleich mit dem besten Preis je Artikel über mehrere Lieferanten" flach>
              <Image
                src={appPreisvergleich}
                alt="Screenshot der Avorix Koch-App: Preisvergleich mit dem besten Preis je Artikel über mehrere Lieferanten"
                widths={[480, 800]}
                sizes="(max-width: 768px) 90vw, (max-width: 1280px) 45vw, 520px"
                loading="lazy"
                decoding="async"
                class="w-full h-auto"
              />
            </Lightbox>
          </div>
        </div>
        <div class="card-modul">
          <div class="card-modul-header">
            <span class="card-modul-label">Zusatzmodul</span>
            <span class="card-modul-leader"></span>
          </div>
          <h3 class="mb-4">Avorix Manager</h3>
          <p class="text-sm" style="color:var(--grau)">
            Wareneinsatz, Personalkosten und Rohgewinn, jeden Monat auf einen Blick, mit Zielwerten und Ampel. Die Leitung sieht alles, der K&uuml;chenchef seinen Kostenteil. Monatsabschluss und Export geh&ouml;ren dazu. <strong>Sie sehen es im Monat, nicht erst im Jahresabschluss.</strong>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Tagesablauf -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">So sieht ein normaler Tag damit aus.</h2>
      <!-- C5 (Anweisung 18): Die Sektion ist ein Tagesablauf und bekommt die Form
           eines Ablaufs. Drei Stationen untereinander, verbunden durch eine duenne
           Linie am linken Rand. Keine Karten, keine Kaesten, nur die Linie und der
           Rhythmus. Auf mobil dieselbe Form, nur schmaler. -->
      <ol class="tagesablauf">
        <li class="tagesablauf-station">
          <h3 class="eyebrow tagesablauf-zeit">Morgens</h3>
          <p class="text-sm max-w-[62ch]" style="color:var(--grau)">Die Vorbereitung l&auml;uft nach Liste. Jeder wei&szlig;, was heute vorproduziert wird, in welcher Menge, f&uuml;r wie viele G&auml;ste.</p>
        </li>
        <li class="tagesablauf-station">
          <h3 class="eyebrow tagesablauf-zeit">Im Service</h3>
          <p class="text-sm max-w-[62ch]" style="color:var(--grau)">Am Posten h&auml;ngt das Tablet. Bestellung kommt rein, die Kraft &ouml;ffnet das Gericht, arbeitet die Schritte ab. <strong>Das Ergebnis sieht aus und schmeckt wie immer.</strong></p>
        </li>
        <li class="tagesablauf-station">
          <h3 class="eyebrow tagesablauf-zeit">Abends</h3>
          <p class="text-sm max-w-[62ch]" style="color:var(--grau)">Der Wareneinsatz des Tages ist dokumentiert, ohne dass jemand etwas aufschreiben musste.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- Eigentum -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Wem geh&ouml;rt das alles?</h2>
      <p class="max-w-[62ch]" style="color:var(--grau)">Ihnen. Ihre Rezepte bleiben Ihr Eigentum und werden nicht an andere Betriebe weitergegeben. <strong>Wenn Sie Avorix verlassen, nehmen Sie Ihre Dokumentation mit.</strong></p>
    </div>
  </section>

  <!-- Einpflegen -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Sie m&uuml;ssen nichts einpflegen. Das machen wir.</h2>
      <p class="mb-6 max-w-[62ch]" style="color:var(--grau)">Ein Avorix-Koch nimmt Ihre Karte bei Ihnen vor Ort auf: kochen, dokumentieren, fotografieren, anlegen. <strong>Danach schult er Ihr Team direkt am Herd.</strong></p>
      <a href="/system" data-cta-location="kochapp-system" class="btn btn-secondary">So funktioniert das Avorix-System</a>
      <a href="/pilotprogramm" data-cta-location="kochapp-pilot" class="btn btn-secondary">Zum Pilotprogramm</a>
    </div>
  </section>

  <!-- FAQ -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">H&auml;ufige Fragen</h2>
      <div class="faq-list">
        <details class="faq-item" open>
          <summary class="faq-q">Auf welchen Ger&auml;ten l&auml;uft die App?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Auf Tablet und Smartphone, direkt in der K&uuml;che.</p></div></div>
        </details>
        <details class="faq-item">

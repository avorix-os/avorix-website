---
import { Image } from "astro:assets";
import BewerberLayout from "../../layouts/BewerberLayout.astro";
import Stempel from "../../components/Stempel.astro";
import BewerbungFormular from "../../components/BewerbungFormular.astro";
import { WHATSAPP_LINK } from "../../data/whatsapp";
import koecheAmPass from "../../assets/bilder/koeche-am-pass-mit-tablet.jpg";

// Anweisung 76: Bewerberprofil-Seite „Hotels und Restaurants bewerben sich bei dir".
// noindex, follow; nicht in Sitemap (astro.config.mjs), nicht in llms.txt, nicht in
// Navigation/Footer anderer Seiten; kein JobPosting-, FAQ- oder hreflang-Markup.
// Nur fuer Anzeigen und selbst verschickte Links. Geht erst mit 77 und nach der
// Kanzlei-Freigabe live. Im ersten Bildschirm nur Formular und WhatsApp.
---
<BewerberLayout
  title="Hotels und Restaurants bewerben sich bei dir"
  description="Leg in zwei Minuten ein kurzes Profil an. Wir zeigen es passenden Hotels und Restaurants ohne deinen Namen, du entscheidest, wen du kennenlernst. Kostenlos."
  lang="de"
  robots="noindex, follow"
  sprachwechsel={[
    { label: "English", href: "/en/jobs/profile/", lang: "en", hreflang: "en" },
    { label: "Magyar", href: "/hu/profil/", lang: "hu", hreflang: "hu" },
  ]}
  alternates={[]}
  impressum={{ label: "Impressum", href: "/impressum/" }}
  datenschutz={{ label: "Datenschutz", href: "/datenschutz/" }}
  cookieLabel="Cookie-Einstellungen"
  footerAdresse="AVORIX GmbH · Fallenbrunnen 14 · 88045 Friedrichshafen"
  consent="de"
  logoHref="/jobs/profil/"
>
  <section class="lp-hero px-6">
    <div class="content-width">
      <p class="eyebrow mb-3">Jobs bei Avorix · Küche, Service, Leitung</p>
      <h1 class="mb-4">Hotels und Restaurants bewerben sich bei dir.</h1>
      <p class="lp-sub mb-5">Leg ein kurzes Profil an. Wir zeigen es passenden Hotels, Restaurants und Kantinen, ohne deinen Namen. Du entscheidest, wen du kennenlernst.</p>
      <ul class="lp-haken mb-6">
        <li>Kostenlos für dich</li>
        <li>Dein Name bleibt bei uns, bis du zustimmst</li>
        <li>Wir melden uns innerhalb von 24 Stunden</li>
      </ul>
      <div id="bewerben" class="lp-formular">
        <BewerbungFormular quelle="profil" lang="de" whatsappHinweis />
      </div>
    </div>
  </section>

  <section class="reveal section-gap">
    <div class="content-width">
      <Image
        src={koecheAmPass}
        alt="Zwei Köche am Pass einer Profiküche stimmen sich über ein Tablet ab"
        widths={[480, 800, 1200, 1600]}
        sizes="(max-width: 1024px) 100vw, 1080px"
        loading="lazy"
        decoding="async"
        class="w-full object-cover"
        style="height:360px;border-radius:var(--radius);box-shadow:var(--schatten)"
      />
    </div>
  </section>

  <section class="reveal section-gap">
    <div class="content-width text-spalte">
      <h2 class="mb-6" style="color:var(--druck)">So läuft es</h2>
      <ol class="lp-schritte max-w-[var(--spalte-text)]" style="color:var(--grau)">
        <li><strong style="color:var(--druck)">Profil anlegen.</strong> Zwei Minuten, ohne Lebenslauf.</li>
        <li><strong style="color:var(--druck)">Wir melden uns</strong> innerhalb von 24 Stunden, meistens per Telefon, und klären mit dir, was du suchst.</li>
        <li><strong style="color:var(--druck)">Wir zeigen dein Kurzprofil passenden Betrieben,</strong> ohne Namen und ohne Kontaktdaten. Will ein Betrieb dich kennenlernen, fragen wir dich, bevor er deinen Namen erfährt.</li>
      </ol>
    </div>
  </section>

  <section class="reveal section-gap section-band">
    <div class="content-width text-spalte">
      <h2 class="mb-6" style="color:var(--druck)">Drei Wege, du entscheidest</h2>
      <div class="max-w-[var(--spalte-text)] space-y-6" style="color:var(--grau)">
        <p><strong style="color:var(--druck)">Bei Avorix angestellt.</strong> Avorix ist dein Arbeitgeber, du arbeitest in wechselnden Häusern. Dein Vertrag läuft auch zwischen zwei Einsätzen weiter.</p>
        <p><strong style="color:var(--druck)">Direkt in einem Betrieb, dauerhaft.</strong> Der Betrieb stellt dich selbst ein. Wir stellen euch einander vor und begleiten dich bis zum Start.</p>
        <p><strong style="color:var(--druck)">Direkt in einem Betrieb, für eine Saison.</strong> Der Betrieb stellt dich für die Saison ein, der Vertrag endet mit ihr.</p>
        <p>Du kannst mehrere Wege ankreuzen. Wir zeigen dein Profil nur für die Wege, die du gewählt hast.</p>
      </div>
    </div>
  </section>

  {/* Kurz gefragt: sichtbar, bewusst OHNE FAQ-Schema (Seite ist noindex) */}
  <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Kurz gefragt</h2>
      <div class="faq-list">
        <details class="faq-item" open>
          <summary class="faq-q">Kostet mich das etwas?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Nein. Für dich ist es kostenlos, egal welchen Weg du wählst.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Erfährt mein jetziger Chef davon?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Dein Kurzprofil zeigt weder deinen Namen noch deine Kontaktdaten oder deinen jetzigen Arbeitgeber. Sag uns beim Telefonat, welchen Betrieben wir es nicht zeigen sollen, dann lassen wir sie aus.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Was steht in meinem Kurzprofil?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Deine Rolle, deine Erfahrung, wo und ab wann du arbeiten willst, Vollzeit oder Teilzeit und die Wege, die du gewählt hast. Kein Name, keine Telefonnummer, kein Gehaltswunsch.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Kann ich mein Profil wieder löschen lassen?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Ja, jederzeit. Eine kurze Nachricht per WhatsApp oder an info@avorix.de reicht.</p></div></div>
        </details>
      </div>
    </div>
  </section>

  <section class="reveal section-gap">
    <div class="content-width text-center">
      <div class="mb-6">
        <Stempel groesse="gross" />
      </div>
      <a href="#bewerben" data-cta-location="profil-ende" class="btn btn-primary mb-6">Jetzt Profil anlegen</a>
      <p class="lp-telefon max-w-[var(--spalte-text)]" style="margin-inline:auto">
        Lieber direkt? Ruf an:
        <a href="tel:+4975413973915" data-cta-location="profil-ende" data-cta-event="personal_anruf_click" class="typo-link">07541 3973915</a>
        (Mo bis Fr 8 bis 17 Uhr, außerhalb über Band) oder schreib uns per
        <a href={WHATSAPP_LINK} data-cta-location="profil-ende-whatsapp" class="typo-link" target="_blank" rel="noopener">WhatsApp</a>.
      </p>
    </div>
  </section>
</BewerberLayout>

<style>
/* Erster Bildschirm: wenig Abstand ueber der H1, damit auf dem Handy der Anfang
   des Formulars ohne Scrollen sichtbar ist (Anweisung 76, Teil 1). */
.lp-hero { padding-top: 24px; padding-bottom: 48px; }
@media (min-width: 768px) {
  .lp-hero { padding-top: 64px; padding-bottom: 64px; }
}
.lp-hero h1 { font-size: clamp(28px, 7vw, 48px); line-height: 1.15; }
.lp-sub { font-size: 18px; line-height: 1.5; color: var(--grau); max-width: var(--spalte-text); }
.lp-haken { list-style: none; padding: 0; margin: 0; color: var(--druck); }
.lp-haken li { position: relative; padding-left: 28px; margin-bottom: 6px; font-weight: 600; }
.lp-haken li::before {
  content: "";
  position: absolute;
  left: 2px;
  top: 0.35em;
  width: 14px;
  height: 8px;
  border-left: 3px solid var(--akzent);
  border-bottom: 3px solid var(--akzent);
  transform: rotate(-45deg);
}
.lp-formular { max-width: 560px; }
.lp-schritte { list-style: decimal; padding-left: 24px; line-height: 1.7; }
.lp-schritte li { margin-bottom: 12px; }
.lp-telefon { font-size: 15px; color: var(--grau); }
</style>

<script>
/* FAQ-Schliess-Animation, wie auf den anderen Seiten */
document.querySelectorAll('.faq-item').forEach(function(item) {
  var summary = item.querySelector('summary');
  if (!summary) return;
  summary.addEventListener('click', function(e) {
    if (!(item as HTMLDetailsElement).open) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    e.preventDefault();
    item.classList.add('faq-closing');
    var body = item.querySelector('.faq-body');
    if (!body) { item.classList.remove('faq-closing'); item.removeAttribute('open'); return; }
    body.addEventListener('transitionend', function handler() {
      body!.removeEventListener('transitionend', handler);
      item.classList.remove('faq-closing');
      item.removeAttribute('open');
    });
  });
});
</script>

---
import BaseLayout from "../layouts/BaseLayout.astro";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Kostenloser Leitfaden: 5 Strategien gegen den Fachkräftemangel in der Küche",
    "description": "Praxisnaher Leitfaden für Hoteliers und Küchenchefs. Jetzt kostenlos herunterladen.",
    "url": "https://avorix.de/leitfaden",
    "inLanguage": "de",
    "dateModified": "2026-09-23",
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": "#direktantwort" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Ist der Fachkräftemangel in der Gastronomie 2026 vorbei?", "acceptedAnswer": { "@type": "Answer", "text": "Nein. Die gemeldeten Stellen sinken, aber die Beschäftigung ist über dem Niveau von 2019 und der Nachwuchs an Köchen schrumpft. Die Bundesagentur führt Koch und Köchin weiter als Engpassberuf." } },
      { "@type": "Question", "name": "Wie viele Köche fehlen in Deutschland?", "acceptedAnswer": { "@type": "Answer", "text": "Eine belastbare Gesamtzahl gibt es nicht; Verbandsschätzungen schwanken stark. Belastbar sind die Ausbildungszahlen: 2025 wurden 7.464 Koch-Ausbildungsverträge neu abgeschlossen, neun Prozent weniger als 2019." } },
      { "@type": "Question", "name": "Gilt das auch für Österreich?", "acceptedAnswer": { "@type": "Answer", "text": "Ja. Koch steht auf der Mangelberufsliste, das AMS meldet sehr hohe Nachfrage, vor allem in Tirol und Salzburg." } }
    ]
  }
];
---

<BaseLayout
  title="Fachkräftemangel in der Küche: 5 Strategien"
  description="Praxisnaher Leitfaden für Hoteliers und Küchenchefs: 5 bewährte Strategien gegen den Fachkräftemangel in der Küche. Kostenlos herunterladen."
  schemaOrg={schema}
>
 <section class="hero-section px-6">
    <div class="content-width">

      {/* Hero (Lead-Magnet-Landing, zentriert = finale Konversion) */}
      <div class="text-center mb-16">
        <span class="eyebrow inline-block mb-4">
          Kostenloser Leitfaden
        </span>
        <h1 class="mb-4">
          5 Strategien, mit denen Hotels den<br class="hidden md:block" />
          <span style="color:var(--akzent)">Fachkräftemangel in der Küche</span> meistern
        </h1>
        <p class="lead" style="color:var(--grau)">
          Ein praxisnaher Leitfaden für Hoteliers und Küchenchefs. Kostenlos und sofort verfügbar.
        </p>
      </div>

      {/* Two-column layout: Preview + Form */}
      <div class="grid sm:grid-cols-2 gap-16 items-start text-left">

        {/* Left: What's inside */}
        <div>
          <h2 class="mb-6" style="color:var(--druck)">Das erwartet Sie im Leitfaden:</h2>

          <ul class="space-y-4 mb-8">
            {[
              { num: "1", title: "Wissen dokumentieren", desc: "Wie Sie Rezept-Know-how aus Köpfen in Systeme bringen, bevor es zu spät ist." },
              { num: "2", title: "Einarbeitung beschleunigen", desc: "Neue Mitarbeiter in Tagen statt Wochen produktiv machen." },
              { num: "3", title: "Qualität standardisieren", desc: "Vom Kontrolleur zum Enabler: Küchenprozesse, die auch ohne den Chef funktionieren." },
              { num: "4", title: "Internationale Teams integrieren", desc: "Sprachbarrieren lösen mit visuellen und mehrsprachigen Rezeptunterlagen." },
              { num: "5", title: "Digitalisierung richtig einsetzen", desc: "Praxistipps für den einfachen Einstieg in die digitale Küche." },
            ].map((item) => (
              <li class="flex gap-4">
                <span class="schritt-chip shrink-0">{item.num}</span>
                <div>
                  <p class="text-sm" style="color:var(--druck);font-weight:600">{item.title}</p>
                  <p class="text-sm" style="color:var(--grau)">{item.desc}</p>
                </div>
              </li>
            ))}
          </ul>

          {/* Trust signals */}
          <div class="flex flex-wrap gap-4">
            <span class="check-badge"><span class="check-badge-mark">&#10003;</span> 8&ndash;10 Seiten, sofort umsetzbar</span>
            <span class="check-badge"><span class="check-badge-mark">&#10003;</span> PDF, kostenlos</span>
            <span class="check-badge"><span class="check-badge-mark">&#10003;</span> Newsletter freiwillig, jederzeit abmeldbar</span>
          </div>
        </div>

        {/* Right: Download gate form */}
        <div class="card" style="padding:2rem">
          {/* Form state: default */}
          <div id="form-container">
            <h3 class="mb-4" style="color:var(--druck)">Jetzt kostenlos herunterladen</h3>
            <p class="text-sm mb-6" style="color:var(--grau)">Tragen Sie sich ein und erhalten Sie den Leitfaden als PDF.</p>

            <p class="formular-pflicht">Felder mit * brauchen wir, alles andere ist freiwillig.</p>
            <form
              id="lead-form"
              action="/api/formular"
              method="POST"
              class="space-y-4"
            >
              {/* Anweisung 45: eigener Formular-Dienst. Betreff setzt der Dienst,
                  Redirect (ohne JS) auf /leitfaden/?download=1 macht der Dienst. */}
              <input type="hidden" name="formular" value="leitfaden" />
              <input type="hidden" name="source" value="leitfaden-landing-page" />
              {/* Spamabwehr: Honigtopf (unsichtbar) + Zeitstempel */}
              <input type="text" name="website" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
              <input type="hidden" name="form_ts" id="lead-ts" value="" />

              <div>
                <label for="lead-name" class="block text-sm font-medium mb-2" style="color:var(--druck)">
                  Ihr Name <span style="color:var(--akzent)">*</span>
                </label>
                <input
                  type="text"
                  id="lead-name"
                  name="name"
                  autocomplete="name"
                  required
                  placeholder="z. B. Maria Huber"
                  class="leitfaden-field w-full"
                />
              </div>

              <div>
                <label for="lead-email" class="block text-sm font-medium mb-2" style="color:var(--druck)">
                  E-Mail-Adresse <span style="color:var(--akzent)">*</span>
                </label>
                <input
                  type="email"
                  id="lead-email"
                  name="email"
                  autocomplete="email"
                  required
                  placeholder="ihre@email.at"
                  class="leitfaden-field w-full"
                />
              </div>

              <div>
                <label for="lead-hotel" class="block text-sm font-medium mb-2" style="color:var(--druck)">
                  Betrieb / Hotel <span style="color:var(--grau)">(optional)</span>
                </label>
                <input
                  type="text"
                  id="lead-hotel"
                  name="betrieb"
                  autocomplete="organization"
                  placeholder="z. B. Hotel Alpenhof"
                  class="leitfaden-field w-full"
                />
              </div>

              {/* Getrennte, NICHT vorausgewaehlte Werbe-Einwilligung (Anweisung 45, 2.1).
                  Der Download haengt NICHT davon ab. */}
              <label class="newsletter-consent">
                <input type="checkbox" name="newsletter" value="on" />
                <span>Sie d&uuml;rfen mir gelegentlich Neuigkeiten von Avorix per E-Mail schicken. Ich kann das jederzeit widerrufen.</span>
              </label>

              <button
                type="submit"
                id="submit-btn"
                class="btn btn-primary w-full"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                Leitfaden jetzt herunterladen
              </button>

              <p class="formular-hinweis">
                Wir verarbeiten Ihre Angaben, um Ihnen den Leitfaden zuzusenden.
                Weitere Informationen finden Sie in unserer <a href="/datenschutz" class="typo-link">Datenschutzerkl&auml;rung</a>.
              </p>
            </form>
          </div>

          {/* Success state (hidden by default, shown after submit) */}
          <div id="success-container" class="hidden text-center py-4">
            <div class="w-14 h-14 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-7 h-7 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h3 class="mb-4" style="color:var(--druck)">Vielen Dank!</h3>
            <p class="text-sm mb-6" style="color:var(--grau)">Ihr Download startet automatisch. Falls nicht, klicken Sie auf den Button.</p>
            <a
              id="manual-download"
              href="/downloads/leitfaden-fachkraeftemangel.pdf"
              download="Avorix-Leitfaden-Fachkraeftemangel.pdf"
              class="btn btn-primary"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              PDF herunterladen
            </a>
            <p class="text-xs mt-4" style="color:var(--grau)">
              Interesse an einer Demo?
              <a href="/kontakt" class="btn-link" style="font-size:inherit">App-Demo vereinbaren &rarr;</a>
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>

  {/* Anweisung 51/2 (A47 B3): Direktantwort (Speakable) + Fachkräftemangel-Zahlen */}
 <section class="reveal section-gap">
    <div class="content-width">
      <p id="direktantwort" class="lead py-4 max-w-[var(--spalte-text)]" style="color:var(--grau)">
        Der Fachkräftemangel in der Gastronomie ist 2026 kein Mangel an Stellen, sondern ein Mangel an Köchen: Die Beschäftigung im deutschen Gastgewerbe liegt wieder über dem Niveau von 2019, die Zahl der neuen Koch-Ausbildungsverträge liegt neun Prozent darunter, und die Bundesagentur führt Koch und Köchin als Engpassberuf. In Österreich steht der Beruf auf der Mangelberufsliste. Wer einen Koch verliert, ersetzt ihn nicht mehr über den Arbeitsmarkt, sondern über Organisation.
      </p>
    </div>
  </section>

 <section class="reveal section-gap">
    <div class="content-width">
      <div class="artikel-prosa">
        <h2>Deutschland: die Zahlen, Stand Anfang 2026</h2>
        <p>Die verlässlichste Quelle ist der Zahlenspiegel des DEHOGA, der die Daten der Bundesagentur für Arbeit auswertet. Stand 24. Februar 2026:</p>
        <div class="tabelle-scroll">
          <table>
            <thead>
              <tr><th>Kennzahl</th><th>Wert</th><th>Was sie bedeutet</th></tr>
            </thead>
            <tbody>
              <tr><td>Sozialversicherungspflichtig Beschäftigte im Gastgewerbe, November 2025</td><td>1.097.200, plus 0,2 Prozent gegenüber November 2019</td><td>Die Branche hat das Vorkrisenniveau wieder erreicht</td></tr>
              <tr><td>Beschäftigte in der Hotellerie, Juni 2025</td><td>265.714, minus 6,7 Prozent gegenüber 2019</td><td>Hotels haben Personal verloren, Restaurants gewonnen</td></tr>
              <tr><td>Bei der BA gemeldete offene Stellen, Januar 2026</td><td>17.667, minus 18,3 Prozent gegenüber Vorjahr, Tiefstwert seit Corona</td><td>Weniger Betriebe suchen überhaupt noch</td></tr>
              <tr><td>Arbeitslose in der Speisenzubereitung, Januar 2026</td><td>128.903, plus 1,3 Prozent</td><td>Es gibt Arbeitslose, aber nicht die gesuchten Qualifikationen</td></tr>
              <tr><td>Neue Ausbildungsverträge Koch/Köchin 2025</td><td>7.464, minus 9,0 Prozent gegenüber 2019</td><td>Der Nachwuchs schrumpft seit sechs Jahren</td></tr>
              <tr><td>Neue Verträge Fachkraft Küche 2025</td><td>1.188, plus 21,8 Prozent gegenüber Vorjahr</td><td>Die kürzere Ausbildung wächst, die volle Kochausbildung nicht</td></tr>
            </tbody>
          </table>
        </div>
        <p>Quelle: DEHOGA-Zahlenspiegel IV/2025 (Daten der Bundesagentur für Arbeit, des Statistischen Bundesamts und des BIBB). Die Bundesagentur führt Koch und Köchin in ihrer Fachkräfteengpassanalyse 2025 als Engpassberuf.</p>
        <p>Was die Tabelle zusammen sagt: Die Zahl der gemeldeten Stellen sinkt nicht, weil die Küchen voll sind, sondern weil viele Betriebe das Suchen aufgegeben haben oder kleiner fahren. Gleichzeitig kommen jedes Jahr weniger ausgebildete Köche nach. Das ist kein vorübergehender Engpass, das ist eine Strukturverschiebung.</p>

        <h2>Österreich: Koch bleibt Mangelberuf</h2>
        <p>In Österreich weist das AMS-JobBarometer für Koch und Köchin eine sehr hohe Nachfrage aus, mit rund 29.800 Stelleninseraten im Jahr 2025 und besonders hoher Nachfrage in Tirol und Salzburg. Der Beruf steht auf der Mangelberufsliste, die Wirtschaftskammer nennt für den Gaststättenkoch einen Stellenandrang von 1,8 Arbeitsuchenden je offener Stelle, gegenüber 1,4 zuvor. Für die Aufnahme in die Liste gilt eine Schwelle von 1,5. Der Beruf ist damit nah an der Grenze, und die Rot-Weiß-Rot-Karte für Köche aus Drittstaaten läuft in der bisherigen Form bis Ende 2026.</p>
        <p>Quellen: AMS-JobBarometer, Beruf Koch/Köchin (Stand 2025); Wirtschaftskammer Niederösterreich, „Aktuelles zur Mangelberufsliste".</p>

        <h2>Was das für Ihre Küche heißt</h2>
        <p>Wenn der Markt keinen Ersatz liefert, bleiben drei Wege: das Wissen im Haus so festhalten, dass es nicht mit einer Person geht; die Einarbeitung so verkürzen, dass auch angelernte Kräfte nach Standard arbeiten; und für den Engpass einen Weg haben, der innerhalb von Tagen jemanden an den Posten bringt. Die ersten beiden Wege beschreibt der Leitfaden unten. Den dritten beschreibt die Seite <a href="/personal/" class="typo-link">Personal</a>.</p>
      </div>
    </div>
  </section>

  {/* FAQ (A47 B3) */}
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Häufige Fragen</h2>
      <div class="faq-list">
        <details class="faq-item" open>
          <summary class="faq-q">Ist der Fachkräftemangel in der Gastronomie 2026 vorbei?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Nein. Die gemeldeten Stellen sinken, aber die Beschäftigung ist über dem Niveau von 2019 und der Nachwuchs an Köchen schrumpft. Die Bundesagentur führt Koch und Köchin weiter als Engpassberuf.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Wie viele Köche fehlen in Deutschland?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Eine belastbare Gesamtzahl gibt es nicht; Verbandsschätzungen schwanken stark. Belastbar sind die Ausbildungszahlen: 2025 wurden 7.464 Koch-Ausbildungsverträge neu abgeschlossen, neun Prozent weniger als 2019.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Gilt das auch für Österreich?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Ja. Koch steht auf der Mangelberufsliste, das AMS meldet sehr hohe Nachfrage, vor allem in Tirol und Salzburg.</p></div></div>
        </details>
      </div>
    </div>
  </section>

  {/* Stats / Social Proof strip */}
 <section class="reveal section-gap">
    <div class="content-width text-spalte">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {[
          { stat: "3–6 Wo.", label: "dauert die Einarbeitung in Hotelküchen im Schnitt" },
          { stat: "Top 20", label: "Rezepte reichen, um die größte Abhängigkeit zu reduzieren" },
          { stat: "Tag 1", label: "ab dem neue Mitarbeiter nach Standard arbeiten können" },
        ].map((item) => (
          <div>
            <p style="font-size:1.5rem;font-weight:700;font-family:var(--f-mono);font-variant-numeric:tabular-nums;color:var(--akzent)">{item.stat}</p>
            <p class="text-xs mt-6" style="color:var(--grau)">{item.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* About Avorix teaser (finale CTA-Sektion, zentriert erlaubt) */}
 <section class="reveal section-gap">
    <div class="content-width text-spalte text-center">
      <p class="eyebrow mb-6">&Uuml;ber Avorix</p>
      <h2 class="mb-6" style="color:var(--druck);margin-left:auto;margin-right:auto">Die Avorix Koch-App: die Lösung, die dieser Leitfaden beschreibt</h2>
      <p class="mb-6 max-w-[var(--spalte-text)]" style="color:var(--grau)">
        Avorix setzt genau das digital um, was in diesem Leitfaden als bewährte Strategie beschrieben wird: zentrale Rezeptverwaltung, Schritt-für-Schritt-Anleitungen und konsistente Qualität, <strong>auch ohne ausgebildete Köche</strong>.
      </p>
      <a
        href="/kontakt"
        data-cta-location="leitfaden"
        class="btn btn-primary"
      >
        App-Demo vereinbaren
      </a>
      <p class="mt-6">
        <a href="/personal#anfrage" data-cta-location="leitfaden-zweitweg" data-cta-event="cta_personal_click" class="btn btn-secondary">Sie brauchen jetzt jemanden?</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
.leitfaden-field {
  display: block;
  background: var(--flaeche);
  border: 1px solid var(--linie);
  border-radius: var(--radius);
  padding: 16px;
  font-size: 16px;
  font-family: var(--f-body);
  color: var(--druck);
  outline: none;
  box-sizing: border-box;
}
.leitfaden-field:focus {
  border-color: var(--akzent);
  box-shadow: 0 0 0 3px rgba(168, 83, 43, 0.15);
}
.leitfaden-field.error {
  border-color: var(--fehler);
}
/* Honigtopf: fuer Menschen unsichtbar, fuer Bots ein Koeder (Anweisung 45) */
.hp-field {
  position: absolute;
  left: -9999px;
  width: 1px;
  height: 1px;
  opacity: 0;
  overflow: hidden;
}
/* Getrennte Werbe-Einwilligung */
.newsletter-consent {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  font-size: 0.8125rem;
  line-height: 1.5;
  color: var(--grau);
}
.newsletter-consent input {
  margin-top: 3px;
  flex-shrink: 0;
}
</style>

<script>
  const form = document.getElementById('lead-form') as HTMLFormElement;
  const formContainer = document.getElementById('form-container');
  const successContainer = document.getElementById('success-container');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  // Zeitfalle: Zeitpunkt des Seitenaufrufs setzen (Anweisung 45, Spamabwehr).
  const tsInput = document.getElementById('lead-ts') as HTMLInputElement | null;
  if (tsInput) tsInput.value = String(Date.now());

  // Check if redirected back with ?download=1 (Dienst-Success-Redirect)
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('download') === '1') {
    showSuccess();
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    submitBtn.disabled = true;
    submitBtn.textContent = 'Wird gesendet…';

    const formData = new FormData(form);

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: { 'Accept': 'application/json' },
      });

      if (response.ok) {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'lead_magnet_download', asset: 'leitfaden_fachkraeftemangel' });
        showSuccess();
      } else {
        // Fallback: still show success + trigger download
        // Even if email fails to save, user gets PDF
        showSuccess();
      }
    } catch {
      // Network error — show success anyway, trigger download
      showSuccess();
    }
  });

  function showSuccess() {
    formContainer?.classList.add('hidden');
    successContainer?.classList.remove('hidden');

    // Auto-trigger download
    const link = document.createElement('a');
    link.href = '/downloads/leitfaden-fachkraeftemangel.pdf';
    link.download = 'Avorix-Leitfaden-Fachkraeftemangel.pdf';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);

    // Clean up URL
    if (window.history.replaceState) {
      window.history.replaceState({}, document.title, window.location.pathname);
    }
  }
</script>

<script>
/* FAQ-Schliess-Animation, progressive enhancement (Anweisung 51/2) */
document.querySelectorAll('.faq-item').forEach(function(item) {
  var summary = item.querySelector('summary');
  if (!summary) return;
  summary.addEventListener('click', function(e) {
    if (!item.open) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    e.preventDefault();
    item.classList.add('faq-closing');
    var body = item.querySelector('.faq-body');
    if (!body) { item.classList.remove('faq-closing'); item.removeAttribute('open'); return; }
    body.addEventListener('transitionend', function handler() {
      body.removeEventListener('transitionend', handler);
      item.classList.remove('faq-closing');
      item.removeAttribute('open');
    });
  });
});
</script>

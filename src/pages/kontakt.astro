---
import BaseLayout from "../layouts/BaseLayout.astro";


const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Avorix Demo vereinbaren",
  "description": "Interesse an Avorix? Wir beraten Hotels und Gastronomiebetriebe zur Küchenmanagement-Software und Avorix Koch-App.",
  "url": "https://avorix.cloud/kontakt",
  "inLanguage": "de",
  "mainEntity": {
    "@type": "Organization",
    "name": "Avorix",
    "url": "https://avorix.cloud",
    "email": "info@avorix.de",
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "info@avorix.de",
      "contactType": "sales",
      "availableLanguage": ["German", "English"]
    }
  }
};
---

<BaseLayout title="Demo vereinbaren" description="Interesse an Avorix? Wir beraten Hotels und Gastronomiebetriebe zur Küchenmanagement-Software und Avorix Koch-App. Jetzt Kontakt aufnehmen." schemaOrg={schema}>
 <section class="hero-section px-6">
    <div class="content-width">
      <p class="eyebrow mb-4">Kostenloses Erstgespräch</p>
      <h1 class="mb-4">Demo vereinbaren</h1>
      <p class="lead mb-10 max-w-[62ch]" style="color:var(--grau)">Lernen Sie Avorix in einem persönlichen Demo-Gespräch kennen. Wir zeigen Ihnen, wie unsere Lösung Ihren Küchenbetrieb konkret unterstützt.</p>

      <!-- Zwei Wege nebeneinander (Anweisung 12a/9): links die bestehende
           Kalender-Karte unveraendert, rechts der Personal-Weg. -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12 items-stretch">
        <div class="card flex flex-col">
          <h2 class="mb-2" style="color:var(--druck)">Demo-Termin direkt buchen</h2>
          <p class="mb-6" style="color:var(--grau)">Wählen Sie einfach einen freien Termin in unserem Kalender. <strong>Kein Telefonieren, kein Warten.</strong></p>
          <a
            href="https://calendly.com/avorix/kostenfreies-erstgesprach"
            target="_blank"
            rel="noopener"
            class="btn btn-primary"
            style="margin-top:auto;align-self:flex-start"
          >
            Termin auswählen
          </a>
          <p class="text-sm mt-3" style="color:var(--grau)">Kostenlos &amp; unverbindlich · 30 Minuten</p>
        </div>

        <div class="card flex flex-col">
          <h2 class="mb-2" style="color:var(--druck)">Sie brauchen Personal?</h2>
          <p class="mb-4" style="color:var(--grau)"><strong>Sofort ein Koch, wenn Ihrer fehlt.</strong> Beschreiben Sie kurz Ihren Bedarf, wir melden uns innerhalb von 24 Stunden.</p>
          <p class="mb-6" style="color:var(--grau);font-size:15px">
            Im Notfall direkt anrufen:
            <a
              href="tel:+4975413973915"
              data-cta-location="kontakt"
              data-cta-event="personal_anruf_click"
              class="kontakt-telefon-link"
            >07541 3973915</a>
            (Mo bis Fr 8 bis 17 Uhr, au&szlig;erhalb &uuml;ber Band)
          </p>
          <a
            href="/personal#anfrage"
            data-cta-location="kontakt"
            data-cta-event="cta_personal_click"
            class="btn btn-primary"
            style="margin-top:auto;align-self:flex-start"
          >
            Personal anfragen
          </a>
        </div>
      </div>

      <p class="eyebrow mb-8">Oder schreiben Sie uns</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <!-- Kontaktdaten (kompakte Karte, §3.15) -->
        <div class="card" style="align-self:start">
          <h3 class="mb-1" style="font-size:14px;font-weight:600;color:var(--druck)">E-Mail</h3>
          <a href="mailto:info@avorix.de" class="kontakt-mailto">
            info@avorix.de
          </a>
        </div>

        <!-- Kontaktformular -->
        <p class="formular-pflicht">Felder mit * brauchen wir, alles andere ist freiwillig.</p>
        <form id="contact-form" class="space-y-4" action="https://formspree.io/f/xqegwngo" method="POST">
          <input type="hidden" name="_subject" value="Demo-Anfrage über avorix.cloud" />
          <div>
            <label for="name" class="block text-sm font-medium mb-1" style="color:var(--druck)">
              Name <span style="color:var(--akzent)">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              class="kontakt-field w-full"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium mb-1" style="color:var(--druck)">
              E-Mail <span style="color:var(--akzent)">*</span>
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="kontakt-field w-full"
            />
          </div>
          <div>
            <label for="message" class="block text-sm font-medium mb-1" style="color:var(--druck)">
              Nachricht <span style="color:var(--akzent)">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="kontakt-field w-full"
            ></textarea>
          </div>
          <button
            type="submit"
            class="btn btn-primary w-full"
          >
            Absenden
          </button>
          <p class="formular-hinweis">
            Mit dem Absenden stimmen Sie der Verarbeitung Ihrer Angaben zur Bearbeitung Ihrer Anfrage zu.
            Mehr dazu in der <a href="/datenschutz" class="typo-link">Datenschutzerkl&auml;rung</a>.
          </p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
/* E-Mail-Link: Kupfer-Farbe, Unterstrich bei Hover (§3.14 Kontaktdaten) */
.kontakt-mailto {
  color: var(--akzent);
  text-decoration: underline;
}
.kontakt-mailto:hover {
  text-decoration: underline;
}
.kontakt-telefon-link {
  font-weight: 700;
  color: var(--akzent);
  text-decoration: underline;
}
.kontakt-telefon-link:hover {
  text-decoration: underline;
}

/* Formularfelder: Token-basiert nach §3.14 */
.kontakt-field {
  display: block;
  background: var(--flaeche);
  border: 1px solid var(--linie);
  border-radius: var(--radius);
  padding: 14px 16px;
  font-size: 16px;
  font-family: var(--f-body);
  color: var(--druck);
  outline: none;
  box-sizing: border-box;
  /* F2 (Anweisung 18): Hoehe fest, damit Auswahlfelder nicht 5px kleiner
     ausfallen als Eingabefelder. Textfelder ueberschreiben das unten. */
  min-height: 56px;
}
.kontakt-field:focus {
  border-color: var(--akzent);
  box-shadow: 0 0 0 3px rgba(168, 83, 43, 0.15);
}
.kontakt-field.error {
  border-color: var(--fehler);
}
textarea.kontakt-field {
  resize: none;
}
@media (prefers-reduced-motion: reduce) {
  .kontakt-field {
    transition: none;
  }
}
</style>

<script>
  const contactForm = document.getElementById('contact-form') as HTMLFormElement;
  if (contactForm) {
    let leadSent = false;
    contactForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = contactForm.querySelector('[type="submit"]') as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Wird gesendet…';
      }
      try {
        const response = await fetch(contactForm.action, {
          method: 'POST',
          body: new FormData(contactForm),
          headers: { 'Accept': 'application/json' },
        });
        if (response.ok && !leadSent) {
          leadSent = true;
          (window as any).dataLayer = (window as any).dataLayer || [];
          (window as any).dataLayer.push({ event: 'generate_lead', form_name: 'demo_kontakt' });
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = response.ok ? 'Gesendet ✔' : 'Absenden';
        }
        if (response.ok) {
          contactForm.reset();
        }
      } catch {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Absenden';
        }
      }
    });
  }
</script>

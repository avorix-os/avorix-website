---
import BaseLayout from "../layouts/BaseLayout.astro";
import { useTranslations } from "../i18n/translations";

const t = useTranslations("de");

const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Avorix Demo vereinbaren",
  "description": "Interesse an Avorix? Wir beraten Hotels und Gastronomiebetriebe zur Küchenmanagement-Software und Avorix Koch App.",
  "url": "https://avorix.cloud/kontakt",
  "inLanguage": "de",
  "mainEntity": {
    "@type": "Organization",
    "name": "Avorix",
    "url": "https://avorix.cloud",
    "email": "info@avorix.de",
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "info@avorix.de",
      "contactType": "sales",
      "availableLanguage": ["German", "English"]
    }
  }
};
---

<BaseLayout title="Demo vereinbaren" description="Interesse an Avorix? Wir beraten Hotels und Gastronomiebetriebe zur Küchenmanagement-Software und Avorix Koch App. Jetzt Kontakt aufnehmen." schemaOrg={schema}>
 <section class="pt-32 pb-20 px-6">
    <div class="max-w-3xl mx-auto">
      <p class="eyebrow mb-4">{t("contact.eyebrow")}</p>
      <h1 class="mb-4">{t("contact.title")}</h1>
      <p class="lead mb-10" style="color:var(--grau)">{t("contact.intro")}</p>

      <!-- Calendly Buchungs-Widget -->
      <div class="card mb-12" style="padding:2rem;text-align:center">
        <h2 class="mb-2">{t("contact.booking.heading")}</h2>
        <p class="mb-6" style="color:var(--grau)">{t("contact.booking.text")}</p>
        <a
          href="https://calendly.com/avorix/kostenfreies-erstgesprach"
          target="_blank"
          rel="noopener"
          class="btn btn-primary"
        >
          {t("contact.booking.button")}
        </a>
        <p class="text-sm mt-3" style="color:var(--grau)">{t("contact.booking.note")}</p>
      </div>

      <p class="eyebrow mb-8">{t("contact.or")}</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <!-- Kontaktdaten -->
        <div class="space-y-6">
          <div>
            <h3 class="mb-1" style="font-size:14px;font-weight:600;color:var(--druck)">{t("contact.email")}</h3>
            <a href="mailto:info@avorix.de" class="kontakt-mailto">
              info@avorix.de
            </a>
          </div>
        </div>

        <!-- Kontaktformular -->
        <form id="contact-form" class="space-y-4" action="https://formspree.io/f/xqegwngo" method="POST">
          <input type="hidden" name="_subject" value="Demo-Anfrage über avorix.cloud" />
          <div>
            <label for="name" class="block text-sm font-medium mb-1" style="color:var(--druck)">
              {t("contact.form.name")}
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="kontakt-field w-full"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium mb-1" style="color:var(--druck)">
              {t("contact.form.email")}
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="kontakt-field w-full"
            />
          </div>
          <div>
            <label for="message" class="block text-sm font-medium mb-1" style="color:var(--druck)">
              {t("contact.form.message")}
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="kontakt-field w-full"
            ></textarea>
          </div>
          <button
            type="submit"
            class="btn btn-primary w-full"
          >
            {t("contact.form.submit")}
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
/* E-Mail-Link: Kupfer-Farbe, Unterstrich bei Hover (§3.14 Kontaktdaten) */
.kontakt-mailto {
  color: var(--akzent);
  text-decoration: none;
}
.kontakt-mailto:hover {
  text-decoration: underline;
}

/* Formularfelder: Token-basiert nach §3.14 */
.kontakt-field {
  display: block;
  background: var(--flaeche);
  border: 1px solid var(--linie);
  border-radius: var(--radius);
  padding: 14px 16px;
  font-size: 16px;
  font-family: var(--f-body);
  color: var(--druck);
  outline: none;
  box-sizing: border-box;
}
.kontakt-field:focus {
  border-color: var(--akzent);
  box-shadow: 0 0 0 3px rgba(168, 83, 43, 0.15);
}
.kontakt-field.error {
  border-color: var(--fehler);
}
textarea.kontakt-field {
  resize: none;
}
@media (prefers-reduced-motion: reduce) {
  .kontakt-field {
    transition: none;
  }
}
</style>

<script>
  const contactForm = document.getElementById('contact-form') as HTMLFormElement;
  if (contactForm) {
    let leadSent = false;
    contactForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = contactForm.querySelector('[type="submit"]') as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Wird gesendet…';
      }
      try {
        const response = await fetch(contactForm.action, {
          method: 'POST',
          body: new FormData(contactForm),
          headers: { 'Accept': 'application/json' },
        });
        if (response.ok && !leadSent) {
          leadSent = true;
          (window as any).dataLayer = (window as any).dataLayer || [];
          (window as any).dataLayer.push({ event: 'generate_lead', form_name: 'demo_kontakt' });
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = response.ok ? 'Gesendet ✔' : 'Absenden';
        }
        if (response.ok) {
          contactForm.reset();
        }
      } catch {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Absenden';
        }
      }
    });
  }
</script>

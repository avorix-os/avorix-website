---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image, getImage } from "astro:assets";
import Stempel from "../components/Stempel.astro";
import dampfTopf from "../assets/bilder/dampf-topf.jpg";

const ogImg = await getImage({ src: dampfTopf, width: 1200, format: "jpeg" });
const ogImageAlt = "Dampf über einem Edelstahltopf auf dem Gasherd einer Profiküche";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Startseite",
        "item": "https://avorix.cloud/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Personal",
        "item": "https://avorix.cloud/personal"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Arbeitnehmerüberlassung von Köchen",
    "serviceType": "Arbeitnehmerüberlassung",
    "description": "Festangestellte Köche, rechtssicher verliehen: für Notfall, Saison und Übergang. Mit behördlicher Arbeitnehmerüberlassungserlaubnis.",
    "provider": {
      "@type": "Organization",
      "name": "Avorix",
      "url": "https://avorix.cloud/"
    },
    "areaServed": ["DE", "AT"],
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": "#direktantwort"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Wer sind die Avorix-Köche?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Fest angestellte Profis mit Berufserfahrung in Hotel- und Restaurantküchen."
        }
      },
      {
        "@type": "Question",
        "name": "Was ist, wenn der Koch nicht zu unserem Team passt?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Dann sprechen Sie mit uns, und wir finden eine Lösung. Es bringt niemandem etwas, wenn die Chemie nicht stimmt."
        }
      },
      {
        "@type": "Question",
        "name": "Wie läuft das vertraglich?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Über einen Arbeitnehmerüberlassungsvertrag, wie ihn die Agentur für Arbeit vorsieht. Sie unterschreiben ein paar Seiten mehr als bei einer Vermittler-Rechnung, und genau das schützt Sie."
        }
      },
      {
        "@type": "Question",
        "name": "Kann aus dem Einsatz mehr werden (Schulung, unser System)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja, jederzeit. Viele Betriebe starten mit einem Personal-Einsatz und bauen danach unser System auf, damit der nächste Ausfall kein Notfall mehr ist."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "url": "https://avorix.cloud/personal",
    "primaryImageOfPage": {
      "@type": "ImageObject",
      "url": `https://avorix.cloud${ogImg.src}`,
      "description": ogImageAlt
    }
  }
];
---

<BaseLayout
  title="Köche mieten mit Arbeitnehmerüberlassungserlaubnis | Avorix"
  description="Festangestellte Köche, rechtssicher verliehen: für Notfall, Saison und Übergang. Mit behördlicher Arbeitnehmerüberlassungserlaubnis."
  ogImage={ogImg.src}
  ogImageAlt={ogImageAlt}
  schemaOrg={schema}
>
  <!-- Hero (W2: Split 55/45, Bild rechts) -->
 <section class="hero-section px-6" style="background:var(--papier)">
    <div class="content-width hero-grid">
      <div class="hero-copy">
        <p class="eyebrow mb-4">Modul: Die Verst&auml;rkung</p>
        <h1 class="mb-6">
          Echte K&ouml;che. Fest angestellt. <mark style="white-space:nowrap">Rechtssicher verliehen.</mark>
        </h1>
        <p class="lead mb-6 max-w-[62ch]" style="color:var(--grau)">
          Wenn Ihnen Personal fehlt, leihen wir Ihnen unsere festangestellten K&ouml;che aus: f&uuml;r den Notfall, f&uuml;r die Saison, f&uuml;r den &Uuml;bergang. Im Gastgewerbe haben diese Erlaubnis nur wenige. Damit sind Sie zu 100 Prozent auf der rechtlich sicheren Seite.
        </p>
        <div class="flex flex-wrap gap-4 mb-6">
          <a href="/kontakt" data-cta-location="personal-hero" class="btn btn-primary">Demo vereinbaren</a>
        </div>
        <div class="hero-badges">
          <Stempel>Gepr&uuml;ft &middot; A&Uuml;-Erlaubnis</Stempel>
        </div>
      </div>
      <div class="hero-media">
        <Image
          src={dampfTopf}
          alt="Dampf &uuml;ber einem Edelstahltopf auf dem Gasherd einer Profik&uuml;che"
          widths={[480, 800, 1200]}
          sizes="(max-width: 900px) 100vw, 528px"
          loading="eager"
          fetchpriority="high"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Direkt-Antwort (GEO) -->
 <section class="reveal">
    <div class="content-width">
      <p id="direktantwort" class="py-4 max-w-[62ch]" style="color:var(--grau)">
        Avorix verleiht festangestellte, sozialversicherte K&ouml;che an Hotels und Restaurants in Deutschland und &Ouml;sterreich. Grundlage ist die beh&ouml;rdliche Arbeitnehmer&uuml;berlassungserlaubnis der Agentur f&uuml;r Arbeit. Das sch&uuml;tzt Betriebe vor dem Scheinselbst&auml;ndigkeits-Risiko, das bei vermittelten &bdquo;selbst&auml;ndigen&ldquo; K&ouml;chen entstehen kann.
      </p>
    </div>
  </section>

  <!-- Wann Sie uns rufen -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-12" style="color:var(--druck)">Wann Sie uns rufen.</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="card">
          <h3 class="mb-3">Der Notfall.</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">
            Der K&uuml;chenchef f&auml;llt aus, die Saison l&auml;uft. Ein Avorix-Koch &uuml;bernimmt, tageweise oder wochenweise.
          </p>
        </div>
        <div class="card">
          <h3 class="mb-3">Die Saison.</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">
            Sie brauchen planbar zwei Kr&auml;fte mehr. Unsere K&ouml;che verst&auml;rken Ihr Team f&uuml;r Wochen oder die ganze Saison.
          </p>
        </div>
        <div class="card">
          <h3 class="mb-3">Der &Uuml;bergang.</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">
            Die Neubesetzung dauert l&auml;nger als geplant. Wir &uuml;berbr&uuml;cken, bis Ihre L&ouml;sung steht.
          </p>
        </div>
      </div>
      <p class="text-sm mt-8 max-w-[62ch]" style="color:var(--grau)">
        Kurzfristige Eins&auml;tze sind in der Regel innerhalb von 24 bis 72 Stunden m&ouml;glich, im Notfall sind wir rund um die Uhr erreichbar. 98 Prozent der Anfragen k&ouml;nnen wir innerhalb von 3 Tagen besetzen.
      </p>
    </div>
  </section>

  <!-- Wissen bleibt -->
 <section class="reveal section-gap" style="background:var(--papier)">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">
        Der Leihkoch geht irgendwann wieder. Sein Wissen bleibt da.
      </h2>
      <p class="lead max-w-[62ch]" style="color:var(--grau)">
        Unsere K&ouml;che arbeiten mit der Avorix Koch-App und dokumentieren dabei weiter. Sie bezahlen Personal und bauen nebenbei unser System in Ihrer K&uuml;che auf. Bei einer klassischen Zeitarbeitsfirma bleibt nach dem Einsatz nichts zur&uuml;ck. Bei uns bleibt das Wissen.
      </p>
    </div>
  </section>

  <!-- Scheinselbständigkeit → dunkle Beweis-Sektion (3.10) -->
 <section class="reveal section-gap" style="background:var(--eisen)">
    <div class="content-width">
      <h2 class="mb-8" style="color:var(--papier)">
        Warum &bdquo;g&uuml;nstige Selbst&auml;ndige&ldquo; Sie 50.000 Euro kosten k&ouml;nnen.
      </h2>
      <p class="leading-relaxed mb-4 max-w-[62ch]" style="color:var(--papier);opacity:0.85">
        Viele Vermittler schicken Ihnen &bdquo;selbst&auml;ndige&ldquo; K&ouml;che, die eine Rechnung mit Mehrwertsteuer schreiben. Klingt unkompliziert, ist aber in den meisten F&auml;llen Scheinselbst&auml;ndigkeit: Die K&ouml;che arbeiten weisungsgebunden in Ihrem Betriebsablauf, wie Angestellte.
      </p>
      <p class="leading-relaxed mb-4 max-w-[62ch]" style="color:var(--papier);opacity:0.85">
        Was bei der n&auml;chsten Sozialversicherungspr&uuml;fung passiert: Die Pr&uuml;fer stufen diese K&ouml;che als scheinselbst&auml;ndig ein, und zwar in den allermeisten F&auml;llen. Dann zahlt nicht der Koch, sondern Ihr Haus: s&auml;mtliche Sozialleistungen, r&uuml;ckwirkend f&uuml;r <strong style="color:var(--akzent-hell)">drei bis vier Jahre</strong>. Je nach Umfang schnell <strong style="color:var(--akzent-hell)">50.000 bis 100.000 Euro</strong>. Der Koch selbst ist dann meist nicht mehr greifbar.
      </p>
      <p class="leading-relaxed mb-4 max-w-[62ch]" style="color:var(--papier);opacity:0.85">
        <strong style="color:var(--papier)">Deshalb machen wir es anders:</strong> Unsere K&ouml;che sind bei Avorix fest angestellt und sozialversichert. Wir haben die beh&ouml;rdliche Arbeitnehmer&uuml;berlassungserlaubnis von der Agentur f&uuml;r Arbeit. Unsere Vertr&auml;ge sind von der Agentur f&uuml;r Arbeit gepr&uuml;ft.
      </p>
      <p class="leading-relaxed max-w-[62ch]" style="color:var(--papier);opacity:0.85">
        Gr&ouml;&szlig;ere H&auml;user und Hotelgruppen buchen inzwischen nur noch Firmen mit dieser Erlaubnis, aus genau diesem Grund. Im Gastgewerbe haben sie nur wenige Anbieter. Fragen Sie danach, bevor Sie irgendwo buchen. Auch wenn es nicht bei uns ist.
      </p>
    </div>
  </section>

  <!-- Diskretion -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">
        Ihre G&auml;ste erleben Ihre K&uuml;che. Nicht unsere.
      </h2>
      <p class="lead max-w-[62ch]" style="color:var(--grau)">
        Kein Gast merkt, dass ein Avorix-Koch mitkocht. Wir nennen keinen Kunden &ouml;ffentlich, und auf Wunsch sichern wir Ihnen das vertraglich zu.
      </p>
    </div>
  </section>

  <!-- Was kostet das -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-8" style="color:var(--druck)">Was kostet das?</h2>
      <div class="card">
        <p class="leading-relaxed mb-6 max-w-[62ch]" style="color:var(--grau)">
          Klare Stundensätze, ohne versteckte Posten. Die Zahlen bekommen Sie im Erstgespräch schwarz auf weiß. Für die ersten Betriebe gelten 2026 Pilotkonditionen deutlich unter dem regulären Preis.
        </p>
        <a
          href="/kontakt"
          data-cta-location="personal-kosten"
          class="btn btn-primary"
        >Demo vereinbaren</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
 <section class="reveal section-gap" style="background:var(--papier)">
    <div class="content-width">
      <h2 class="mb-10" style="color:var(--druck)">H&auml;ufige Fragen</h2>
      <div class="faq-list">
        <details class="faq-item" open>
          <summary class="faq-q">Wer sind die Avorix-K&ouml;che?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Fest angestellte Profis mit Berufserfahrung in Hotel- und Restaurantk&uuml;chen.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Was ist, wenn der Koch nicht zu unserem Team passt?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Dann sprechen Sie mit uns, und wir finden eine L&ouml;sung. Es bringt niemandem etwas, wenn die Chemie nicht stimmt.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Wie l&auml;uft das vertraglich?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>&Uuml;ber einen Arbeitnehmer&uuml;berlassungsvertrag, wie ihn die Agentur f&uuml;r Arbeit vorsieht. Sie unterschreiben ein paar Seiten mehr als bei einer Vermittler-Rechnung, und genau das sch&uuml;tzt Sie.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Kann aus dem Einsatz mehr werden (Schulung, unser System)?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Ja, jederzeit. Viele Betriebe starten mit einem Personal-Einsatz und bauen danach unser System auf, damit der n&auml;chste Ausfall kein Notfall mehr ist.</p></div></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Final CTA → Peak-End (3.18) -->
 <section class="reveal section-gap">
    <div class="content-width text-center">
      <div class="mb-6">
        <Stempel>Gepr&uuml;ft &middot; A&Uuml;-Erlaubnis</Stempel>
      </div>
      <p class="mb-6" style="font-family:Charter, Georgia, serif; font-style:italic; font-size:24px; color:var(--druck)">Es ist geregelt.</p>
      <a
        href="/kontakt"
        data-cta-location="personal-final"
        class="btn btn-primary"
      >Demo vereinbaren</a>
    </div>
  </section>
</BaseLayout>

<style>
/* FAQ-Accordion (3.13) */
.faq-list {
  border-top: 1px solid var(--linie);
}
.faq-item {
  border-bottom: 1px solid var(--linie);
}
.faq-item summary {
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  cursor: pointer;
  font-family: var(--f-head);
  font-weight: 700;
  font-size: 17px;
  line-height: 1.35;
  color: var(--text-primary, #1C1B16);
  padding: 18px 0;
}
.faq-item summary::-webkit-details-marker { display: none; }
.faq-chevron {
  color: var(--akzent);
  flex-shrink: 0;
  transition: transform 0.2s ease;
}
.faq-item[open] > summary .faq-chevron {
  transform: rotate(180deg);
}
.faq-item.faq-closing > summary .faq-chevron {
  transform: rotate(0deg);
}
.faq-body {
  display: grid;
  grid-template-rows: 0fr;
  overflow: hidden;
  transition: grid-template-rows 0.25s ease;
}
.faq-item[open] > .faq-body {
  grid-template-rows: 1fr;
}
.faq-item.faq-closing > .faq-body {
  grid-template-rows: 0fr;
}
.faq-inner {
  min-height: 0;
}
.faq-inner p {
  font-size: 16px;
  color: var(--grau);
  padding-bottom: 18px;
  margin: 0;
  max-width: 62ch;
}
@media (prefers-reduced-motion: reduce) {
  .faq-body,
  .faq-chevron {
    transition: none;
  }
}
</style>

<script>
/* FAQ-Schlie&szlig;-Animation &mdash; progressive enhancement */
document.querySelectorAll('.faq-item').forEach(function(item) {
  var summary = item.querySelector('summary');
  if (!summary) return;
  summary.addEventListener('click', function(e) {
    if (!item.open) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    e.preventDefault();
    item.classList.add('faq-closing');
    var body = item.querySelector('.faq-body');
    if (!body) { item.classList.remove('faq-closing'); item.removeAttribute('open'); return; }
    body.addEventListener('transitionend', function handler() {
      body.removeEventListener('transitionend', handler);
      item.classList.remove('faq-closing');
      item.removeAttribute('open');
    });
  });
});
</script>

<script>
/* FAQ-Schlie&szlig;-Animation &mdash; progressive enhancement */
document.querySelectorAll('.faq-item').forEach(function(item) {
  var summary = item.querySelector('summary');
  if (!summary) return;
  summary.addEventListener('click', function(e) {
    if (!item.open) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    e.preventDefault();
    item.classList.add('faq-closing');
    var body = item.querySelector('.faq-body');
    if (!body) { item.classList.remove('faq-closing'); item.removeAttribute('open'); return; }
    body.addEventListener('transitionend', function handler() {
      body.removeEventListener('transitionend', handler);
      item.classList.remove('faq-closing');
      item.removeAttribute('open');
    });
  });
});
</script>

<script>
  /* Personal-Anfrage — Mechanik wie Pilot-Formular, Event nur bei Erfolg */
  const personalForm = document.getElementById('personal-form') as HTMLFormElement;
  if (personalForm) {
    let personalSent = false;
    personalForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = personalForm.querySelector('[type="submit"]') as HTMLButtonElement;
      const successMsg = document.getElementById('personal-success');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Wird gesendet…';
      }
      try {
        const response = await fetch(personalForm.action, {
          method: 'POST',
          body: new FormData(personalForm),
          headers: { 'Accept': 'application/json' },
        });
        if (response.ok && !personalSent) {
          personalSent = true;
          (window as any).dataLayer = (window as any).dataLayer || [];
          (window as any).dataLayer.push({ event: 'personal_anfrage', form_name: 'personal' });
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = response.ok ? 'Gesendet ✔' : 'Anfrage senden';
        }
        if (response.ok) {
          personalForm.reset();
          if (successMsg) {
            successMsg.classList.remove('hidden');
          }
        }
      } catch {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Anfrage senden';
        }
      }
    });
  }
</script>

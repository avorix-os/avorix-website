---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image, getImage } from "astro:assets";
import Stempel from "../components/Stempel.astro";
import dampfTopf from "../assets/bilder/dampf-topf.jpg";

const ogImg = await getImage({ src: dampfTopf, width: 1200, format: "jpeg" });
const ogImageAlt = "Dampf über einem Edelstahltopf auf dem Gasherd einer Profiküche";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Startseite",
        "item": "https://avorix.cloud/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Personal",
        "item": "https://avorix.cloud/personal"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Arbeitnehmerüberlassung von Köchen",
    "serviceType": "Arbeitnehmerüberlassung",
    "description": "Festangestellte Köche, rechtssicher verliehen: für Notfall, Saison und Übergang. Mit behördlicher Arbeitnehmerüberlassungserlaubnis.",
    "provider": {
      "@type": "Organization",
      "name": "Avorix",
      "url": "https://avorix.cloud/"
    },
    "areaServed": ["DE", "AT"],
    "speakable": {
      "@type": "SpeakableSpecification",
      "cssSelector": "#direktantwort"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Wer sind die Avorix-Köche?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Fest angestellte Profis mit Berufserfahrung in Hotel- und Restaurantküchen."
        }
      },
      {
        "@type": "Question",
        "name": "Was ist, wenn der Koch nicht zu unserem Team passt?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Dann sprechen Sie mit uns, und wir finden eine Lösung. Es bringt niemandem etwas, wenn die Chemie nicht stimmt."
        }
      },
      {
        "@type": "Question",
        "name": "Wie läuft das vertraglich?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Über einen Arbeitnehmerüberlassungsvertrag, wie ihn die Agentur für Arbeit vorsieht. Sie unterschreiben ein paar Seiten mehr als bei einer Vermittler-Rechnung, und genau das schützt Sie."
        }
      },
      {
        "@type": "Question",
        "name": "Kann aus dem Einsatz mehr werden (Schulung, unser System)?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja, jederzeit. Viele Betriebe starten mit einem Personal-Einsatz und bauen danach unser System auf, damit der nächste Ausfall kein Notfall mehr ist."
        }
      },
      {
        "@type": "Question",
        "name": "Was ist Arbeitnehmerüberlassung und warum schützt sie Sie?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Arbeitnehmerüberlassung bedeutet: Der Koch bleibt Arbeitnehmer von Avorix. Wir schließen mit ihm den Arbeitsvertrag, zahlen seinen Lohn und führen Sozialversicherungsbeiträge und Lohnnebenkosten ab. Sie setzen ihn vorübergehend in Ihrem Betrieb ein und können ihn dort in Ihre Arbeitsabläufe integrieren und ihm arbeitsbezogene Weisungen erteilen. Dafür zahlen Sie uns den vereinbarten Stundensatz. Für diese Form des Personaleinsatzes benötigt der Verleiher grundsätzlich eine Erlaubnis der Bundesagentur für Arbeit, und über diese verfügt Avorix. Der entscheidende Vorteil für Sie: Der Einsatz erfolgt offen und bewusst im Rahmen der gesetzlich geregelten Arbeitnehmerüberlassung und nicht über eine rechtlich zweifelhafte Konstruktion. Sie erhalten flexibel qualifiziertes Personal für Ihre Küche und reduzieren zugleich die rechtlichen Risiken beim Fremdpersonaleinsatz."
        }
      },
      {
        "@type": "Question",
        "name": "Wie schnell kann jemand bei uns stehen?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "In der Regel innerhalb von 24 bis 72 Stunden, je nach Standort und Anforderung."
        }
      },
      {
        "@type": "Question",
        "name": "Gibt es eine Mindest-Einsatzdauer?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Nein. Ein einzelner Tag ist genauso möglich wie eine ganze Saison."
        }
      },
      {
        "@type": "Question",
        "name": "Bekommen wir auch nur einen Koch, ohne App und System?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja. Viele Häuser fangen genau so an: Es fehlt jemand, wir schicken einen Koch. Mehr müssen Sie nicht buchen."
        }
      },
      {
        "@type": "Question",
        "name": "Wer ist der Arbeitgeber unseres Leihkochs?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Avorix bleibt der Arbeitgeber. Wir kümmern uns um Arbeitsvertrag, Lohn, Sozialversicherung und die Arbeitgeberpflichten. In Ihrer Küche wird der Koch in Ihre Abläufe eingebunden und Sie steuern seinen konkreten Arbeitseinsatz. Diese klare Rollenverteilung ist das Prinzip der Arbeitnehmerüberlassung."
        }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "url": "https://avorix.cloud/personal",
    "primaryImageOfPage": {
      "@type": "ImageObject",
      "url": `https://avorix.cloud${ogImg.src}`,
      "description": ogImageAlt
    }
  }
];
---

<BaseLayout
  title="Köche mieten mit Arbeitnehmerüberlassungserlaubnis | Avorix"
  description="Festangestellte Köche, rechtssicher verliehen: für Notfall, Saison und Übergang. Mit behördlicher Arbeitnehmerüberlassungserlaubnis."
  ogImage={ogImg.src}
  ogImageAlt={ogImageAlt}
  schemaOrg={schema}
>
  <!-- Hero (W2: Split 55/45, Bild rechts) -->
 <section class="hero-section px-6" style="background:var(--papier)">
    <div class="content-width hero-grid">
      <div class="hero-copy">
        <p class="eyebrow mb-4">Modul: Die Verst&auml;rkung</p>
        <h1 class="mb-6">
          Echte K&ouml;che. Fest angestellt. <mark style="white-space:nowrap">Rechtssicher verliehen.</mark>
        </h1>
        <p class="lead mb-6 max-w-[62ch]" style="color:var(--grau)">
          Ihre K&uuml;che steht und f&auml;llt mit einer einzigen Person. Wenn Ihnen Personal fehlt, leihen wir Ihnen unsere festangestellten K&ouml;che aus: f&uuml;r den Notfall, f&uuml;r die Saison, f&uuml;r den &Uuml;bergang. Im Gastgewerbe haben diese Erlaubnis nur wenige. Damit sind Sie auf der rechtlich sicheren Seite.
        </p>
        <div class="flex flex-wrap gap-4 mb-6">
          <a href="#anfrage" data-cta-location="personal-hero" data-cta-event="cta_personal_click" class="btn btn-primary">Personal anfragen</a>
        </div>
        <div class="hero-badges">
          <Stempel>Gepr&uuml;ft &middot; A&Uuml;-Erlaubnis</Stempel>
        </div>
        <p class="hero-telefon mt-6">
          Im Notfall direkt anrufen:
          <a
            href="tel:+4975413973915"
            data-cta-location="hero"
            data-cta-event="personal_anruf_click"
            class="hero-telefon-link"
          >07541 3973915</a>
          <span class="hero-telefon-zeit">(Mo bis Fr 8 bis 17 Uhr, au&szlig;erhalb &uuml;ber Band)</span>
        </p>
      </div>
      <div class="hero-media">
        <Image
          src={dampfTopf}
          alt="Dampf &uuml;ber einem Edelstahltopf auf dem Gasherd einer Profik&uuml;che"
          widths={[480, 800, 1200]}
          sizes="(max-width: 900px) 100vw, 528px"
          loading="eager"
          fetchpriority="high"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- Direkt-Antwort (GEO) -->
 <section class="reveal">
    <div class="content-width">
      <p id="direktantwort" class="py-4 max-w-[62ch]" style="color:var(--grau)">
        Avorix verleiht festangestellte, sozialversicherte K&ouml;che an Hotels und Restaurants in Deutschland und &Ouml;sterreich. Grundlage ist die beh&ouml;rdliche Arbeitnehmer&uuml;berlassungserlaubnis der Agentur f&uuml;r Arbeit. Das sch&uuml;tzt Betriebe vor dem Scheinselbst&auml;ndigkeits-Risiko, das bei vermittelten &bdquo;selbst&auml;ndigen&ldquo; K&ouml;chen entstehen kann. Personal k&ouml;nnen Betriebe telefonisch oder &uuml;ber das Anfrage-Formular auf dieser Seite anfragen.
      </p>
    </div>
  </section>

  <!-- Wann Sie uns rufen -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-12" style="color:var(--druck)">Wann Sie uns rufen.</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="card">
          <h3 class="mb-3">Der Notfall.</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">
            Der K&uuml;chenchef f&auml;llt aus, die Saison l&auml;uft. Ein Avorix-Koch &uuml;bernimmt, tageweise oder wochenweise.
          </p>
        </div>
        <div class="card">
          <h3 class="mb-3">Die Saison.</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">
            Sie brauchen planbar zwei Kr&auml;fte mehr. Unsere K&ouml;che verst&auml;rken Ihr Team f&uuml;r Wochen oder die ganze Saison.
          </p>
        </div>
        <div class="card">
          <h3 class="mb-3">Der &Uuml;bergang.</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">
            Die Neubesetzung dauert l&auml;nger als geplant. Wir &uuml;berbr&uuml;cken, bis Ihre L&ouml;sung steht.
          </p>
        </div>
      </div>
      <p class="text-sm mt-8 max-w-[62ch]" style="color:var(--grau)">
        Kurzfristige Eins&auml;tze sind in der Regel innerhalb von 24 bis 72 Stunden m&ouml;glich. Im Notfall sind wir rund um die Uhr einsatzbereit.
      </p>
    </div>
  </section>

  <!-- So läuft ein Einsatz (12b, Sektion 3) -->
 <section class="reveal section-gap" style="background:var(--papier)">
    <div class="content-width">
      <h2 class="mb-12" style="color:var(--druck)">So l&auml;uft ein Einsatz. In vier Schritten.</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="card">
          <div class="mb-4"><span class="schritt-chip">1</span></div>
          <h3 class="mb-3">Sie fragen an oder rufen an.</h3>
          <p class="leading-relaxed" style="color:var(--grau)">
            Wir melden uns innerhalb von 24 Stunden.
          </p>
        </div>
        <div class="card">
          <div class="mb-4"><span class="schritt-chip">2</span></div>
          <h3 class="mb-3">Wir kl&auml;ren Bedarf, Zeitraum und Anforderung.</h3>
          <p class="leading-relaxed" style="color:var(--grau)">
            Kurz und konkret: Was f&uuml;r ein Betrieb, was f&uuml;r eine Karte, ab wann.
          </p>
        </div>
        <div class="card">
          <div class="mb-4"><span class="schritt-chip">3</span></div>
          <h3 class="mb-3">B&ouml;rge Penk sucht den passenden Koch aus.</h3>
          <p class="leading-relaxed" style="color:var(--grau)">
            Unser K&uuml;chenchef nimmt jede Anfrage selbst in die Hand. Er kennt die Anforderungen einer K&uuml;che, und er kennt seine Leute.
          </p>
        </div>
        <div class="card">
          <div class="mb-4"><span class="schritt-chip">4</span></div>
          <h3 class="mb-3">Der Einsatz startet.</h3>
          <p class="leading-relaxed" style="color:var(--grau)">
            Die geleisteten Stunden werden dokumentiert.
          </p>
        </div>
      </div>
      <p class="mt-8 max-w-[62ch]" style="color:var(--druck);font-weight:700">
        Sie f&uuml;hren Ihre K&uuml;che. Nicht Ihre K&uuml;che Sie.
      </p>
    </div>
  </section>

  <!-- Wer bei Ihnen am Herd steht (12b, Sektion 4) -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Wer bei Ihnen am Herd steht.</h2>
      <p class="lead max-w-[62ch]" style="color:var(--grau)">
        Unsere K&ouml;che sind bei Avorix fest angestellt und sozialversichert. Jeder, den wir schicken, ist Koch mit langj&auml;hriger K&uuml;chenerfahrung. K&uuml;chenhilfen schicken wir nicht. Wir arbeiten in Deutschland und &Ouml;sterreich.
      </p>
    </div>
  </section>

  <!-- Wissen bleibt -->
 <section class="reveal section-gap" style="background:var(--papier)">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">
        Der Leihkoch geht irgendwann wieder. Sein Wissen bleibt da.
      </h2>
      <p class="lead max-w-[62ch]" style="color:var(--grau)">
        Unsere K&ouml;che arbeiten mit der Avorix Koch-App und dokumentieren dabei weiter. Sie bezahlen Personal und bauen nebenbei unser System in Ihrer K&uuml;che auf. Bei einer klassischen Zeitarbeitsfirma bleibt nach dem Einsatz nichts zur&uuml;ck. Bei uns bleibt das Wissen.
      </p>
      <div class="mt-8">
        <a href="/kontakt" data-cta-location="personal-app" class="btn btn-secondary">App-Demo vereinbaren</a>
      </div>
    </div>
  </section>

  <!-- Scheinselbständigkeit → dunkle Beweis-Sektion (3.10) -->
 <section class="reveal section-gap section-dunkel" style="background:var(--eisen)">
    <div class="content-width">
      <h2 class="mb-8" style="color:var(--papier)">
        Warum &bdquo;g&uuml;nstige Selbst&auml;ndige&ldquo; Sie 50.000 Euro kosten k&ouml;nnen.
      </h2>
      <p class="leading-relaxed mb-4 max-w-[62ch]" style="color:var(--papier);opacity:0.85">
        Viele Vermittler schicken Ihnen &bdquo;selbst&auml;ndige&ldquo; K&ouml;che, die eine Rechnung mit Mehrwertsteuer schreiben. Klingt unkompliziert, ist aber in den meisten F&auml;llen Scheinselbst&auml;ndigkeit: Die K&ouml;che arbeiten weisungsgebunden in Ihrem Betriebsablauf, wie Angestellte.
      </p>
      <p class="leading-relaxed mb-4 max-w-[62ch]" style="color:var(--papier);opacity:0.85">
        Was bei der n&auml;chsten Sozialversicherungspr&uuml;fung passiert: Die Pr&uuml;fer stufen diese K&ouml;che als scheinselbst&auml;ndig ein, und zwar in den allermeisten F&auml;llen. Dann zahlt nicht der Koch, sondern Ihr Haus: s&auml;mtliche Sozialleistungen, r&uuml;ckwirkend f&uuml;r <strong style="color:var(--akzent-hell)">drei bis vier Jahre</strong>. Je nach Umfang schnell <strong style="color:var(--akzent-hell)">50.000 bis 100.000 Euro</strong>. Der Koch selbst ist dann meist nicht mehr greifbar.
      </p>
      <p class="leading-relaxed mb-4 max-w-[62ch]" style="color:var(--papier);opacity:0.85">
        <strong style="color:var(--papier)">Deshalb machen wir es anders:</strong> Unsere K&ouml;che sind bei Avorix fest angestellt und sozialversichert. Wir haben die beh&ouml;rdliche Arbeitnehmer&uuml;berlassungserlaubnis von der Agentur f&uuml;r Arbeit.
      </p>
      <p class="leading-relaxed max-w-[62ch]" style="color:var(--papier);opacity:0.85">
        Gr&ouml;&szlig;ere H&auml;user und Hotelgruppen buchen inzwischen nur noch Firmen mit dieser Erlaubnis, aus genau diesem Grund. Im Gastgewerbe haben sie nur wenige Anbieter. Fragen Sie danach, bevor Sie irgendwo buchen. Auch wenn es nicht bei uns ist.
      </p>
    </div>
  </section>

  <!-- Was ist Arbeitnehmerüberlassung (12b, Sektion 7) -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">
        Was ist Arbeitnehmer&uuml;berlassung und warum sch&uuml;tzt sie Sie?
      </h2>
      <p class="leading-relaxed mb-4 max-w-[62ch]" style="color:var(--grau)">
        Arbeitnehmer&uuml;berlassung bedeutet: Der Koch bleibt Arbeitnehmer von Avorix. Wir schlie&szlig;en mit ihm den Arbeitsvertrag, zahlen seinen Lohn und f&uuml;hren Sozialversicherungsbeitr&auml;ge und Lohnnebenkosten ab. Sie setzen ihn vor&uuml;bergehend in Ihrem Betrieb ein und k&ouml;nnen ihn dort in Ihre Arbeitsabl&auml;ufe integrieren und ihm arbeitsbezogene Weisungen erteilen. Daf&uuml;r zahlen Sie uns den vereinbarten Stundensatz.
      </p>
      <p class="leading-relaxed max-w-[62ch]" style="color:var(--grau)">
        F&uuml;r diese Form des Personaleinsatzes ben&ouml;tigt der Verleiher grunds&auml;tzlich eine Erlaubnis der Bundesagentur f&uuml;r Arbeit, und &uuml;ber diese verf&uuml;gt Avorix. Der entscheidende Vorteil f&uuml;r Sie: Der Einsatz erfolgt offen und bewusst im Rahmen der gesetzlich geregelten Arbeitnehmer&uuml;berlassung und nicht &uuml;ber eine rechtlich zweifelhafte Konstruktion. Sie erhalten flexibel qualifiziertes Personal f&uuml;r Ihre K&uuml;che und reduzieren zugleich die rechtlichen Risiken beim Fremdpersonaleinsatz.
      </p>
    </div>
  </section>

  <!-- Diskretion -->
 <section class="reveal section-gap" style="background:var(--papier)">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">
        Ihre G&auml;ste erleben Ihre K&uuml;che. Nicht unsere.
      </h2>
      <p class="lead max-w-[62ch]" style="color:var(--grau)">
        Kein Gast merkt, dass ein Avorix-Koch mitkocht. Wir nennen keinen Kunden &ouml;ffentlich, und auf Wunsch sichern wir Ihnen das vertraglich zu.
      </p>
    </div>
  </section>

  <!-- Beweis-Block (12b, Sektion 9) -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-8" style="color:var(--druck)">Aus dem laufenden Betrieb.</h2>
      <ul class="beweis-liste mb-8">
        <li>&Uuml;ber 1.000 Einsatztage in den K&uuml;chen unserer Kunden.</li>
        <li>Ein Cateringunternehmen bezieht &uuml;ber uns rund 15.000 Stunden im Jahr.</li>
      </ul>
      <figure class="card card-text beweis-zitat">
        <blockquote>
          <p class="leading-relaxed" style="color:var(--grau)">
            &bdquo;[&hellip;] kann ich die Zusammenarbeit mit dem Avorix Team sehr empfehlen. Unter der Leitung von K&uuml;chenchef B&ouml;rge Penk hat Avorix bei uns Spitzenlasten, insbesondere bei starken Messen und gr&ouml;&szlig;eren Kongressen, zuverl&auml;ssig und sehr professionell unterst&uuml;tzt. Das Team f&uuml;gt sich sehr schnell in die Abl&auml;ufe ein, auch mit bis zu 20 K&ouml;chen gleichzeitig, sauber organisiert, ruhig im Ablauf, qualit&auml;tsbewusst, gutes Timing und Hygiene. [&hellip;]&ldquo;
          </p>
        </blockquote>
        <figcaption class="text-sm mt-4" style="color:var(--grau)">
          K&uuml;chendirektorin eines Cateringunternehmens, Bewertung vom 25. Februar 2026
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Was kostet das -->
 <section class="reveal section-gap" style="background:var(--papier)">
    <div class="content-width">
      <h2 class="mb-8" style="color:var(--druck)">Was kostet das?</h2>
      <div class="card card-text">
        <p class="leading-relaxed mb-6" style="color:var(--grau)">
          Klare Stundensätze, ohne versteckte Posten. Die Zahlen bekommen Sie im Erstgespräch schwarz auf weiß. Für die ersten Betriebe gelten 2026 Pilotkonditionen deutlich unter dem regulären Preis.
        </p>
        <a
          href="#anfrage"
          data-cta-location="personal-kosten"
          data-cta-event="cta_personal_click"
          class="btn btn-primary"
        >Personal anfragen</a>
      </div>
    </div>
  </section>

  <!-- Anfrage-Strecke (12b, Sektion 11) -->
 <section id="anfrage" class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Personal anfragen.</h2>
      <p class="formular-pflicht">Felder mit * brauchen wir, alles andere ist freiwillig.</p>
      <div class="anfrage-grid">
        <form id="personal-form" class="card anfrage-form-wrap space-y-5" action="https://formspree.io/f/xqegwngo" method="POST">
          <input type="hidden" name="_subject" value="Personal-Anfrage" />

          <div>
            <label for="pa-betrieb" class="anfrage-label">
              Betrieb <span style="color:var(--akzent)">*</span>
            </label>
            <input type="text" id="pa-betrieb" name="betrieb" required autocomplete="organization" class="anfrage-field" />
          </div>

          <div>
            <label for="pa-name" class="anfrage-label">
              Ihr Name <span style="color:var(--akzent)">*</span>
            </label>
            <input type="text" id="pa-name" name="name" required autocomplete="name" class="anfrage-field" />
          </div>

          <div>
            <label for="pa-telefon" class="anfrage-label">
              Telefon <span style="color:var(--akzent)">*</span>
            </label>
            <input type="tel" id="pa-telefon" name="telefon" required autocomplete="tel" class="anfrage-field" />
          </div>

          <div>
            <label for="pa-email" class="anfrage-label">
              E-Mail <span class="anfrage-label-opt">(optional)</span>
            </label>
            <input type="email" id="pa-email" name="email" autocomplete="email" class="anfrage-field" />
          </div>

          <div>
            <label for="pa-ab-wann" class="anfrage-label">
              Ab wann brauchen Sie jemanden? <span style="color:var(--akzent)">*</span>
            </label>
            <input
              type="text"
              id="pa-ab-wann"
              name="ab_wann"
              required
              placeholder="z.B. sofort oder ab 15. September"
              class="anfrage-field"
            />
          </div>

          <div>
            <label for="pa-hinweis" class="anfrage-label">
              Was sollen wir wissen? <span class="anfrage-label-opt">(optional)</span>
            </label>
            <textarea id="pa-hinweis" name="hinweis" rows="4" class="anfrage-field anfrage-textarea"></textarea>
          </div>

          <div id="personal-success" class="hidden anfrage-success-msg">
            Ihre Anfrage ist da. Wir melden uns innerhalb von 24 Stunden.
          </div>

          <button
            type="submit"
            class="btn btn-primary anfrage-submit"

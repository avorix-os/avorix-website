---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image, getImage } from "astro:assets";
import Stempel from "../components/Stempel.astro";
import hotelSpeisesaal from "../assets/bilder/hotel-speisesaal.jpg";
import tellerStapelReihe from "../assets/bilder/teller-stapel-reihe.jpg";

const ogImg = await getImage({ src: hotelSpeisesaal, width: 1200, format: "jpeg" });
const ogImageAlt = "Eingedeckter Speisesaal eines Hotels mit Seeblick am Abend";
---

<BaseLayout
  title="K&uuml;chensystem f&uuml;r Ferienhotels mit Halbpension | Avorix"
  description="Halbpension auf Ihrem Niveau, jeden Abend: Men&uuml;s sichern, Team anlernen, Ausf&auml;lle &uuml;berbr&uuml;cken. Avorix f&uuml;r Ferienhotels."
  ogImage={ogImg.src}
  ogImageAlt={ogImageAlt}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "url": "https://avorix.cloud/fuer-hotels",
    "primaryImageOfPage": {
      "@type": "ImageObject",
      "url": `https://avorix.cloud${ogImg.src}`,
      "description": ogImageAlt
    }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://avorix.cloud/" },
          { "@type": "ListItem", "position": 2, "name": "Für Ferienhotels", "item": "https://avorix.cloud/fuer-hotels" }
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          { "@type": "Question", "name": "Wir fahren Halbpension und à la carte gemischt. Geht das?", "acceptedAnswer": { "@type": "Answer", "text": "Ja. Menüzyklen und Karte werden beide dokumentiert, jedes Gericht ist ein eigenes Rezept mit eigener Portionslogik." } },
          { "@type": "Question", "name": "Unsere Menüs wechseln wöchentlich. Passt das trotzdem?", "acceptedAnswer": { "@type": "Answer", "text": "Gerade dann. Der Menüplaner legt Wochenpläne an, bewährte Wochen kopieren Sie in die nächste. Neue Gerichte pflegen Sie selbst ein oder wir übernehmen das." } },
          { "@type": "Question", "name": "Was sagt unser Küchenchef dazu?", "acceptedAnswer": { "@type": "Answer", "text": "Die Erfahrung zeigt: Gute Küchenchefs gewinnen dadurch. Ihr Wissen ist endlich gesichert, ihr Team arbeitet selbstständiger, und sie selbst sind nicht mehr an jedem Abend der Engpass." } },
          { "@type": "Question", "name": "Auch das Frühstück?", "acceptedAnswer": { "@type": "Answer", "text": "Der Schwerpunkt liegt auf dem Abendessen. Was dokumentierbar ist, lässt sich aber grundsätzlich abbilden." } },
          { "@type": "Question", "name": "Wie schnell vor Saisonstart können wir anfangen?", "acceptedAnswer": { "@type": "Answer", "text": "Je nach Umfang typischerweise wenige Wochen für Aufnahme und Schulung. Je früher vor der Saison, desto entspannter." } }
        ]
      }
    ]
  })} />

  <!-- Hero -->
 <section class="pt-28 pb-16 px-6" style="background:var(--papier)">
    <div class="max-w-4xl mx-auto">
      <p class="eyebrow mb-4">F&uuml;r Ferienhotels mit Halbpension</p>
      <h1 class="mb-6">
        Halbpension <mark>auf Ihrem Niveau.</mark> Jeden Abend. Egal wer in der K&uuml;che steht.
      </h1>
      <p class="lead mb-6" style="color:var(--grau)">
        Avorix sichert die Men&uuml;s Ihres Hauses als Schritt-f&uuml;r-Schritt-System, lernt Ihr Team an und &uuml;berbr&uuml;ckt Ausf&auml;lle mit echten K&ouml;chen. Damit jeder Gast das Abendessen bekommt, f&uuml;r das er gebucht hat. <strong style="color:var(--druck)">Auch ohne ausgebildete K&ouml;che.</strong>
      </p>
      <div class="flex flex-wrap gap-4 mb-6">
        <a href="/kontakt" data-cta-location="hotels-hero" class="btn btn-primary">Demo vereinbaren</a>
      </div>
      <div class="flex flex-wrap gap-3">
        <span class="check-badge"><span class="check-badge-mark">&#10003;</span> Beh&ouml;rdliche Arbeitnehmer&uuml;berlassungserlaubnis (Agentur f&uuml;r Arbeit)</span>
      </div>
      <div class="mt-8">
        <Image
          src={hotelSpeisesaal}
          alt="Eingedeckter Speisesaal eines Hotels mit Seeblick am Abend"
          widths={[480, 800, 1200, 1600]}
          sizes="(max-width: 896px) 100vw, 896px"
          loading="eager"
          fetchpriority="high"
          class="w-full h-64 md:h-80 object-cover"
          style="border-radius:var(--radius);box-shadow:var(--schatten)"
        />
      </div>
    </div>
  </section>

  <!-- Halbpension ist ein Versprechen -->
 <section class="reveal py-[56px] md:py-[84px] px-6" style="border-top:1px solid var(--linie)">
    <div class="max-w-5xl mx-auto">
      <h2 class="mb-8">Halbpension ist ein Versprechen. Jeden Tag aufs Neue.</h2>
      <Image
        src={tellerStapelReihe}
        alt="Viele identisch angerichtete Teller in einer Reihe in einer Gro&szlig;k&uuml;che"
        widths={[480, 800, 1200, 1600]}
        sizes="(max-width: 1024px) 100vw, 1024px"
        loading="lazy"
        decoding="async"
        class="w-full h-64 md:h-72 object-cover mb-8"
        style="border-radius:var(--radius);box-shadow:var(--schatten)"
      />
      <div class="grid md:grid-cols-3 gap-6">
        <div class="card">
          <h3 class="mb-3">Jeden Abend ein Men&uuml; f&uuml;r das ganze Haus.</h3>
          <p class="text-sm" style="color:var(--grau)">Halbpension hei&szlig;t: kein Ausweichen, kein &bdquo;heute mal reduzierte Karte&ldquo;. Ihre K&uuml;che muss liefern, ob das Team komplett ist oder nicht.</p>
        </div>
        <div class="card">
          <h3 class="mb-3">Die Bewertung entscheidet die n&auml;chste Buchung.</h3>
          <p class="text-sm" style="color:var(--grau)">Das Abendessen wird auf den Portalen mitbewertet. Ein schwaches K&uuml;chenjahr steht dort dauerhaft, und der neue Gast liest es vor der Buchung.</p>
        </div>
        <div class="card">
          <h3 class="mb-3">Schl&uuml;sselkr&auml;fte gehen, Saisonkr&auml;fte kommen.</h3>
          <p class="text-sm" style="color:var(--grau)">K&uuml;ndigt der K&uuml;chenchef oder der Souschef, geht das Wissen mit. Und die neuen Saisonkr&auml;fte fangen jedes Jahr bei null an.</p>
        </div>
      </div>
      <p class="mt-6" style="color:var(--grau)">Wenn die K&uuml;che wackelt, wackelt das ganze Haus: erst die Teller, dann die Bewertungen, dann die Buchungen. Genau daf&uuml;r gibt es Avorix.</p>
    </div>
  </section>

  <!-- Unser System -->
 <section class="reveal py-[56px] md:py-[84px] px-6" style="background:var(--papier);border-top:1px solid var(--linie)">
    <div class="max-w-5xl mx-auto">
      <h2 class="mb-4">Unser System: Men&uuml;s sichern, Team anlernen, Ausf&auml;lle &uuml;berbr&uuml;cken.</h2>
      <p class="max-w-3xl mb-8" style="color:var(--grau)">Stellen Sie sich ein Navi f&uuml;r Ihre K&uuml;che vor: Es bringt jede Kraft zum fertigen Gericht, auch wenn sie es noch nie gekocht hat. Daf&uuml;r kommen drei Bausteine zusammen:</p>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="card">
          <h3 class="mb-3">Unser System</h3>
          <p class="text-sm" style="color:var(--grau)">Ihre Men&uuml;s als Schritt-f&uuml;r-Schritt-Anleitungen in der Koch-App, mit Fotos, Mengen und Zeiten. Denn viele K&uuml;chen haben Rezepte, gekocht wird trotzdem nach Gef&uuml;hl. Mit der App h&auml;ngt das Rezept direkt am Posten, und der einfachste Weg ist der richtige.</p>
        </div>
        <div class="card">
          <h3 class="mb-3">Die Schulung</h3>
          <p class="text-sm" style="color:var(--grau)">Ein Avorix-Koch (mindestens Sous-Chef-Erfahrung) nimmt Ihre Men&uuml;s auf und lernt Ihr Team an, direkt am Herd.</p>
        </div>
        <div class="card">
          <h3 class="mb-3">Die Verst&auml;rkung</h3>
          <p class="text-sm" style="color:var(--grau)">F&auml;llt jemand aus, leihen wir Ihnen einen festangestellten Koch. Rechtssicher, mit Arbeitnehmer&uuml;berlassungserlaubnis.</p>
        </div>
      </div>
      <div class="mt-8 space-y-3" style="color:var(--grau)">
        <p><strong style="color:var(--druck)">Und Ihre Kosten?</strong> Ausgebildete K&ouml;che sind teuer, wenn Sie &uuml;berhaupt welche finden. Mit Avorix kochen angelernte Kr&auml;fte auf Ihrem Niveau, und Ihre Fachkr&auml;fte machen nur noch das, was wirklich ihr K&ouml;nnen braucht.</p>
        <p>Und Ihre G&auml;ste? Merken nichts. Sie erleben Ihre K&uuml;che, nur eben verl&auml;sslich. Wir nennen keinen Kunden &ouml;ffentlich.</p>
      </div>
      <div class="mt-6">
        <a href="/system" data-cta-location="hotels-system" class="btn btn-secondary">So funktioniert unser System</a>
      </div>
    </div>
  </section>

  <!-- Halbpensions-Zyklen -->
 <section class="reveal py-[56px] md:py-[84px] px-6" style="border-top:1px solid var(--linie)">
    <div class="max-w-4xl mx-auto">
      <h2 class="mb-4">Halbpensions-Zyklen sind wie gemacht f&uuml;r unser System.</h2>
      <p style="color:var(--grau)">Ihre Men&uuml;zyklen wiederholen sich, und genau das ist die St&auml;rke: Einmal sauber dokumentiert, l&auml;uft jeder Zyklus reproduzierbar, Woche f&uuml;r Woche, Saison f&uuml;r Saison. Der Men&uuml;planer der App legt Wochenpl&auml;ne an und kopiert bew&auml;hrte Wochen in die n&auml;chste. Der Portionsrechner skaliert jedes Gericht automatisch auf die Hausbelegung, ob 60 oder 120 G&auml;ste. Und aus dem fertigen Wochenplan erzeugt die App die Einkaufsliste.</p>
    </div>
  </section>

  <!-- Vier Schritte -->
 <section class="reveal py-[56px] md:py-[84px] px-6" style="background:var(--papier);border-top:1px solid var(--linie)">
    <div class="max-w-4xl mx-auto">
      <h2 class="mb-8">Vier Schritte, am besten zwischen den Saisons.</h2>
      <div class="space-y-6">
        <div class="flex gap-4">
          <div class="schritt-chip shrink-0">1</div>
          <div>
            <h3 class="mb-1">Gespr&auml;ch (30 Minuten, kostenlos)</h3>
            <p class="text-sm mt-1" style="color:var(--grau)">Sie erz&auml;hlen, wo es klemmt. Wir sagen ehrlich, ob Avorix passt.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="schritt-chip shrink-0">2</div>
          <div>
            <h3 class="mb-1">Aufnahme</h3>
            <p class="text-sm mt-1" style="color:var(--grau)">Ein Avorix-Koch kocht mit, dokumentiert Ihre Men&uuml;s und legt sie in der App an.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="schritt-chip shrink-0">3</div>
          <div>
            <h3 class="mb-1">Schulung</h3>
            <p class="text-sm mt-1" style="color:var(--grau)">Ihr Team lernt das System am Herd, im laufenden Betrieb.</p>
          </div>
        </div>
        <div class="flex gap-4">
          <div class="schritt-chip shrink-0">4</div>
          <div>
            <h3 class="mb-1">Selbstst&auml;ndig arbeiten</h3>
            <p class="text-sm mt-1" style="color:var(--grau)">Die App f&uuml;hrt Ihr Team durch jeden Abend. Wir bleiben erreichbar.</p>
          </div>
        </div>
      </div>
      <p class="text-sm mt-8" style="color:var(--grau)">Die ruhigen Wochen zwischen den Saisons sind der ideale Zeitpunkt: Zum Saisonstart l&auml;uft Ihr System schon.</p>
    </div>
  </section>

  <!-- Pilotbetrieb -->
 <section class="reveal py-[56px] md:py-[84px] px-6" style="border-top:1px solid var(--linie)">
    <div class="max-w-4xl mx-auto">
      <h2 class="mb-4">Als Pilotbetrieb zur halben Rechnung.</h2>
      <p class="mb-6" style="color:var(--grau)">Wir nehmen 2026 eine kleine Zahl von Pilotbetrieben auf: rund die H&auml;lfte des regul&auml;ren Preises, im Gegenzug ehrliches Feedback und die anonyme Auswertung Ihrer Ergebnisse. Ihr Name taucht nirgends auf.</p>
      <a href="/pilotprogramm" data-cta-location="hotels-pilot" class="btn btn-primary">Zum Pilotprogramm</a>
    </div>
  </section>

  <!-- FAQ -->
 <section class="reveal py-[56px] md:py-[84px] px-6" style="background:var(--papier);border-top:1px solid var(--linie)">
    <div class="max-w-3xl mx-auto">
      <h2 class="mb-8">H&auml;ufige Fragen</h2>
      <div class="faq-list">
        <details class="faq-item" open>
          <summary class="faq-q">Wir fahren Halbpension und &agrave; la carte gemischt. Geht das?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Ja. Men&uuml;zyklen und Karte werden beide dokumentiert, jedes Gericht ist ein eigenes Rezept mit eigener Portionslogik.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Unsere Men&uuml;s wechseln w&ouml;chentlich. Passt das trotzdem?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Gerade dann. Der Men&uuml;planer legt Wochenpl&auml;ne an, bew&auml;hrte Wochen kopieren Sie in die n&auml;chste. Neue Gerichte pflegen Sie selbst ein oder wir &uuml;bernehmen das.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Was sagt unser K&uuml;chenchef dazu?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Die Erfahrung zeigt: Gute K&uuml;chenchefs gewinnen dadurch. Ihr Wissen ist endlich gesichert, ihr Team arbeitet selbstst&auml;ndiger, und sie selbst sind nicht mehr an jedem Abend der Engpass.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Auch das Fr&uuml;hst&uuml;ck?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Der Schwerpunkt liegt auf dem Abendessen. Was dokumentierbar ist, l&auml;sst sich aber grunds&auml;tzlich abbilden.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Wie schnell vor Saisonstart k&ouml;nnen wir anfangen?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Je nach Umfang typischerweise wenige Wochen f&uuml;r Aufnahme und Schulung. Je fr&uuml;her vor der Saison, desto entspannter.</p></div></div>
        </details>
      </div>
    </div>
  </section>

  <!-- Final CTA → Peak-End (3.18) -->
 <section class="reveal py-[56px] md:py-[84px] px-6" style="background:var(--papier);border-top:1px solid var(--linie)">
    <div class="max-w-3xl mx-auto text-center">
      <div class="mb-6">
        <Stempel>Gepr&uuml;ft &middot; A&Uuml;-Erlaubnis</Stempel>
      </div>
      <p class="mb-6" style="font-family:Charter, Georgia, serif; font-style:italic; font-size:24px; color:var(--druck)">Es ist geregelt.</p>
      <a href="/kontakt" data-cta-location="hotels-final" class="btn btn-primary">Demo vereinbaren</a>
    </div>
  </section>
</BaseLayout>

<style>
/* FAQ-Accordion (3.13) */
.faq-list {
  border-top: 1px solid var(--linie);
}
.faq-item {
  border-bottom: 1px solid var(--linie);
}
.faq-item summary {
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  cursor: pointer;
  font-family: var(--f-head);
  font-weight: 700;
  font-size: 17px;
  line-height: 1.35;
  color: var(--text-primary, #1C1B16);
  padding: 18px 0;
}
.faq-item summary::-webkit-details-marker { display: none; }
.faq-chevron {
  color: var(--akzent);
  flex-shrink: 0;
  transition: transform 0.2s ease;
}
.faq-item[open] > summary .faq-chevron {
  transform: rotate(180deg);
}
.faq-item.faq-closing > summary .faq-chevron {
  transform: rotate(0deg);
}
.faq-body {
  display: grid;
  grid-template-rows: 0fr;
  overflow: hidden;
  transition: grid-template-rows 0.25s ease;
}
.faq-item[open] > .faq-body {
  grid-template-rows: 1fr;
}
.faq-item.faq-closing > .faq-body {
  grid-template-rows: 0fr;
}
.faq-inner {
  min-height: 0;
}
.faq-inner p {
  font-size: 16px;
  color: var(--grau);
  padding-bottom: 18px;
  margin: 0;
}
@media (prefers-reduced-motion: reduce) {
  .faq-body,
  .faq-chevron {
    transition: none;
  }
}
</style>

<script>
/* FAQ-Schlie&szlig;-Animation — progressive enhancement */
document.querySelectorAll('.faq-item').forEach(function(item) {
  var summary = item.querySelector('summary');
  if (!summary) return;
  summary.addEventListener('click', function(e) {
    if (!item.open) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    e.preventDefault();
    item.classList.add('faq-closing');
    var body = item.querySelector('.faq-body');
    if (!body) { item.classList.remove('faq-closing'); item.removeAttribute('open'); return; }
    body.addEventListener('transitionend', function handler() {
      body.removeEventListener('transitionend', handler);
      item.classList.remove('faq-closing');
      item.removeAttribute('open');
    });
  });
});
</script>

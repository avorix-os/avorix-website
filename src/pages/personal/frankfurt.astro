---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Stempel from "../../components/Stempel.astro";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://avorix.de/" },
      { "@type": "ListItem", "position": 2, "name": "Personal", "item": "https://avorix.de/personal" },
      { "@type": "ListItem", "position": 3, "name": "Mietkoch in Frankfurt", "item": "https://avorix.de/personal/frankfurt/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Arbeitnehmerüberlassung von Köchen in Frankfurt und Rhein-Main",
    "serviceType": "Arbeitnehmerüberlassung",
    "provider": { "@type": "Organization", "name": "AVORIX GmbH", "url": "https://avorix.de/" },
    "areaServed": "Frankfurt und Rhein-Main",
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": "#direktantwort" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Könnt ihr während der Messewochen kurzfristig verstärken?", "acceptedAnswer": { "@type": "Answer", "text": "Ja, genau dafür sind unsere Einsätze gedacht. In der Regel innerhalb von 24 bis 72 Stunden, Einsätze sind rund um die Uhr möglich." } },
      { "@type": "Question", "name": "Arbeitet ihr auch für Betriebsrestaurants und Caterer?", "acceptedAnswer": { "@type": "Answer", "text": "Ja. Unsere Köche arbeiten in Restaurants, Hotels, im Veranstaltungs-Catering und in Betriebsrestaurants." } },
      { "@type": "Question", "name": "Was kostet ein Leihkoch in Frankfurt?", "acceptedAnswer": { "@type": "Answer", "text": "Sie zahlen einen Stundenverrechnungssatz, in dem Lohn, Sozialabgaben und das komplette Arbeitgeberrisiko schon enthalten sind. Die Konditionen besprechen wir im Erstgespräch: 30 Minuten, kostenlos, unverbindlich." } }
    ]
  }
];
---
<BaseLayout
  title="Mietkoch Frankfurt: Koch mieten in Rhein-Main"
  description="Koch mieten in Frankfurt und Rhein-Main: festangestellte Köche für Restaurant, Hotel, Catering und Betriebsgastronomie, meist in 24 bis 72 Stunden."
  schemaOrg={schema}
>
  {/* Hero */}
 <section class="hero-section px-6">
    <div class="content-width">
      <p class="eyebrow mb-4"><a href="/personal/" class="eyebrow-link">Personal</a></p>
      <h1 class="mb-6 max-w-[var(--spalte-schmal)]">Mietkoch in Frankfurt: Köche mieten für Rhein-Main</h1>
      <p class="lead mb-6 max-w-[var(--spalte-text)]" style="color:var(--grau)">
        Messe, Bankett, Krankheitswelle: Wenn die Küche Verstärkung braucht, leihen wir Ihnen unsere festangestellten Köche aus. Für den Notfall, für die Saison, für den Übergang.
      </p>
      <div class="flex flex-wrap gap-4 mb-6">
        <a href="/personal#anfrage" data-cta-location="personal-frankfurt-hero" data-cta-event="cta_personal_click" class="btn btn-primary">Personal anfragen</a>
      </div>
      <div class="hero-badges mb-6">
        <span class="check-badge"><span class="check-badge-mark">&#10003;</span> Behördliche Arbeitnehmerüberlassungserlaubnis (Agentur für Arbeit)</span>
      </div>
      <p class="hero-telefon">
        Im Notfall direkt anrufen:
        <a href="tel:+4975413973915" data-cta-location="personal-frankfurt-hero" data-cta-event="personal_anruf_click" class="hero-telefon-link">07541 3973915</a>
        <span class="hero-telefon-zeit">(Mo bis Fr 8 bis 17 Uhr, außerhalb über Band)</span>
      </p>
    </div>
  </section>

  {/* Direktantwort (GEO) */}
 <section class="reveal">
    <div class="content-width">
      <p id="direktantwort" class="lead py-4 max-w-[var(--spalte-text)]" style="color:var(--grau)">
        Avorix verleiht festangestellte, sozialversicherte Köche an Betriebe in Frankfurt und im Rhein-Main-Gebiet, mit behördlicher Arbeitnehmerüberlassungserlaubnis. In der Regel steht Ihr Koch innerhalb von 24 bis 72 Stunden in der Küche.
      </p>
    </div>
  </section>

  {/* Unser Einsatzgebiet (schmale Spalte) */}
 <section class="reveal section-gap">
    <div class="content-width text-spalte">
      <h2 class="mb-6" style="color:var(--druck)">Unser Einsatzgebiet</h2>
      <p class="max-w-[var(--spalte-text)]" style="color:var(--grau)">Frankfurt lebt von Terminen: Messewochen, Kongresse, Bankette, dazu eine dichte Betriebsgastronomie-Landschaft und die Hotellerie rund um Flughafen und Innenstadt. Wenn der Kalender voll ist und der Personalstand nicht, verleihen wir Köche in Frankfurt und im gesamten Rhein-Main-Gebiet, von Mainz und Wiesbaden bis Offenbach und Darmstadt.</p>
      <p class="max-w-[var(--spalte-text)] mt-4" style="color:var(--grau)">Dazu kommt der Frankfurter Rhythmus: Hotellerie, Messe-Catering und Eventgastronomie schöpfen aus demselben Pool an Köchen, und zur Messe brauchen alle gleichzeitig Verstärkung. Wir sind da, wenn der Markt leergefegt ist.</p>
    </div>
  </section>

  {/* Typische Einsätze */}
 <section class="reveal section-gap section-band">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Typische Einsätze in Rhein-Main</h2>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">
        <div class="card"><p class="text-sm" style="color:var(--grau)">Zwei Messewochen hintereinander füllen Haus und Bankettkalender, die Küche braucht vorübergehend einen Posten mehr.</p></div>
        <div class="card"><p class="text-sm" style="color:var(--grau)">Ein Betriebsrestaurant fährt 400 Essen am Tag, der Souschef geht von heute auf morgen.</p></div>
        <div class="card"><p class="text-sm" style="color:var(--grau)">Ein Caterer gewinnt einen Großauftrag und braucht Verstärkung, die vom ersten Tag an selbständig am Posten steht.</p></div>
      </div>
    </div>
  </section>

  {/* So läuft ein Einsatz (wortgleich, schmale Spalte) */}
 <section class="reveal section-gap section-band">
    <div class="content-width text-spalte">
      <h2 class="mb-6" style="color:var(--druck)">So läuft ein Einsatz</h2>
      <p class="max-w-[var(--spalte-text)]" style="color:var(--grau)">Sie rufen an oder schreiben uns, wir klären in einem kurzen Gespräch, wen Sie brauchen und ab wann. In der Regel steht Ihr Koch innerhalb von 24 bis 72 Stunden in der Küche, unsere Einsätze sind rund um die Uhr möglich, auch nachts und am Wochenende. Eine Mindest-Einsatzdauer gibt es nicht: Viele Häuser überbrücken zwei Wochen, andere eine ganze Saison. Ihr Erstgespräch: 30 Minuten, kostenlos, unverbindlich.</p>
    </div>
  </section>

  {/* Fest angestellt statt auf Rechnung (wortgleich, dunkler Block) */}
 <section class="reveal section-gap section-dunkel">
    <div class="content-width text-spalte">
      <h2 class="mb-6">Fest angestellt statt auf Rechnung</h2>
      <p class="max-w-[var(--spalte-text)]">Unsere Köche sind bei Avorix fest angestellt und sozialversichert und arbeiten bei Ihnen im Rahmen der Arbeitnehmerüberlassung. Sie integrieren den Koch in Ihre Abläufe und erteilen arbeitsbezogene Weisungen, genau das ist bei diesem Modell vorgesehen. Verträge in dieser Form reduzieren zugleich die rechtlichen Risiken beim Fremdpersonaleinsatz. Warum das beim selbständigen Mietkoch auf Rechnung anders aussieht: <a href="/wissen/mietkoch-scheinselbstaendigkeit/" class="typo-link">Mietkoch auf Rechnung: Wo Scheinselbständigkeit beginnt</a></p>
    </div>
  </section>

  {/* FAQ */}
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Häufige Fragen</h2>
      <div class="faq-list">
        <details class="faq-item" open>
          <summary class="faq-q">Könnt ihr während der Messewochen kurzfristig verstärken?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Ja, genau dafür sind unsere Einsätze gedacht. In der Regel innerhalb von 24 bis 72 Stunden, Einsätze sind rund um die Uhr möglich.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Arbeitet ihr auch für Betriebsrestaurants und Caterer?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Ja. Unsere Köche arbeiten in Restaurants, Hotels, im Veranstaltungs-Catering und in Betriebsrestaurants.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Was kostet ein Leihkoch in Frankfurt?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Sie zahlen einen Stundenverrechnungssatz, in dem Lohn, Sozialabgaben und das komplette Arbeitgeberrisiko schon enthalten sind. Die Konditionen besprechen wir im Erstgespräch: 30 Minuten, kostenlos, unverbindlich.</p></div></div>
        </details>
      </div>
    </div>
  </section>

  {/* CTA-Abschluss */}
 <section class="reveal section-gap">
    <div class="content-width text-center">
      <div class="mb-6">
        <Stempel>Geprüft &middot; AÜ-Erlaubnis</Stempel>
      </div>
      <p class="mb-6 max-w-[var(--spalte-text)]" style="margin-inline:auto;color:var(--grau)">Wenn der Kalender voll ist, ist Ihre Küche besetzt.</p>
      <p class="mb-6" style="font-family:Charter, Georgia, serif; font-style:italic; font-size:24px; color:var(--druck)">Es ist geregelt.</p>
      <a href="/personal" data-cta-location="personal-frankfurt-ende" class="btn btn-primary">Personal anfragen</a>
    </div>
  </section>
</BaseLayout>

<script>
/* FAQ-Schließ-Animation — progressive enhancement */
document.querySelectorAll('.faq-item').forEach(function(item) {
  var summary = item.querySelector('summary');
  if (!summary) return;
  summary.addEventListener('click', function(e) {
    if (!item.open) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    e.preventDefault();
    item.classList.add('faq-closing');
    var body = item.querySelector('.faq-body');
    if (!body) { item.classList.remove('faq-closing'); item.removeAttribute('open'); return; }
    body.addEventListener('transitionend', function handler() {
      body.removeEventListener('transitionend', handler);
      item.classList.remove('faq-closing');
      item.removeAttribute('open');
    });
  });
});
</script>

</style>

<script>
/* FAQ-Schlie&szlig;-Animation &mdash; progressive enhancement */
document.querySelectorAll('.faq-item').forEach(function(item) {
  var summary = item.querySelector('summary');
  if (!summary) return;
  summary.addEventListener('click', function(e) {
    if (!item.open) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    e.preventDefault();
    item.classList.add('faq-closing');
    var body = item.querySelector('.faq-body');
    if (!body) { item.classList.remove('faq-closing'); item.removeAttribute('open'); return; }
    body.addEventListener('transitionend', function handler() {
      body.removeEventListener('transitionend', handler);
      item.classList.remove('faq-closing');
      item.removeAttribute('open');
    });
  });
});
</script>

<script>
  /* Personal-Anfrage — gemeinsame Absende-Logik (A63), Event nur ohne Verdacht */
  import { absenden } from '../../scripts/formular';
  const personalForm = document.getElementById('personal-form') as HTMLFormElement;
  if (personalForm) {
    let personalSent = false;
    const tsField = document.getElementById('personal-ts') as HTMLInputElement | null;
    if (tsField) tsField.value = String(Date.now());
    personalForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = personalForm.querySelector('[type="submit"]') as HTMLButtonElement;
      const successMsg = document.getElementById('personal-success');
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Wird gesendet…'; }
      const r = await absenden(personalForm, { sprache: 'de' });
      if (r.ok && !r.verdacht && !personalSent) {
        personalSent = true;
        // Anweisung 77: Kuerzel des Felds „Fuer wie lange?" mitgeben; leer, wenn nichts gewaehlt.
        const dauerSel = personalForm.querySelector('input[name="dauer"]:checked') as HTMLInputElement | null;
        const dauerMap: Record<string, string> = { 'ein paar Tage oder Wochen': 'kurz', 'eine Saison': 'saison', 'dauerhaft': 'dauerhaft' };
        const dauer = dauerSel ? (dauerMap[dauerSel.value] || '') : '';
        (window as any).dataLayer = (window as any).dataLayer || [];
        (window as any).dataLayer.push({ event: 'personal_anfrage', form_name: 'personal', dauer });
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = r.ok ? 'Gesendet ✔' : 'Anfrage senden';
      }
      if (r.ok) {
        personalForm.reset();
        if (successMsg) successMsg.classList.remove('hidden');
      }
    });
  }
</script>

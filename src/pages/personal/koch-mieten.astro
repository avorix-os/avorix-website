---
// Anweisung 86: Zielseite "Koch mieten" nur fuer die Google-Anzeigen.
// noindex, follow; nicht in Sitemap, llms.txt, Menue oder Links anderer Seiten.
// Kein hreflang (keine EN/HU-Fassung), kein FAQPage-Schema.
//
// Gebaut aus den Bausteinen von /personal/: Bon, Beweis-Block, Formular (gleiche
// Felder, POST /api/formular, Ereignis personal_anfrage) und die FAQ-Eintraege sind
// WOERTLICH aus personal.astro uebernommen. Wer dort das Formular oder die Fragen
// zu Kosten, Mietkoch-Unterschied und Arbeitgeber aendert, muss es hier mitziehen;
// die Gate-Tests "A86" vergleichen beides mit /personal/.
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image, getImage } from "astro:assets";
import Altcha from "../../components/Altcha.astro";
import PartnerSlider from "../../components/PartnerSlider.astro";
import dampfTopf from "../../assets/bilder/dampf-topf.jpg";

const ogImg = await getImage({ src: dampfTopf, width: 1200, format: "jpeg" });
const ogImageAlt = "Dampf über einem Edelstahltopf auf dem Gasherd einer Profiküche";
---

<BaseLayout
  title="Koch mieten für Hotel, Restaurant und Kantine"
  description="Koch mieten für Ihren Betrieb: Rückmeldung innerhalb von 24 Stunden, Einsatz in der Regel innerhalb von 24 bis 72 Stunden, keine Mindest-Einsatzdauer."
  robots="noindex, follow"
  ogImage={ogImg.src}
  ogImageAlt={ogImageAlt}
>
  {/* 3.1 Hero (Baustein wie /personal/) */}
 <section class="hero-section px-6">
    <div class="content-width hero-grid">
      <div class="hero-copy">
        <p class="eyebrow mb-4">Mietkoch f&uuml;r Betriebe</p>
        <h1 class="mb-6">Koch mieten f&uuml;r Hotel, Restaurant und Kantine.</h1>
        <p class="lead mb-6 max-w-[var(--spalte-text)]" style="color: var(--druck)">
          Es fehlt jemand, wir schicken einen Koch. Kurzfristige Eins&auml;tze sind in der Regel innerhalb von 24 bis 72 Stunden m&ouml;glich, tageweise, wochenweise oder f&uuml;r die ganze Saison.
        </p>
        <div class="flex flex-wrap gap-4 mb-6">
          <a href="#anfrage" data-cta-location="koch-mieten-hero" data-cta-event="cta_personal_click" class="btn btn-primary">Koch anfragen</a>
        </div>
        <p class="hero-telefon">
          Im Notfall direkt anrufen:
          <a
            href="tel:+4975413973915"
            data-cta-location="hero"
            data-cta-event="personal_anruf_click"
            class="hero-telefon-link"
          >07541 3973915</a>
          <span class="hero-telefon-zeit">(Mo bis Fr 8 bis 17 Uhr, au&szlig;erhalb &uuml;ber Band)</span>
        </p>
      </div>
      <div class="hero-media">
        <Image
          src={dampfTopf}
          alt="Dampf &uuml;ber einem Edelstahltopf auf dem Gasherd einer Profik&uuml;che"
          widths={[480, 800, 1200]}
          sizes="(max-width: 900px) 100vw, 528px"
          loading="eager"
          fetchpriority="high"
          class="w-full h-full object-cover"
        />
      </div>
    </div>
  </section>

  {/* 3.2 Partner-Band (Anweisung 85), ohne section-gap/reveal */}
  <PartnerSlider lang="de" />

  {/* 3.3 Das gilt bei jedem Einsatz (Karten wie "Wann Sie uns rufen.") */}
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-10 md:mb-16" style="color:var(--druck)">Das gilt bei jedem Einsatz.</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="card">
          <h3 class="mb-4">In der Regel innerhalb von 24 bis 72 Stunden.</h3>
          <p class="text-sm leading-relaxed" style="color: var(--druck)">
            Wir melden uns innerhalb von 24 Stunden. Danach steht in der Regel innerhalb von 24 bis 72 Stunden ein Koch in Ihrer K&uuml;che, je nach Standort und Anforderung.
          </p>
        </div>
        <div class="card">
          <h3 class="mb-4">Keine Mindest-Einsatzdauer.</h3>
          <p class="text-sm leading-relaxed" style="color: var(--druck)">
            Ein einzelner Tag ist genauso m&ouml;glich wie eine ganze Saison.
          </p>
        </div>
        <div class="card">
          <h3 class="mb-4">Fester Stundensatz.</h3>
          <p class="text-sm leading-relaxed" style="color: var(--druck)">
            Der Stundensatz steht fest, bevor der Einsatz beginnt. Keine versteckten Posten.
          </p>
        </div>
        <div class="card">
          <h3 class="mb-4">Fest angestellt statt auf Rechnung.</h3>
          <p class="text-sm leading-relaxed" style="color: var(--druck)">
            Unsere K&ouml;che sind bei Avorix fest angestellt und sozialversichert. Avorix bleibt der Arbeitgeber.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* 3.4 Wer bei Ihnen am Herd steht */}
 <section class="reveal section-gap section-band">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Wer bei Ihnen am Herd steht.</h2>
      <p class="lead max-w-[var(--spalte-text)]" style="color: var(--druck)">
        Wir arbeiten f&uuml;r Betriebe: Hotels, Restaurants, Kantinen und Caterer. F&uuml;r private Feiern und Haushalte schicken wir keine K&ouml;che.
      </p>
      <p class="lead max-w-[var(--spalte-text)] mt-6" style="color: var(--druck)">
        Jeder, den wir schicken, ist Koch mit langj&auml;hriger K&uuml;chenerfahrung, je nach Bedarf als Beikoch, Koch oder Souschef, in Ausnahmen auch als K&uuml;chenchef. <strong>K&uuml;chenhilfen schicken wir nicht.</strong> Wir arbeiten in ganz Deutschland und &Ouml;sterreich.
      </p>
      <p class="max-w-[var(--spalte-text)] mt-6" style="color: var(--druck)">
        Du bist selbst Koch und suchst eine Stelle? Dann geht es hier entlang: <a href="/jobs/" class="typo-link">Jobs bei Avorix</a>.
      </p>
    </div>
  </section>

  {/* 3.5 So läuft ein Einsatz (Anweisung 81, Teil E: als Bon) */}
 <section class="reveal section-gap section-band">
    <div class="content-width">
      <div class="bon-layout">
        <div class="bon-copy">
          <h2>So l&auml;uft ein Einsatz. In vier Schritten.</h2>
        </div>
        <div class="bon-wrap">
          <div class="bon">
            <div aria-hidden="true">
              <p class="bon-kopf"><span>AVORIX</span><span>EINSATZ</span></p>
              <p class="bon-unterkopf"><span>Friedrichshafen</span><span>4 Schritte</span></p>
              <hr />
            </div>
            <ol>
              <li><div><b>Sie fragen an oder rufen an.</b><span>Wir melden uns innerhalb von 24 Stunden.</span></div></li>
              <li><div><b>Wir kl&auml;ren Bedarf, Zeitraum und Anforderung.</b><span>Kurz und konkret: Was f&uuml;r ein Betrieb, was f&uuml;r eine Karte, ab wann.</span></div></li>
              <li><div><b>B&ouml;rge Penk sucht den passenden Koch aus.</b><span>Unser K&uuml;chenchef nimmt jede Anfrage selbst in die Hand. Er kennt die Anforderungen einer K&uuml;che, und er kennt seine Leute.</span></div></li>
              <li><div><b>Der Einsatz startet.</b><span>Die geleisteten Stunden werden dokumentiert.</span></div></li>
            </ol>
            <hr />
            <p class="bon-fuss">Sie f&uuml;hren Ihre K&uuml;che.<br />Nicht Ihre K&uuml;che Sie.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 3.6 Beweis-Block (12b, Sektion 9) */}
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Aus dem laufenden Betrieb.</h2>
      <ul class="beweis-liste mb-8">
        <li>&Uuml;ber 1.000 Einsatztage in den K&uuml;chen unserer Kunden.</li>
        <li>Ein Cateringunternehmen bezieht &uuml;ber uns rund 15.000 Stunden im Jahr.</li>
      </ul>
      <figure class="card card-text beweis-zitat mb-6">
        <p class="mb-3" style="color:var(--druck);font-weight:700">Erprobt in der Praxis: das Seehotel Friedrichshafen.</p>
        <blockquote>
          <p class="leading-relaxed" style="color: var(--druck)">
            &bdquo;Das AVORIX System hat unseren K&uuml;chenalltag stabilisiert. Wir haben die Qualit&auml;t gesteigert und gleichzeitig die Abh&auml;ngigkeit vom Arbeitsmarkt massiv gesenkt.&ldquo;
          </p>
        </blockquote>
      </figure>
      <figure class="card card-text beweis-zitat">
        <blockquote>
          <p class="leading-relaxed" style="color: var(--druck)">
            &bdquo;[&hellip;] kann ich die Zusammenarbeit mit dem Avorix Team sehr empfehlen. Unter der Leitung von K&uuml;chenchef B&ouml;rge Penk hat Avorix bei uns Spitzenlasten, insbesondere bei starken Messen und gr&ouml;&szlig;eren Kongressen, zuverl&auml;ssig und sehr professionell unterst&uuml;tzt. Das Team f&uuml;gt sich sehr schnell in die Abl&auml;ufe ein, auch mit bis zu 20 K&ouml;chen gleichzeitig, sauber organisiert, ruhig im Ablauf, qualit&auml;tsbewusst, gutes Timing und Hygiene. [&hellip;]&ldquo;
          </p>
        </blockquote>
        <figcaption class="text-sm mt-4" style="color:var(--grau)">
          K&uuml;chendirektorin eines Cateringunternehmens, Bewertung vom 25. Februar 2026
        </figcaption>
      </figure>
    </div>
  </section>

  {/* 3.7 Was kostet das (wie /personal/, Knopf "Koch anfragen") */}
 <section class="reveal section-gap section-band">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Was kostet das?</h2>
      <div class="card card-text">
        <p class="leading-relaxed mb-6" style="color: var(--druck)">
          Klare Stundensätze, <strong>ohne versteckte Posten</strong>. Die Zahlen bekommen Sie im Erstgespräch schwarz auf weiß. Für die ersten Betriebe gelten 2026 Pilotkonditionen deutlich unter dem regulären Preis.
        </p>
        <a
          href="#anfrage"
          data-cta-location="koch-mieten-kosten"
          data-cta-event="cta_personal_click"
          class="btn btn-primary"
        >Koch anfragen</a>
      </div>
    </div>
  </section>

  {/* 3.8 Formular: Baustein von /personal/; Ueberschrift hier "Koch anfragen." (Regel 3.8, /personal/ bleibt) */}
 <section id="anfrage" class="reveal section-gap section-band">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Koch anfragen.</h2>
      <p class="formular-pflicht">Felder mit * brauchen wir, alles andere ist freiwillig.</p>
      <div class="anfrage-grid">
        <form id="personal-form" class="card anfrage-form-wrap space-y-6" action="/api/formular" method="POST">
          {/* Anweisung 45: eigener Formular-Dienst statt Formspree. Betreff setzt der Dienst. */}
          <input type="hidden" name="formular" value="personal" />
          <input type="text" name="website" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="hidden" name="form_ts" id="personal-ts" value="" />

          <div>
            <label for="pa-betrieb" class="anfrage-label">
              Betrieb <span style="color:var(--akzent)">*</span>
            </label>
            <input type="text" id="pa-betrieb" name="betrieb" required autocomplete="organization" class="anfrage-field" />
          </div>

          <div>
            <label for="pa-name" class="anfrage-label">
              Ihr Name <span style="color:var(--akzent)">*</span>
            </label>
            <input type="text" id="pa-name" name="name" required autocomplete="name" class="anfrage-field" />
          </div>

          <div>
            <label for="pa-telefon" class="anfrage-label">
              Telefon <span style="color:var(--akzent)">*</span>
            </label>
            <input type="tel" id="pa-telefon" name="telefon" required autocomplete="tel" class="anfrage-field" />
          </div>

          <div>
            <label for="pa-email" class="anfrage-label">
              E-Mail <span class="anfrage-label-opt">(optional)</span>
            </label>
            <input type="email" id="pa-email" name="email" autocomplete="email" class="anfrage-field" />
          </div>

          <div>
            <label for="pa-ab-wann" class="anfrage-label">
              Ab wann brauchen Sie jemanden? <span style="color:var(--akzent)">*</span>
            </label>
            <input
              type="text"
              id="pa-ab-wann"
              name="ab_wann"
              required
              placeholder="z.B. sofort oder ab 15. September"
              class="anfrage-field"
            />
          </div>

          {/* Anweisung 77: freiwilliges Feld, drei Knoepfe, keine Vorauswahl. */}
          <fieldset class="anfrage-fieldset">
            <legend class="anfrage-label">
              F&uuml;r wie lange brauchen Sie jemanden? <span class="anfrage-label-opt">(optional)</span>
            </legend>
            <div class="anfrage-dauer">
              <label class="anfrage-dauer-opt">
                <input type="radio" name="dauer" value="ein paar Tage oder Wochen" />
                <span>Ein paar Tage oder Wochen</span>
              </label>
              <label class="anfrage-dauer-opt">
                <input type="radio" name="dauer" value="eine Saison" />
                <span>Eine Saison</span>
              </label>
              <label class="anfrage-dauer-opt">
                <input type="radio" name="dauer" value="dauerhaft" />
                <span>Dauerhaft</span>
              </label>
            </div>
          </fieldset>

          <div>
            <label for="pa-hinweis" class="anfrage-label">
              Was sollen wir wissen? <span class="anfrage-label-opt">(optional)</span>
            </label>
            <textarea id="pa-hinweis" name="hinweis" rows="4" class="anfrage-field anfrage-textarea"></textarea>
          </div>

          <div id="personal-success" class="hidden anfrage-success-msg">
            Ihre Anfrage ist da. Wir melden uns innerhalb von 24 Stunden.
          </div>

          <Altcha sprache="de" />
          <button
            type="submit"
            class="btn btn-primary anfrage-submit"
          >
            Anfrage senden
          </button>
          <p class="formular-hinweis">
            Wir verarbeiten Ihre Angaben zur Bearbeitung Ihrer Anfrage.
            Weitere Informationen finden Sie in unserer <a href="/datenschutz" class="typo-link">Datenschutzerkl&auml;rung</a>.
          </p>
          {/* Anweisung 77 (Teil 2, Kanzlei-Vorbehalt): was nach der Anfrage passiert. */}
          <div class="anfrage-ablauf">
            <p class="anfrage-ablauf-titel">Was nach Ihrer Anfrage passiert</p>
            <p>Wir melden uns innerhalb von 24 Stunden und kl&auml;ren, wen Sie brauchen und f&uuml;r wie lange. F&uuml;r einen Einsatz &uuml;ber Avorix suchen wir die passenden Leute aus; Avorix bleibt der Arbeitgeber, und Sie zahlen die geleisteten Stunden. M&ouml;chten Sie jemanden dauerhaft oder f&uuml;r eine Saison selbst einstellen, zeigen wir Ihnen passende Bewerber, zuerst als Kurzprofil ohne Namen. Dann sind Sie der Arbeitgeber, und es f&auml;llt in der Regel ein einmaliges Vermittlungshonorar an.</p>
          </div>
        </form>

        <div class="card anfrage-telefon-karte">
          <h3 class="mb-4">Im Notfall geht es schneller am Telefon.</h3>
          <p class="mb-4">
            <a
              href="tel:+4975413973915"
              data-cta-location="anfrage"
              data-cta-event="personal_anruf_click"
              class="telefon-link"
            >07541 3973915</a>
          </p>
          <p class="leading-relaxed" style="color: var(--druck)">
            Montag bis Freitag von 8 bis 17 Uhr sind wir pers&ouml;nlich da. Au&szlig;erhalb sprechen Sie aufs Band und wir rufen zur&uuml;ck. Einsatzbereit sind wir rund um die Uhr, auch nachts und am Wochenende.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* 3.9 Haeufige Fragen: sechs Fragen woertlich wie /personal/, OHNE FAQPage-Schema */}
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-10" style="color:var(--druck)">H&auml;ufige Fragen</h2>
      <div class="faq-list">
        <details class="faq-item" open>
          <summary class="faq-q">Wie schnell kann jemand bei uns stehen?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>In der Regel innerhalb von 24 bis 72 Stunden, je nach Standort und Anforderung.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Gibt es eine Mindest-Einsatzdauer?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Nein. Ein einzelner Tag ist genauso m&ouml;glich wie eine ganze Saison.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Was kostet ein Mietkoch bei Avorix?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Einen festen Stundensatz f&uuml;r Ihren Einsatz, den Sie im Erstgespr&auml;ch bekommen und der gilt, bevor der Koch kommt. Er enth&auml;lt Lohn, Sozialabgaben, Urlaub und Ausfallrisiko, ein Vermittlungshonorar kommt nicht dazu. Was in einem Stundensatz steckt und wie Sie ihn mit einer Festanstellung vergleichen: <a href="/wissen/mietkoch-kosten/" class="typo-link">Was kostet ein Mietkoch?</a></p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Was ist der Unterschied zwischen einem Mietkoch und einem Koch von Avorix?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Ein klassischer Mietkoch arbeitet meist selbst&auml;ndig auf Rechnung. Unsere K&ouml;che sind bei Avorix fest angestellt und sozialversichert und arbeiten bei Ihnen im Rahmen der Arbeitnehmer&uuml;berlassung. Vertr&auml;ge in dieser Form reduzieren zugleich die rechtlichen Risiken beim Fremdpersonaleinsatz. Mehr dazu: <a href="/wissen/mietkoch-scheinselbstaendigkeit/" class="typo-link">Mietkoch auf Rechnung: Wo Scheinselbst&auml;ndigkeit beginnt</a></p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Wer ist der Arbeitgeber unseres Leihkochs?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Avorix bleibt der Arbeitgeber. Wir k&uuml;mmern uns um Arbeitsvertrag, Lohn, Sozialversicherung und die Arbeitgeberpflichten. In Ihrer K&uuml;che wird der Koch in Ihre Abl&auml;ufe eingebunden und Sie steuern seinen konkreten Arbeitseinsatz. Diese klare Rollenverteilung ist das Prinzip der Arbeitnehmer&uuml;berlassung.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Was ist, wenn der Koch nicht zu unserem Team passt?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Dann sprechen Sie mit uns, und wir finden eine L&ouml;sung. Es bringt niemandem etwas, wenn die Chemie nicht stimmt.</p></div></div>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
/* Honigtopf: fuer Menschen unsichtbar, fuer Bots ein Koeder (Anweisung 45) */
.hp-field { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; overflow: hidden; }

/* A70/71/72-Nachwirkung: Die Hervorhebung wuchs von "Rechtssicher verliehen."
   auf "Rechtssicher an Sie verliehen." und passt nicht mehr in eine Zeile der
   Hero-Spalte. Der globale Desktop-nowrap (global.css 421-427) liess sie unter
   das Bild laufen. Hier Umbruch wieder erlauben -- gezielt nur fuer diese H1. */
.hero-copy h1 mark { white-space: normal; }

/* Telefon-Zeile im Hero (12b).
   Nachtrag 1 (Punkt 1): 15px -> Druckfarbe (Faustregel: grau ab 15px wird druck). */
.hero-telefon {
  font-size: 15px;
  color: var(--druck);
}
.hero-telefon-link {
  font-weight: 700;
  color: var(--akzent);
  text-decoration: underline;
}
.hero-telefon-link:hover {
  text-decoration: underline;
}
.hero-telefon-zeit {
  display: inline-block;
}

/* Beweis-Block (12b, Sektion 9) */
.beweis-liste {
  list-style: none;
  padding: 0;
  margin: 0;
  border-top: 1px solid var(--linie);
  max-width: var(--spalte-text);
}
.beweis-liste li {
  border-bottom: 1px solid var(--linie);
  padding: 16px 0;
  font-size: 17px;
  color: var(--druck);
}
.beweis-zitat {
  /* Anweisung 40 (A1/A2): dieselbe Textspalte wie Liste und Ueberschrift
     darueber, linksbuendig an derselben Kante. Die fruehere Zentrierung
     (margin: auto) entfaellt. Der 40px-Abstand nach oben bleibt, damit die Box
     die Trennlinie der Liste nicht beruehrt. */
  max-width: var(--spalte-text);
  margin-top: 40px;
}
.beweis-zitat blockquote {
  margin: 0;
}

/* Anfrage-Strecke (12b, Sektion 11) */
.anfrage-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
}
@media (min-width: 900px) {
  .anfrage-grid {
    grid-template-columns: 1.15fr 1fr;
    align-items: start;
  }
}
.anfrage-form-wrap {
  padding: 2rem;
}
.anfrage-telefon-karte {
  padding: 2rem;
}
/* Anweisung 40 (C1): grosse Telefonnummer nutzt jetzt die geteilte
   .telefon-link-Klasse (>=44px). Hier nur noch die Kartengroesse. */
.anfrage-telefon-karte .telefon-link {
  font-family: var(--f-head);
  font-size: 24px;
}
.anfrage-label {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: var(--druck);
  margin-bottom: 8px;
}
.anfrage-label-opt {
  font-weight: 400;
  color: var(--grau);
}
.anfrage-field {
  width: 100%;
  background: var(--flaeche);
  border: 1px solid var(--linie);
  border-radius: var(--radius);
  padding: 16px;
  font-size: 16px;
  font-family: var(--f-body);
  color: var(--druck);
  transition: border-color .15s;
  appearance: auto;
  box-sizing: border-box;
}
.anfrage-field:focus {
  outline: none;
  border-color: var(--akzent);
}
.anfrage-field:focus-visible {
  outline: 3px solid var(--akzent);
  outline-offset: 2px;
}
.anfrage-textarea {
  resize: none;
}
/* Anweisung 77: Feld „Fuer wie lange?" — drei Knoepfe gestapelt, linksbuendig. */
.anfrage-fieldset { border: 0; padding: 0; margin: 0; }
.anfrage-fieldset legend { padding: 0; }
.anfrage-dauer { display: grid; grid-template-columns: 1fr; gap: 12px; }
.anfrage-dauer-opt { position: relative; display: block; cursor: pointer; }
.anfrage-dauer-opt input { position: absolute; opacity: 0; width: 1px; height: 1px; }
.anfrage-dauer-opt span {
  display: flex; align-items: center; justify-content: flex-start; text-align: left;
  min-height: 0; padding: 12px 16px;
  border: 1px solid var(--linie); border-radius: var(--radius);
  background: var(--flaeche); font-weight: 600; color: var(--druck);
  transition: border-color .15s, background-color .15s;
}
.anfrage-dauer-opt input:checked + span { border-color: var(--akzent); background: #F3D9C8; color: var(--akzent); }
.anfrage-dauer-opt input:focus-visible + span { outline: 3px solid var(--akzent); outline-offset: 2px; }
@media (prefers-reduced-motion: reduce) { .anfrage-dauer-opt span { transition: none; } }
/* Anweisung 77: Absatz „Was nach Ihrer Anfrage passiert" unter dem Formular. */

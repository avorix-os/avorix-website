---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Stempel from "../../components/Stempel.astro";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://avorix.de/" },
      { "@type": "ListItem", "position": 2, "name": "Personal", "item": "https://avorix.de/personal" },
      { "@type": "ListItem", "position": 3, "name": "Mietkoch am Bodensee", "item": "https://avorix.de/personal/bodensee/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Arbeitnehmerüberlassung von Köchen am Bodensee",
    "serviceType": "Arbeitnehmerüberlassung",
    "provider": { "@type": "Organization", "name": "AVORIX GmbH", "url": "https://avorix.de/" },
    "areaServed": "Bodensee",
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": "#direktantwort" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Wie schnell seid ihr am westlichen Bodensee, etwa in Konstanz?", "acceptedAnswer": { "@type": "Answer", "text": "Genauso schnell wie überall am See: in der Regel innerhalb von 24 bis 72 Stunden. Im Notfall rufen Sie am besten direkt an: 07541 3973915 (Mo bis Fr 8 bis 17 Uhr, außerhalb über Band)." } },
      { "@type": "Question", "name": "Übernehmt ihr auch nur die Saison?", "acceptedAnswer": { "@type": "Answer", "text": "Ja. Viele Häuser am See verstärken sich von Ostern bis Oktober und fahren danach wieder herunter. Eine Mindest-Einsatzdauer gibt es nicht." } },
      { "@type": "Question", "name": "Arbeitet ihr auch auf der Schweizer Seeseite?", "acceptedAnswer": { "@type": "Answer", "text": "Nein. In die Schweiz verleihen wir nicht, wir arbeiten in Deutschland und Österreich." } }
    ]
  }
];
---
<BaseLayout
  title="Mietkoch Bodensee: Koch mieten in Friedrichshafen"
  description="Koch mieten am Bodensee: festangestellte Köche für Hotels und Restaurants, in der Regel innerhalb von 24 bis 72 Stunden. Sitz in Friedrichshafen."
  schemaOrg={schema}
>
  {/* Hero */}
 <section class="hero-section px-6" style="background:var(--papier)">
    <div class="content-width">
      <p class="eyebrow mb-4"><a href="/personal/" class="eyebrow-link">Personal</a></p>
      <h1 class="mb-6 max-w-[24ch]">Mietkoch am Bodensee: Köche mieten, wo wir zu Hause sind</h1>
      <p class="lead mb-6 max-w-[62ch]" style="color:var(--grau)">
        Ein Koch fällt aus, die Terrasse ist voll? Wir leihen Ihnen unsere festangestellten Köche aus: für den Notfall, für die Saison, für den Übergang. Avorix sitzt in Friedrichshafen, unsere Wege am See sind kurz.
      </p>
      <div class="flex flex-wrap gap-4 mb-6">
        <a href="/personal#anfrage" data-cta-location="personal-bodensee-hero" data-cta-event="cta_personal_click" class="btn btn-primary">Personal anfragen</a>
      </div>
      <div class="hero-badges mb-6">
        <span class="check-badge"><span class="check-badge-mark">&#10003;</span> Behördliche Arbeitnehmerüberlassungserlaubnis (Agentur für Arbeit)</span>
      </div>
      <p class="hero-telefon">
        Im Notfall direkt anrufen:
        <a href="tel:+4975413973915" data-cta-location="personal-bodensee-hero" data-cta-event="personal_anruf_click" class="hero-telefon-link">07541 3973915</a>
        <span class="hero-telefon-zeit">(Mo bis Fr 8 bis 17 Uhr, außerhalb über Band)</span>
      </p>
    </div>
  </section>

  {/* Direktantwort (GEO) */}
 <section class="reveal">
    <div class="content-width">
      <p id="direktantwort" class="lead py-4 max-w-[62ch]" style="color:var(--grau)">
        Avorix verleiht festangestellte, sozialversicherte Köche an Hotels, Restaurants und Betriebe rund um den Bodensee, mit behördlicher Arbeitnehmerüberlassungserlaubnis und Sitz in Friedrichshafen. In der Regel steht Ihr Koch innerhalb von 24 bis 72 Stunden in der Küche.
      </p>
    </div>
  </section>

  {/* Unser Einsatzgebiet (schmale Spalte) */}
 <section class="reveal section-gap">
    <div class="content-width text-spalte">
      <h2 class="mb-6" style="color:var(--druck)">Unser Einsatzgebiet</h2>
      <p class="max-w-[62ch]" style="color:var(--grau)">Wir arbeiten dort, wo wir selbst herkommen: am ganzen See und im Hinterland. Friedrichshafen, Konstanz, Lindau, Überlingen, Meersburg, Ravensburg, Oberschwaben bis ins Allgäu. Die Saison am See ist kurz und intensiv: Wenn im Sommer jede Terrasse voll ist und im Winter die Häuser umbauen oder schließen, braucht die Küche in beiden Fällen einen anderen Personalstand. Genau für dieses Auf und Ab sind unsere Einsätze gedacht. Und weil die Wege kurz sind, sind wir im Notfall schnell bei Ihnen in der Küche.</p>
      <p class="max-w-[62ch] mt-4" style="color:var(--grau)">Dazu kommt das Bodensee-Problem: Die Schweiz liegt eine Fährfahrt entfernt und zahlt Löhne, bei denen kein deutsches Haus mithalten kann. Wer hier gut kocht, bekommt Angebote von drüben. Wir sind die Antwort darauf: Ihr Betrieb läuft weiter, auch wenn wieder einer geht.</p>
    </div>
  </section>

  {/* Typische Einsätze */}
 <section class="reveal section-gap" style="background:var(--papier)">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Typische Einsätze am See</h2>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">
        <div class="card"><p class="text-sm" style="color:var(--grau)">Das Terrassengeschäft explodiert am ersten warmen Wochenende, die Küche ist noch auf Winterbesetzung.</p></div>
        <div class="card"><p class="text-sm" style="color:var(--grau)">Der Küchenchef fällt mitten in der Hochsaison aus, Halbpension und À la carte laufen trotzdem parallel weiter.</p></div>
        <div class="card"><p class="text-sm" style="color:var(--grau)">Ein Haus baut im Winter um und braucht für die Wiedereröffnungswochen einen zusätzlichen Posten.</p></div>
      </div>
    </div>
  </section>

  {/* So läuft ein Einsatz (wortgleich, schmale Spalte) */}
 <section class="reveal section-gap">
    <div class="content-width text-spalte">
      <h2 class="mb-6" style="color:var(--druck)">So läuft ein Einsatz</h2>
      <p class="max-w-[62ch]" style="color:var(--grau)">Sie rufen an oder schreiben uns, wir klären in einem kurzen Gespräch, wen Sie brauchen und ab wann. In der Regel steht Ihr Koch innerhalb von 24 bis 72 Stunden in der Küche, unsere Einsätze sind rund um die Uhr möglich, auch nachts und am Wochenende. Eine Mindest-Einsatzdauer gibt es nicht: Viele Häuser überbrücken zwei Wochen, andere eine ganze Saison. Ihr Erstgespräch: 30 Minuten, kostenlos, unverbindlich.</p>
    </div>
  </section>

  {/* Fest angestellt statt auf Rechnung (wortgleich, dunkler Block) */}
 <section class="reveal section-gap section-dunkel">
    <div class="content-width text-spalte">
      <h2 class="mb-6">Fest angestellt statt auf Rechnung</h2>
      <p class="max-w-[62ch]">Unsere Köche sind bei Avorix fest angestellt und sozialversichert und arbeiten bei Ihnen im Rahmen der Arbeitnehmerüberlassung. Sie integrieren den Koch in Ihre Abläufe und erteilen arbeitsbezogene Weisungen, genau das ist bei diesem Modell vorgesehen. Verträge in dieser Form reduzieren zugleich die rechtlichen Risiken beim Fremdpersonaleinsatz. Warum das beim selbständigen Mietkoch auf Rechnung anders aussieht: <a href="/wissen/mietkoch-scheinselbstaendigkeit/" class="typo-link">Mietkoch auf Rechnung: Wo Scheinselbständigkeit beginnt</a></p>
    </div>
  </section>

  {/* FAQ */}
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Häufige Fragen</h2>
      <div class="faq-list">
        <details class="faq-item" open>
          <summary class="faq-q">Wie schnell seid ihr am westlichen Bodensee, etwa in Konstanz?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Genauso schnell wie überall am See: in der Regel innerhalb von 24 bis 72 Stunden. Im Notfall rufen Sie am besten direkt an: 07541 3973915 (Mo bis Fr 8 bis 17 Uhr, außerhalb über Band).</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Übernehmt ihr auch nur die Saison?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Ja. Viele Häuser am See verstärken sich von Ostern bis Oktober und fahren danach wieder herunter. Eine Mindest-Einsatzdauer gibt es nicht.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Arbeitet ihr auch auf der Schweizer Seeseite?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Nein. In die Schweiz verleihen wir nicht, wir arbeiten in Deutschland und Österreich.</p></div></div>
        </details>
      </div>
    </div>
  </section>

  {/* CTA-Abschluss */}
 <section class="reveal section-gap" style="background:var(--papier)">
    <div class="content-width text-center">
      <div class="mb-6">
        <Stempel>Geprüft &middot; AÜ-Erlaubnis</Stempel>
      </div>
      <p class="mb-6 max-w-[62ch]" style="margin-inline:auto;color:var(--grau)">Kurze Wege, feste Köche, klare Verträge.</p>
      <p class="mb-6" style="font-family:Charter, Georgia, serif; font-style:italic; font-size:24px; color:var(--druck)">Es ist geregelt.</p>
      <a href="/personal" data-cta-location="personal-bodensee-ende" class="btn btn-primary">Personal anfragen</a>
    </div>
  </section>
</BaseLayout>

<script>
/* FAQ-Schließ-Animation — progressive enhancement */
document.querySelectorAll('.faq-item').forEach(function(item) {
  var summary = item.querySelector('summary');
  if (!summary) return;
  summary.addEventListener('click', function(e) {
    if (!item.open) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    e.preventDefault();
    item.classList.add('faq-closing');
    var body = item.querySelector('.faq-body');
    if (!body) { item.classList.remove('faq-closing'); item.removeAttribute('open'); return; }
    body.addEventListener('transitionend', function handler() {
      body.removeEventListener('transitionend', handler);
      item.classList.remove('faq-closing');
      item.removeAttribute('open');
    });
  });
});
</script>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Stempel from "../../components/Stempel.astro";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://avorix.de/" },
      { "@type": "ListItem", "position": 2, "name": "Personal", "item": "https://avorix.de/personal" },
      { "@type": "ListItem", "position": 3, "name": "Mietkoch in Vorarlberg", "item": "https://avorix.de/personal/vorarlberg/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Arbeitnehmerüberlassung von Köchen in Vorarlberg",
    "serviceType": "Arbeitnehmerüberlassung",
    "provider": { "@type": "Organization", "name": "AVORIX GmbH", "url": "https://avorix.de/" },
    "areaServed": "Vorarlberg",
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": "#direktantwort" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Braucht mein Betrieb für den Einsatz eine eigene Genehmigung?", "acceptedAnswer": { "@type": "Answer", "text": "In der Regel nicht: Die Meldepflichten für die grenzüberschreitende Überlassung liegen beim Verleiher, also bei uns. Was auf Ihrer Seite zu beachten ist, klären wir im Erstgespräch: 30 Minuten, kostenlos, unverbindlich." } },
      { "@type": "Question", "name": "Wie schnell seid ihr in Vorarlberg?", "acceptedAnswer": { "@type": "Answer", "text": "In der Regel innerhalb von 24 bis 72 Stunden. Vom Bodensee aus ist Vorarlberg die Region mit dem kürzesten Weg." } },
      { "@type": "Question", "name": "Arbeitet ihr auch in der Schweiz oder in Liechtenstein?", "acceptedAnswer": { "@type": "Answer", "text": "Nein. Wir arbeiten in Deutschland und Österreich. In die Schweiz verleihen wir nicht, und Liechtenstein gehört nicht zu unserem Gebiet." } }
    ]
  }
];
---
<BaseLayout
  title="Mietkoch Vorarlberg: Koch mieten vom Bodensee aus"
  description="Koch mieten in Vorarlberg: festangestellte Köche für Hotellerie und Gastronomie, vom Rheintal bis zum Arlberg. Vom Bodensee aus, grenzüberschreitend gemeldet."
  schemaOrg={schema}
>
  {/* Hero */}
 <section class="hero-section px-6">
    <div class="content-width">
      <p class="eyebrow mb-4"><a href="/personal/" class="eyebrow-link">Personal</a></p>
      <h1 class="mb-6 max-w-[var(--spalte-schmal)]">Mietkoch in Vorarlberg: Köche mieten, direkt vom Bodensee</h1>
      <p class="lead mb-6 max-w-[var(--spalte-text)]" style="color:var(--grau)">
        Vorarlberg ist von Friedrichshafen aus näher als München. Wenn im Rheintal, im Bregenzerwald oder am Arlberg ein Posten leer bleibt, leihen wir Ihnen unsere festangestellten Köche aus: für die Saison, für den Engpass, für die Wochen dazwischen.
      </p>
      <div class="flex flex-wrap gap-4 mb-6">
        <a href="/personal#anfrage" data-cta-location="personal-vorarlberg-hero" data-cta-event="cta_personal_click" class="btn btn-primary">Personal anfragen</a>
      </div>
      <div class="hero-badges mb-6">
        <span class="check-badge"><span class="check-badge-mark">&#10003;</span> Behördliche Arbeitnehmerüberlassungserlaubnis (Agentur für Arbeit)</span>
      </div>
      <p class="hero-telefon">
        Im Notfall direkt anrufen:
        <a href="tel:+4975413973915" data-cta-location="personal-vorarlberg-hero" data-cta-event="personal_anruf_click" class="hero-telefon-link">07541 3973915</a>
        <span class="hero-telefon-zeit">(Mo bis Fr 8 bis 17 Uhr, außerhalb über Band)</span>
      </p>
    </div>
  </section>

  {/* Direktantwort (GEO) */}
 <section class="reveal">
    <div class="content-width">
      <p id="direktantwort" class="lead py-4 max-w-[var(--spalte-text)]" style="color:var(--grau)">
        Avorix verleiht festangestellte, sozialversicherte Köche an Hotellerie und Gastronomie in Vorarlberg, mit behördlicher Arbeitnehmerüberlassungserlaubnis und ordnungsgemäßer Meldung in Österreich. In der Regel steht Ihr Koch innerhalb von 24 bis 72 Stunden in der Küche.
      </p>
    </div>
  </section>

  {/* Unser Einsatzgebiet (schmale Spalte) */}
 <section class="reveal section-gap">
    <div class="content-width text-spalte">
      <h2 class="mb-6" style="color:var(--druck)">Unser Einsatzgebiet</h2>
      <p class="max-w-[var(--spalte-text)]" style="color:var(--grau)">Vorarlberg ist unser nächstes Ausland: Von Friedrichshafen bis Bregenz sind es rund 40 Kilometer, und die Küchen zwischen Bodensee und Arlberg leben im selben Rhythmus wie unsere: Sommergäste am See, Wintergäste am Berg, dazwischen Umbau und Pause. Wir verleihen Köche im ganzen Land, vom Rheintal über den Bregenzerwald bis nach Lech und Zürs. Grenzüberschreitende Einsätze melden wir vor Arbeitsbeginn bei den österreichischen Behörden an (ZKO-Meldung) und halten die österreichischen Entlohnungs- und Meldevorschriften ein. Sie müssen sich um nichts davon kümmern.</p>
      <p class="max-w-[var(--spalte-text)] mt-4" style="color:var(--grau)">Wir sind außerdem <a href="/personal/bodensee/">am Bodensee</a>, in <a href="/personal/tirol/">Tirol</a>, im Großraum <a href="/personal/muenchen/">München</a>, in <a href="/personal/stuttgart/">Stuttgart</a> und in <a href="/personal/frankfurt/">Frankfurt und Rhein-Main</a> im Einsatz.</p>
    </div>
  </section>

  {/* Typische Einsätze */}
 <section class="reveal section-gap section-band">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Typische Einsätze in Vorarlberg</h2>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">
        <div class="card"><p class="text-sm" style="color:var(--grau)">Das Seehotel in Bregenz verlängert die Sommersaison um drei Wochen, das Stammteam ist ab September weg.</p></div>
        <div class="card"><p class="text-sm" style="color:var(--grau)">Der Küchenchef am Arlberg kündigt im Oktober, die Wintersaison beginnt im Dezember.</p></div>
        <div class="card"><p class="text-sm" style="color:var(--grau)">Das Haus im Bregenzerwald hat ein Bankett mit 120 Personen und zwei Posten unbesetzt.</p></div>
      </div>
    </div>
  </section>

  {/* So läuft ein Einsatz (wortgleich von Tirol, schmale Spalte) */}
 <section class="reveal section-gap section-band">
    <div class="content-width text-spalte">
      <h2 class="mb-6" style="color:var(--druck)">So läuft ein Einsatz</h2>
      <p class="max-w-[var(--spalte-text)]" style="color:var(--grau)">Sie rufen an oder schreiben uns, wir klären in einem kurzen Gespräch, wen Sie brauchen und ab wann. In der Regel steht Ihr Koch innerhalb von 24 bis 72 Stunden in der Küche, unsere Einsätze sind rund um die Uhr möglich, auch nachts und am Wochenende. Eine Mindest-Einsatzdauer gibt es nicht: Viele Häuser überbrücken zwei Wochen, andere eine ganze Saison. Ihr Erstgespräch: 30 Minuten, kostenlos, unverbindlich.</p>
    </div>
  </section>

  {/* Fest angestellt statt auf Rechnung (wortgleich von Tirol, dunkler Block) */}
 <section class="reveal section-gap section-dunkel">
    <div class="content-width text-spalte">
      <h2 class="mb-6">Fest angestellt statt auf Rechnung</h2>
      <p class="max-w-[var(--spalte-text)]">Unsere Köche sind bei Avorix fest angestellt und sozialversichert und arbeiten bei Ihnen im Rahmen der Arbeitnehmerüberlassung. Sie integrieren den Koch in Ihre Abläufe und erteilen arbeitsbezogene Weisungen, genau das ist bei diesem Modell vorgesehen. Verträge in dieser Form reduzieren zugleich die rechtlichen Risiken beim Fremdpersonaleinsatz. Warum das beim selbständigen Mietkoch auf Rechnung anders aussieht: <a href="/wissen/mietkoch-scheinselbstaendigkeit/" class="typo-link">Mietkoch auf Rechnung: Wo Scheinselbständigkeit beginnt</a></p>
      <p class="max-w-[var(--spalte-text)]">Im Sprachgebrauch heißt dieses Modell Zeitarbeit, in der Küche Leihkoch oder Mietkoch. Rechtlich ist es immer dasselbe: Arbeitnehmerüberlassung mit behördlicher Erlaubnis, durch einen Personaldienstleister, der seine Köche selbst anstellt.</p>
    </div>
  </section>

  {/* FAQ */}
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Häufige Fragen</h2>
      <div class="faq-list">
        <details class="faq-item" open>
          <summary class="faq-q">Braucht mein Betrieb für den Einsatz eine eigene Genehmigung?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>In der Regel nicht: Die Meldepflichten für die grenzüberschreitende Überlassung liegen beim Verleiher, also bei uns. Was auf Ihrer Seite zu beachten ist, klären wir im Erstgespräch: 30 Minuten, kostenlos, unverbindlich.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Wie schnell seid ihr in Vorarlberg?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>In der Regel innerhalb von 24 bis 72 Stunden. Vom Bodensee aus ist Vorarlberg die Region mit dem kürzesten Weg.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Arbeitet ihr auch in der Schweiz oder in Liechtenstein?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Nein. Wir arbeiten in Deutschland und Österreich. In die Schweiz verleihen wir nicht, und Liechtenstein gehört nicht zu unserem Gebiet.</p></div></div>
        </details>
      </div>
    </div>
  </section>

  {/* CTA-Abschluss */}
 <section class="reveal section-gap">
    <div class="content-width text-center">
      <div class="mb-6">
        <Stempel>Geprüft &middot; AÜ-Erlaubnis</Stempel>
      </div>
      <p class="mb-6 max-w-[var(--spalte-text)]" style="margin-inline:auto;color:var(--grau)">Die Saison wartet nicht.</p>
      <p class="mb-6" style="font-family:Charter, Georgia, serif; font-style:italic; font-size:24px; color:var(--druck)">Es ist geregelt.</p>
      <a href="/personal#anfrage" data-cta-location="personal-vorarlberg-ende" class="btn btn-primary">Personal anfragen</a>
    </div>
  </section>
</BaseLayout>

<script>
/* FAQ-Schliess-Animation, progressive enhancement */
document.querySelectorAll('.faq-item').forEach(function(item) {
  var summary = item.querySelector('summary');
  if (!summary) return;
  summary.addEventListener('click', function(e) {
    if (!item.open) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    e.preventDefault();
    item.classList.add('faq-closing');
    var body = item.querySelector('.faq-body');
    if (!body) { item.classList.remove('faq-closing'); item.removeAttribute('open'); return; }
    body.addEventListener('transitionend', function handler() {
      body.removeEventListener('transitionend', handler);
      item.classList.remove('faq-closing');
      item.removeAttribute('open');
    });
  });
});
</script>

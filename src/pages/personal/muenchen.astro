---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Stempel from "../../components/Stempel.astro";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://avorix.de/" },
      { "@type": "ListItem", "position": 2, "name": "Personal", "item": "https://avorix.de/personal" },
      { "@type": "ListItem", "position": 3, "name": "Mietkoch in München", "item": "https://avorix.de/personal/muenchen/" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Arbeitnehmerüberlassung von Köchen in München",
    "serviceType": "Arbeitnehmerüberlassung",
    "provider": { "@type": "Organization", "name": "AVORIX GmbH", "url": "https://avorix.de/" },
    "areaServed": "München",
    "speakable": { "@type": "SpeakableSpecification", "cssSelector": "#direktantwort" }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "Verstärkt ihr auch nur für einzelne Veranstaltungen?", "acceptedAnswer": { "@type": "Answer", "text": "Ja. Eine Mindest-Einsatzdauer gibt es nicht, auch ein einzelnes Bankett oder eine Messewoche ist ein normaler Einsatz." } },
      { "@type": "Question", "name": "Arbeitet ihr auch für Caterer und Betriebsgastronomie?", "acceptedAnswer": { "@type": "Answer", "text": "Ja. Unsere Köche arbeiten in Restaurants, Hotels, im Veranstaltungs-Catering und in Betriebsrestaurants." } },
      { "@type": "Question", "name": "Was kostet ein Leihkoch in München?", "acceptedAnswer": { "@type": "Answer", "text": "Sie zahlen einen Stundenverrechnungssatz, in dem Lohn, Sozialabgaben und das komplette Arbeitgeberrisiko schon enthalten sind. Die Konditionen besprechen wir im Erstgespräch: 30 Minuten, kostenlos, unverbindlich." } }
    ]
  }
];
---
<BaseLayout
  title="Mietkoch München: Koch kurzfristig mieten"
  description="Koch mieten in München: festangestellte Köche für Restaurant, Hotel, Catering und Betriebsgastronomie, in der Regel innerhalb von 24 bis 72 Stunden."
  schemaOrg={schema}
>
  <!-- Hero -->
 <section class="hero-section px-6" style="background:var(--papier)">
    <div class="content-width">
      <p class="eyebrow mb-4"><a href="/personal/" class="eyebrow-link">Personal</a></p>
      <h1 class="mb-6 max-w-[24ch]">Mietkoch in München: Köche mieten für Restaurant, Hotel und Catering</h1>
      <p class="lead mb-6 max-w-[62ch]" style="color:var(--grau)">
        Der Küchenchef kündigt, das Bankett ist verkauft, die Messewoche steht vor der Tür? Wir leihen Ihnen unsere festangestellten Köche aus: für das Bankett, für die Messewoche, für den Übergang.
      </p>
      <div class="flex flex-wrap gap-4 mb-6">
        <a href="/personal#anfrage" data-cta-location="personal-muenchen-hero" data-cta-event="cta_personal_click" class="btn btn-primary">Personal anfragen</a>
      </div>
      <div class="hero-badges mb-6">
        <span class="check-badge"><span class="check-badge-mark">&#10003;</span> Behördliche Arbeitnehmerüberlassungserlaubnis (Agentur für Arbeit)</span>
      </div>
      <p class="hero-telefon">
        Im Notfall direkt anrufen:
        <a href="tel:+4975413973915" data-cta-location="personal-muenchen-hero" data-cta-event="personal_anruf_click" class="hero-telefon-link">07541 3973915</a>
        <span class="hero-telefon-zeit">(Mo bis Fr 8 bis 17 Uhr, außerhalb über Band)</span>
      </p>
    </div>
  </section>

  <!-- Direktantwort (GEO) -->
 <section class="reveal">
    <div class="content-width">
      <p id="direktantwort" class="lead py-4 max-w-[62ch]" style="color:var(--grau)">
        Avorix verleiht festangestellte, sozialversicherte Köche an Betriebe im Großraum München, mit behördlicher Arbeitnehmerüberlassungserlaubnis. In der Regel steht Ihr Koch innerhalb von 24 bis 72 Stunden in der Küche, auch für einzelne Veranstaltungen und Spitzenzeiten.
      </p>
    </div>
  </section>

  <!-- Unser Einsatzgebiet (schmale Spalte) -->
 <section class="reveal section-gap">
    <div class="content-width text-spalte">
      <h2 class="mb-6" style="color:var(--druck)">Unser Einsatzgebiet</h2>
      <p class="max-w-[62ch]" style="color:var(--grau)">München ist ein dichter Gastronomie-Markt: Messen und Kongresse, Veranstaltungs-Catering, Betriebsrestaurants, dazu die klassische Hotellerie und Gastronomie der Stadt. Das heißt auch: Personalspitzen, die sich nicht in Festanstellungen abbilden lassen. Ein Bankett für 200 Gäste, zwei Messewochen im Herbst, ein Betriebsrestaurant, dessen Koch drei Monate ausfällt. Für solche Lagen verleihen wir Köche im gesamten Großraum München und ins Umland.</p>
      <p class="max-w-[62ch] mt-4" style="color:var(--grau)">Dazu kommt der Münchner Arbeitsmarkt: Die Schweiz und die Tourismusregionen in Österreich werben um dieselben Köche wie Sie, und in der Stadt konkurrieren die vielen Häuser untereinander. Wer gut ist, hat Angebote. Wir sind da, wenn wieder einer geht.</p>
    </div>
  </section>

  <!-- Typische Einsätze -->
 <section class="reveal section-gap" style="background:var(--papier)">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Typische Einsätze in München</h2>
      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">
        <div class="card"><p class="text-sm" style="color:var(--grau)">Ein Bankett für 200 Gäste ist verkauft, zwei Tage vorher fällt ein Posten krankheitsbedingt aus.</p></div>
        <div class="card"><p class="text-sm" style="color:var(--grau)">Messewochen verdoppeln das Geschäft rund ums Gelände, die Stammbesetzung bleibt gleich.</p></div>
        <div class="card"><p class="text-sm" style="color:var(--grau)">Ein Betriebsrestaurant verliert seinen Koch mitten im Quartal, 300 Essen am Tag warten nicht auf die Neubesetzung.</p></div>
      </div>
    </div>
  </section>

  <!-- So läuft ein Einsatz (wortgleich, schmale Spalte) -->
 <section class="reveal section-gap">
    <div class="content-width text-spalte">
      <h2 class="mb-6" style="color:var(--druck)">So läuft ein Einsatz</h2>
      <p class="max-w-[62ch]" style="color:var(--grau)">Sie rufen an oder schreiben uns, wir klären in einem kurzen Gespräch, wen Sie brauchen und ab wann. In der Regel steht Ihr Koch innerhalb von 24 bis 72 Stunden in der Küche, unsere Einsätze sind rund um die Uhr möglich, auch nachts und am Wochenende. Eine Mindest-Einsatzdauer gibt es nicht: Viele Häuser überbrücken zwei Wochen, andere eine ganze Saison. Ihr Erstgespräch: 30 Minuten, kostenlos, unverbindlich.</p>
    </div>
  </section>

  <!-- Fest angestellt statt auf Rechnung (wortgleich, dunkler Block) -->
 <section class="reveal section-gap section-dunkel">
    <div class="content-width text-spalte">
      <h2 class="mb-6">Fest angestellt statt auf Rechnung</h2>
      <p class="max-w-[62ch]">Unsere Köche sind bei Avorix fest angestellt und sozialversichert und arbeiten bei Ihnen im Rahmen der Arbeitnehmerüberlassung. Sie integrieren den Koch in Ihre Abläufe und erteilen arbeitsbezogene Weisungen, genau das ist bei diesem Modell vorgesehen. Verträge in dieser Form reduzieren zugleich die rechtlichen Risiken beim Fremdpersonaleinsatz. Warum das beim selbständigen Mietkoch auf Rechnung anders aussieht: <a href="/wissen/mietkoch-scheinselbstaendigkeit/" class="typo-link">Mietkoch auf Rechnung: Wo Scheinselbständigkeit beginnt</a></p>
    </div>
  </section>

  <!-- FAQ -->
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">Häufige Fragen</h2>
      <div class="faq-list">
        <details class="faq-item" open>
          <summary class="faq-q">Verstärkt ihr auch nur für einzelne Veranstaltungen?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Ja. Eine Mindest-Einsatzdauer gibt es nicht, auch ein einzelnes Bankett oder eine Messewoche ist ein normaler Einsatz.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Arbeitet ihr auch für Caterer und Betriebsgastronomie?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Ja. Unsere Köche arbeiten in Restaurants, Hotels, im <a href="/fuer-catering/" class="typo-link">Veranstaltungs-Catering</a> und in <a href="/fuer-kantinen/" class="typo-link">Betriebsrestaurants</a>.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Was kostet ein Leihkoch in München?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Sie zahlen einen Stundenverrechnungssatz, in dem Lohn, Sozialabgaben und das komplette Arbeitgeberrisiko schon enthalten sind. Die Konditionen besprechen wir im Erstgespräch: 30 Minuten, kostenlos, unverbindlich.</p></div></div>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA-Abschluss -->
 <section class="reveal section-gap" style="background:var(--papier)">
    <div class="content-width text-center">
      <div class="mb-6">
        <Stempel>Geprüft &middot; AÜ-Erlaubnis</Stempel>
      </div>
      <p class="mb-6 max-w-[62ch]" style="margin-inline:auto;color:var(--grau)">Wenn die Küche Verstärkung braucht, ist der Vertrag das Letzte, worüber Sie sich Sorgen machen sollten.</p>
      <p class="mb-6" style="font-family:Charter, Georgia, serif; font-style:italic; font-size:24px; color:var(--druck)">Es ist geregelt.</p>
      <a href="/personal" data-cta-location="personal-muenchen-ende" class="btn btn-primary">Personal anfragen</a>
    </div>
  </section>
</BaseLayout>

<script>
/* FAQ-Schließ-Animation — progressive enhancement */
document.querySelectorAll('.faq-item').forEach(function(item) {
  var summary = item.querySelector('summary');
  if (!summary) return;
  summary.addEventListener('click', function(e) {
    if (!item.open) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    e.preventDefault();
    item.classList.add('faq-closing');
    var body = item.querySelector('.faq-body');
    if (!body) { item.classList.remove('faq-closing'); item.removeAttribute('open'); return; }
    body.addEventListener('transitionend', function handler() {
      body.removeEventListener('transitionend', handler);
      item.classList.remove('faq-closing');
      item.removeAttribute('open');
    });
  });
});
</script>

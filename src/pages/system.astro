---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image, getImage } from "astro:assets";
import Stempel from "../components/Stempel.astro";
import bonLeiste from "../assets/bilder/bon-leiste.jpg";
import schulungVonHinten from "../assets/bilder/schulung-von-hinten.jpg";

const ogImg = await getImage({ src: bonLeiste, width: 1200, format: "jpeg" });
const ogImageAlt = "Bon-Leiste mit Bestellzetteln &uuml;ber dem Pass einer Restaurantk&uuml;che";
---

<BaseLayout
  title="Unser System: Koch-App, Schulung und Personal aus einer Hand"
  description="Drei Bausteine, ein Ziel: eine K&uuml;che, die Ihr Niveau h&auml;lt. So greifen Koch-App, Schulung und Personalverleih bei Avorix ineinander."
  ogImage={ogImg.src}
  ogImageAlt={ogImageAlt}
>
  {/* WebPage Schema */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "url": "https://avorix.de/system",
    "primaryImageOfPage": {
      "@type": "ImageObject",
      "url": `https://avorix.de${ogImg.src}`,
      "description": ogImageAlt
    }
  })} />

  {/* BreadcrumbList Schema */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Startseite",
        "item": "https://avorix.de/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Unser System",
        "item": "https://avorix.de/system"
      }
    ]
  })} />

  {/* FAQPage Schema */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Kann ich nur die App nehmen, ohne Schulung?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Nein, und das ist Absicht. Eine leere App hilft Ihnen nicht. Die Einrichtung durch einen Avorix-Koch gehört immer dazu, sonst geben wir das System nicht aus der Hand."
        }
      },
      {
        "@type": "Question",
        "name": "Kann ich nur Personal buchen, ohne App?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja, das geht. Wir empfehlen aber die Kombination: Dann hinterlässt jeder Einsatz dokumentiertes Wissen in Ihrer Küche statt nur gearbeitete Stunden."
        }
      },
      {
        "@type": "Question",
        "name": "Wir haben unsere Rezepte schon dokumentiert. Bringt das was?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja, das beschleunigt die Aufnahme deutlich. Der Avorix-Koch prüft Ihre Unterlagen, ergänzt Fotos, Mengen und Zeiten und bringt alles in die App."
        }
      },
      {
        "@type": "Question",
        "name": "Wie lange dauert die Einführung insgesamt?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Je nach Karte typischerweise wenige Wochen vom Erstgespräch bis zum eigenständigen Arbeiten."
        }
      },
      {
        "@type": "Question",
        "name": "Was passiert nach den 12 Monaten?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sie entscheiden: verlängern oder beenden. Ihre Rezepte bleiben in jedem Fall Ihr Eigentum."
        }
      },
      {
        "@type": "Question",
        "name": "Schmeckt das wie frisch gekocht?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja. Durch das Vakuumieren bleiben Aromen, Textur und Nährstoffe unter Luftabschluss erhalten. Regeneriert wird erst, wenn der Gast bestellt, punktgenau und in wenigen Minuten."
        }
      },
      {
        "@type": "Question",
        "name": "Brauche ich neue Geräte?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Meist nicht. In den meisten Küchen reicht das vorhandene Equipment. Was Ihnen wirklich fehlt, klären wir im kostenlosen Erstgespräch."
        }
      },
      {
        "@type": "Question",
        "name": "Bietet ihr auch reine F&B-Beratung an?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ja. Wenn Sie erst einmal nur einen Blick von außen auf Karte, Abläufe und Kalkulation wollen, machen wir auch das. Sprechen Sie uns im Erstgespräch darauf an."
        }
      }
    ]
  })} />

  {/* Hero (W2: Text-Hero, linksbündig) */}
 <section class="hero-section px-6">
    <div class="content-width">
      <p class="eyebrow mb-4">Das Avorix-System</p>
      <h1 class="mb-6">Nicht nur eine App.<br /><mark>Ein komplettes K&uuml;chensystem.</mark></h1>
      <p class="lead mb-8 max-w-[var(--spalte-text)]" style="color:var(--grau)">
        Drei Bausteine, ein Ziel: eine K&uuml;che, die Ihr Niveau h&auml;lt, egal wer gerade am Herd steht.
        <strong>Software, Schulung und Personal greifen bei Avorix ineinander.</strong> Deshalb funktioniert es.
      </p>
      <a
        href="/kontakt"
        data-cta-location="system-hero"
        class="btn btn-primary"
      >App-Demo vereinbaren</a>
      <div class="hero-badges mt-6">
        <Stempel>Gepr&uuml;ft &middot; A&Uuml;-Erlaubnis</Stempel>
      </div>
    </div>
  </section>

  {/* Drei Bausteine */}
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">
        Unser System. Die Schulung. Die Verst&auml;rkung.
      </h2>
      {/* Korrektur 9 (Anweisung 25): Der Satz stand unter den Modulen. Er ist
           zu verstehen, bevor man sie gesehen hat, also gehoert er nach oben. */}
      <p class="text-sm mb-10 max-w-[var(--spalte-text)]" style="color:var(--grau)">
        Denken Sie an Feuerwehr und Brandschutz: Die Verst&auml;rkung l&ouml;scht den akuten Brand. System und Schulung
        sorgen daf&uuml;r, dass es nie wieder brennt. <strong>Avorix ist beides.</strong>
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
        {/* Baustein 1: Unser System */}
        <div class="card-modul">
          <div class="card-modul-header">
            <span class="card-modul-label">Modul 1</span>
            <span class="card-modul-leader"></span>
          </div>
          <h3 class="mb-4">Unser System (die Koch-App)</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">
            <strong>Das Ged&auml;chtnis Ihrer K&uuml;che.</strong> Jedes Gericht Ihrer Karte als Schritt-f&uuml;r-Schritt-Anleitung: mit Fotos,
            genauen Mengen und Zeiten. Die App rechnet Portionen um und wertet den Wareneinsatz aus. L&auml;uft jeden
            Tag, auf Tablet und Smartphone, direkt im Browser.
          </p>
        </div>
        {/* Baustein 2: Die Schulung */}
        <div class="card-modul">
          <div class="card-modul-header">
            <span class="card-modul-label">Modul 2</span>
            <span class="card-modul-leader"></span>
          </div>
          <h3 class="mb-4">Die Schulung</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">
            Der Transfer. Ein Avorix-Koch mit mindestens Sous-Chef-Erfahrung nimmt Ihre Karte auf, legt sie in der
            App an und lernt Ihr Team an. Als kompakte Schulungsbl&ouml;cke oder live im laufenden Betrieb.
          </p>
        </div>
        {/* Baustein 3: Die Verstärkung */}
        <div class="card-modul">
          <div class="card-modul-header">
            <span class="card-modul-label">Modul 3</span>
            <span class="card-modul-leader"></span>
          </div>
          <h3 class="mb-4">Die Verst&auml;rkung</h3>
          <p class="text-sm leading-relaxed" style="color:var(--grau)">
            Festangestellte Avorix-K&ouml;che, die wir Ihnen rechtssicher ausleihen. F&uuml;r den Notfall, f&uuml;r die Saison,
            f&uuml;r den &Uuml;bergang. Mit beh&ouml;rdlicher Arbeitnehmer&uuml;berlassungserlaubnis.
          </p>
          <div class="mt-4">
            <Stempel>Gepr&uuml;ft &middot; A&Uuml;-Erlaubnis</Stempel>
          </div>
          <div class="mt-4">
            <a href="/personal#anfrage" data-cta-location="system-verstaerkung" data-cta-event="cta_personal_click" class="btn btn-secondary">Personal anfragen</a>
          </div>
        </div>
      </div>
      {/* Korrektur 21 (Anweisung 25): Das Bild stand zwischen Ueberschrift und
           Modulen. Die Ueberschrift kuendigt drei Dinge an, der Leser sucht sie;
           das Bild schob sich dazwischen. Jetzt darunter. */}
      <Image
        src={bonLeiste}
        alt="Bon-Leiste mit Bestellzetteln &uuml;ber dem Pass einer Restaurantk&uuml;che"
        widths={[480, 800, 1200, 1600]}
        sizes="(max-width: 1024px) 100vw, 1080px"
        loading="lazy"
        decoding="async"
        class="w-full object-cover mt-10"
        style="height:360px;border-radius:var(--radius);box-shadow:var(--schatten)"
      />
    </div>
  </section>

  {/* Einzeln gut. Zusammen unschlagbar. */}
 <section class="reveal section-gap section-dunkel">
    <div class="content-width">
      <h2 class="mb-10 md:mb-16">
        Einzeln gut. Zusammen unschlagbar.
      </h2>
      <div class="grid sm:grid-cols-2 gap-6">
        {/* a */}
        <div class="card">
          <span class="schritt-chip">a</span>
          <h3 class="mt-4 mb-4">Eine App allein ist eine leere H&uuml;lle.</h3>
          <p class="text-sm leading-relaxed">
            Irgendwer muss Ihre Karte aufnehmen, fotografieren und Ihr Team anlernen. Genau das ist die Schulung.
            Deshalb richten wir jedes System selbst ein.
          </p>
        </div>
        {/* b */}
        <div class="card">
          <span class="schritt-chip">b</span>
          <h3 class="mt-4 mb-4">Eine Schulung allein verpufft.</h3>
          <p class="text-sm leading-relaxed">
            Angelernte Menschen vergessen, wechseln, k&uuml;ndigen. Ohne App wandert das Wissen zur&uuml;ck in K&ouml;pfe,
            und mit den K&ouml;pfen aus der T&uuml;r. <strong>Die App h&auml;lt fest, was die Schulung aufbaut.</strong>
          </p>
        </div>
        {/* c */}
        <div class="card">
          <span class="schritt-chip">c</span>
          <h3 class="mt-4 mb-4">Ein Leihkoch allein ist die teuerste L&ouml;sung der Welt.</h3>
          <p class="text-sm leading-relaxed">
            Wenn er geht, ist alles wie vorher, und Sie buchen den n&auml;chsten. Das ist das Gesch&auml;ftsmodell
            klassischer Zeitarbeit. Genau davon unterscheiden wir uns:
          </p>
        </div>
        {/* star */}
        <div class="card">
          <span class="schritt-chip">&#9733;</span>
          <h3 class="mt-4 mb-4">Bei uns geht der Leihkoch irgendwann wieder. Sein Wissen bleibt da.</h3>
          <p class="text-sm leading-relaxed">
            Jeder Avorix-Koch arbeitet mit der App und dokumentiert dabei weiter. <strong>Sie bezahlen Personal und
            bauen nebenbei Ihr System auf.</strong>
          </p>
        </div>
      </div>
      {/* Kernsatz (Anweisung 30, Schritt 4) */}
      <p class="mt-8 max-w-[var(--spalte-text)]" style="color:var(--papier);font-weight:700">Avorix hilft doppelt: sofort ein Koch, wenn Ihrer fehlt. Und ein System, damit es nie wieder so weit kommt.</p>
    </div>
  </section>

  {/* Vom ersten Gespräch */}
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">
        Vom ersten Gespr&auml;ch zur K&uuml;che, die immer funktioniert.
      </h2>
      {/* Korrektur 21 (Anweisung 25): Bild und Schritte standen untereinander,
           das Bild ueber die volle Breite. Jetzt nebeneinander: Bild links, die
           vier Schritte rechts. Auf dem Handy untereinander, Bild zuerst -- das
           macht .split-row von selbst. */}
      <div class="split-row" style="align-items:start">
      <div class="split-media">
        <Image
          src={schulungVonHinten}
          alt="Zwei K&ouml;che von hinten am Herd, einer erkl&auml;rt einen Arbeitsschritt"
          widths={[480, 800, 1200, 1600]}
          sizes="(max-width: 900px) 100vw, 420px"
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover"
        />
      </div>
      <div class="split-copy space-y-6">
        {/* Step 1 */}
        <div class="schritt">
          <span class="schritt-chip shrink-0">1</span>
          <div>
            <h3 class="mb-4">Wir schauen uns Ihre K&uuml;che an. (Kostenlos)</h3>
            <p class="text-sm leading-relaxed max-w-[var(--spalte-text)]" style="color:var(--grau)">
              30 Minuten, per Video oder vor Ort. Sie erz&auml;hlen, wo es klemmt. Wir sagen ehrlich, ob Avorix zu
              Ihnen passt, und was es kosten w&uuml;rde.
            </p>
          </div>
        </div>
        {/* Step 2 */}
        <div class="schritt">
          <span class="schritt-chip shrink-0">2</span>
          <div>
            <h3 class="mb-4">Ein Avorix-Koch nimmt Ihre Karte auf.</h3>
            <p class="text-sm leading-relaxed max-w-[var(--spalte-text)]" style="color:var(--grau)">
              Er kocht mit Ihrem Team, dokumentiert jedes Gericht, fotografiert jeden Schritt und legt alles in
              der App an. Ein Aufnahme-Block umfasst f&uuml;nf Tage mit je sechs Stunden. Eine typische Karte mit 12
              bis 15 Gerichten braucht die Aufnahme plus einen zweiten Block f&uuml;r die reine Schulung.
            </p>
          </div>
        </div>
        {/* Step 3 */}
        <div class="schritt">
          <span class="schritt-chip shrink-0">3</span>
          <div>
            <h3 class="mb-4">Ihr Team lernt das System.</h3>
            <p class="text-sm leading-relaxed max-w-[var(--spalte-text)]" style="color:var(--grau)">
              Kompakte Schulungstage oder ein Koch, der produktiv mitarbeitet und nebenbei anlernt. <strong>Wer eine
              Woche mit der App gekocht hat, braucht sie nicht mehr erkl&auml;rt zu bekommen.</strong>
            </p>
          </div>
        </div>
        {/* Step 4 */}
        <div class="schritt">
          <span class="schritt-chip shrink-0">4</span>
          <div>
            <h3 class="mb-4">Sie arbeiten selbst&auml;ndig. Wir bleiben erreichbar.</h3>
            <p class="text-sm leading-relaxed max-w-[var(--spalte-text)]" style="color:var(--grau)">
              Die App f&uuml;hrt Ihr Team durch jeden Tag. Neue Gerichte pflegen Sie selbst ein oder wir &uuml;bernehmen
              das. F&auml;llt Ihnen ein Koch aus, rufen Sie uns an. Auf Wunsch kommt ein Avorix-Koch regelm&auml;&szlig;ig in Ihren Betrieb, schaut sich die Abl&auml;ufe an und coacht Ihr Team.
            </p>
          </div>
        </div>
      </div>
      </div>
      <div class="mt-16">
        <a
          href="/kontakt"
          data-cta-location="system-ablauf"
          class="btn btn-primary"
        >App-Demo vereinbaren</a>
      </div>
    </div>
  </section>

  {/* Gebaut für Häuser mit fester Karte */}
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">
        Gebaut f&uuml;r H&auml;user mit fester Karte.
      </h2>
      <p class="leading-relaxed max-w-[var(--spalte-text)] mb-6" style="color:var(--grau)">
        Avorix passt zu Betrieben, deren Karte wiederkehrt: Ferienhotels mit Halbpension, Gastl&ouml;fe und Restaurants
        mit fester Karte, Sporthotels mit Gruppen und Trainingslagern. <strong>Je fester die Karte, desto st&auml;rker wirkt
        das System.</strong>
      </p>
      <p class="leading-relaxed max-w-[var(--spalte-text)]" style="color:var(--grau)">
        Und ehrlich gesagt: F&uuml;r eine t&auml;glich wechselnde Spitzengastronomie mit Patron am Herd <strong>ist Avorix nicht
        gebaut</strong>. Das sagen wir Ihnen auch im ersten Gespr&auml;ch.
      </p>
    </div>
  </section>

  {/* Was kostet das */}
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-6" style="color:var(--druck)">
        Was kostet das?
      </h2>
      <div class="card card-text">
        <p class="leading-relaxed mb-8" style="color:var(--grau)">
          Jeder Baustein hat einen klaren Preis, und Sie bekommen ihn im Erstgespr&auml;ch schwarz auf wei&szlig;: App
          monatlich, Schulung pro Block, Personal pro Stunde. Keine versteckten Posten. F&uuml;r die ersten Betriebe
          gelten 2026 Pilotkonditionen deutlich unter dem regul&auml;ren Preis.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="/kontakt"
            data-cta-location="system-kosten"
            class="btn btn-primary"
          >App-Demo vereinbaren</a>
          <a
            href="/pilotprogramm"
            data-cta-location="system-pilot"
            class="btn btn-secondary"
          >Zum Pilotprogramm</a>
        </div>
      </div>
    </div>
  </section>

  {/* FAQ */}
 <section class="reveal section-gap">
    <div class="content-width">
      <h2 class="mb-10" style="color:var(--druck)">
        H&auml;ufige Fragen
      </h2>
      <div class="faq-list">
        <details class="faq-item" open>
          <summary class="faq-q">Kann ich nur die App nehmen, ohne Schulung?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Nein, und das ist Absicht. <strong>Eine leere App hilft Ihnen nicht.</strong> Die Einrichtung durch einen Avorix-Koch
            geh&ouml;rt immer dazu, sonst geben wir das System nicht aus der Hand.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Kann ich nur Personal buchen, ohne App?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Ja, das geht. Wir empfehlen aber die Kombination: Dann hinterl&auml;sst jeder Einsatz dokumentiertes
            Wissen in Ihrer K&uuml;che statt nur gearbeitete Stunden.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Wir haben unsere Rezepte schon dokumentiert. Bringt das was?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Ja, das beschleunigt die Aufnahme deutlich. Der Avorix-Koch pr&uuml;ft Ihre Unterlagen, erg&auml;nzt Fotos,
            Mengen und Zeiten und bringt alles in die App.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Wie lange dauert die Einf&uuml;hrung insgesamt?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Je nach Karte typischerweise wenige Wochen vom Erstgespr&auml;ch bis zum eigenst&auml;ndigen Arbeiten.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Was passiert nach den 12 Monaten?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Sie entscheiden: verl&auml;ngern oder beenden. Ihre Rezepte bleiben in jedem Fall Ihr Eigentum.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Schmeckt das wie frisch gekocht?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Ja. Durch das Vakuumieren bleiben Aromen, Textur und N&auml;hrstoffe unter Luftabschluss erhalten. Regeneriert wird erst, wenn der Gast bestellt, punktgenau und in wenigen Minuten.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Brauche ich neue Ger&auml;te?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Meist nicht. In den meisten K&uuml;chen reicht das vorhandene Equipment. Was Ihnen wirklich fehlt, kl&auml;ren wir im kostenlosen Erstgespr&auml;ch.</p></div></div>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Bietet ihr auch reine F&amp;B-Beratung an?<svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M4.5 6.75L9 11.25L13.5 6.75" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
          <div class="faq-body"><div class="faq-inner"><p>Ja. Wenn Sie erst einmal nur einen Blick von au&szlig;en auf Karte, Abl&auml;ufe und Kalkulation wollen, machen wir auch das. Sprechen Sie uns im Erstgespr&auml;ch darauf an.</p></div></div>
        </details>

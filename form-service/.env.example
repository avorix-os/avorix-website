# Avorix-Formular-Dienst – Konfiguration
# Kopie als .env anlegen und ausfuellen. Die .env ist per .gitignore
# ausgeschlossen und darf NIE ins Repo. Secrets (SMTP_PASS) nur hier eintragen.

# Port, auf dem der Dienst lokal lauscht (nginx reicht /api/formular hierher).
PORT=8081

# Erlaubte Urspruenge (kommagetrennt). LEER = alle erlauben -> nur fuer DEV!
ALLOWED_ORIGINS=https://avorix.de,https://www.avorix.de

# Basis-URL fuer Redirects (ohne Schraegstrich am Ende).
SITE_BASE=https://avorix.de

# Ablageverzeichnis fuer eingegangene Anfragen (jede Anfrage als Datei).
DATA_DIR=/var/lib/avorix-form/data

# Aufbewahrung in Tagen.
RETENTION_DAYS=90
RETENTION_DAYS_BEWERBUNG=180

# --- SMTP (eigenes Postfach der Domain, KEIN Versanddienst) ---
SMTP_HOST=
SMTP_PORT=587
# true nur bei Port 465 (implizites TLS); bei 587 = false (STARTTLS).
SMTP_SECURE=false
SMTP_USER=formular@avorix.de
# ACHTUNG SECRET – nur hier, nie in Chat/Repo/Logs:
SMTP_PASS=

# Absender / Empfaenger
MAIL_FROM=formular@avorix.de
MAIL_TO=info@avorix.de
# Optional: eigene Adresse fuer Bewerbungen (leer -> geht an MAIL_TO).
MAIL_TO_BEWERBUNG=
# Optional: zweite Warn-Adresse bei Zustellfehler.
MAIL_FAILOVER=

# Spamabwehr (Feldnamen muessen mit dem Formular-Markup uebereinstimmen).
HONEYPOT_FIELD=website
TS_FIELD=form_ts
MIN_FILL_MS=3000
